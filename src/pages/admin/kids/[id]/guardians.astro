---
export const prerender = false;
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import FamilyGuardians from "../../../../components/react/FamilyGuardians";
import { getDatabase } from "../../../../lib/server/db";
import { kidGuardians } from "../../../../lib/registration/guardians";
import { uuid } from "../../../../lib/registration/schema";
const id = Astro.params.id;
if (!uuid.safeParse(id).success) return new Response("Duckie not found", {status:404});
const { rows } = await getDatabase().query("SELECT id,name FROM club_kid WHERE id=$1 AND archived_at IS NULL", [id]);
if (!rows[0]) return new Response("Duckie not found", {status:404});
const guardians = await kidGuardians([id!]);
---
<AdminLayout title={`Guardians · ${rows[0].name}`} section="kids">
  <a href="/admin/kids" class="font-bold underline underline-offset-4">← Duckies</a>
  <h1 class="mt-5 font-display text-4xl font-bold">{rows[0].name}’s family</h1>
  <FamilyGuardians client:load kids={rows} initialGuardians={guardians} actorEmail={Astro.locals.session!.user.email.toLowerCase()} />
</AdminLayout>
