---
export const prerender = false;
import type { Order, OrderItem, Product } from "../../generated/prisma/client";
import { OrderStatus } from "../../generated/prisma/client";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { STATUS_COLOR, STATUS_LABEL } from "../../lib/admin-orders";
import { formatPrice, shortOrderId } from "../../lib/format";
import { prisma } from "../../lib/prisma";
import Kicker from "../../components/ui/Kicker.astro";
import StickerCard from "../../components/ui/StickerCard.astro";

type DashboardData = {
  revenue7d: number;
  revenue30d: number;
  openCount: number;
  cashToCollectCents: number;
  cashToCollectCount: number;
  totalCount: number;
  recentOrders: (Order & { items: OrderItem[] })[];
  lowStock: Product[];
  statusBreakdown: Record<OrderStatus, number>;
};

const now = new Date();
const day = 24 * 60 * 60 * 1000;

let data: DashboardData | null = null;
let loadError: string | null = null;

try {
  const [
    revenue7dAgg,
    revenue30dAgg,
    openCount,
    cashToCollectAgg,
    totalCount,
    recentOrders,
    lowStock,
    statusGroups,
  ] = await Promise.all([
    prisma.order.aggregate({
      _sum: { totalCents: true },
      where: {
        createdAt: { gte: new Date(now.getTime() - 7 * day) },
        status: { not: OrderStatus.CANCELLED },
      },
    }),
    prisma.order.aggregate({
      _sum: { totalCents: true },
      where: {
        createdAt: { gte: new Date(now.getTime() - 30 * day) },
        status: { not: OrderStatus.CANCELLED },
      },
    }),
    prisma.order.count({
      where: {
        status: {
          in: [OrderStatus.PENDING, OrderStatus.CONFIRMED, OrderStatus.READY],
        },
      },
    }),
    prisma.order.aggregate({
      _sum: { totalCents: true },
      _count: { _all: true },
      where: {
        status: OrderStatus.FULFILLED,
        paidAt: null,
      },
    }),
    prisma.order.count(),
    prisma.order.findMany({
      orderBy: { createdAt: "desc" },
      take: 8,
      include: { items: true },
    }),
    prisma.product.findMany({
      where: { active: true, stock: { not: null, lte: 3 } },
      orderBy: { stock: "asc" },
      take: 6,
    }),
    prisma.order.groupBy({
      by: ["status"],
      _count: { _all: true },
    }),
  ]);

  const statusBreakdown: Record<OrderStatus, number> = {
    PENDING: 0,
    CONFIRMED: 0,
    READY: 0,
    FULFILLED: 0,
    CANCELLED: 0,
  };
  for (const row of statusGroups) {
    statusBreakdown[row.status] = row._count._all;
  }

  data = {
    revenue7d: revenue7dAgg._sum.totalCents ?? 0,
    revenue30d: revenue30dAgg._sum.totalCents ?? 0,
    openCount,
    cashToCollectCents: cashToCollectAgg._sum.totalCents ?? 0,
    cashToCollectCount: cashToCollectAgg._count._all,
    totalCount,
    recentOrders,
    lowStock,
    statusBreakdown,
  };
} catch (err) {
  loadError = "Could not load dashboard.";
  Astro.response.status = 503;
  console.error("[admin] dashboard load failed:", err);
}
---

<AdminLayout title="Dashboard · Admin · Sunset Duckies" section="dashboard">
  <div class="mb-8 space-y-2">
    <Kicker>✦ Overview</Kicker>
    <h1 class="font-display text-fg text-[clamp(2rem,4vw,3rem)] leading-[1] [font-variation-settings:'wdth'_114] font-bold"
    >
      Club backstage.
    </h1>
  </div>

  {loadError ? (
    <StickerCard class="p-6">
      <p class="font-mono text-[0.7rem] uppercase tracking-[0.22em] text-coral-500">
        Dashboard offline
      </p>
      <p class="mt-2 text-[0.95rem] text-fg/80">{loadError}</p>
    </StickerCard>
  ) : data && (
    <>
      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <StickerCard class="p-5">
          <Kicker>Booked · 7d</Kicker>
          <p class="mt-2 font-display text-3xl text-fg [font-variation-settings:'wdth'_112] font-bold">
            {formatPrice(data.revenue7d)}
          </p>
          <p class="mt-1 font-mono text-[0.66rem] uppercase tracking-[0.16em] text-fg/55">
            Reserved value · excludes cancelled
          </p>
        </StickerCard>
        <StickerCard class="p-5">
          <Kicker>Booked · 30d</Kicker>
          <p class="mt-2 font-display text-3xl text-fg [font-variation-settings:'wdth'_112] font-bold">
            {formatPrice(data.revenue30d)}
          </p>
        </StickerCard>
        <StickerCard class="p-5">
          <Kicker>Open reservations</Kicker>
          <p class="mt-2 font-display text-3xl text-fg [font-variation-settings:'wdth'_112] font-bold">
            {data.openCount}
          </p>
          <p class="mt-1 font-mono text-[0.66rem] uppercase tracking-[0.16em] text-fg/55">
            Pending · confirmed · ready
          </p>
        </StickerCard>
        <StickerCard class="bg-sun-500 p-5 text-ink-950">
          <Kicker>Cash to collect</Kicker>
          <p class="mt-2 font-display text-3xl text-fg [font-variation-settings:'wdth'_112] font-bold">
            {formatPrice(data.cashToCollectCents)}
          </p>
          <p class="mt-1 font-mono text-[0.66rem] uppercase tracking-[0.16em] text-fg/65">
            {data.cashToCollectCount} fulfilled, unpaid
          </p>
        </StickerCard>
      </div>

      <div class="mt-10 grid gap-6 lg:grid-cols-[1.4fr_0.9fr]">
        <StickerCard as="section" class="p-5">
          <div class="mb-4 flex items-end justify-between">
            <Kicker>Recent reservations</Kicker>
            <a href="/admin/orders" class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-coral-500 hover:underline">
              All reservations →
            </a>
          </div>
          {data.recentOrders.length === 0 ? (
            <p class="py-10 text-center font-mono text-[0.76rem] uppercase tracking-[0.16em] text-fg/55">
              No reservations yet — the first one will appear here.
            </p>
          ) : (
            <ul class="divide-y divide-dashed divide-edge/15">
              {data.recentOrders.map((o) => (
                <li class="py-3">
                  <a href={`/admin/orders/${o.id}`} class="flex flex-wrap items-center justify-between gap-3 hover:text-coral-500">
                    <div class="min-w-0">
                      <p class="font-display text-base text-fg [font-variation-settings:'wdth'_110] font-bold">
                        {o.name} · {shortOrderId(o.id)}
                      </p>
                      <p class="font-mono text-[0.64rem] uppercase tracking-[0.16em] text-fg/55">
                        {new Date(o.createdAt).toLocaleString("en-GB", {
                          day: "2-digit",
                          month: "short",
                          hour: "2-digit",
                          minute: "2-digit",
                        })}
                        · {o.items.reduce((n, i) => n + i.quantity, 0)} items
                      </p>
                    </div>
                    <div class="flex items-center gap-3">
                      <span class:list={["rounded-full border border-ink-950 px-2.5 py-0.5 font-mono text-[0.6rem] uppercase tracking-[0.14em]", STATUS_COLOR[o.status]]}>
                        {STATUS_LABEL[o.status]}
                      </span>
                      <span class="font-mono text-[0.82rem] text-fg">
                        {formatPrice(o.totalCents, o.currency)}
                      </span>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </StickerCard>

        <aside class="space-y-6">
          <StickerCard class="p-5">
            <Kicker>Status mix</Kicker>
            <ul class="mt-3 space-y-2">
              {(Object.keys(data.statusBreakdown) as OrderStatus[]).map((status) => (
                <li class="flex items-center justify-between gap-3">
                  <span class="flex items-center gap-2 font-mono text-[0.72rem] uppercase tracking-[0.16em] text-fg/75">
                    <span class:list={["inline-block h-2 w-2 rounded-full", STATUS_COLOR[status]]}></span>
                    {STATUS_LABEL[status]}
                  </span>
                  <span class="font-mono text-[0.82rem] text-fg">
                    {data.statusBreakdown[status]}
                  </span>
                </li>
              ))}
            </ul>
          </StickerCard>

          <StickerCard class="p-5">
            <Kicker>Low stock</Kicker>
            {data.lowStock.length === 0 ? (
              <p class="mt-3 font-mono text-[0.72rem] uppercase tracking-[0.16em] text-fg/55">
                Nothing's running low.
              </p>
            ) : (
              <ul class="mt-3 space-y-2">
                {data.lowStock.map((p) => (
                  <li>
                    <a href={`/admin/products/${p.id}`} class="flex items-center justify-between gap-3 hover:text-coral-500">
                      <span class="font-display text-sm [font-variation-settings:'wdth'_110] font-bold">
                        {p.name}
                      </span>
                      <span class="rounded-full border border-coral-500 bg-coral-500/10 px-2 py-0.5 font-mono text-[0.62rem] uppercase tracking-[0.14em] text-coral-500">
                        {p.stock} left
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </StickerCard>
        </aside>
      </div>
    </>
  )}
</AdminLayout>
