---
export const prerender = false;
import DropForm from "../../../components/react/DropForm";
import AdminLayout from "../../../layouts/AdminLayout.astro";
---

<AdminLayout title="New drop · Admin" section="drops">
  <div class="mb-6 space-y-2">
    <a href="/admin/drops" class="font-mono text-[0.66rem] uppercase tracking-[0.2em] text-fg/65 hover:text-coral-500">
      ← Drops
    </a>
    <h1 class="font-display text-fg text-[clamp(1.8rem,3.5vw,2.6rem)] leading-[1] [font-variation-settings:'wdth'_114] font-bold"
    >
      Spin up the next drop.
    </h1>
  </div>
  <DropForm client:load mode="create" />
</AdminLayout>
