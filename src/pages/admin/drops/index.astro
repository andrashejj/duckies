---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { DROP_STATUS_COLOR, DROP_STATUS_LABEL, listDropsWithCounts } from "../../../lib/drops";
import Cta from "../../../components/ui/Cta.astro";
import Kicker from "../../../components/ui/Kicker.astro";
import StickerCard from "../../../components/ui/StickerCard.astro";

let drops: Awaited<ReturnType<typeof listDropsWithCounts>> = [];
let loadError: string | null = null;

try {
  drops = await listDropsWithCounts();
} catch (err) {
  loadError = "Could not load drops.";
  Astro.response.status = 503;
  console.error("[admin/drops] load failed:", err);
}

const dateFormatter = new Intl.DateTimeFormat("en-GB", {
  day: "2-digit",
  month: "short",
  year: "numeric",
});
---

<AdminLayout title="Drops · Admin" section="drops">
  <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div class="space-y-2">
      <Kicker>✦ Drops</Kicker>
      <h1 class="font-display text-fg text-[clamp(2rem,4vw,3rem)] leading-[1] [font-variation-settings:'wdth'_114] font-bold"
      >
        The seasons.
      </h1>
    </div>
    <Cta href="/admin/drops/new">+ New drop</Cta>
  </div>

  {loadError ? (
    <StickerCard class="p-6">
      <p class="font-mono text-[0.7rem] uppercase tracking-[0.22em] text-coral-500">
        Could not load drops
      </p>
      <p class="mt-2 text-[0.95rem] text-fg/80">{loadError}</p>
    </StickerCard>
  ) : drops.length === 0 ? (
    <StickerCard class="p-12 text-center">
      <p class="font-mono text-[0.72rem] uppercase tracking-[0.2em] text-fg/55">
        No drops yet.
      </p>
      <Cta class="mt-5" href="/admin/drops/new">Create the first drop →</Cta>
    </StickerCard>
  ) : (
    <StickerCard class="overflow-hidden">
      <table class="w-full border-separate border-spacing-0 text-sm">
        <thead class="bg-ink-950 text-cream-soft">
          <tr>
            <th class="px-4 py-3 text-left font-mono text-[0.66rem] uppercase tracking-[0.2em]">Drop</th>
            <th class="px-4 py-3 text-left font-mono text-[0.66rem] uppercase tracking-[0.2em]">Status</th>
            <th class="px-4 py-3 text-left font-mono text-[0.66rem] uppercase tracking-[0.2em]">Window</th>
            <th class="px-4 py-3 text-right font-mono text-[0.66rem] uppercase tracking-[0.2em]">Products</th>
          </tr>
        </thead>
        <tbody>
          {drops.map((d) => (
            <tr class="group border-t border-edge/10 hover:bg-sun-500/20">
              <td class="px-4 py-3">
                <a href={`/admin/drops/${d.id}`} class="block">
                  <p class="font-display text-sm text-fg group-hover:text-coral-500 [font-variation-settings:'wdth'_110] font-bold">
                    {d.name}
                  </p>
                  <p class="font-mono text-[0.62rem] uppercase tracking-[0.14em] text-fg/55">
                    /{d.slug}
                  </p>
                </a>
              </td>
              <td class="px-4 py-3">
                <span class:list={["rounded-full border border-ink-950 px-2.5 py-0.5 font-mono text-[0.62rem] uppercase tracking-[0.14em]", DROP_STATUS_COLOR[d.status]]}>
                  {DROP_STATUS_LABEL[d.status]}
                </span>
              </td>
              <td class="px-4 py-3 font-mono text-[0.72rem] text-fg/70">
                {d.opensAt ? dateFormatter.format(d.opensAt) : "—"}
                {" → "}
                {d.closesAt ? dateFormatter.format(d.closesAt) : "—"}
              </td>
              <td class="px-4 py-3 text-right font-mono text-[0.82rem]">
                {d._count.products}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </StickerCard>
  )}
</AdminLayout>
