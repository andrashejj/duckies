---
export const prerender = false;
import { canManagePayments } from "../../../lib/registration/schema";
import OrderActions from "../../../components/react/OrderActions";
import OrderNoteForm from "../../../components/react/OrderNoteForm";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import {
  getOrderForAdmin,
  STATUS_COLOR,
  STATUS_LABEL,
  STATUS_TRANSITIONS,
} from "../../../lib/admin-orders";
import { formatPrice, shortOrderId } from "../../../lib/format";
import { prisma } from "../../../lib/prisma";
import Kicker from "../../../components/ui/Kicker.astro";
import StickerCard from "../../../components/ui/StickerCard.astro";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/admin/orders");
}

let order: Awaited<ReturnType<typeof getOrderForAdmin>> = null;
let actor: { name: string | null; email: string } | null = null;

try {
  order = await getOrderForAdmin(id);
  if (order?.userId) {
    const user = await prisma.user.findUnique({
      where: { id: order.userId },
      select: { name: true, email: true },
    });
    actor = user ?? null;
  }
} catch (err) {
  console.error("[admin/orders/[id]] load failed:", err);
}

if (!order) {
  return new Response(null, { status: 404, statusText: "Reservation not found" });
}

const nextStatuses = STATUS_TRANSITIONS[order.status];
const eventTypeLabel: Record<string, string> = {
  CREATED: "Created",
  CONFIRMED: "Confirmed",
  READY: "Ready",
  FULFILLED: "Fulfilled",
  CANCELLED: "Cancelled",
  PAID: "Paid",
  NOTE: "Note",
  EMAIL_SENT: "Email sent",
};

const eventTypeColor: Record<string, string> = {
  CREATED: "bg-sun-500",
  CONFIRMED: "bg-teal-500",
  READY: "bg-teal-500",
  FULFILLED: "bg-lilac-400",
  CANCELLED: "bg-coral-500",
  PAID: "bg-teal-500",
  NOTE: "bg-surface-2",
  EMAIL_SENT: "bg-surface-2",
};
---

<AdminLayout
 title={`Reservation ${shortOrderId(order.id)} · Admin`}
  section="orders"
>
  <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
    <div class="space-y-2">
      <a href="/admin/orders" class="font-mono text-[0.66rem] uppercase tracking-[0.2em] text-fg/65 hover:text-coral-500">
        ← Reservations
      </a>
      <h1 class="font-display text-fg text-[clamp(1.8rem,3.5vw,2.6rem)] leading-[1] [font-variation-settings:'wdth'_112] font-bold"
      >
        Reservation {shortOrderId(order.id)}
      </h1>
      <p class="font-mono text-[0.66rem] uppercase tracking-[0.18em] text-fg/55">
        Placed {new Date(order.createdAt).toLocaleString("en-GB", {
          day: "2-digit",
          month: "short",
          year: "numeric",
          hour: "2-digit",
          minute: "2-digit",
        })}
        {actor ? ` · signed-in · ${actor.email}` : " · guest"}
      </p>
    </div>
    <div class="flex flex-col items-end gap-2">
      <span class:list={["rounded-full border-2 border-ink-950 px-4 py-1.5 font-mono text-[0.72rem] uppercase tracking-[0.18em] shadow-[3px_3px_0_0_var(--color-ink-950)]", STATUS_COLOR[order.status]]}>
        {STATUS_LABEL[order.status]}
      </span>
      {order.paidAt ? (
        <span class="font-mono text-[0.66rem] uppercase tracking-[0.16em] text-teal-500">
          ✓ Paid {new Date(order.paidAt).toLocaleDateString("en-GB", { day: "2-digit", month: "short" })}
        </span>
      ) : (
        <span class="font-mono text-[0.66rem] uppercase tracking-[0.16em] text-coral-500">
          Cash outstanding · {formatPrice(order.totalCents, order.currency)}
        </span>
      )}
    </div>
  </div>

  <div class="grid gap-6 lg:grid-cols-[1.35fr_1fr]">
    <section class="space-y-6">
      <StickerCard class="p-5">
        <Kicker>Items</Kicker>
        <ul class="mt-4 divide-y divide-dashed divide-edge/15">
          {order.items.map((item) => (
            <li class="flex justify-between gap-4 py-3">
              <div class="min-w-0">
                <p class="font-display text-base text-fg [font-variation-settings:'wdth'_110] font-bold">
                  {item.nameSnapshot}
                </p>
                <p class="mt-0.5 font-mono text-[0.66rem] uppercase tracking-[0.16em] text-fg/60">
                  SKU {item.sku}
                  {item.size ? ` · ${item.size}` : ""} · ×{item.quantity}
                </p>
                {item.kidName && (
                  <p class="mt-1 inline-flex rounded-full border border-edge/40 bg-sun-500/40 px-2.5 py-0.5 font-mono text-[0.62rem] uppercase tracking-[0.16em] text-fg">
                    For {item.kidName}
                  </p>
                )}
              </div>
              <div class="text-right">
                <p class="font-mono text-[0.82rem] text-fg">
                  {formatPrice(item.lineTotalCents, order.currency)}
                </p>
                <p class="font-mono text-[0.64rem] uppercase tracking-[0.14em] text-fg/55">
                  {formatPrice(item.priceCentsSnapshot, order.currency)} each
                </p>
              </div>
            </li>
          ))}
        </ul>
        <dl class="mt-4 space-y-1 border-t-2 border-edge pt-4 font-mono text-[0.82rem]">
          <div class="flex justify-between">
            <dt class="text-fg/70">Subtotal</dt>
            <dd>{formatPrice(order.subtotalCents, order.currency)}</dd>
          </div>
          <div class="mt-2 flex justify-between border-t-2 border-edge pt-3 text-base">
            <dt class="font-display font-bold [font-variation-settings:'wdth'_110]">
              Cash to collect
            </dt>
            <dd class="font-display font-bold [font-variation-settings:'wdth'_110]">
              {formatPrice(order.totalCents, order.currency)}
            </dd>
          </div>
        </dl>
      </StickerCard>

      <StickerCard class="p-5">
        <Kicker>Activity</Kicker>
        <ul class="mt-4 space-y-3">
          {order.events.map((event) => (
            <li class="flex gap-3">
              <span class:list={["mt-1 inline-block h-3 w-3 flex-none rounded-full border border-edge", eventTypeColor[event.type] ?? "bg-surface-2"]}></span>
              <div class="min-w-0 flex-1">
                <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-fg/65">
                  {eventTypeLabel[event.type] ?? event.type}
                  {" · "}
                  {new Date(event.createdAt).toLocaleString("en-GB", {
                    day: "2-digit",
                    month: "short",
                    hour: "2-digit",
                    minute: "2-digit",
                  })}
                </p>
                {event.message && (
                  <p class="mt-0.5 text-[0.92rem] leading-6 text-fg/85">
                    {event.message}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ul>
        <div class="mt-4 border-t border-dashed border-edge/15 pt-4">
          <OrderNoteForm client:load orderId={order.id} />
        </div>
      </StickerCard>
    </section>

    <aside class="space-y-6">
      <StickerCard class="p-5">
        <Kicker>Move it</Kicker>
        <div class="mt-4">
          <OrderActions
 client:load
            orderId={order.id}
            currentStatus={order.status}
            isPaid={order.paidAt !== null}
            canManagePayments={canManagePayments(Astro.locals.session!.user.email)}
            nextStatuses={nextStatuses}
            statusLabel={STATUS_LABEL}
          />
        </div>
      </StickerCard>

      <StickerCard class="p-5 space-y-3">
        <Kicker>Customer</Kicker>
        <p class="font-display text-lg text-fg [font-variation-settings:'wdth'_110] font-bold">
          {order.name}
        </p>
        <a href={`mailto:${order.email}`} class="block font-mono text-[0.82rem] text-coral-500 hover:underline">
          {order.email}
        </a>
        {order.phone && (
          <p class="font-mono text-[0.82rem] text-fg/80">
            {order.phone}
          </p>
        )}
        <dl class="space-y-2 border-t border-dashed border-edge/15 pt-3 font-mono text-[0.72rem] uppercase tracking-[0.14em]">
          <div class="flex justify-between">
            <dt class="text-fg/65">Pickup</dt>
            <dd class="text-fg">{order.pickupMethod}</dd>
          </div>
        </dl>
        {order.customerNote && (
          <div class="rounded-[0.8rem] border border-edge/20 bg-surface-2/60 p-3">
            <p class="font-mono text-[0.6rem] uppercase tracking-[0.16em] text-fg/55">
              Customer note
            </p>
            <p class="mt-1 text-[0.88rem] leading-6 text-fg/85">
              {order.customerNote}
            </p>
          </div>
        )}
      </StickerCard>
    </aside>
  </div>
</AdminLayout>
