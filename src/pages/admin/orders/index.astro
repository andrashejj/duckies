---
export const prerender = false;
import { OrderStatus } from "../../../generated/prisma/client";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { STATUS_COLOR, STATUS_LABEL } from "../../../lib/admin-orders";
import { formatPrice, shortOrderId } from "../../../lib/format";
import { prisma } from "../../../lib/prisma";
import Cta from "../../../components/ui/Cta.astro";
import Kicker from "../../../components/ui/Kicker.astro";
import StickerCard from "../../../components/ui/StickerCard.astro";

const statusParam = Astro.url.searchParams.get("status");
const qParam = Astro.url.searchParams.get("q")?.trim() ?? "";

const statusFilter =
  statusParam && Object.values(OrderStatus).includes(statusParam as OrderStatus)
    ? (statusParam as OrderStatus)
    : null;

let orders: Awaited<ReturnType<typeof prisma.order.findMany>> = [];
let loadError: string | null = null;

try {
  orders = await prisma.order.findMany({
    where: {
      ...(statusFilter ? { status: statusFilter } : {}),
      ...(qParam
        ? {
            OR: [
              { email: { contains: qParam, mode: "insensitive" } },
              { name: { contains: qParam, mode: "insensitive" } },
              { id: { contains: qParam } },
            ],
          }
        : {}),
    },
    orderBy: { createdAt: "desc" },
    include: { items: true },
    take: 100,
  });
} catch (err) {
  loadError = "Could not load reservations.";
  Astro.response.status = 503;
  console.error("[admin/orders] load failed:", err);
}

const filterChips: { label: string; value: OrderStatus | null }[] = [
  { label: "All", value: null },
  { label: "Pending", value: OrderStatus.PENDING },
  { label: "Confirmed", value: OrderStatus.CONFIRMED },
  { label: "Ready", value: OrderStatus.READY },
  { label: "Fulfilled", value: OrderStatus.FULFILLED },
  { label: "Cancelled", value: OrderStatus.CANCELLED },
];

const buildChipHref = (value: OrderStatus | null) => {
  const params = new URLSearchParams();
  if (value) params.set("status", value);
  if (qParam) params.set("q", qParam);
  const qs = params.toString();
  return `/admin/orders${qs ? `?${qs}` : ""}`;
};
---

<AdminLayout title="Reservations · Admin" section="orders">
  <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div class="space-y-2">
      <Kicker>✦ Reservations</Kicker>
      <h1 class="font-display text-fg text-[clamp(2rem,4vw,3rem)] leading-[1] [font-variation-settings:'wdth'_114] font-bold"
      >
        The book.
      </h1>
    </div>
    <form method="get" action="/admin/orders" class="flex items-center gap-2">
      {statusFilter && <input type="hidden" name="status" value={statusFilter} />}
      <input
 type="search"
        name="q"
        value={qParam}
        placeholder="Email, name, reservation id…"
        class="w-64 rounded-[0.8rem] border-2 border-edge bg-surface px-3 py-2 font-sans text-sm shadow-sticker-xs focus:outline-none focus:ring-2 focus:ring-coral-500"
      />
      <Cta variant="secondary" type="submit" class="py-2 px-4 text-[0.78rem]">Search</Cta>
    </form>
  </div>

  <div class="mb-4 flex flex-wrap gap-2">
    {filterChips.map((chip) => {
      const active = chip.value === statusFilter;
      return (
        <a
 href={buildChipHref(chip.value)}
          class:list={[
            "rounded-full border-2 px-3 py-1.5 font-mono text-[0.68rem] uppercase tracking-[0.14em] transition",
            active
              ? "border-edge bg-ink-950 text-sun-500 shadow-sticker-sm"
              : "border-edge/40 bg-surface text-fg/75 hover:bg-sun-500 hover:text-ink-950",
          ]}
        >
          {chip.label}
        </a>
      );
    })}
  </div>

  {loadError ? (
    <StickerCard class="p-6">
      <p class="font-mono text-[0.7rem] uppercase tracking-[0.22em] text-coral-500">
        Could not load reservations
      </p>
      <p class="mt-2 text-[0.95rem] text-fg/80">{loadError}</p>
    </StickerCard>
  ) : orders.length === 0 ? (
    <StickerCard class="p-12 text-center">
      <p class="font-mono text-[0.72rem] uppercase tracking-[0.2em] text-fg/55">
        No reservations match.
      </p>
    </StickerCard>
  ) : (
    <StickerCard class="overflow-hidden">
      <table class="w-full border-separate border-spacing-0 text-sm">
        <thead class="bg-ink-950 text-cream-soft">
          <tr>
            <th class="px-4 py-3 text-left font-mono text-[0.66rem] uppercase tracking-[0.2em]">Reservation</th>
            <th class="px-4 py-3 text-left font-mono text-[0.66rem] uppercase tracking-[0.2em]">Customer</th>
            <th class="px-4 py-3 text-left font-mono text-[0.66rem] uppercase tracking-[0.2em]">Status</th>
            <th class="px-4 py-3 text-left font-mono text-[0.66rem] uppercase tracking-[0.2em]">Paid</th>
            <th class="px-4 py-3 text-right font-mono text-[0.66rem] uppercase tracking-[0.2em]">Total</th>
          </tr>
        </thead>
        <tbody>
          {orders.map((o) => (
            <tr class="group border-t border-edge/10 hover:bg-sun-500/20">
              <td class="px-4 py-3">
                <a href={`/admin/orders/${o.id}`} class="block">
                  <p class="font-display text-sm text-fg group-hover:text-coral-500 [font-variation-settings:'wdth'_110] font-bold">
                    {shortOrderId(o.id)}
                  </p>
                  <p class="font-mono text-[0.62rem] uppercase tracking-[0.14em] text-fg/55">
                    {new Date(o.createdAt).toLocaleString("en-GB", {
                      day: "2-digit",
                      month: "short",
                      hour: "2-digit",
                      minute: "2-digit",
                    })}
                  </p>
                </a>
              </td>
              <td class="px-4 py-3">
                <a href={`/admin/orders/${o.id}`} class="block">
                  <p class="font-semibold text-fg">{o.name}</p>
                  <p class="font-mono text-[0.68rem] text-fg/65">{o.email}</p>
                </a>
              </td>
              <td class="px-4 py-3">
                <span class:list={["rounded-full border border-ink-950 px-2.5 py-0.5 font-mono text-[0.6rem] uppercase tracking-[0.14em]", STATUS_COLOR[o.status]]}>
                  {STATUS_LABEL[o.status]}
                </span>
              </td>
              <td class="px-4 py-3">
                {o.paidAt ? (
                  <span class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-teal-500">
                    ✓ Paid
                  </span>
                ) : (
                  <span class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-fg/45">
                    —
                  </span>
                )}
              </td>
              <td class="px-4 py-3 text-right">
                <span class="font-mono text-[0.82rem] text-fg">
                  {formatPrice(o.totalCents, o.currency)}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </StickerCard>
  )}
</AdminLayout>
