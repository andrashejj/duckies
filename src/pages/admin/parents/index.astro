---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import ParentsTable from "../../../components/react/ParentsTable";
import { readParentProfiles } from "../../../lib/server/parent-profiles";
export const prerender = false;
const parents = await readParentProfiles();
---
<AdminLayout title="Parents · Sunset Duckies" section="parents">
  <header class="mb-8 max-w-2xl">
    <p class="font-mono text-xs uppercase tracking-widest text-accent-text">The grown-ups behind the duckies</p>
    <h1 class="mt-3 font-display text-4xl font-extrabold sm:text-5xl">Parents & guardians</h1>
    <p class="mt-3 text-fg-muted">Registration details, familiar faces and their duckies. Private to organisers. New registrations appear automatically.</p>
  </header>
  <ParentsTable client:load initialParents={parents} />
</AdminLayout>
