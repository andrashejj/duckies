---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Kicker from "../../../components/ui/Kicker.astro";
import SectionTitle from "../../../components/ui/SectionTitle.astro";
import { listUploads, type GalleryUpload } from "../../../lib/server/gallery";
import { bodyCopy, ctaClass, field, label } from "../../../lib/ui";

let uploads: GalleryUpload[] = [];
let loadError: string | null = null;
try { uploads = await listUploads(); } catch { loadError = "The gallery queue could not be loaded. Check the database connection and reload."; }

const groups = [
  { status: "pending", title: "Waiting for review", tone: "sun", empty: "Nothing waiting. Share the link and the queue fills itself: /gallery/share" },
  { status: "approved", title: "On the gallery page", tone: "teal", empty: "No parent photos published yet." },
  { status: "rejected", title: "Rejected", tone: "none", empty: "Nothing rejected." },
] as const;
const when = (iso: string) => new Date(iso).toLocaleString("en-GB", { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit", timeZone: "Indian/Mauritius" });
---

<AdminLayout title="Gallery photos · Admin" section="gallery">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <Kicker>📸 Parent uploads</Kicker>
      <SectionTitle as="h1" class="mt-4">Gallery queue</SectionTitle>
      <p class={`mt-3 max-w-2xl ${bodyCopy}`}>Photos sent through <a class="underline" href="/gallery/share" target="_blank" rel="noreferrer">/gallery/share</a>. Approve to publish under "From the parents" on the gallery page; reject to keep it out. Check the family's media consent on the waiver before approving anything with a recognisable Duckie.</p>
    </div>
    <a class={ctaClass("secondary", "sm")} href="/gallery#from-the-parents" target="_blank" rel="noreferrer">↗ Gallery page</a>
  </div>

  {loadError && <p class="mt-8 rounded-xl border-2 border-coral-500 bg-sticker-coral px-4 py-3 text-ink-950">{loadError}</p>}

  {groups.map((group) => {
    const rows = uploads.filter((u) => u.status === group.status);
    return (
      <section class="mt-12" data-group={group.status}>
        <div class="flex items-baseline gap-3">
          <h2 class="font-display text-2xl font-semibold text-fg">{group.title}</h2>
          <span class="font-mono text-[0.7rem] uppercase tracking-[0.18em] text-fg/60" data-count>{rows.length}</span>
        </div>
        <p class:list={["mt-3", bodyCopy, rows.length && "hidden"]} data-empty>{group.empty}</p>
        <ul class="mt-5 grid gap-5 sm:grid-cols-2 xl:grid-cols-3" data-list>
          {rows.map((u) => (
            <li class="overflow-hidden rounded-sticker border-2 border-edge bg-surface shadow-sticker-sm" data-upload={u.id} data-status={u.status}>
              <a href={`/gallery/photo/${u.id}.webp`} target="_blank" rel="noreferrer" class="block bg-ink-950">
                <img src={`/gallery/photo/${u.id}.webp?size=thumb`} alt="" width={u.width} height={u.height} loading="lazy" class="aspect-[4/3] w-full object-contain" />
              </a>
              <div class="p-4">
                <p class="font-mono text-[0.66rem] uppercase tracking-[0.18em] text-fg/60">{when(u.createdAt)} · {u.uploaderName ?? "no name"}{u.width}×{u.height}</p>
                {u.note && <p class="mt-2 text-sm text-fg">“{u.note}”</p>}
                <label class={`mt-3 ${label}`} for={`caption-${u.id}`}>Caption on the site</label>
                <input id={`caption-${u.id}`} type="text" maxlength="200" value={u.caption ?? u.note ?? ""} class={`mt-1 ${field} py-2 text-sm`} data-caption placeholder="Optional" />
                <div class="mt-3 flex flex-wrap gap-2">
                  {u.status !== "approved" && <button type="button" class={ctaClass("primary", "sm")} data-action="approved">Approve</button>}
                  {u.status === "approved" && <button type="button" class={ctaClass("secondary", "sm")} data-action="pending">Unpublish</button>}
                  {u.status !== "rejected" && <button type="button" class={ctaClass("secondary", "sm")} data-action="rejected">Reject</button>}
                  <button type="button" class="ml-auto font-mono text-[0.68rem] uppercase tracking-[0.16em] text-fg/60 underline underline-offset-4 hover:text-coral-500" data-action="delete">Delete</button>
                </div>
                <p class="mt-2 hidden text-sm text-coral-500" data-error role="alert"></p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    );
  })}
</AdminLayout>

<script>
  // Approve / reject / unpublish / delete without leaving the page; the card moves to its new group.
  document.addEventListener("click", async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-action]");
    if (!button) return;
    const card = button.closest<HTMLLIElement>("[data-upload]");
    if (!card) return;
    const id = card.dataset.upload; const action = button.dataset.action!;
    const error = card.querySelector<HTMLElement>("[data-error]")!;
    error.classList.add("hidden");
    if (action === "delete" && !confirm("Delete this photo for good?")) return;
    button.disabled = true;
    try {
      const caption = card.querySelector<HTMLInputElement>("[data-caption]")?.value ?? "";
      const response = action === "delete"
        ? await fetch(`/api/admin/gallery/${id}`, { method: "DELETE" })
        : await fetch(`/api/admin/gallery/${id}`, { method: "PATCH", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ status: action, caption }) });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.error ?? "That did not work.");
      location.reload();
    } catch (err) {
      error.textContent = err instanceof Error ? err.message : "That did not work.";
      error.classList.remove("hidden");
      button.disabled = false;
    }
  });
</script>
