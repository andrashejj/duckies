---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { formatPrice } from "../../../lib/format";
import { CATEGORY_LABEL } from "../../../lib/product-admin";
import { prisma } from "../../../lib/prisma";
import Cta from "../../../components/ui/Cta.astro";
import Kicker from "../../../components/ui/Kicker.astro";
import StickerCard from "../../../components/ui/StickerCard.astro";

let products: Awaited<ReturnType<typeof prisma.product.findMany>> = [];
let loadError: string | null = null;

try {
  products = await prisma.product.findMany({
    orderBy: [{ active: "desc" }, { sortOrder: "asc" }, { name: "asc" }],
  });
} catch (err) {
  loadError = "Could not load products.";
  Astro.response.status = 503;
  console.error("[admin/products] load failed:", err);
}
---

<AdminLayout title="Products · Admin" section="products">
  <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div class="space-y-2">
      <Kicker>✦ Products</Kicker>
      <h1 class="font-display text-fg text-[clamp(2rem,4vw,3rem)] leading-[1] [font-variation-settings:'wdth'_114] font-bold"
      >
        The rack.
      </h1>
    </div>
    <Cta href="/admin/products/new">+ New product</Cta>
  </div>

  {loadError ? (
    <StickerCard class="p-6">
      <p class="font-mono text-[0.7rem] uppercase tracking-[0.22em] text-coral-500">
        Could not load products
      </p>
      <p class="mt-2 text-[0.95rem] text-fg/80">{loadError}</p>
    </StickerCard>
  ) : products.length === 0 ? (
    <StickerCard class="p-12 text-center">
      <p class="font-mono text-[0.72rem] uppercase tracking-[0.2em] text-fg/55">
        No products yet.
      </p>
      <Cta class="mt-5" href="/admin/products/new">Create the first one →</Cta>
    </StickerCard>
  ) : (
    <StickerCard class="overflow-hidden">
      <table class="w-full border-separate border-spacing-0 text-sm">
        <thead class="bg-ink-950 text-cream-soft">
          <tr>
            <th class="px-4 py-3 text-left font-mono text-[0.66rem] uppercase tracking-[0.2em]">Product</th>
            <th class="px-4 py-3 text-left font-mono text-[0.66rem] uppercase tracking-[0.2em]">SKU</th>
            <th class="px-4 py-3 text-left font-mono text-[0.66rem] uppercase tracking-[0.2em]">Category</th>
            <th class="px-4 py-3 text-right font-mono text-[0.66rem] uppercase tracking-[0.2em]">Price</th>
            <th class="px-4 py-3 text-right font-mono text-[0.66rem] uppercase tracking-[0.2em]">Stock</th>
            <th class="px-4 py-3 text-left font-mono text-[0.66rem] uppercase tracking-[0.2em]">State</th>
          </tr>
        </thead>
        <tbody>
          {products.map((p) => (
            <tr class="group border-t border-edge/10 hover:bg-sun-500/20">
              <td class="px-4 py-3">
                <a href={`/admin/products/${p.id}`} class="block">
                  <p class="font-display text-sm text-fg group-hover:text-coral-500 [font-variation-settings:'wdth'_110] font-bold">
                    {p.name}
                  </p>
                  {p.tagline && (
                    <p class="font-mono text-[0.62rem] uppercase tracking-[0.14em] text-fg/55">
                      {p.tagline}
                    </p>
                  )}
                </a>
              </td>
              <td class="px-4 py-3 font-mono text-[0.72rem] text-fg/75">
                {p.sku}
              </td>
              <td class="px-4 py-3">
                <span class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-fg/70">
                  {CATEGORY_LABEL[p.category]}
                </span>
              </td>
              <td class="px-4 py-3 text-right font-mono text-[0.82rem]">
                {formatPrice(p.priceCents, p.currency)}
              </td>
              <td class="px-4 py-3 text-right font-mono text-[0.82rem]">
                {p.stock === null ? "—" : p.stock}
              </td>
              <td class="px-4 py-3">
                <div class="flex flex-wrap gap-1">
                  <span class="rounded-full border border-edge px-2 py-0.5 font-mono text-[0.6rem] uppercase tracking-[0.14em]"
                    style={`background:${p.active ? "var(--color-teal-500)" : "var(--color-cream-deep)"};`}
                  >
                    {p.active ? "Active" : "Archived"}
                  </span>
                  {p.featured && (
                    <span class="rounded-full border border-edge bg-sun-500 px-2 py-0.5 font-mono text-[0.6rem] uppercase tracking-[0.14em]">
                      Featured
                    </span>
                  )}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </StickerCard>
  )}
</AdminLayout>
