---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Kicker from "../../components/ui/Kicker.astro";
import SectionTitle from "../../components/ui/SectionTitle.astro";
import CupLive from "../../components/react/CupLive";
import CupJudge from "../../components/react/CupJudge";
import { CUP_LABEL } from "../../lib/registration/cup";
import { site } from "../../data/site";

---

<BaseLayout title={`Judge sheet · ${CUP_LABEL}`} description="Judges' scoring sheet for the Sunset Duckies Cup.">
  <section class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
    <Kicker>Judges · {CUP_LABEL}</Kicker>
    <SectionTitle as="h1" class="mt-4">Score the <span class="font-accent italic">waves.</span></SectionTitle>
    {Astro.locals.session ? <div class="mt-6"><CupJudge client:load /></div> : <p class="mt-6">Everyone can follow the scores below. Parents and volunteers: <a class="underline" href="/login?next=%2Fcup%2Fjudge">sign in to judge</a>.</p>}
  </section>
  <section class="pb-12" aria-label="Live competition board"><CupLive client:load dateLabel={site.cupVol2.dateLabel} warnings={!Astro.locals.session} /></section>
</BaseLayout>
