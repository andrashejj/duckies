---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/plan.css";
import { site } from "../data/site";

const title = `What do we make first? | ${site.name}`;
const description =
  "Sunset Duckies runs on dues and sponsorship, and both limit how many kids get in the water. The plan to 31 October: work up four product ideas, test them with the club, and pick the first product and the brand around it.";

const audience = [
  {
    emoji: "🌱",
    title: "The kids",
    accent: "sticker-teal",
    text: "They test everything. Look, feel and taste are their call, and what they actually use counts for more than any concept sheet.",
  },
  {
    emoji: "🏄",
    title: "The parents",
    accent: "sticker-sun",
    text: "They know what they bought, what stopped getting used and what they wish existed. Their answers name the problem in each category.",
  },
  {
    emoji: "🤝",
    title: "The club around them",
    accent: "sticker-pink",
    text: "A small community that helps choose and test the product, then sees exactly what each sale gives back.",
  },
];

const principles = [
  {
    name: "Solves a real problem",
    accent: "sticker-teal",
    emoji: "🎯",
    text: "Start from a problem families name themselves. No problem, no product.",
  },
  {
    name: "Built for years",
    accent: "sticker-sun",
    emoji: "🛠️",
    text: "Materials and construction that survive salt, sun and repeat use. Repair and hand-me-downs are part of the brief.",
  },
  {
    name: "The club is in the price",
    accent: "sticker-pink",
    emoji: "🌊",
    text: "Every product carries a fixed, visible contribution to the club: gear, sessions, events, whatever else we agree.",
  },
];

const problem = [
  {
    title: "Two sources of money",
    text: `The club runs on ${site.membership.feeLabel} in dues and on sponsors who cover operations. Both work, and both have a ceiling.`,
  },
  {
    title: "Gear is the other gate",
    text: `Members bring their own ${site.membership.bringYourOwn.join(" and ")}. A family that cannot buy those cannot really join, whatever the fee says.`,
  },
  {
    title: "A third leg",
    text: "Something people buy because it is good, that also pays into the club. It only works if the product stands up without the cause attached.",
  },
];

const categories = [
  {
    code: "01",
    name: "Everyday wear",
    context: "Off the water",
    text: "Clothes for ordinary days. It has to get worn often, look good, and last long enough to justify the price.",
  },
  {
    code: "02",
    name: "Surf wear",
    context: "In the water",
    text: "Lycras, wetsuits, anything worn in the water. Fit, movement, comfort, sun, salt and growing bodies shape the brief.",
  },
  {
    code: "03",
    name: "Surf gear",
    context: "Boards and equipment",
    text: "The technical end. A first board has to be useful, durable and realistic to make, test, ship and pass on.",
  },
  {
    code: "04",
    name: "Surf nutrition",
    context: "Before and after",
    text: "Granola, porridge, breakfast and recovery food. Families rebuy it every few weeks, and a batch is quicker to make and test than a garment or a board.",
  },
];

const steps = [
  {
    date: "28 Aug – 7 Sep",
    emoji: "🗣️",
    accent: "sticker-teal",
    status: "now",
    title: "Find the problem worth solving",
    text: "Before anything gets designed, find out what families actually lack.",
    tasks: [
      "Ask parents what they bought in their child's first six months, what gets used every session and what stays at home.",
      "Record what has stopped fitting, broken, turned uncomfortable or been replaced, and why.",
      "Ask what is hard about buying for growing kids: fit, comfort, durability, style, price, availability.",
      "Ask what kids eat before a session and what parents pack: what gets refused, what is bought for convenience, what they wish existed.",
      "Ask the kids what they reach for, what they avoid and what they would be proud to own.",
      "Ask coaches which problems they see every week at training.",
      "Ask what keeps a family out of the club: the fee, the board, the wetsuit, the drive, the time.",
      "List the club costs a product could pay for, and price them.",
    ],
    links: [
      { label: "Questions for parents", file: "/templates/brand-parent-questionnaire.html" },
      { label: "Talking to the kids", file: "/templates/brand-kid-conversations.html" },
    ],
  },
  {
    date: "8 – 14 Sep",
    emoji: "📚",
    accent: "sticker-teal",
    title: "Learn the rules and write ours",
    text: "What good looks like in each category, and what Sunset Duckies will hold itself to.",
    tasks: [
      "Review premium everyday wear, surf wear and surf gear for kids and family surfers: materials, sizing, useful life, repair options, prices.",
      "Review premium breakfast and sports nutrition: ingredients, sugar and protein per serving, allergens, shelf life, packaging, batch size, price.",
      "Find the Mauritian food, hygiene and labelling rules that would apply to anything edible made and sold here.",
      "Read Yvon Chouinard’s “Let My People Go Surfing” on product quality, culture and responsibility.",
      "Read “The Future of the Responsible Company” (Chouinard and Stanley) for its tests of a legitimate product and a responsible supply chain.",
      "Look at how purpose-led companies explain where the money goes.",
      "Write the one page of rules: quality, useful life, customer, club contribution, accountability.",
    ],
    links: [],
  },
  {
    date: "15 – 28 Sep",
    emoji: "✏️",
    accent: "sticker-sun",
    title: "Drill down all four ideas",
    text: "Take each category from a heading to something concrete enough to argue with.",
    tasks: [
      "Work up one idea per category, to the same depth, on the same sheet.",
      "For each: who it is for, the problem it solves, what it is made of, what it costs to make and what it would sell for.",
      "For each: what a sale returns to the club, and what that money would buy.",
      "For each: what it takes to actually produce it here, and what could stop us.",
      "Push the two ideas that already exist — the granola and the board — past the sketch stage.",
      "Give everyday wear and surf wear the same treatment instead of leaving them as headings.",
      "Mark every number that is still a guess.",
    ],
    links: [
      { label: "Product ideas", file: "/product-ideas" },
      { label: "Product concept sheet", file: "/templates/brand-direction-sheet.html" },
    ],
  },
  {
    date: "29 Sep – 12 Oct",
    emoji: "⚖️",
    accent: "sticker-pink",
    title: "Evaluate them against each other",
    text: "Same questions asked of all four, then a choice the club can live with.",
    tasks: [
      "Score all four on the same criteria: the problem, how often families buy, what it takes to make, regulation, price, and what a sale returns.",
      "Show the four to parents on WhatsApp and at training, in a different order each time.",
      "Let the kids handle, wear or taste whatever there is to react to.",
      "Ask which one they would buy, at what price, and what would stop them.",
      "Explain the club contribution as its own number and ask whether it feels worth it.",
      "Keep younger kids, older kids and parents separate. Do not average them.",
      "Choose one with Estelle, the coaches and the founding families. Write down the evidence and the risks left.",
    ],
    links: [
      { label: "Product ideas", file: "/product-ideas" },
      { label: "Questions for parents", file: "/templates/brand-parent-questionnaire.html" },
    ],
  },
  {
    date: "13 – 26 Oct",
    emoji: "🧪",
    accent: "sticker-coral",
    title: "Test the winner and build the brand around it",
    text: "Whether the chosen product can be made, and what it is called when it is.",
    tasks: [
      "Get a sample, a sourced reference product or a detailed prototype spec.",
      "Talk to suppliers or kitchens: materials or ingredients, minimum order, lead time, packaging, delivery, approvals.",
      "Build the unit economics: cost, margin, retail price and what each sale returns to the club.",
      "Work out what that return buys in a year, and whether the number is realistic.",
      "Decide what the brand stands for in one paragraph, and what it will not do.",
      "Draft the name, the look and the story of where the money goes.",
      "Show it to buyers outside the club and record pre-orders, not likes.",
    ],
    links: [
      { label: "Product clarity check", file: "/templates/brand-stranger-test.html" },
    ],
  },
  {
    date: "27 – 31 Oct",
    emoji: "📋",
    accent: "sticker-lilac",
    title: "Decide",
    text: "One product, one brand, and an honest account of what it takes.",
    tasks: [
      "Name the product, the problem it solves and the evidence behind the choice.",
      "Set the requirements the product has to meet before it ships.",
      "Present the price, costs, margin and club contribution, with the assumptions marked.",
      "Say what the contribution funds in year one, and whether that is realistic.",
      "Present the brand: what it stands for, what it is called, how the money is explained.",
      "Recommend: build, change or stop. Then scope, owners, budget and dates.",
    ],
    links: [],
  },
  {
    date: "After 31 Oct",
    emoji: "🛠️",
    accent: "sticker-teal",
    title: "Make it",
    text: "Starts once the club approves the assessment and the budget.",
    tasks: [
      "Work through samples, revising until the product meets the brief.",
      "Run real tests with kids and parents. Fix what fails and repeat.",
      "Confirm production, minimum order, quality control, delivery and returns.",
      "Finish the identity, packaging, product page and the explanation of where the money goes.",
      "Keep a simple public record: sold, costs covered, surplus banked, what the club bought.",
      "Make a limited first run and launch it through the Tamarin community.",
      "Review before the next product or the next club.",
    ],
    links: [],
  },
];

const kit = [
  {
    emoji: "🧭",
    title: "Product and purpose brief",
    phase: "Estelle",
    file: "/templates/brand-concept.html",
    window: "Opens 8 Sep",
    desc: "Who we are building for, the product standard, why it costs what it costs and the promise to the club.",
  },
  {
    emoji: "✏️",
    title: "Product concept sheet",
    phase: "Estelle",
    file: "/templates/brand-direction-sheet.html",
    window: "Opens 15 Sep",
    desc: "One sheet per idea: what it is, who for, what it is made of, useful life or shelf life, price, club contribution, testing.",
  },
  {
    emoji: "💬",
    title: "Questions for parents",
    phase: "Families",
    file: "/templates/brand-parent-questionnaire.html",
    open: true,
    window: "Open now · closes 7 Sep",
    now: "Every founding family fills one in. Parts 1 and 2 now, part 3 once the four ideas are worked up.",
    desc: "What they have bought, what stopped getting used, what keeps families out of the club, and what they would pay for.",
  },
  {
    emoji: "🏄",
    title: "Talking to the kids",
    phase: "Coaches",
    file: "/templates/brand-kid-conversations.html",
    open: true,
    window: "Open now · closes 7 Sep",
    now: "Coaches run these at training, one child at a time. Sections 1 and 2 now, the ideas later.",
    desc: "What kids use, avoid and want to be seen with, then their verdict on the four ideas.",
  },
  {
    emoji: "⏱️",
    title: "Product clarity check",
    phase: "Testing",
    file: "/templates/brand-stranger-test.html",
    window: "Opens 13 Oct",
    desc: "Does a buyer outside the club get who it is for, why it costs what it costs and what the contribution buys?",
  },
  {
    emoji: "📸",
    title: "Photo permission",
    phase: "Families",
    file: "/templates/brand-photo-permission.html",
    open: true,
    window: "Open now · closes 7 Sep",
    now: "Signed once per child, before any photo or video is used. Needed before product testing.",
    desc: "Where each child may appear in product work and club communications.",
  },
];

const openNow = kit.filter((item) => item.open);
---

<BaseLayout title={title} description={description} variant="performance">
  <div class="performance-plan">
    <section class="plan-hero">
      <figure class="plan-hero-media" data-float>
        <img
          src="/media/young-rider.jpg"
          alt="A young surfer riding a wave at sunset in Tamarin"
          width="1200"
          height="1600"
          loading="eager"
        />
        <figcaption>Tamarin · Mauritius · Brand development</figcaption>
      </figure>

      <div class="plan-hero-panel" data-float>
        <div class="plan-hero-topline">
          <span>Sunset Duckies / Product development</span>
          <span>Assessment 2026</span>
        </div>

        <div class="plan-hero-content">
          <p class="plan-overline">Brand development</p>
          <h1>What do we <span>make first?</span></h1>
          <p class="plan-hero-lead">
            The club runs on dues and sponsorship. Both work, and both cap how many kids get
            in the water. A product people actually want would be a third leg.
          </p>
          <p class="plan-hero-copy">
            Which product, and what brand around it, is what this exercise decides. Four
            ideas get worked up to the same depth, tested with the families, and compared
            on the same terms by 31 October.
          </p>
        </div>

        <div class="plan-hero-data" aria-label="Project facts">
          <div><strong>04</strong><span>Ideas on the table</span></div>
          <div><strong>01</strong><span>First product</span></div>
          <div><strong>31.10</strong><span>Decision</span></div>
        </div>
      </div>
    </section>

    <nav class="plan-index" aria-label="Brand development sections">
      <a href="#problem"><span>01</span> The problem</a>
      <a href="#the-range"><span>02</span> The ideas</a>
      <a href="#product-standard"><span>03</span> Product standard</a>
      <a href="#assessment"><span>04</span> The plan</a>
      <a href="#working-documents"><span>05</span> Documents</a>
    </nav>

    <section id="problem" class="plan-section plan-problem-section" data-reveal>
      <div class="plan-section-head">
        <p class="plan-overline">01 / The problem</p>
        <h2>Money decides who gets in the water.</h2>
        <p>
          Not talent, not interest. The club can only take the kids its funding and its
          spare boards can carry, and a product is one way to change that.
        </p>
      </div>

      <div class="plan-three-grid">
        {
          problem.map((item, i) => (
            <article class="plan-info-card">
              <span class="plan-info-number">0{i + 1}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>

      <p class="plan-note">
        The trap is obvious: a mediocre product with a good cause stapled to it. Nobody
        rebuys that. Whatever we make has to be worth buying on its own, and the money it
        sends back to the club has to be a number we publish rather than a feeling.
      </p>
    </section>

    <div class="plan-divider" aria-hidden="true"></div>

    <section id="the-range" class="plan-section plan-category-section" data-reveal>
      <div class="plan-section-head">
        <p class="plan-overline">02 / The ideas</p>
        <h2>Four directions, none of them chosen.</h2>
        <p>
          Two already have ideas attached: a granola made with a local girl, and a first
          surfboard. The other two are still headings. All four get worked up to the same
          depth before any of them wins.
        </p>
      </div>

      <div class="plan-category-grid">
        {categories.map((category) => (
          <article class="plan-category-card">
            <div class="plan-card-code"><span>{category.code}</span><span>{category.context}</span></div>
            <h3>{category.name}</h3>
            <p>{category.text}</p>
            <span class="plan-card-line" aria-hidden="true"></span>
          </article>
        ))}
      </div>

      <a class="plan-jump" href="/product-ideas">
        <span class="plan-jump-label">Separate artifact</span>
        <span class="plan-jump-title">The four ideas, drilled down and compared</span>
        <span class="plan-jump-cta">Open the ideas <span aria-hidden="true">→</span></span>
      </a>
    </section>

  <section class="plan-section plan-audience-section" data-reveal>
    <div class="plan-section-head plan-section-head-wide">
      <p class="plan-overline">The customer and the community</p>
      <h2>The club decides what is worth making.</h2>
    </div>

    <div class="plan-three-grid">
      {
        audience.map((item, i) => (
          <article class="plan-info-card">
            <span class="plan-info-number">0{i + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))
      }
    </div>

    <p class="plan-note">
      Whatever wins has to earn its price on its own merits first. If the kids will not
      wear it, use it or eat it, the idea fails and we say so rather than shipping it with
      a story attached.
    </p>
  </section>

  <div class="plan-divider" aria-hidden="true"></div>

  <section id="product-standard" class="plan-section plan-standard-section" data-reveal>
    <div class="plan-section-head">
      <p class="plan-overline">03 / Product standard</p>
      <h2>Purpose has to show up in the product.</h2>
    </div>
    <p class="plan-reference-copy">
      Two books are working references:
      <a href="https://www.patagonia.com/product/let-my-people-go-surfing-revised-paperback-book/BK067.html" target="_blank" rel="noreferrer">Let My People Go Surfing</a>
      and
      <a href="https://www.patagonia.com/product/the-future-of-the-responsible-company-paperback/BK235.html" target="_blank" rel="noreferrer">The Future of the Responsible Company</a>.
      The challenge they set is practical: make a legitimate product that lasts, know how it
      is made, respect the people around it, and build the purpose into how the company runs.
    </p>

    <div class="plan-three-grid plan-principles-grid">
      {
        principles.map((principle, i) => (
          <article class="plan-info-card plan-principle-card">
            <span class="plan-info-number">P-0{i + 1}</span>
            <h3>{principle.name}</h3>
            <p>{principle.text}</p>
          </article>
        ))
      }
    </div>

    <p class="plan-note">
      For food, “built for years” means ingredients we can name, honest nutrition and a shelf
      life a small batch can hold. The other two rules stand.
    </p>

    <p class="plan-note">
      A high price is a promise. The assessment has to name what makes it fair — materials
      or ingredients, construction, testing, useful life — then publish what each sale
      leaves over and what the club bought with it.
    </p>
  </section>

  <div class="plan-divider" aria-hidden="true"></div>

  <section id="assessment" class="plan-section plan-assessment-section" data-reveal>
    <div class="plan-section-head">
      <p class="plan-overline">04 / The plan</p>
      <h2>From four ideas to one product.</h2>
      <p>
        Four ideas, worked up to the same depth and put to the families on the same terms.
        The work to 31 October picks one, tests whether it can be made, and builds the brand
        around it. Production starts only once the club approves it.
      </p>
    </div>

    <div class="plan-open-now">
      <div class="plan-open-head">
        <p class="plan-overline">Open now · closes 7 September</p>
        <h3>Three sheets are collecting answers this week.</h3>
        <p>
          Everything after this phase is built on what they say. They close with the first
          phase on 7 September. Fill them in on a phone, or print them.
        </p>
      </div>

      <div class="plan-open-grid">
        {
          openNow.map((item) => (
            <a href={item.file} target="_blank" rel="noreferrer" class="plan-open-card">
              <span class="plan-open-tag">{item.phase}</span>
              <h4>{item.title}</h4>
              <p>{item.now}</p>
              <span class="plan-open-cta">Open sheet ↗</span>
            </a>
          ))
        }
      </div>
    </div>

    <ol class="plan-timeline">
      {
        steps.map((step, index) => (
          <li class:list={["plan-step", step.status === "now" && "is-current"]}>
            <div class="plan-step-rail">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <time>{step.date}</time>
              {step.status === "now" && <em>Current phase</em>}
            </div>
            <div class="plan-step-body">
              <h3>{step.title}</h3>
              <p class="plan-step-intro">{step.text}</p>
              <ul>
                {step.tasks.map((task) => <li>{task}</li>)}
              </ul>
              {step.links.length > 0 && (
                <div class="plan-step-links">
                  {step.links.map((link) => (
                    <a href={link.file} target="_blank" rel="noreferrer">
                      {link.label} <span aria-hidden="true">↗</span>
                    </a>
                  ))}
                </div>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <div class="plan-divider" aria-hidden="true"></div>

  <section id="working-documents" class="plan-section plan-documents-section" data-reveal>
    <div class="plan-section-head">
      <p class="plan-overline">05 / Working documents</p>
      <h2>Evidence, recorded as we go.</h2>
      <p>
        The sheets that turn interviews, product ideas and buyer reactions into the
        assessment. All of them work on a phone or printed.
      </p>
    </div>

    <div class="plan-document-grid">
      {
        kit.map((item, index) => (
          <a href={item.file} target="_blank" rel="noreferrer" class="plan-document-card">
            <div class="plan-document-meta">
              <span>DOC-{String(index + 1).padStart(2, "0")}</span>
              <span>{item.phase}</span>
            </div>
            <span class:list={["plan-document-window", item.open && "is-open"]}>{item.window}</span>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
            <span class="plan-document-open">Open document ↗</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="plan-decision" data-reveal>
    <img
      src="/media/board-lineup.jpg"
      alt="Young surfers and their boards gathered on the beach at sunset"
      width="1600"
      height="1067"
      loading="lazy"
    />
    <div class="plan-decision-overlay">
      <p class="plan-overline">Decision gate / 31 October</p>
      <h2>Which one deserves to be made?</h2>
      <p>
        The assessment ends with one product, the club's verdict on it, a price, a supplier,
        the brand around it and the number it sends back each year. If the case holds, the
        first run starts next.
      </p>
    </div>
  </section>
  </div>
</BaseLayout>
