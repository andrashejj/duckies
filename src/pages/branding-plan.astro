---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const title = `The Brand Plan | ${site.name}`;
const description =
  "Four weeks, one volunteer, zero budget: how Sunset Duckies is figuring out what it stands for — and writing it down.";

const timeline = [
  { week: "W1", label: "Listen" },
  { week: "W2", label: "Sketch" },
  { week: "W3", label: "Test" },
  { week: "W4", label: "Write it down" },
];

const week1Steps = [
  {
    emoji: "✍️",
    text: "Before I ask anyone anything: write down what I believe this club is. One page, dated, put away. So that twenty opinions don't quietly blur into mine.",
  },
  {
    emoji: "🏄",
    text: "Ask the kids at Monday and Friday training. Not “what do you think” — hand out stickers and watch which ones actually end up on boards.",
  },
  {
    emoji: "🗣️",
    text: "Ask parents on the beach: “when someone asks about the club, what do you say — word for word?” What they already say is closer to the brand than anything I could invent.",
  },
  {
    emoji: "🔍",
    text: "One evening looking at how other surf clubs and kids' clubs present themselves. Mostly to list the clichés we're going to refuse.",
  },
];

const routes = [
  {
    name: "Access",
    accent: "sticker-teal",
    emoji: "🌊",
    tension: "The ocean is free. Getting to it isn't.",
  },
  {
    name: "Outside",
    accent: "sticker-sun",
    emoji: "📱",
    tension: "Childhood moved onto screens. We're the other direction.",
  },
  {
    name: "Belonging",
    accent: "sticker-pink",
    emoji: "🤝",
    tension: "Kids here don't lack activities. They lack a crew that's theirs.",
  },
];

const week3Tests = [
  {
    emoji: "🛹",
    title: "The sticker test",
    text: "Three sticker designs on the table at training. Nobody has to take one. Which ones disappear onto boards, and which stay on the table?",
  },
  {
    emoji: "🧠",
    title: "The memory test",
    text: "Show the boards Monday, say nothing. Ask on Friday: “what do you remember?” Whatever survives four days is the brand.",
  },
  {
    emoji: "✏️",
    title: "The drawing test",
    text: "One kid describes a badge to another, who draws it without seeing it. What makes it through is what a badge actually is.",
  },
  {
    emoji: "⏱️",
    title: "The stranger test",
    text: "Show each board to people outside the club for five seconds. “What is this?” If they can't answer, it doesn't work.",
  },
];

const failureModes = [
  {
    emoji: "🥣",
    title: "Averaging into beige",
    accent: "sticker-sun",
    text: "If I treat every opinion equally I'll end up with the mush in the middle. That's why my own one-pager gets written first — the asking informs the decision, it doesn't make it.",
  },
  {
    emoji: "💘",
    title: "Falling for one early",
    accent: "sticker-pink",
    text: "By the end of week 2 I'll have a favourite. That's what the sealed prediction is for: if the kids agree, great. If they don't, the envelope keeps me honest.",
  },
  {
    emoji: "🐌",
    title: "Drifting into October",
    accent: "sticker-teal",
    text: "Each week ends whether I feel ready or not. A decent direction decided on time beats a perfect one that never ships.",
  },
];
---

<BaseLayout title={title} description={description}>
  <!-- ===================== HERO ===================== -->
  <section class="relative mx-auto max-w-7xl px-6 pb-10 pt-14 lg:px-10">
    <div class="surface-card p-8 md:p-12" data-float>
      <div class="flex flex-wrap items-center gap-3">
        <p class="section-kicker">Club notebook · working in the open</p>
        <span class="tag-pill lilac">24 Aug – 20 Sep 2026</span>
      </div>
      <h1
        class="section-title mt-6 max-w-4xl"
        style="font-size: clamp(2.4rem, 5.5vw, 4.6rem); line-height: 0.95;"
      >
        The
        <span class="font-accent italic" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">brand</span>
        <span class="ink-underline">plan</span>.
      </h1>
      <p class="body-copy mt-6 max-w-3xl">
        Sunset Duckies needs a proper identity — a badge for the rashies, stickers for the
        boards, and a clear answer to “what is this club?” There's no agency and no budget.
        There's one volunteer, four weeks, and a beach full of honest critics aged 7 to 13.
      </p>
      <p class="body-copy mt-4 max-w-3xl">
        The plan below is the same process the professionals use, stripped to what one person
        can do for free: listen first, sketch a few directions, let the kids kill the wrong
        ones, write down what's left. Each week has a finish line. I don't move on until it's
        crossed.
      </p>

      <!-- Timeline strip -->
      <div class="mt-8 flex flex-wrap items-center gap-2 sm:gap-3">
        {
          timeline.map((step, i) => (
            <>
              <span class="chip">
                <strong class="font-bold">{step.week}</strong>&nbsp;{step.label}
              </span>
              {i < timeline.length - 1 && (
                <span class="font-mono text-lg font-bold text-[var(--color-coral-500)]" aria-hidden="true">
                  →
                </span>
              )}
            </>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== WEEK 1 — LISTEN ===================== -->
  <section class="relative mx-auto max-w-7xl px-6 py-10 lg:px-10" data-reveal>
    <div class="mb-8 flex flex-wrap items-center gap-4">
      <span class="step-bubble">W1</span>
      <h2 class="section-title" style="font-size: clamp(1.8rem, 3.4vw, 2.8rem);">Listen</h2>
      <span class="tag-pill">24–30 Aug</span>
    </div>

    <div class="grid gap-6 lg:grid-cols-[1.15fr_0.85fr]">
      <div class="surface-card p-6 md:p-8">
        <ul class="space-y-5">
          {
            week1Steps.map((step) => (
              <li class="flex items-start gap-4">
                <span class="text-2xl" aria-hidden="true">{step.emoji}</span>
                <p class="body-copy text-sm">{step.text}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="surface-card sticker-sun dashed p-6 md:p-8">
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-ink-950)]">
          ✦ Done when
        </p>
        <p class="mt-4 text-lg font-bold leading-snug" style="font-family: var(--font-display); font-variation-settings: 'wdth' 106;">
          I can say what this club is actually about in one sentence.
        </p>
        <p class="body-copy mt-3 text-sm">
          Not a slogan — an observation. The shape I'm after:
          <em class="font-accent italic">“everyone assumes X, but actually Y, so we do Z.”</em>
          If the week ends without that sentence, the week isn't over.
        </p>
      </div>
    </div>
  </section>

  <div class="wave-divider mx-auto max-w-7xl px-6"></div>

  <!-- ===================== WEEK 2 — SKETCH ===================== -->
  <section class="relative mx-auto max-w-7xl px-6 py-10 lg:px-10" data-reveal>
    <div class="mb-8 flex flex-wrap items-center gap-4">
      <span class="step-bubble">W2</span>
      <h2 class="section-title" style="font-size: clamp(1.8rem, 3.4vw, 2.8rem);">Sketch</h2>
      <span class="tag-pill">31 Aug – 6 Sep</span>
    </div>

    <div class="surface-card p-6 md:p-8">
      <p class="body-copy max-w-3xl text-sm">
        First, one page for myself: what we believe, what we're against, what we promise
        families, how we talk. Then three rough directions. Not three logos — three different
        answers to “what is this club?”, each built on something true about Tamarin:
      </p>
    </div>

    <div class="mt-6 grid gap-6 md:grid-cols-3">
      {
        routes.map((route, i) => (
          <div class:list={["surface-card p-6", route.accent, i === 0 ? "tilt-left" : i === 2 ? "tilt-right" : ""]}>
            <span class="text-3xl" aria-hidden="true">{route.emoji}</span>
            <h3
              class="mt-3 text-2xl font-bold text-[var(--color-ink-950)]"
              style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;"
            >
              {route.name}
            </h3>
            <p class="body-copy mt-2 text-sm">{route.tension}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-[1.15fr_0.85fr]">
      <div class="surface-card p-6 md:p-8">
        <p class="body-copy text-sm">
          Each direction gets one sheet: a line, a rough badge, three colours, a sticker.
          Felt-tip rough, and all three <strong>equally</strong> rough — if one is prettier,
          the kids will pick the drawing, not the idea. And at least one should feel slightly
          too bold. If all three feel safe, I've drawn the same thing three times.
        </p>
      </div>
      <div class="surface-card sticker-sun dashed p-6 md:p-8">
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-ink-950)]">
          ✦ Done when
        </p>
        <p class="mt-4 text-lg font-bold leading-snug" style="font-family: var(--font-display); font-variation-settings: 'wdth' 106;">
          A stranger can tell the three apart and say what each one is going for.
        </p>
      </div>
    </div>
  </section>

  <div class="wave-divider mx-auto max-w-7xl px-6"></div>

  <!-- ===================== WEEK 3 — TEST ===================== -->
  <section class="relative mx-auto max-w-7xl px-6 py-10 lg:px-10" data-reveal>
    <div class="mb-8 flex flex-wrap items-center gap-4">
      <span class="step-bubble">W3</span>
      <h2 class="section-title" style="font-size: clamp(1.8rem, 3.4vw, 2.8rem);">Test</h2>
      <span class="tag-pill">7–13 Sep</span>
    </div>

    <p class="body-copy max-w-3xl text-sm">
      Monday of this week, before anyone sees anything: I write my prediction of which
      direction wins, seal it, and don't open it until Friday. Then the three sheets go up at
      training and I mostly shut up and watch.
    </p>

    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      {
        week3Tests.map((test) => (
          <div class="surface-card p-6">
            <span class="text-2xl" aria-hidden="true">{test.emoji}</span>
            <h3
              class="mt-3 text-xl font-bold text-[var(--color-ink-950)]"
              style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;"
            >
              {test.title}
            </h3>
            <p class="body-copy mt-2 text-sm">{test.text}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-[1.15fr_0.85fr]">
      <div class="surface-card sticker-pink p-6 md:p-8">
        <p class="body-copy text-sm">
          Two rules for the beach conversations. Ask
          <em class="font-accent italic">“which one would embarrass you?”</em> — never
          “which do you like?” Kids are polite about likes and dead honest about embarrassment.
          And keep the 8-year-olds' answers separate from the 13-year-olds' — they'll disagree,
          and whatever bridges that gap is the badge we need.
        </p>
        <p class="mt-4 font-mono text-xs font-bold uppercase tracking-[0.14em] text-[var(--color-coral-500)]">
          It's not a vote. I say that out loud at the start.
        </p>
      </div>

      <div class="surface-card sticker-sun dashed p-6 md:p-8">
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-ink-950)]">
          ✦ Done when
        </p>
        <p class="mt-4 text-lg font-bold leading-snug" style="font-family: var(--font-display); font-variation-settings: 'wdth' 106;">
          One direction wins for reasons I can point to, not reasons I feel.
        </p>
        <p class="body-copy mt-3 text-sm">
          Plus a short note on what to steal from the two that lost — there's always something.
        </p>
      </div>
    </div>
  </section>

  <div class="wave-divider mx-auto max-w-7xl px-6"></div>

  <!-- ===================== WEEK 4 — WRITE IT DOWN ===================== -->
  <section class="relative mx-auto max-w-7xl px-6 py-10 lg:px-10" data-reveal>
    <div class="mb-8 flex flex-wrap items-center gap-4">
      <span class="step-bubble">W4</span>
      <h2 class="section-title" style="font-size: clamp(1.8rem, 3.4vw, 2.8rem);">Write it down</h2>
      <span class="tag-pill">14–20 Sep</span>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      <div class="surface-card sticker-coral p-6">
        <span class="text-2xl" aria-hidden="true">🎨</span>
        <h3 class="mt-3 text-xl font-bold" style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;">
          Clean up the winner
        </h3>
        <p class="body-copy mt-2 text-sm">
          Me, free tools, a few evenings. It's finished when it passes three checks: a
          ten-year-old can draw it from memory, it's still legible at 15mm, and it works in a
          single colour — because that's how it'll actually get printed.
        </p>
      </div>
      <div class="surface-card sticker-lilac p-6">
        <span class="text-2xl" aria-hidden="true">📓</span>
        <h3 class="mt-3 text-xl font-bold" style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;">
          A short brand book
        </h3>
        <p class="body-copy mt-2 text-sm">
          A dozen pages, not fifty: what we believe, the badge and how not to mangle it,
          colours, and how we talk — with real examples of how we don't. Enough that the next
          volunteer can make a poster without asking me anything.
        </p>
      </div>
      <div class="surface-card sticker-teal p-6">
        <span class="text-2xl" aria-hidden="true">📸</span>
        <h3 class="mt-3 text-xl font-bold" style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;">
          Put it on real things
        </h3>
        <p class="body-copy mt-2 text-sm">
          A rashie in the water, a sticker on a board, a page of this site. Photographed, not
          mocked up. If it only looks good on a screen, it doesn't look good.
        </p>
      </div>
    </div>

    <div class="surface-card sticker-sun dashed mt-6 p-6 md:p-8">
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-ink-950)]">
        ✦ Done when
      </p>
      <p class="mt-4 max-w-3xl text-lg font-bold leading-snug" style="font-family: var(--font-display); font-variation-settings: 'wdth' 106;">
        Someone else could use all of it without asking me a single question.
      </p>
      <p class="body-copy mt-3 text-sm">
        The founding families see it first — they earned that.
      </p>
    </div>
  </section>

  <div class="wave-divider mx-auto max-w-7xl px-6"></div>

  <!-- ===================== FAILURE MODES ===================== -->
  <section class="relative mx-auto max-w-7xl px-6 py-10 lg:px-10" data-reveal>
    <p class="section-kicker">Being honest</p>
    <h2 class="section-title mt-5" style="font-size: clamp(1.8rem, 3.4vw, 2.8rem);">
      Three ways I'll probably
      <span class="font-accent italic" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">mess this up</span>.
    </h2>

    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {
        failureModes.map((mode, i) => (
          <div class:list={["surface-card p-6", mode.accent, i === 0 ? "tilt-left" : i === 2 ? "tilt-right" : ""]}>
            <span class="text-3xl" aria-hidden="true">{mode.emoji}</span>
            <h3
              class="mt-3 text-xl font-bold text-[var(--color-ink-950)]"
              style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;"
            >
              {mode.title}
            </h3>
            <p class="body-copy mt-2 text-sm">{mode.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ===================== THE TEST ===================== -->
  <section class="relative mx-auto max-w-7xl px-6 pb-20 pt-6 lg:px-10" data-reveal>
    <div class="glass-panel p-8 md:p-12">
      <p class="eyebrow-badge">20 September</p>
      <h2
        class="mt-6 max-w-3xl text-3xl font-bold leading-tight md:text-4xl"
        style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;"
      >
        How I'll know it worked.
      </h2>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-[var(--color-cream)]/85">
        Show everything to someone who's never heard of us and ask two questions:
        <em class="font-accent italic text-[var(--color-sun-500)]">what does this club believe,
        and what is it against?</em>
        If they answer both without hesitating, we have a brand. If they hesitate, back to work.
      </p>
    </div>
  </section>
</BaseLayout>
