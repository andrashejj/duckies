---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const title = `Global brand project | ${site.name}`;
const description =
  "The assessment and implementation plan for Sunset Duckies, a global purpose-driven brand that promotes local kids' surf clubs.";

const deliverables = [
  {
    emoji: "🧭",
    title: "A clear purpose",
    accent: "sticker-teal",
    text: "Promote local kids' surf clubs and the coaches, families and communities that keep them going.",
  },
  {
    emoji: "🎨",
    title: "A global brand",
    accent: "sticker-sun",
    text: "A shared name, voice and identity that can introduce local clubs to people far beyond their home break.",
  },
  {
    emoji: "📓",
    title: "A format for local clubs",
    accent: "sticker-pink",
    text: "A repeatable way to feature each club's place, people and work without losing what makes it local.",
  },
];

const ideas = [
  {
    name: "Access",
    accent: "sticker-teal",
    emoji: "🌊",
    text: "Promote the local clubs that help kids reach the water, find gear and learn from people they trust.",
  },
  {
    name: "Outside",
    accent: "sticker-sun",
    emoji: "☀️",
    text: "Show what local clubs give kids: time outside, confidence in the water and a regular reason to surf.",
  },
  {
    name: "Belonging",
    accent: "sticker-pink",
    emoji: "🤝",
    text: "Tell the stories of the kids, parents and coaches who turn a surf session into a community.",
  },
];

const steps = [
  {
    date: "August",
    emoji: "🗣️",
    accent: "sticker-teal",
    status: "done",
    title: "Collect the club's words",
    text: "Start with the language people in Tamarin already use for Sunset Duckies.",
    tasks: [
      "Send the first part of the parent questionnaire to the family WhatsApp group.",
      "Ask coaches how they describe the club to a new family.",
      "Copy the answers into one working document, keeping people's own words.",
    ],
    links: [
      { label: "Questions for parents", file: "/templates/brand-parent-questionnaire.html" },
    ],
  },
  {
    date: "By 6 Sep",
    emoji: "📄",
    accent: "sticker-teal",
    status: "now",
    title: "Read and write up the research",
    text: "The research ends with one page of useful notes for this club.",
    tasks: [
      "Read “Let My People Go Surfing” by Yvon Chouinard.",
      "Read “The Future of the Responsible Company” by Yvon Chouinard and Vincent Stanley.",
      "Find purpose-driven brands that promote independent local groups. Note how they share attention, credit and control.",
      "Make a shortlist of local kids' surf clubs in different countries and record how they currently tell their stories.",
      "Write one page on what Sunset Duckies owes a featured club, its kids and families, and its local community.",
    ],
    links: [],
  },
  {
    date: "By 20 Sep",
    emoji: "✏️",
    accent: "sticker-sun",
    title: "Make three rough versions",
    text: "Prepare one version for Access, one for Outside and one for Belonging.",
    tasks: [
      "Fill in the project summary with the global purpose, the promise to local clubs and the way Sunset Duckies speaks.",
      "Complete one idea sheet for each of the three starting points.",
      "Give every version a line, a badge sketch, three colours, a sticker and one example feature about the Tamarin club using a real training photo.",
      "Write the main line so someone outside Mauritius understands that Sunset Duckies promotes local surf clubs.",
      "Keep Tamarin, its coaches and its families visible in the example instead of presenting everything as Sunset Duckies' own work.",
      "Keep all three equally rough so the family feedback is about the idea rather than the neatest drawing.",
    ],
    links: [
      { label: "Project summary", file: "/templates/brand-concept.html" },
      { label: "Idea sheet", file: "/templates/brand-direction-sheet.html" },
    ],
  },
  {
    date: "21 Sep – 4 Oct",
    emoji: "🏄",
    accent: "sticker-pink",
    title: "Show all three to the club",
    text: "Families see the same rough sheets in WhatsApp and at training.",
    tasks: [
      "Send the three idea sheets and the second part of the parent questionnaire to the family WhatsApp group.",
      "Use the kid conversations sheet at training: offer the stickers, ask which one would embarrass them, and check on Friday what they remember.",
      "Record answers from ages 7 to 9 separately from ages 10 to 13.",
      "Ask parents whether the example presents the Tamarin club accurately and what a global brand must never take away from it.",
      "Collect a photo permission form from every family before using images of the kids on global Sunset Duckies channels.",
      "Hold a call with Estelle and the founding families, then choose one idea and write down why.",
    ],
    links: [
      { label: "Questions for parents", file: "/templates/brand-parent-questionnaire.html" },
      { label: "Talking to the kids", file: "/templates/brand-kid-conversations.html" },
      { label: "Photo permission", file: "/templates/brand-photo-permission.html" },
    ],
  },
  {
    date: "5 Oct – 1 Nov",
    emoji: "🛹",
    accent: "sticker-coral",
    title: "Build and test a prototype",
    text: "Make enough of the chosen idea to test the model before implementation.",
    tasks: [
      "Prepare a working badge, colours, type and main line. Check them in one colour, at 15 mm and as a profile picture.",
      "Run the five-second recognition check with eight people who do not know the club. They should understand that Sunset Duckies promotes local surf clubs.",
      "Prototype the first local club feature around Tamarin, with the club's own place, people, photos and words clearly credited.",
      "Show that feature to at least two people who run or help with local surf clubs outside Mauritius. Ask what they would need before taking part.",
      "Run a two-week posting trial and note which local club stories parents share, save or repost, and whether they reach people beyond the existing families.",
    ],
    links: [
      { label: "Quick recognition check", file: "/templates/brand-stranger-test.html" },
    ],
  },
  {
    date: "1 Nov",
    emoji: "📋",
    accent: "sticker-lilac",
    title: "Complete the initial assessment",
    text: "Turn the research, concepts and tests into a recommendation and implementation brief.",
    tasks: [
      "Write the research summary, including the two books, comparable brands and shortlist of local surf clubs.",
      "Record the chosen direction, the reasons for choosing it and the questions still open.",
      "Summarise what Tamarin families, outside viewers and people from other local clubs understood, questioned or wanted changed.",
      "Recommend whether the model should move into implementation and list the changes needed first.",
      "Set the proposed implementation scope, owners, budget and dates for approval.",
    ],
    links: [],
  },
  {
    date: "After 1 Nov",
    emoji: "🛠️",
    accent: "sticker-teal",
    title: "Implement the brand and club programme",
    text: "The club sets the dates after reviewing and approving the initial assessment.",
    tasks: [
      "Finalise the badge, colours, type, voice and brand files from the approved direction.",
      "Build the reusable local club feature and the process for participation, credit, story approval and photo permission.",
      "Apply the brand to the website, social accounts, rashies, stickers and the first Tamarin club feature.",
      "Invite the first local surf clubs, collect their stories and approvals, and prepare their features.",
      "Launch the pilot, publish the first club stories and review what reaches new people and what helps the featured clubs.",
    ],
    links: [],
  },
];

const kit = [
  {
    emoji: "🧭",
    title: "Project summary",
    phase: "Estelle",
    file: "/templates/brand-concept.html",
    desc: "A one-page place to define the global purpose, the promise to local clubs and what Sunset Duckies is responsible for.",
  },
  {
    emoji: "✏️",
    title: "Idea sheet",
    phase: "Estelle",
    file: "/templates/brand-direction-sheet.html",
    desc: "The same sheet used for each rough idea: purpose, line, badge, colours and an example that promotes the Tamarin club.",
  },
  {
    emoji: "💬",
    title: "Questions for parents",
    phase: "Families",
    file: "/templates/brand-parent-questionnaire.html",
    desc: "Questions about the Tamarin club, the three ideas and whether the global brand represents the local work fairly.",
  },
  {
    emoji: "🏄",
    title: "Talking to the kids",
    phase: "Coaches",
    file: "/templates/brand-kid-conversations.html",
    desc: "A simple guide for showing the ideas at training and recording what the younger and older kids say about them.",
  },
  {
    emoji: "⏱️",
    title: "Quick recognition check",
    phase: "Testing",
    file: "/templates/brand-stranger-test.html",
    desc: "Show the brand for five seconds and check whether people understand that it promotes local surf clubs.",
  },
  {
    emoji: "📸",
    title: "Photo permission",
    phase: "Families",
    file: "/templates/brand-photo-permission.html",
    desc: "A clear record of whether and where each child may appear when Sunset Duckies promotes the local club.",
  },
];
---

<BaseLayout title={title} description={description}>
  <!-- ===================== INTRO ===================== -->
  <section class="relative mx-auto max-w-7xl px-6 pb-10 pt-14 lg:px-10">
    <div class="surface-card p-8 md:p-12" data-float>
      <div class="flex flex-wrap items-center gap-3">
        <p class="section-kicker">A global brand for local clubs</p>
        <span class="tag-pill lilac">Initial assessment · August–1 November 2026</span>
        <span class="tag-pill">Implementation follows</span>
      </div>
      <h1
        class="section-title mt-6 max-w-4xl"
        style="font-size: clamp(2.4rem, 5.5vw, 4.6rem); line-height: 0.95;"
      >
        Building
        <span class="font-accent italic" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">Sunset Duckies</span>
        to promote local surf clubs.
      </h1>
      <p class="body-copy mt-6 max-w-3xl">
        Sunset Duckies started with a kids' surf club in Tamarin. Estelle's project asks
        whether it can also become a global, purpose-driven brand whose job is to promote
        local surf clubs. The local clubs do the work. Sunset Duckies helps more people see
        the kids, coaches, families and places behind it.
      </p>
      <p class="body-copy mt-4 max-w-3xl">
        Tamarin is the first club and the first test. Its own name, people and character stay
        visible. The global brand provides a shared identity and a larger audience for its story.
        Estelle is a friend of the club, studying in Switzerland, and is doing the work part
        time alongside her degree.
      </p>
    </div>
  </section>

  <!-- ===================== WHAT WE ARE MAKING ===================== -->
  <section class="relative mx-auto max-w-7xl px-6 py-10 lg:px-10" data-reveal>
    <p class="section-kicker">The model</p>
    <h2 class="section-title mt-5" style="font-size: clamp(1.8rem, 3.4vw, 2.8rem);">
      One global brand, built around
      <span class="font-accent italic" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">local clubs</span>.
    </h2>

    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {
        deliverables.map((item, i) => (
          <div class:list={["surface-card p-6", item.accent, i === 0 ? "tilt-left" : i === 2 ? "tilt-right" : ""]}>
            <span class="text-3xl" aria-hidden="true">{item.emoji}</span>
            <h3
              class="mt-3 text-xl font-bold text-[var(--color-ink-950)]"
              style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;"
            >
              {item.title}
            </h3>
            <p class="body-copy mt-2 text-sm">{item.text}</p>
          </div>
        ))
      }
    </div>

    <p class="body-copy mt-8 max-w-3xl text-sm">
      Families in Tamarin decide whether the brand represents their club fairly. People
      outside Mauritius test whether its purpose is clear. People involved in other local
      surf clubs say whether they would want their own club presented this way. Those three
      groups give us the answer.
    </p>
  </section>

  <div class="wave-divider mx-auto max-w-7xl px-6"></div>

  <!-- ===================== THE IDEAS ===================== -->
  <section class="relative mx-auto max-w-7xl px-6 py-10 lg:px-10" data-reveal>
    <p class="section-kicker">The starting point</p>
    <h2 class="section-title mt-5" style="font-size: clamp(1.8rem, 3.4vw, 2.8rem);">
      Three ideas to
      <span class="font-accent italic" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">explore</span>.
    </h2>
    <p class="body-copy mt-4 max-w-3xl text-sm">
      The three starting points are different ways for the global brand to talk about local
      clubs: the access they create, the time they give kids outside, and the communities they
      build. Estelle will make one rough version of each, using the Tamarin club as the first
      real example.
    </p>

    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {
        ideas.map((idea, i) => (
          <div class:list={["surface-card p-6", idea.accent, i === 0 ? "tilt-left" : i === 2 ? "tilt-right" : ""]}>
            <span class="text-3xl" aria-hidden="true">{idea.emoji}</span>
            <h3
              class="mt-3 text-2xl font-bold text-[var(--color-ink-950)]"
              style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;"
            >
              {idea.name}
            </h3>
            <p class="body-copy mt-2 text-sm">{idea.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <div class="wave-divider mx-auto max-w-7xl px-6"></div>

  <!-- ===================== THE PROCESS ===================== -->
  <section class="relative mx-auto max-w-7xl px-6 py-10 lg:px-10" data-reveal>
    <p class="section-kicker">How the project works</p>
    <h2 class="section-title mt-5" style="font-size: clamp(1.8rem, 3.4vw, 2.8rem);">
      The
      <span class="font-accent italic" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">schedule</span>.
    </h2>
    <p class="body-copy mt-4 max-w-3xl text-sm">
      The first part is an assessment: research the model, make rough directions and test one
      prototype. That work ends on 1 November with a recommendation and implementation brief.
      The second part turns the approved direction into the finished brand and launches the
      first local-club pilot. The club sets those dates after reviewing the assessment.
    </p>

    <div class="relative mx-auto mt-10 max-w-3xl">
      <div
        class="absolute bottom-8 top-2 border-l-2 border-dashed border-[var(--color-ink-950)]/35"
        style="left: calc(1.5rem - 1px);"
        aria-hidden="true"
      ></div>
      <ol class="space-y-6">
        {
          steps.map((step) => (
            <li class="relative grid grid-cols-[3rem_1fr] gap-4 sm:gap-6">
              <span
                class:list={[
                  "relative z-10 mt-1 inline-flex h-12 w-12 items-center justify-center rounded-full border-2 border-[var(--color-ink-950)] text-xl shadow-[3px_3px_0_0_var(--color-ink-950)]",
                  step.status === "done"
                    ? "bg-[var(--color-teal-500)]"
                    : step.status === "now"
                      ? "bg-[var(--color-coral-500)]"
                      : "bg-[var(--color-sun-500)]",
                ]}
                aria-hidden="true"
              >
                {step.status === "done" ? "✓" : step.emoji}
              </span>
              <div class:list={["surface-card p-5 md:p-6", step.accent, step.status === "now" ? "dashed" : ""]}>
                <div class="flex flex-wrap items-center gap-2">
                  <span class="tag-pill sun">{step.date}</span>
                  {step.status === "done" && <span class="tag-pill">done</span>}
                  {step.status === "now" && <span class="tag-pill pink">we are here</span>}
                </div>
                <h3
                  class="mt-3 text-xl font-bold text-[var(--color-ink-950)]"
                  style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;"
                >
                  {step.title}
                </h3>
                <p class="body-copy mt-1 text-sm">{step.text}</p>
                <ul class="mt-4 space-y-2">
                  {step.tasks.map((task) => (
                    <li class="flex items-start gap-3 text-sm leading-relaxed text-[var(--color-ink-950)]/80">
                      <span class="mt-[0.1rem] font-mono font-bold text-[var(--color-coral-500)]" aria-hidden="true">→</span>
                      <span>{task}</span>
                    </li>
                  ))}
                </ul>
                {step.links.length > 0 && (
                  <div class="mt-5 flex flex-wrap gap-2 border-t border-[var(--color-ink-950)]/15 pt-4">
                    {step.links.map((link) => (
                      <a
                        href={link.file}
                        target="_blank"
                        rel="noreferrer"
                        class="tag-pill transition hover:-translate-y-0.5 hover:bg-[var(--color-teal-500)]"
                      >
                        Open {link.label} ↗
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <div class="wave-divider mx-auto max-w-7xl px-6"></div>

  <!-- ===================== WORKING DOCUMENTS ===================== -->
  <section class="relative mx-auto max-w-7xl px-6 py-10 lg:px-10" data-reveal>
    <p class="section-kicker">The templates</p>
    <h2 class="section-title mt-5" style="font-size: clamp(1.8rem, 3.4vw, 2.8rem);">
      The documents we are
      <span class="font-accent italic" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">working with</span>.
    </h2>
    <p class="body-copy mt-4 max-w-3xl text-sm">
      These practical worksheets are part of the work in progress. Estelle uses the first two
      to develop the ideas. The other four help the coaches and families give feedback, test
      the result and agree how photos of the kids may be used. They work on a phone and can
      also be printed.
    </p>

    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        kit.map((item) => (
          <a
            href={item.file}
            target="_blank"
            rel="noreferrer"
            class="surface-card group block p-6 transition hover:-translate-y-1"
          >
            <div class="flex items-start justify-between gap-3">
              <span class="text-2xl" aria-hidden="true">{item.emoji}</span>
              <span class="tag-pill">{item.phase}</span>
            </div>
            <h3
              class="mt-3 text-xl font-bold text-[var(--color-ink-950)] transition group-hover:text-[var(--color-coral-500)]"
              style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;"
            >
              {item.title}
            </h3>
            <p class="body-copy mt-2 text-sm">{item.desc}</p>
            <p class="mt-4 font-mono text-xs font-bold uppercase tracking-[0.14em] text-[var(--color-coral-500)]">
              → Open
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ===================== FINISH ===================== -->
  <section class="relative mx-auto max-w-7xl px-6 pb-20 pt-6 lg:px-10" data-reveal>
    <div class="glass-panel p-8 md:p-12">
      <p class="eyebrow-badge">1 November · initial assessment</p>
      <h2
        class="mt-6 max-w-3xl text-3xl font-bold leading-tight md:text-4xl"
        style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;"
      >
        1 November produces the implementation decision.
      </h2>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-[var(--color-cream)]/85">
        The assessment says whether the model should continue, what needs to change and what
        the implementation will require. The work after 1 November finalises the brand, builds
        the club participation process and launches the first pilot with local surf clubs.
      </p>
    </div>
  </section>
</BaseLayout>
