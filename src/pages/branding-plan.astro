---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const title = `Granola that buys boards | ${site.name}`;
const description =
  "Concept draft: a granola made with Abigaelle. Every bag covers what it costs to make, and the surplus buys community boards so local kids can join Sunset Duckies without owning gear.";

const audience = [
  {
    emoji: "🌱",
    title: "The kids",
    accent: "sticker-teal",
    text: "They test everything. Look, feel and taste are their call, and what they actually use counts for more than any concept sheet.",
  },
  {
    emoji: "🏄",
    title: "The parents",
    accent: "sticker-sun",
    text: "They know what they bought, what stopped getting used and what they wish existed. Their answers name the problem in each category.",
  },
  {
    emoji: "🤝",
    title: "The club around them",
    accent: "sticker-pink",
    text: "A small community that helps choose and test the product, then sees exactly what each sale gives back.",
  },
];

const principles = [
  {
    name: "Solves a real problem",
    accent: "sticker-teal",
    emoji: "🎯",
    text: "Start from a problem families name themselves. No problem, no product.",
  },
  {
    name: "Built for years",
    accent: "sticker-sun",
    emoji: "🛠️",
    text: "Materials and construction that survive salt, sun and repeat use. Repair and hand-me-downs are part of the brief.",
  },
  {
    name: "The club is in the price",
    accent: "sticker-pink",
    emoji: "🌊",
    text: "Every product carries a fixed, visible contribution to the club: gear, sessions, events, whatever else we agree.",
  },
];

const moneyFlow = [
  {
    step: "01",
    title: "The bag pays for itself",
    text: "The idea is that ingredients, packaging, kitchen time and Abigaelle's share come out of the price first, so nothing sells below what it costs to make.",
  },
  {
    step: "02",
    title: "The surplus buys boards",
    text: "Whatever is left over goes to one thing rather than general funds. Boards is the current answer. More boards, wetsuits, coaching and comp travel are the alternatives to argue about.",
  },
  {
    step: "03",
    title: "Ten boards, ten places?",
    text: "Ten of each in the first year is a neat fit on paper. Whether free places should depend on granola sales at all is the part we are least sure about.",
  },
];

const clubAccess = [
  {
    label: "Families who can pay",
    text: `The base membership stays as it is, ${site.membership.feeLabel}, and covers comps, club lycras and safety gear.`,
  },
  {
    label: "Ten free places",
    text: "The number to start from: ten places for local kids at no fee. How many, and how a family gets one, is not settled.",
  },
  {
    label: "The link to test",
    text: "Members bring their own board, so a free place is only usable if there is one to lend. That is the reasoning behind tying the two together, and it may not survive contact with the club.",
  },
];

const openQuestions = [
  "Whether granola is even the right shape for this, or whether the same idea works better as something else.",
  "What Abigaelle wants out of this: her role, her time, her share of each bag and her name on the product.",
  "What a bag costs to make, what it sells for, and how much surplus is left per bag.",
  "What a community board costs, and therefore how many bags fund ten of them.",
  "Where the granola is made, and which Mauritian kitchen, hygiene and labelling rules apply.",
  "Who decides which kids get the ten free places, and how a family asks for one.",
  "Whether the free places open as the boards arrive, all at once, or independently of the granola.",
  "What else the surplus could buy, and why boards beat the alternatives.",
];

const categories = [
  {
    code: "01",
    name: "Everyday wear",
    context: "Off the water",
    text: "Clothes for ordinary days. It has to get worn often, look good, and last long enough to justify the price.",
  },
  {
    code: "02",
    name: "Surf wear",
    context: "In the water",
    text: "Lycras, wetsuits, anything worn in the water. Fit, movement, comfort, sun, salt and growing bodies shape the brief.",
  },
  {
    code: "03",
    name: "Surf gear",
    context: "Boards and equipment",
    text: "The technical end. A first board has to be useful, durable and realistic to make, test, ship and pass on.",
  },
  {
    code: "04",
    name: "Surf nutrition",
    context: "Before and after",
    start: true,
    text: "Granola, porridge, breakfast and recovery food. Families rebuy it every few weeks, and a batch is quicker to make and test than a garment or a board. This is where we start.",
  },
];

const steps = [
  {
    date: "28 Aug – 7 Sep",
    emoji: "🗣️",
    accent: "sticker-teal",
    status: "now",
    title: "Sit down with Abigaelle and the families",
    text: "Agree terms with the person making it, then hand the draft to the club and let them break it.",
    tasks: [
      "Agree with Abigaelle what she wants out of this: her role, her time, her share of each bag and her name on the product.",
      "Write down what she already makes, how she makes it and what she would want to change.",
      "Ask what kids eat before a session and what parents pack: what gets refused, what is bought for convenience, what they wish existed.",
      "Ask the kids what they would actually eat before and after surfing, and what they would not touch.",
      "Ask parents what they would pay for a bag, how often they would buy it and what would stop them.",
      "Ask coaches and families who the free places should reach, who decides, and whether they should depend on granola sales at all.",
      "Price the boards the club would buy, and check what the club already spends on shared gear.",
      "List what else the surplus could buy — more boards, wetsuits, coaching hours, comp travel — and say why boards win, or change it.",
      "Show the draft around as a draft. Collect the objections rather than the compliments, then rewrite it before any cooking starts.",
    ],
    links: [
      { label: "Questions for parents", file: "/templates/brand-parent-questionnaire.html" },
      { label: "Talking to the kids", file: "/templates/brand-kid-conversations.html" },
    ],
  },
  {
    date: "8 – 14 Sep",
    emoji: "📚",
    accent: "sticker-teal",
    title: "Learn the rules",
    text: "Food rules, comparable products and the standard we hold ourselves to.",
    tasks: [
      "Find the Mauritian food, hygiene and labelling rules for a granola made and sold here, and what a small kitchen or co-packer needs.",
      "Review premium breakfast and sports nutrition: ingredients, sugar and protein per serving, allergens, shelf life, packaging, batch size, price.",
      "Read Yvon Chouinard’s “Let My People Go Surfing” on product quality, culture and responsibility.",
      "Read “The Future of the Responsible Company” (Chouinard and Stanley) for its tests of a legitimate product and a responsible supply chain.",
      "Look at how purpose-led companies explain where the money goes.",
      "Write the one page of rules: quality, ingredients, customer, club contribution, accountability.",
      "Note what the other three categories would need, for whenever we get to them.",
    ],
    links: [],
  },
  {
    date: "15 – 28 Sep",
    emoji: "🥣",
    accent: "sticker-sun",
    title: "Make the granola",
    text: "Batches with Abigaelle until there is something worth putting a name on. The concept keeps moving while the recipe does.",
    tasks: [
      "Cook batches with Abigaelle and write down every version of the recipe.",
      "Fix the ingredient list and where each ingredient comes from, local first.",
      "Work out nutrition per serving, allergens and serving size.",
      "Test how long a batch holds, in what packaging, stored how.",
      "Choose a bag size and packaging that survives a school bag and a beach.",
      "Fill in the concept sheet, including the provisional price and the surplus per bag.",
    ],
    links: [
      { label: "Product and purpose brief", file: "/templates/brand-concept.html" },
      { label: "Product concept sheet", file: "/templates/brand-direction-sheet.html" },
    ],
  },
  {
    date: "29 Sep – 12 Oct",
    emoji: "🏄",
    accent: "sticker-pink",
    title: "Taste it with the club",
    text: "The kids decide whether it is good. The parents decide whether it sells.",
    tasks: [
      "Run taste tests at training. Check allergies and permission with parents first.",
      "Record what kids finish, what they leave and what they ask for again.",
      "Try it against a comparable shop-bought product without saying which is which.",
      "Ask parents the price question again, now with something real to taste.",
      "Show the money flow — cost, surplus, boards — and ask whether it is clear and worth it.",
      "Take pre-orders. Count those, not likes.",
    ],
    links: [
      { label: "Questions for parents", file: "/templates/brand-parent-questionnaire.html" },
      { label: "Talking to the kids", file: "/templates/brand-kid-conversations.html" },
    ],
  },
  {
    date: "13 – 26 Oct",
    emoji: "🧪",
    accent: "sticker-coral",
    title: "Check it can be made and sold",
    text: "Kitchen, costs and the board maths, far enough to make an honest call.",
    tasks: [
      "Confirm the kitchen or co-packer, batch size, hygiene approval, labelling and how it is stored and delivered.",
      "Get ingredient sourcing and pricing, and what a bag costs at each batch size.",
      "Build the unit economics: ingredients, packaging, kitchen time, Abigaelle’s share, retail price, surplus per bag.",
      "Price a community board, then work out how many bags fund ten of them.",
      "Agree Abigaelle’s share in writing before anything is sold.",
      "Write the one sentence customers read: what the surplus buys and how we report it.",
      "Show it to buyers outside the club and record pre-orders, not likes.",
    ],
    links: [
      { label: "Product clarity check", file: "/templates/brand-stranger-test.html" },
    ],
  },
  {
    date: "27 – 31 Oct",
    emoji: "📋",
    accent: "sticker-lilac",
    title: "Decide",
    text: "Whether the granola holds up as a product and as a way to buy boards.",
    tasks: [
      "State the product, the problem it solves and the evidence from the club.",
      "Set the requirements: ingredients, nutrition, allergens, shelf life, packaging.",
      "Present the price, costs, Abigaelle’s share and surplus per bag, with assumptions marked.",
      "Say how many bags a year ten boards needs, and whether that is realistic.",
      "Settle the free places: how many, who decides, when they open.",
      "Recommend: build, change or stop. Then scope, owners, budget and dates.",
    ],
    links: [],
  },
  {
    date: "After 31 Oct",
    emoji: "🛠️",
    accent: "sticker-teal",
    title: "First run, first boards",
    text: "Starts once the club approves the assessment and the budget.",
    tasks: [
      "Finish the identity, packaging, product page and the surplus explainer.",
      "Make a limited first run and launch it through the Tamarin community.",
      "Keep a simple public record: bags sold, costs covered, surplus banked, boards bought.",
      "Buy boards as the surplus lands instead of waiting for all ten.",
      "Open free places as the boards arrive, on whatever basis the club agreed.",
      "Review taste, sell-through, surplus and how the boards get used before the next product or the next club.",
    ],
    links: [],
  },
];

const kit = [
  {
    emoji: "🧭",
    title: "Product and purpose brief",
    phase: "Estelle",
    file: "/templates/brand-concept.html",
    window: "Opens 8 Sep",
    desc: "Who we are building for, the product standard, why it costs what it costs and the promise to the club.",
  },
  {
    emoji: "✏️",
    title: "Product concept sheet",
    phase: "Estelle",
    file: "/templates/brand-direction-sheet.html",
    window: "Opens 15 Sep",
    desc: "The granola on one sheet: ingredients, nutrition, shelf life, packaging, price, surplus per bag, testing.",
  },
  {
    emoji: "💬",
    title: "Questions for parents",
    phase: "Families",
    file: "/templates/brand-parent-questionnaire.html",
    open: true,
    window: "Open now · closes 7 Sep",
    now: "Every founding family fills one in. Parts 1 and 2 now, part 3 once there is a batch to taste.",
    desc: "What they feed their kids around surfing, what they would pay for a bag, and what they make of the boards plan.",
  },
  {
    emoji: "🏄",
    title: "Talking to the kids",
    phase: "Coaches",
    file: "/templates/brand-kid-conversations.html",
    open: true,
    window: "Open now · closes 7 Sep",
    now: "Coaches run these at training, one child at a time. Sections 1 and 2 now, the taste test later.",
    desc: "What kids eat before and after surfing, then their verdict on the granola.",
  },
  {
    emoji: "⏱️",
    title: "Product clarity check",
    phase: "Testing",
    file: "/templates/brand-stranger-test.html",
    window: "Opens 13 Oct",
    desc: "Does a buyer outside the club get who it is for, why it costs what it costs and what the surplus buys?",
  },
  {
    emoji: "📸",
    title: "Photo permission",
    phase: "Families",
    file: "/templates/brand-photo-permission.html",
    open: true,
    window: "Open now · closes 7 Sep",
    now: "Signed once per child, before any photo or video is used. Needed before the taste tests.",
    desc: "Where each child may appear in product work and club communications.",
  },
];

const openNow = kit.filter((item) => item.open);
---

<BaseLayout title={title} description={description} variant="performance">
  <div class="performance-plan">
    <section class="plan-hero">
      <figure class="plan-hero-media" data-float>
        <img
          src="/media/young-rider.jpg"
          alt="A young surfer riding a wave at sunset in Tamarin"
          width="1200"
          height="1600"
          loading="eager"
        />
        <figcaption>Tamarin · Mauritius · Concept draft</figcaption>
      </figure>

      <div class="plan-hero-panel" data-float>
        <div class="plan-hero-topline">
          <span>Sunset Duckies / Product development</span>
          <span>Concept draft · 2026</span>
        </div>

        <div class="plan-hero-content">
          <p class="plan-overline">Concept draft · first product</p>
          <h1>Granola that <span>buys boards.</span></h1>
          <p class="plan-hero-lead">
            The idea: a granola made with Abigaelle, a local girl. Every bag covers what it
            costs to make, and the surplus buys surfboards the club owns and lends out.
          </p>
          <p class="plan-hero-copy">
            Ten boards in the first year, and ten free places for local kids. Every number
            here is a starting guess. The plan to 31 October is how they get argued with,
            tested and changed.
          </p>
        </div>

        <div class="plan-hero-data" aria-label="Project facts">
          <div><strong>10</strong><span>Boards, year one</span></div>
          <div><strong>10</strong><span>Free places</span></div>
          <div><strong>31.10</strong><span>Go or no go</span></div>
        </div>
      </div>
    </section>

    <nav class="plan-index" aria-label="Brand development sections">
      <a href="#concept"><span>01</span> The idea</a>
      <a href="#the-range"><span>02</span> The range</a>
      <a href="#product-standard"><span>03</span> Product standard</a>
      <a href="#assessment"><span>04</span> The plan</a>
      <a href="#working-documents"><span>05</span> Documents</a>
    </nav>

    <section id="concept" class="plan-section plan-concept-section" data-reveal>
      <div class="plan-section-head">
        <p class="plan-overline">01 / Concept draft</p>
        <h2>Make it with Abigaelle, not for her.</h2>
        <p>
          A first idea, written down so it can be pulled apart. Every number here is a guess
          until the plan tests it, and the shape may change completely.
        </p>
      </div>

      <div class="plan-three-grid">
        {
          moneyFlow.map((item) => (
            <article class="plan-info-card">
              <span class="plan-info-number">{item.step}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>

      <div class="plan-access">
        <div class="plan-access-head">
          <p class="plan-overline">Who gets to surf</p>
          <h3>Ten free places, and where the boards come in.</h3>
        </div>
        <dl class="plan-access-list">
          {
            clubAccess.map((item) => (
              <div>
                <dt>{item.label}</dt>
                <dd>{item.text}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="plan-questions">
        <p class="plan-overline">What the plan has to work out</p>
        <ul>
          {openQuestions.map((question) => <li>{question}</li>)}
        </ul>
      </div>
    </section>

    <div class="plan-divider" aria-hidden="true"></div>

    <section id="the-range" class="plan-section plan-category-section" data-reveal>
      <div class="plan-section-head">
        <p class="plan-overline">02 / The range</p>
        <h2>Four directions. One of them starts.</h2>
        <p>
          The other three stay on the table for later years. Granola goes first because a
          small club can actually make it, test it with the kids and sell it this year.
        </p>
      </div>

      <div class="plan-category-grid">
        {categories.map((category) => (
          <article class:list={["plan-category-card", category.start && "is-start"]}>
            <div class="plan-card-code">
              <span>{category.code}</span>
              <span>{category.start ? "Starting here" : category.context}</span>
            </div>
            <h3>{category.name}</h3>
            <p>{category.text}</p>
            <span class="plan-card-line" aria-hidden="true"></span>
          </article>
        ))}
      </div>
    </section>

  <section class="plan-section plan-audience-section" data-reveal>
    <div class="plan-section-head plan-section-head-wide">
      <p class="plan-overline">The customer and the community</p>
      <h2>The club decides whether it is any good.</h2>
    </div>

    <div class="plan-three-grid">
      {
        audience.map((item, i) => (
          <article class="plan-info-card">
            <span class="plan-info-number">0{i + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))
      }
    </div>

    <p class="plan-note">
      The granola has to earn its price on taste and quality first. Nobody buys a bad
      breakfast twice because the money goes somewhere good. If the kids will not eat it,
      the concept fails and we say so.
    </p>
  </section>

  <div class="plan-divider" aria-hidden="true"></div>

  <section id="product-standard" class="plan-section plan-standard-section" data-reveal>
    <div class="plan-section-head">
      <p class="plan-overline">03 / Product standard</p>
      <h2>Purpose has to show up in the product.</h2>
    </div>
    <p class="plan-reference-copy">
      Two books are working references:
      <a href="https://www.patagonia.com/product/let-my-people-go-surfing-revised-paperback-book/BK067.html" target="_blank" rel="noreferrer">Let My People Go Surfing</a>
      and
      <a href="https://www.patagonia.com/product/the-future-of-the-responsible-company-paperback/BK235.html" target="_blank" rel="noreferrer">The Future of the Responsible Company</a>.
      The challenge they set is practical: make a legitimate product that lasts, know how it
      is made, respect the people around it, and build the purpose into how the company runs.
    </p>

    <div class="plan-three-grid plan-principles-grid">
      {
        principles.map((principle, i) => (
          <article class="plan-info-card plan-principle-card">
            <span class="plan-info-number">P-0{i + 1}</span>
            <h3>{principle.name}</h3>
            <p>{principle.text}</p>
          </article>
        ))
      }
    </div>

    <p class="plan-note">
      For food, “built for years” means ingredients we can name, honest nutrition and a shelf
      life a small batch can hold. The other two rules stand.
    </p>

    <p class="plan-note">
      A high price is a promise. The assessment has to name the ingredients, sourcing,
      testing and shelf life that make it fair, then publish what each bag leaves over and
      what the club bought with it.
    </p>
  </section>

  <div class="plan-divider" aria-hidden="true"></div>

  <section id="assessment" class="plan-section plan-assessment-section" data-reveal>
    <div class="plan-section-head">
      <p class="plan-overline">04 / The plan</p>
      <h2>From kitchen table to first run.</h2>
      <p>
        The draft above is the starting point, not the answer. The work to 31 October pulls
        it apart with the club, rebuilds it, and turns whatever survives into a real recipe,
        a real price and an honest number. Production starts only once the club approves it.
      </p>
    </div>

    <div class="plan-open-now">
      <div class="plan-open-head">
        <p class="plan-overline">Open now · closes 7 September</p>
        <h3>Three sheets are collecting answers this week.</h3>
        <p>
          Everything after this phase is built on what they say. They close with the first
          phase on 7 September. Fill them in on a phone, or print them.
        </p>
      </div>

      <div class="plan-open-grid">
        {
          openNow.map((item) => (
            <a href={item.file} target="_blank" rel="noreferrer" class="plan-open-card">
              <span class="plan-open-tag">{item.phase}</span>
              <h4>{item.title}</h4>
              <p>{item.now}</p>
              <span class="plan-open-cta">Open sheet ↗</span>
            </a>
          ))
        }
      </div>
    </div>

    <ol class="plan-timeline">
      {
        steps.map((step, index) => (
          <li class:list={["plan-step", step.status === "now" && "is-current"]}>
            <div class="plan-step-rail">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <time>{step.date}</time>
              {step.status === "now" && <em>Current phase</em>}
            </div>
            <div class="plan-step-body">
              <h3>{step.title}</h3>
              <p class="plan-step-intro">{step.text}</p>
              <ul>
                {step.tasks.map((task) => <li>{task}</li>)}
              </ul>
              {step.links.length > 0 && (
                <div class="plan-step-links">
                  {step.links.map((link) => (
                    <a href={link.file} target="_blank" rel="noreferrer">
                      {link.label} <span aria-hidden="true">↗</span>
                    </a>
                  ))}
                </div>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <div class="plan-divider" aria-hidden="true"></div>

  <section id="working-documents" class="plan-section plan-documents-section" data-reveal>
    <div class="plan-section-head">
      <p class="plan-overline">05 / Working documents</p>
      <h2>Evidence, recorded as we go.</h2>
      <p>
        The sheets that turn kitchen sessions, taste tests and buyer reactions into the
        assessment. All of them work on a phone or printed.
      </p>
    </div>

    <div class="plan-document-grid">
      {
        kit.map((item, index) => (
          <a href={item.file} target="_blank" rel="noreferrer" class="plan-document-card">
            <div class="plan-document-meta">
              <span>DOC-{String(index + 1).padStart(2, "0")}</span>
              <span>{item.phase}</span>
            </div>
            <span class:list={["plan-document-window", item.open && "is-open"]}>{item.window}</span>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
            <span class="plan-document-open">Open document ↗</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="plan-decision" data-reveal>
    <img
      src="/media/board-lineup.jpg"
      alt="Young surfers and their boards gathered on the beach at sunset"
      width="1600"
      height="1067"
      loading="lazy"
    />
    <div class="plan-decision-overlay">
      <p class="plan-overline">Decision gate / 31 October</p>
      <h2>Does the granola buy the boards?</h2>
      <p>
        The assessment ends with a recipe, the club's verdict, a kitchen, a price, the
        surplus per bag and the number of bags ten boards needs. If the case holds, the
        first run starts next.
      </p>
    </div>
  </section>
  </div>
</BaseLayout>

<style is:global>
  .performance-plan {
    --plan-bg: #071015;
    --plan-panel: #0b171d;
    --plan-panel-raised: #0f1e25;
    --plan-text: #f2f4ed;
    --plan-muted: #9ba8a5;
    --plan-line: rgba(242, 244, 237, 0.16);
    --plan-accent: #d7ff3f;
    --plan-warm: #ff6849;
    overflow: hidden;
    color: var(--plan-text);
    background:
      linear-gradient(rgba(242, 244, 237, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(242, 244, 237, 0.035) 1px, transparent 1px),
      radial-gradient(circle at 82% 5%, rgba(68, 113, 109, 0.22), transparent 28rem),
      var(--plan-bg);
    background-size: 64px 64px, 64px 64px, auto, auto;
  }

  .performance-plan a:focus-visible {
    outline: 2px solid var(--plan-accent);
    outline-offset: 4px;
  }

  .plan-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    min-height: calc(100vh - 5rem);
    border-bottom: 1px solid var(--plan-line);
