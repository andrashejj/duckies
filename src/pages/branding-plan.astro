---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const title = `The Brand Plan | ${site.name}`;
const description =
  "How Sunset Duckies gets a proper identity: Estelle's part-time brand project treats the club as a small purpose company and designs the brand to travel on social media without ad spend.";

const timeline = [
  { week: "P1", label: "Research" },
  { week: "P2", label: "Concept" },
  { week: "P3", label: "Community" },
  { week: "P4", label: "Test" },
];

const pillars = [
  {
    emoji: "🧭",
    title: "Purpose",
    accent: "sticker-teal",
    text: "The club teaches kids to surf, and it takes on responsibility while doing it: for the kids' confidence, for the families' trust, and for the lagoon they surf in. The brand has to carry that, and every decision in this plan gets checked against it.",
  },
  {
    emoji: "🤝",
    title: "Community",
    accent: "sticker-sun",
    text: "The families build the brand with Estelle. They supply the words, react to the directions, and pick the winner. A brand the community shaped is one it will wear and defend.",
  },
  {
    emoji: "📲",
    title: "Organic social",
    accent: "sticker-pink",
    text: "There is no ad budget, and the plan is to never need one. The brand has to earn its reach: moments worth filming, a badge that reads at feed size, and posts parents are proud to share. Unpaid social is a design requirement from day one.",
  },
];

const milestones = [
  {
    date: "Mid Aug",
    marker: "done ✓",
    status: "done",
    emoji: "📚",
    accent: "sticker-teal",
    title: "Kickoff",
    text: "Estelle started on the books, and the coaches started collecting parents' words on WhatsApp.",
  },
  {
    date: "6 Sep",
    marker: "closes P1",
    status: "now",
    emoji: "📄",
    accent: "sticker-teal",
    title: "Research digest",
    text: "One page on how community brands were built, what a responsible company owes, and what makes club content get shared.",
  },
  {
    date: "20 Sep",
    marker: "closes P2",
    emoji: "🧭",
    accent: "sticker-sun",
    title: "Concept locked",
    text: "The brand core one-pager plus three equally rough direction sheets, ready to travel.",
  },
  {
    date: "21 Sep",
    marker: "opens P3",
    emoji: "✉️",
    accent: "sticker-pink",
    title: "Sheets land in Tamarin",
    text: "Estelle's prediction goes in a sealed envelope, the posters go up at training, the questionnaires go out.",
  },
  {
    date: "4 Oct",
    marker: "closes P3",
    emoji: "🏁",
    accent: "sticker-pink",
    title: "The direction",
    text: "Chosen on the family call, for reasons the club can point to. Photo permissions signed.",
  },
  {
    date: "12 Oct",
    marker: "mid P4",
    emoji: "📲",
    accent: "sticker-coral",
    title: "Badge final, trial live",
    text: "The cleaned-up badge passes the draw-it-from-memory, 15mm, and one-colour checks. Two weeks of organic posting begin.",
  },
  {
    date: "1 Nov",
    marker: "closes P4",
    emoji: "🎉",
    accent: "sticker-lilac",
    title: "Handover",
    text: "The brand book is done, the stranger test is passed, and the founding families see everything first.",
  },
];

const researchSteps = [
  {
    emoji: "📚",
    text: "Start with Patagonia. In “Let My People Go Surfing”, Yvon Chouinard describes a brand that came from how the company already behaved, written down after the fact. That is the model here: the club already has a character, and the job is to find it and put it on paper.",
  },
  {
    emoji: "🌍",
    text: "Then “The Future of the Responsible Company”, where Chouinard and Vincent Stanley set out what a business owes the people and places it touches. The exercise: translate that to a volunteer kids' club. Who is the club answerable to, and what does each answer mean for the brand?",
  },
  {
    emoji: "📲",
    text: "Study how small clubs and community projects grow on social media without paying for reach. Find a handful of accounts that managed it, work out which posts actually travelled, and write down the patterns: the moments, the formats, the captions.",
  },
  {
    emoji: "🏄",
    text: "Look at how other surf clubs, community sports clubs, and grassroots kids' organisations present themselves. Partly for ideas, mostly to list the clichés to avoid.",
  },
  {
    emoji: "🎓",
    text: "Go through the branding basics from her course material: positioning, brand core, identity, tone of voice. Enough theory to know the steps and their order, without turning this into a thesis.",
  },
  {
    emoji: "🗣️",
    text: "Ask the club what people already say. Coaches and parents in Tamarin describe the club in their own words over WhatsApp, and those words go into a document. What families already say is the raw material for the concept.",
  },
];

const routes = [
  {
    name: "Access",
    accent: "sticker-teal",
    emoji: "🌊",
    tension: "The lagoon is right there. The club makes sure gear, coaching, and a spot in the lineup are too.",
  },
  {
    name: "Outside",
    accent: "sticker-sun",
    emoji: "📱",
    tension: "An afternoon in the water beats an afternoon on a screen.",
  },
  {
    name: "Belonging",
    accent: "sticker-pink",
    emoji: "🤝",
    tension: "Kids in Tamarin have plenty of activities. The club gives them a crew of their own.",
  },
];

const communityTests = [
  {
    emoji: "🛹",
    title: "The sticker test",
    text: "Three sticker designs on the table at training. Nobody has to take one. The coaches note which ones disappear onto boards and which stay on the table.",
  },
  {
    emoji: "🧠",
    title: "The memory test",
    text: "The three sheets go up at training on Monday, then come down. On Friday the coaches ask the kids what they remember. Whatever survives four days is doing its job.",
  },
  {
    emoji: "💬",
    title: "The parent question",
    text: "Parents get asked two things: which direction sounds like the club they actually send their kids to, and which example post they would share on their own profile. Sharing is a higher bar than liking, and it is the bar that matters.",
  },
  {
    emoji: "📞",
    title: "The call",
    text: "A video call between Estelle and the founding families to go through what the kids and parents said, and to pick a direction together.",
  },
];

const kit = [
  {
    emoji: "🧭",
    title: "Brand concept one-pager",
    phase: "P2",
    file: "/templates/brand-concept.html",
    desc: "The skeleton Estelle fills in: the sentence, purpose and responsibilities, beliefs, the promise to families, voice, and the map of the three directions.",
  },
  {
    emoji: "✏️",
    title: "Direction sheet",
    phase: "P2",
    file: "/templates/brand-direction-sheet.html",
    desc: "Printed three times, one per direction: the line, badge sketch, colours, sticker, example post, and a self-check before it ships.",
  },
  {
    emoji: "💬",
    title: "Parent questionnaire",
    phase: "P1 + P3",
    file: "/templates/brand-parent-questionnaire.html",
    desc: "Five minutes on the beach or over WhatsApp. Part one collects the words parents already use; part two comes back with the direction sheets.",
  },
  {
    emoji: "🏄",
    title: "Kid conversations run sheet",
    phase: "P3",
    file: "/templates/brand-kid-conversations.html",
    desc: "For the coaches at training: the sticker tally, the embarrassment question by age group, the memory test, and space for exact words.",
  },
  {
    emoji: "⏱️",
    title: "Stranger test scoresheet",
    phase: "P2 + P4",
    file: "/templates/brand-stranger-test.html",
    desc: "Five seconds, three questions, eight people. Works for the rough directions and again for the finished badge.",
  },
  {
    emoji: "📸",
    title: "Photo permission form",
    phase: "P3",
    file: "/templates/brand-photo-permission.html",
    desc: "One per kid, signed before the first post goes out. Families choose what is OK, and the club's promises are printed on the same page.",
  },
];

const failureModes = [
  {
    emoji: "🥣",
    title: "Averaging into beige",
    accent: "sticker-sun",
    text: "If every opinion counts equally, the result is the mush in the middle. The community phase informs the decision; it does not make it. That is also why the concept gets written before the feedback comes in.",
  },
  {
    emoji: "✈️",
    title: "Designing from a desk",
    accent: "sticker-pink",
    text: "The risk of working remotely is a brand that looks great in a study project and wrong on a beach in Tamarin. Every direction has to be built on something a coach or parent actually said, and nothing ships without a photo of it on a real board.",
  },
  {
    emoji: "🎭",
    title: "Performing for the algorithm",
    accent: "sticker-teal",
    text: "Chasing shares can quietly take over, until the club posts what travels instead of what is true. The purpose page is the guardrail: if a post would feel off to a family on the beach, it doesn't go up, however well it would do.",
  },
  {
    emoji: "🐌",
    title: "Drifting into next year",
    accent: "sticker-lilac",
    text: "A part-time project next to full-time studies can slide forever. Each phase has an end date, and a decent direction decided on time beats a perfect one that never ships.",
  },
];
---

<BaseLayout title={title} description={description}>
  <!-- ===================== HERO ===================== -->
  <section class="relative mx-auto max-w-7xl px-6 pb-10 pt-14 lg:px-10">
    <div class="surface-card p-8 md:p-12" data-float>
      <div class="flex flex-wrap items-center gap-3">
        <p class="section-kicker">Club notebook · working in the open</p>
        <span class="tag-pill lilac">Underway · wraps 1 Nov 2026</span>
      </div>
      <h1
        class="section-title mt-6 max-w-4xl"
        style="font-size: clamp(2.4rem, 5.5vw, 4.6rem); line-height: 0.95;"
      >
        The
        <span class="font-accent italic" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">brand</span>
        <span class="ink-underline">plan</span>.
      </h1>
      <p class="body-copy mt-6 max-w-3xl">
        Sunset Duckies needs a proper identity: a badge for the rashies, stickers for the
        boards, and a clear answer to “what is this club?”. Estelle, a friend of the club
        studying in Switzerland, is building it as a part-time project alongside her degree.
        She does the research and the concept work from there; the kids, coaches, and parents
        in Tamarin do the reacting.
      </p>
      <p class="body-copy mt-4 max-w-3xl">
        The plan runs in four phases: research, concept, community, test. Two ideas shape all
        four. The club gets treated as a purpose company in miniature, answerable to the kids,
        the families, and the lagoon, the way Patagonia describes it in its books. And the
        brand gets designed to travel on social media by itself, because the club will never
        have an advertising budget and shouldn't need one. Kickoff is behind us; the research
        phase is running now.
      </p>

      <!-- Timeline strip -->
      <div class="mt-8 flex flex-wrap items-center gap-2 sm:gap-3">
        {
          timeline.map((step, i) => (
            <>
              <span class="chip">
                <strong class="font-bold">{step.week}</strong>&nbsp;{step.label}
              </span>
              {i < timeline.length - 1 && (
                <span class="font-mono text-lg font-bold text-[var(--color-coral-500)]" aria-hidden="true">
                  →
                </span>
              )}
            </>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== PILLARS ===================== -->
  <section class="relative mx-auto max-w-7xl px-6 py-10 lg:px-10" data-reveal>
    <p class="section-kicker">Before the phases</p>
    <h2 class="section-title mt-5" style="font-size: clamp(1.8rem, 3.4vw, 2.8rem);">
      Three pillars the brand
      <span class="font-accent italic" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">stands on</span>.
    </h2>

    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {
        pillars.map((pillar, i) => (
          <div class:list={["surface-card p-6", pillar.accent, i === 0 ? "tilt-left" : i === 2 ? "tilt-right" : ""]}>
            <span class="text-3xl" aria-hidden="true">{pillar.emoji}</span>
            <h3
              class="mt-3 text-xl font-bold text-[var(--color-ink-950)]"
              style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;"
            >
              {pillar.title}
            </h3>
            <p class="body-copy mt-2 text-sm">{pillar.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <div class="wave-divider mx-auto max-w-7xl px-6"></div>

  <!-- ===================== TIMELINE & MILESTONES ===================== -->
  <section class="relative mx-auto max-w-7xl px-6 py-10 lg:px-10" data-reveal>
    <p class="section-kicker">Milestones</p>
    <h2 class="section-title mt-5" style="font-size: clamp(1.8rem, 3.4vw, 2.8rem);">
      The
      <span class="font-accent italic" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">timeline</span>.
    </h2>
    <p class="body-copy mt-4 max-w-3xl text-sm">
      Kickoff is done and research is underway. The remaining dates hold, even when the work
      inside a phase flexes around Estelle's studies.
    </p>

    <div class="relative mx-auto mt-10 max-w-3xl">
      <div
        class="absolute bottom-8 top-2 border-l-2 border-dashed border-[var(--color-ink-950)]/35"
        style="left: calc(1.5rem - 1px);"
        aria-hidden="true"
      >
      </div>
      <ol class="space-y-6">
        {
          milestones.map((m) => (
            <li class="relative grid grid-cols-[3rem_1fr] gap-4 sm:gap-6">
              <span
                class:list={[
                  "relative z-10 mt-1 inline-flex h-12 w-12 items-center justify-center rounded-full border-2 border-[var(--color-ink-950)] text-xl shadow-[3px_3px_0_0_var(--color-ink-950)]",
                  m.status === "done"
                    ? "bg-[var(--color-teal-500)] font-bold"
                    : m.status === "now"
                      ? "bg-[var(--color-coral-500)]"
                      : "bg-[var(--color-sun-500)]",
                ]}
                aria-hidden="true"
              >
                {m.status === "done" ? "✓" : m.emoji}
              </span>
              <div class:list={["surface-card p-5 md:p-6", m.accent, m.status === "now" ? "dashed" : ""]}>
                <div class="flex flex-wrap items-center gap-3">
                  <span class="tag-pill sun">{m.date}</span>
                  {m.status === "now" && <span class="tag-pill pink">we are here</span>}
                  <span class="font-mono text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-ink-950)]/60">
                    {m.marker}
                  </span>
                </div>
                <h3
                  class="mt-2 text-xl font-bold text-[var(--color-ink-950)]"
                  style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;"
                >
                  {m.title}
                </h3>
                <p class="body-copy mt-1 text-sm">{m.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <div class="wave-divider mx-auto max-w-7xl px-6"></div>

  <!-- ===================== PHASE 1 — RESEARCH ===================== -->
  <section class="relative mx-auto max-w-7xl px-6 py-10 lg:px-10" data-reveal>
    <div class="mb-8 flex flex-wrap items-center gap-4">
      <span class="step-bubble">P1</span>
      <h2 class="section-title" style="font-size: clamp(1.8rem, 3.4vw, 2.8rem);">Research</h2>
      <span class="tag-pill pink">now · until 6 Sep</span>
    </div>

    <div class="grid gap-6 lg:grid-cols-[1.15fr_0.85fr]">
      <div class="surface-card p-6 md:p-8">
        <ul class="space-y-5">
          {
            researchSteps.map((step) => (
              <li class="flex items-start gap-4">
                <span class="text-2xl" aria-hidden="true">{step.emoji}</span>
                <p class="body-copy text-sm">{step.text}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="surface-card sticker-sun dashed p-6 md:p-8">
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-ink-950)]">
          ✦ Done when
        </p>
        <p class="mt-4 text-lg font-bold leading-snug" style="font-family: var(--font-display); font-variation-settings: 'wdth' 106;">
          She can explain, on one page, how community brands were built, what a responsible
          company owes the people around it, and what makes club content get shared.
        </p>
        <p class="body-copy mt-3 text-sm">
          All of it reduced to steps a small volunteer club can copy for free.
        </p>
      </div>
    </div>
  </section>

  <div class="wave-divider mx-auto max-w-7xl px-6"></div>

  <!-- ===================== PHASE 2 — CONCEPT ===================== -->
  <section class="relative mx-auto max-w-7xl px-6 py-10 lg:px-10" data-reveal>
    <div class="mb-8 flex flex-wrap items-center gap-4">
      <span class="step-bubble">P2</span>
      <h2 class="section-title" style="font-size: clamp(1.8rem, 3.4vw, 2.8rem);">Concept</h2>
      <span class="tag-pill">7 – 20 Sep</span>
    </div>

    <div class="surface-card p-6 md:p-8">
      <p class="body-copy max-w-3xl text-sm">
        This is the main part of the project. It starts with one page: what the club believes,
        what it is responsible for, what it promises families, and how it talks. Then three
        rough directions, each a different answer to “what is this club?”, and each built on
        something true about Tamarin:
      </p>
    </div>

    <div class="mt-6 grid gap-6 md:grid-cols-3">
      {
        routes.map((route, i) => (
          <div class:list={["surface-card p-6", route.accent, i === 0 ? "tilt-left" : i === 2 ? "tilt-right" : ""]}>
            <span class="text-3xl" aria-hidden="true">{route.emoji}</span>
            <h3
              class="mt-3 text-2xl font-bold text-[var(--color-ink-950)]"
              style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;"
            >
              {route.name}
            </h3>
            <p class="body-copy mt-2 text-sm">{route.tension}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-[1.15fr_0.85fr]">
      <div class="surface-card p-6 md:p-8">
        <p class="body-copy text-sm">
          Each direction gets one sheet: a line, a rough badge, three colours, a sticker, and
          one example post built from a real training photo. The post matters as much as the
          badge, because the feed and the beach are the two places this brand will actually
          live. All three sheets stay <strong>equally</strong> rough, because if one is
          prettier the kids will pick the drawing instead of the idea. At least one should
          feel slightly too bold. If all three feel safe, she has drawn the same thing three
          times.
        </p>
      </div>
      <div class="surface-card sticker-sun dashed p-6 md:p-8">
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-ink-950)]">
          ✦ Done when
        </p>
        <p class="mt-4 text-lg font-bold leading-snug" style="font-family: var(--font-display); font-variation-settings: 'wdth' 106;">
          A stranger can tell the three directions apart, say what each one is going for, and
          point at the one they would follow.
        </p>
      </div>
    </div>
  </section>

  <div class="wave-divider mx-auto max-w-7xl px-6"></div>

  <!-- ===================== PHASE 3 — COMMUNITY ===================== -->
  <section class="relative mx-auto max-w-7xl px-6 py-10 lg:px-10" data-reveal>
    <div class="mb-8 flex flex-wrap items-center gap-4">
      <span class="step-bubble">P3</span>
      <h2 class="section-title" style="font-size: clamp(1.8rem, 3.4vw, 2.8rem);">Community</h2>
      <span class="tag-pill">21 Sep – 4 Oct</span>
    </div>

    <p class="body-copy max-w-3xl text-sm">
      Estelle is nine thousand kilometres from the beach, so this phase runs through the club.
      The three sheets go to Tamarin, the coaches put them up at training, and the parents get
      them on WhatsApp. Before anything goes out, she writes down her own prediction of which
      direction wins and keeps it sealed until the phase ends. If the club agrees with her,
      good. If it disagrees, the prediction keeps her honest.
    </p>

    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      {
        communityTests.map((test) => (
          <div class="surface-card p-6">
            <span class="text-2xl" aria-hidden="true">{test.emoji}</span>
            <h3
              class="mt-3 text-xl font-bold text-[var(--color-ink-950)]"
              style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;"
            >
              {test.title}
            </h3>
            <p class="body-copy mt-2 text-sm">{test.text}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-[1.15fr_0.85fr]">
      <div class="surface-card sticker-pink p-6 md:p-8">
        <p class="body-copy text-sm">
          Two rules for the beach conversations. The coaches ask
          <em class="font-accent italic">“which one would embarrass you?”</em> instead of
          “which one do you like?”, because kids are polite about likes and honest about
          embarrassment. And the 8-year-olds' answers stay separate from the 13-year-olds',
          because the two groups will disagree, and the badge has to work for both.
        </p>
        <p class="body-copy mt-4 text-sm">
          This phase also settles photo permissions. Every family signs off, in writing, on
          whether and how their kid can appear on the club's accounts, before the first post
          goes out. Responsibility to the kids starts there, and the social pillar depends on
          it.
        </p>
        <p class="mt-4 font-mono text-xs font-bold uppercase tracking-[0.14em] text-[var(--color-coral-500)]">
          It's a conversation, not a vote. Everyone hears that up front.
        </p>
      </div>

      <div class="surface-card sticker-sun dashed p-6 md:p-8">
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-ink-950)]">
          ✦ Done when
        </p>
        <p class="mt-4 text-lg font-bold leading-snug" style="font-family: var(--font-display); font-variation-settings: 'wdth' 106;">
          One direction is chosen, for reasons the club can point to, and the photo
          permissions are signed.
        </p>
        <p class="body-copy mt-3 text-sm">
          Plus a short note on what to borrow from the two that lost. There is always
          something.
        </p>
      </div>
    </div>
  </section>

  <div class="wave-divider mx-auto max-w-7xl px-6"></div>

  <!-- ===================== PHASE 4 — TEST ===================== -->
  <section class="relative mx-auto max-w-7xl px-6 py-10 lg:px-10" data-reveal>
    <div class="mb-8 flex flex-wrap items-center gap-4">
      <span class="step-bubble">P4</span>
      <h2 class="section-title" style="font-size: clamp(1.8rem, 3.4vw, 2.8rem);">Test</h2>
      <span class="tag-pill">5 Oct – 1 Nov</span>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <div class="surface-card sticker-coral p-6">
        <span class="text-2xl" aria-hidden="true">🎨</span>
        <h3 class="mt-3 text-xl font-bold" style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;">
          Clean up the winner
        </h3>
        <p class="body-copy mt-2 text-sm">
          Free tools and a few evenings. It passes when a ten-year-old can draw it from
          memory, it stays legible at 15mm and as a profile picture, and it works in a single
          colour, because that is how it will actually get printed.
        </p>
      </div>
      <div class="surface-card sticker-pink p-6">
        <span class="text-2xl" aria-hidden="true">📲</span>
        <h3 class="mt-3 text-xl font-bold" style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;">
          The social trial
        </h3>
        <p class="body-copy mt-2 text-sm">
          Two weeks of posting with the new identity, organic only: first waves, wipeouts,
          award days, the walk down to the beach. Success is measured in shares, saves, and
          reposts by parents, since those are the free reach the brand is designed for. What
          travelled and what didn't goes into the brand book.
        </p>
      </div>
      <div class="surface-card sticker-teal p-6">
        <span class="text-2xl" aria-hidden="true">🧪</span>
        <h3 class="mt-3 text-xl font-bold" style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;">
          Put it on real things
        </h3>
        <p class="body-copy mt-2 text-sm">
          A rashie in the water, a sticker on a board, a page of this site, photographed by
          the club. Then the stranger test: show it to people who have never heard of the club
          for five seconds and ask what it is. If they can't answer, it goes back for another
          round.
        </p>
      </div>
      <div class="surface-card sticker-lilac p-6">
        <span class="text-2xl" aria-hidden="true">📓</span>
        <h3 class="mt-3 text-xl font-bold" style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;">
          A short brand book
        </h3>
        <p class="body-copy mt-2 text-sm">
          A dozen pages: what the club believes and is responsible for, the badge and how to
          use it, colours, how the club talks, and a social chapter with the posts that
          worked, the kinds it never posts, and the photo permission rules. Enough that any
          volunteer can run the accounts and make a poster without asking Estelle anything.
        </p>
      </div>
    </div>

    <div class="surface-card sticker-sun dashed mt-6 p-6 md:p-8">
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-ink-950)]">
        ✦ Done when
      </p>
      <p class="mt-4 max-w-3xl text-lg font-bold leading-snug" style="font-family: var(--font-display); font-variation-settings: 'wdth' 106;">
        Someone else could use all of it without asking a single question.
      </p>
      <p class="body-copy mt-3 text-sm">
        The founding families see it first. They earned that.
      </p>
    </div>
  </section>

  <div class="wave-divider mx-auto max-w-7xl px-6"></div>

  <!-- ===================== THE KIT ===================== -->
  <section class="relative mx-auto max-w-7xl px-6 py-10 lg:px-10" data-reveal>
    <p class="section-kicker">Print and fill</p>
    <h2 class="section-title mt-5" style="font-size: clamp(1.8rem, 3.4vw, 2.8rem);">
      The
      <span class="font-accent italic" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">kit</span>.
    </h2>
    <p class="body-copy mt-4 max-w-3xl text-sm">
      Every worksheet the plan mentions, ready to print. Estelle fills the first two; the
      coaches and families in Tamarin get the rest. Pencil beats polish on all of them.
    </p>

    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        kit.map((item) => (
          <a
            href={item.file}
            target="_blank"
            rel="noreferrer"
            class="surface-card group block p-6 transition hover:-translate-y-1"
          >
            <div class="flex items-start justify-between gap-3">
              <span class="text-2xl" aria-hidden="true">{item.emoji}</span>
              <span class="tag-pill">{item.phase}</span>
            </div>
            <h3
              class="mt-3 text-xl font-bold text-[var(--color-ink-950)] transition group-hover:text-[var(--color-coral-500)]"
              style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;"
            >
              {item.title}
            </h3>
            <p class="body-copy mt-2 text-sm">{item.desc}</p>
            <p class="mt-4 font-mono text-xs font-bold uppercase tracking-[0.14em] text-[var(--color-coral-500)]">
              → Open &amp; print
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <div class="wave-divider mx-auto max-w-7xl px-6"></div>

  <!-- ===================== FAILURE MODES ===================== -->
  <section class="relative mx-auto max-w-7xl px-6 py-10 lg:px-10" data-reveal>
    <p class="section-kicker">Being honest</p>
    <h2 class="section-title mt-5" style="font-size: clamp(1.8rem, 3.4vw, 2.8rem);">
      Four ways this could go
      <span class="font-accent italic" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">wrong</span>.
    </h2>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {
        failureModes.map((mode, i) => (
          <div class:list={["surface-card p-6", mode.accent, i % 2 === 0 ? "tilt-left" : "tilt-right"]}>
            <span class="text-3xl" aria-hidden="true">{mode.emoji}</span>
            <h3
              class="mt-3 text-xl font-bold text-[var(--color-ink-950)]"
              style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;"
            >
              {mode.title}
            </h3>
            <p class="body-copy mt-2 text-sm">{mode.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ===================== THE TEST ===================== -->
  <section class="relative mx-auto max-w-7xl px-6 pb-20 pt-6 lg:px-10" data-reveal>
    <div class="glass-panel p-8 md:p-12">
      <p class="eyebrow-badge">1 November</p>
      <h2
        class="mt-6 max-w-3xl text-3xl font-bold leading-tight md:text-4xl"
        style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;"
      >
        How we'll know it worked.
      </h2>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-[var(--color-cream)]/85">
        Show everything to someone who has never heard of us and ask three questions:
        <em class="font-accent italic text-[var(--color-sun-500)]">what does this club believe,
        who is it for, and would you follow it?</em>
        If they answer all three without hesitating, we have a brand. If they hesitate, back
        to work.
      </p>
    </div>
  </section>
</BaseLayout>
