---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const title = `Brand project | ${site.name}`;
const description =
  "How Estelle is helping Sunset Duckies put its story, voice and character into something the whole club can use.";

const deliverables = [
  {
    emoji: "🧭",
    title: "The club's story",
    accent: "sticker-teal",
    text: "The words that explain why Sunset Duckies exists, what families can expect and how the club talks.",
  },
  {
    emoji: "🎨",
    title: "A recognisable badge",
    accent: "sticker-sun",
    text: "A badge, colours and type that work on rashies, board stickers, posters and a small profile picture.",
  },
  {
    emoji: "📓",
    title: "Examples and a guide",
    accent: "sticker-pink",
    text: "Examples for WhatsApp, social posts, stickers and signs, with notes any volunteer can follow.",
  },
];

const ideas = [
  {
    name: "Access",
    accent: "sticker-teal",
    emoji: "🌊",
    text: "The lagoon is right here, but learning to surf and finding the right gear is not easy for every kid. The club helps make that possible.",
  },
  {
    name: "Outside",
    accent: "sticker-sun",
    emoji: "☀️",
    text: "More time in the water, less time on a screen. The club gives kids a regular reason to get outside and surf together.",
  },
  {
    name: "Belonging",
    accent: "sticker-pink",
    emoji: "🤝",
    text: "Surfing brings everyone together. The club also gives the kids, parents and coaches a group that looks out for them.",
  },
];

const steps = [
  {
    date: "August",
    emoji: "🗣️",
    accent: "sticker-teal",
    status: "done",
    title: "Collect the club's words",
    text: "Start with the language people in Tamarin already use for Sunset Duckies.",
    tasks: [
      "Send the first part of the parent questionnaire to the family WhatsApp group.",
      "Ask coaches how they describe the club to a new family.",
      "Copy the answers into one working document, keeping people's own words.",
    ],
    links: [
      { label: "Questions for parents", file: "/templates/brand-parent-questionnaire.html" },
    ],
  },
  {
    date: "By 6 Sep",
    emoji: "📄",
    accent: "sticker-teal",
    status: "now",
    title: "Read and write up the research",
    text: "The research ends with one page of useful notes for this club.",
    tasks: [
      "Read “Let My People Go Surfing” by Yvon Chouinard.",
      "Read “The Future of the Responsible Company” by Yvon Chouinard and Vincent Stanley.",
      "Look at how other surf clubs, kids' sports clubs and small community projects present themselves.",
      "Write one page covering what is useful for Sunset Duckies, what families have said and which kinds of club posts people share.",
    ],
    links: [],
  },
  {
    date: "By 20 Sep",
    emoji: "✏️",
    accent: "sticker-sun",
    title: "Make three rough versions",
    text: "Prepare one version for Access, one for Outside and one for Belonging.",
    tasks: [
      "Fill in the project summary with the club's purpose, promise to families and way of speaking.",
      "Complete one idea sheet for each of the three starting points.",
      "Give every version a line, a badge sketch, three colours, a sticker and one post using a real training photo.",
      "Keep all three equally rough so the family feedback is about the idea rather than the neatest drawing.",
    ],
    links: [
      { label: "Project summary", file: "/templates/brand-concept.html" },
      { label: "Idea sheet", file: "/templates/brand-direction-sheet.html" },
    ],
  },
  {
    date: "21 Sep – 4 Oct",
    emoji: "🏄",
    accent: "sticker-pink",
    title: "Show all three to the club",
    text: "Families see the same rough sheets in WhatsApp and at training.",
    tasks: [
      "Send the three idea sheets and the second part of the parent questionnaire to the family WhatsApp group.",
      "Use the kid conversations sheet at training: offer the stickers, ask which one would embarrass them, and check on Friday what they remember.",
      "Record answers from ages 7 to 9 separately from ages 10 to 13.",
      "Collect a photo permission form from every family before posting images of the kids.",
      "Hold a call with Estelle and the founding families, then choose one idea and write down why.",
    ],
    links: [
      { label: "Questions for parents", file: "/templates/brand-parent-questionnaire.html" },
      { label: "Talking to the kids", file: "/templates/brand-kid-conversations.html" },
      { label: "Photo permission", file: "/templates/brand-photo-permission.html" },
    ],
  },
  {
    date: "5 Oct – 1 Nov",
    emoji: "🛹",
    accent: "sticker-coral",
    title: "Finish and test the chosen idea",
    text: "Turn the rough version into artwork the club can use.",
    tasks: [
      "Finish the badge and check that it still works in one colour, at 15 mm and as a profile picture.",
      "Run the five-second recognition check with eight people who do not know the club.",
      "Put the badge on a rashie, board sticker, social profile and page on this site. Photograph the real items and fix anything that is hard to read.",
      "Use the new look in club posts for two weeks and note which posts parents share, save or repost.",
    ],
    links: [
      { label: "Quick recognition check", file: "/templates/brand-stranger-test.html" },
    ],
  },
  {
    date: "1 Nov",
    emoji: "🎉",
    accent: "sticker-lilac",
    title: "Hand it over",
    text: "Give the club the artwork and the instructions needed to keep using it.",
    tasks: [
      "Deliver the final badge files for print and screen.",
      "List the colours, type choices and rules for placing the badge.",
      "Include example posts, writing notes and the agreed photo rules.",
      "Show the finished work to the families who helped before sharing it more widely.",
    ],
    links: [],
  },
];

const kit = [
  {
    emoji: "🧭",
    title: "Project summary",
    phase: "Estelle",
    file: "/templates/brand-concept.html",
    desc: "A one-page place to write down what the club is, what it wants to say and the three ideas being explored.",
  },
  {
    emoji: "✏️",
    title: "Idea sheet",
    phase: "Estelle",
    file: "/templates/brand-direction-sheet.html",
    desc: "The same sheet used for each rough idea: badge, colours, sticker and one example post.",
  },
  {
    emoji: "💬",
    title: "Questions for parents",
    phase: "Families",
    file: "/templates/brand-parent-questionnaire.html",
    desc: "A few questions about how parents describe Sunset Duckies now, followed later by their thoughts on the three ideas.",
  },
  {
    emoji: "🏄",
    title: "Talking to the kids",
    phase: "Coaches",
    file: "/templates/brand-kid-conversations.html",
    desc: "A simple guide for showing the ideas at training and recording what the younger and older kids say about them.",
  },
  {
    emoji: "⏱️",
    title: "Quick recognition check",
    phase: "Testing",
    file: "/templates/brand-stranger-test.html",
    desc: "Show someone the badge for five seconds, then ask what they saw. It tells us whether the design is clear enough.",
  },
  {
    emoji: "📸",
    title: "Photo permission",
    phase: "Families",
    file: "/templates/brand-photo-permission.html",
    desc: "A clear record of whether and where each child may appear in club photos and videos.",
  },
];
---

<BaseLayout title={title} description={description}>
  <!-- ===================== INTRO ===================== -->
  <section class="relative mx-auto max-w-7xl px-6 pb-10 pt-14 lg:px-10">
    <div class="surface-card p-8 md:p-12" data-float>
      <div class="flex flex-wrap items-center gap-3">
        <p class="section-kicker">A project for the club</p>
        <span class="tag-pill lilac">In progress · August–November 2026</span>
      </div>
      <h1
        class="section-title mt-6 max-w-4xl"
        style="font-size: clamp(2.4rem, 5.5vw, 4.6rem); line-height: 0.95;"
      >
        Giving
        <span class="font-accent italic" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">Sunset Duckies</span>
        a life of its own.
      </h1>
      <p class="body-copy mt-6 max-w-3xl">
        Estelle is helping us put what already happens at training into words, images and
        things the club can use beyond the water. That means a clear story, a voice, a badge,
        and ways for families to take part and share it. She is a friend of the club, studying
        in Switzerland, and is doing the project part time alongside her degree.
      </p>
      <p class="body-copy mt-4 max-w-3xl">
        The project starts with the club as it is today: kids learning to surf, coaches giving
        their time, families helping on the beach, and everyone meeting at Tamarin Bay twice a
        week. Estelle works remotely; the kids, parents and coaches shape the work by sharing
        what the club means to them and trying out her ideas.
      </p>
    </div>
  </section>

  <!-- ===================== WHAT WE ARE MAKING ===================== -->
  <section class="relative mx-auto max-w-7xl px-6 py-10 lg:px-10" data-reveal>
    <p class="section-kicker">What comes out of it</p>
    <h2 class="section-title mt-5" style="font-size: clamp(1.8rem, 3.4vw, 2.8rem);">
      Words, artwork and a way to
      <span class="font-accent italic" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">use them</span>.
    </h2>

    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {
        deliverables.map((item, i) => (
          <div class:list={["surface-card p-6", item.accent, i === 0 ? "tilt-left" : i === 2 ? "tilt-right" : ""]}>
            <span class="text-3xl" aria-hidden="true">{item.emoji}</span>
            <h3
              class="mt-3 text-xl font-bold text-[var(--color-ink-950)]"
              style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;"
            >
              {item.title}
            </h3>
            <p class="body-copy mt-2 text-sm">{item.text}</p>
          </div>
        ))
      }
    </div>

    <p class="body-copy mt-8 max-w-3xl text-sm">
      Families will mostly see the new look on the beach, in WhatsApp and as a small social
      profile image. The club does not buy advertising. Parents sharing training photos and
      club posts is how other local families hear about it, so the design has to be easy to
      spot and still feel like the club they know.
    </p>
  </section>

  <div class="wave-divider mx-auto max-w-7xl px-6"></div>

  <!-- ===================== THE IDEAS ===================== -->
  <section class="relative mx-auto max-w-7xl px-6 py-10 lg:px-10" data-reveal>
    <p class="section-kicker">The starting point</p>
    <h2 class="section-title mt-5" style="font-size: clamp(1.8rem, 3.4vw, 2.8rem);">
      Three ideas to
      <span class="font-accent italic" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">explore</span>.
    </h2>
    <p class="body-copy mt-4 max-w-3xl text-sm">
      The three starting points describe things that are already true about Sunset Duckies.
      Estelle will make a rough badge, sticker and example post for each one. The club can then
      see which idea feels closest to what happens at training every week.
    </p>

    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {
        ideas.map((idea, i) => (
          <div class:list={["surface-card p-6", idea.accent, i === 0 ? "tilt-left" : i === 2 ? "tilt-right" : ""]}>
            <span class="text-3xl" aria-hidden="true">{idea.emoji}</span>
            <h3
              class="mt-3 text-2xl font-bold text-[var(--color-ink-950)]"
              style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;"
            >
              {idea.name}
            </h3>
            <p class="body-copy mt-2 text-sm">{idea.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <div class="wave-divider mx-auto max-w-7xl px-6"></div>

  <!-- ===================== THE PROCESS ===================== -->
  <section class="relative mx-auto max-w-7xl px-6 py-10 lg:px-10" data-reveal>
    <p class="section-kicker">How the project works</p>
    <h2 class="section-title mt-5" style="font-size: clamp(1.8rem, 3.4vw, 2.8rem);">
      The
      <span class="font-accent italic" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">schedule</span>.
    </h2>
    <p class="body-copy mt-4 max-w-3xl text-sm">
      Estelle does the research and design work. The club collects answers in Tamarin, shows
      the ideas to families and tests them on the things we use. Each step below lists the work
      and links to the worksheet that goes with it.
    </p>

    <div class="relative mx-auto mt-10 max-w-3xl">
      <div
        class="absolute bottom-8 top-2 border-l-2 border-dashed border-[var(--color-ink-950)]/35"
        style="left: calc(1.5rem - 1px);"
        aria-hidden="true"
      ></div>
      <ol class="space-y-6">
        {
          steps.map((step) => (
            <li class="relative grid grid-cols-[3rem_1fr] gap-4 sm:gap-6">
              <span
                class:list={[
                  "relative z-10 mt-1 inline-flex h-12 w-12 items-center justify-center rounded-full border-2 border-[var(--color-ink-950)] text-xl shadow-[3px_3px_0_0_var(--color-ink-950)]",
                  step.status === "done"
                    ? "bg-[var(--color-teal-500)]"
                    : step.status === "now"
                      ? "bg-[var(--color-coral-500)]"
                      : "bg-[var(--color-sun-500)]",
                ]}
                aria-hidden="true"
              >
                {step.status === "done" ? "✓" : step.emoji}
              </span>
              <div class:list={["surface-card p-5 md:p-6", step.accent, step.status === "now" ? "dashed" : ""]}>
                <div class="flex flex-wrap items-center gap-2">
                  <span class="tag-pill sun">{step.date}</span>
                  {step.status === "done" && <span class="tag-pill">done</span>}
                  {step.status === "now" && <span class="tag-pill pink">we are here</span>}
                </div>
                <h3
                  class="mt-3 text-xl font-bold text-[var(--color-ink-950)]"
                  style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;"
                >
                  {step.title}
                </h3>
                <p class="body-copy mt-1 text-sm">{step.text}</p>
                <ul class="mt-4 space-y-2">
                  {step.tasks.map((task) => (
                    <li class="flex items-start gap-3 text-sm leading-relaxed text-[var(--color-ink-950)]/80">
                      <span class="mt-[0.1rem] font-mono font-bold text-[var(--color-coral-500)]" aria-hidden="true">→</span>
                      <span>{task}</span>
                    </li>
                  ))}
                </ul>
                {step.links.length > 0 && (
                  <div class="mt-5 flex flex-wrap gap-2 border-t border-[var(--color-ink-950)]/15 pt-4">
                    {step.links.map((link) => (
                      <a
                        href={link.file}
                        target="_blank"
                        rel="noreferrer"
                        class="tag-pill transition hover:-translate-y-0.5 hover:bg-[var(--color-teal-500)]"
                      >
                        Open {link.label} ↗
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <div class="wave-divider mx-auto max-w-7xl px-6"></div>

  <!-- ===================== WORKING DOCUMENTS ===================== -->
  <section class="relative mx-auto max-w-7xl px-6 py-10 lg:px-10" data-reveal>
    <p class="section-kicker">The templates</p>
    <h2 class="section-title mt-5" style="font-size: clamp(1.8rem, 3.4vw, 2.8rem);">
      The documents we are
      <span class="font-accent italic" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">working with</span>.
    </h2>
    <p class="body-copy mt-4 max-w-3xl text-sm">
      These practical worksheets are part of the work in progress. Estelle uses the first two
      to develop the ideas. The other four help the coaches and families give feedback, test
      the result and agree how photos of the kids may be used. They work on a phone and can
      also be printed.
    </p>

    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        kit.map((item) => (
          <a
            href={item.file}
            target="_blank"
            rel="noreferrer"
            class="surface-card group block p-6 transition hover:-translate-y-1"
          >
            <div class="flex items-start justify-between gap-3">
              <span class="text-2xl" aria-hidden="true">{item.emoji}</span>
              <span class="tag-pill">{item.phase}</span>
            </div>
            <h3
              class="mt-3 text-xl font-bold text-[var(--color-ink-950)] transition group-hover:text-[var(--color-coral-500)]"
              style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;"
            >
              {item.title}
            </h3>
            <p class="body-copy mt-2 text-sm">{item.desc}</p>
            <p class="mt-4 font-mono text-xs font-bold uppercase tracking-[0.14em] text-[var(--color-coral-500)]">
              → Open
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ===================== FINISH ===================== -->
  <section class="relative mx-auto max-w-7xl px-6 pb-20 pt-6 lg:px-10" data-reveal>
    <div class="glass-panel p-8 md:p-12">
      <p class="eyebrow-badge">By 1 November</p>
      <h2
        class="mt-6 max-w-3xl text-3xl font-bold leading-tight md:text-4xl"
        style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;"
      >
        A badge the kids are happy to wear.
      </h2>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-[var(--color-cream)]/85">
        At the end, Sunset Duckies should have a finished badge, the files needed to use it,
        and a short guide for future volunteers. The badge should feel at home on a rashie, a
        board and the club's WhatsApp profile.
      </p>
    </div>
  </section>
</BaseLayout>
