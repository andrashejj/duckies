---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/plan.css";
import { site } from "../data/site";

const title = `Project Molt brief | ${site.name}`;
const description =
  "Project Molt: build Sunset Duckies into a quality-first surf brand with a real purpose, a strong community and a model that can grow globally.";

const projectGoals = [
  { code: "01", name: "Quality first", text: "Make products surfers choose because they are useful, well made and worth the price, even if they never hear the community story." },
  { code: "02", name: "Purpose in the work", text: "Create paid local work and give participating communities a real role in developing, making and representing the products." },
  { code: "03", name: "Community strength", text: "Build a committed group of surfers, families, makers and supporters who test, use, recommend and help grow the brand." },
  { code: "04", name: "Global growth", text: "Define what stays shared and what stays local so the model can travel without turning every community into Tamarin." },
];

const methodology = [
  { name: "Compare fairly", text: "Draft all four products with the same sheet, detail and provisional price. Rotate their order in interviews." },
  { name: "Test behaviour", text: "Record choices, refusals, price objections, maker quotes, production limits, sales and repeat orders." },
  { name: "Require evidence", text: "Every phase ends with a named deliverable and a continue, revise or stop decision." },
];

const communityApproach = [
  "Start with an existing local group",
  "Agree roles and the first useful work",
  "Move decisions and assets into local hands",
  "Stay connected through shared brand rules",
];

const explorationSteps = [
  {
    date: "28 Aug – 7 Sep",
    status: "now",
    title: "Detail the four product ideas",
    deliverable: "Four completed product concept sheets at the same level of detail.",
    tasks: [
      "Complete one product concept sheet for each of the four areas.",
      "For each idea, define the product, customer, problem, surf moment, quality promise, materials or ingredients and provisional price.",
      "Bring all four ideas to the same level of detail. Do not choose a favourite or contact makers yet.",
    ],
    links: [
      { label: "Four product areas", file: "/product-ideas" },
      { label: "Product concept sheet", file: "/templates/brand-direction-sheet.html" },
    ],
  },
  {
    date: "8 – 18 Sep",
    title: "Run the interviews",
    deliverable: "Interview log and one comparison table covering all four products.",
    tasks: [
      "Interview all founding families and participating kids using the same four concepts and prices.",
      "Interview at least five likely buyers outside the club and one relevant maker or supplier per concept.",
      "Record choices, reasons, refusals, price objections, quoted costs, minimums and lead times.",
    ],
    links: [
      { label: "Parent interview", file: "/templates/brand-parent-questionnaire.html" },
      { label: "Kid interview", file: "/templates/brand-kid-conversations.html" },
    ],
  },
  {
    date: "19 – 25 Sep",
    title: "Choose one product",
    deliverable: "Product decision record and approved proof-of-concept brief.",
    tasks: [
      "Score all four against the same demand, quality, maker, cost, risk and brand criteria.",
      "Record why one product advances and why each of the other three stops or is parked.",
      "Approve the proof-of-concept owner, budget and pass or fail tests.",
    ],
    links: [
      { label: "Comparison table", file: "/product-ideas#evaluation" },
      { label: "Product clarity check", file: "/templates/brand-stranger-test.html" },
    ],
  },
  {
    date: "26 Sep – 18 Oct",
    title: "Build the proof of concept",
    deliverable: "Launch-ready small batch or sample, product specification and unit economics.",
    tasks: [
      "Agree the maker role, payment, credit, approval, production method and quality checks.",
      "If granola wins, test recipe, ingredients, portion, packaging, shelf life, food safety, nutrition information and permitted claims.",
      "Test the sample, confirm launch quantity and price, then make a launch, revise or stop decision.",
    ],
    links: [
      { label: "Product clarity check", file: "/templates/brand-stranger-test.html" },
    ],
  },
  {
    date: "19 – 31 Oct",
    title: "Run the competition and launch",
    deliverable: "Completed event, 48-hour launch report and approved November-to-February plan.",
    tasks: [
      "Confirm the date, venue, surf format, permissions, safety plan, roles, stock and event budget.",
      "Launch at a visible price and record units sold, orders, refusals, product issues and customer reasons.",
      "Reconcile the event within 48 hours and decide what changes before the second product cycle.",
    ],
    links: [],
  },
];

const pilotSteps = [
  {
    date: "November 2026",
    title: "Improve after the launch",
    deliverable: "Revised product specification, economics and second-cycle plan.",
    tasks: [
      "Reconcile every unit and all event and product costs.",
      "Review feedback, failures, price objections and follow-on demand.",
      "Revise the product, price, production process and maker agreement where needed.",
    ],
    links: [{ label: "Brand and community model", file: "/templates/brand-concept.html" }],
  },
  {
    date: "Dec 2026 – Jan 2027",
    title: "Run the second product cycle",
    deliverable: "Second-cycle report and Tamarin handover record.",
    tasks: [
      "Produce and sell or take orders using the revised specification and economics.",
      "Track repeat and new customers, quality, returns, production reliability and margin.",
      "Move agreed roles and decisions to local people and record where central help is still required.",
    ],
    links: [{ label: "Brand and community model", file: "/templates/brand-concept.html" }],
  },
  {
    date: "By 28 Feb 2027",
    title: "Decide what can travel",
    deliverable: "Global rollout plan and recommendation for the next proof community.",
    tasks: [
      "Challenge the Tamarin model with people from at least two potential communities outside Mauritius.",
      "Set the readiness test, first 90 days, local roles, handover, shared rules, economics and measures.",
      "Name the next community, sequence, team, budget, risks and decisions required to begin.",
    ],
    links: [{ label: "Brand and community model", file: "/templates/brand-concept.html" }],
  },
];

const octoberGate = [
  "Four-product decision record",
  "Launch-ready proof of concept",
  "Competition and launch report",
  "Approved November-to-February plan",
];

const februaryGate = [
  "Two product-cycle reports",
  "Tamarin ownership and handover record",
  "Actual economics and product standards",
  "Costed global rollout plan",
];

const templates = [
  { when: "Now · by 7 Sep", name: "Product concept sheet", use: "Complete once for each of the four products.", file: "/templates/brand-direction-sheet.html" },
  { when: "8–18 Sep", name: "Parent interview", use: "Record buying history and compare all four concepts.", file: "/templates/brand-parent-questionnaire.html" },
  { when: "8–18 Sep", name: "Kid interview", use: "Record what kids would use, reject and change.", file: "/templates/brand-kid-conversations.html" },
  { when: "19 Sep–18 Oct", name: "Product clarity check", use: "Test whether an outside buyer understands the product and price.", file: "/templates/brand-stranger-test.html" },
  { when: "Nov–Feb", name: "Brand and community model", use: "Record local ownership, handover, shared rules and rollout decisions.", file: "/templates/brand-concept.html" },
  { when: "Before public media", name: "Photo permission", use: "Supporting consent document, used only when a child's image will be published.", file: "/templates/brand-photo-permission.html" },
];
---

<BaseLayout title={title} description={description} variant="performance">
  <div class="performance-plan">
    <section class="plan-hero">
      <figure class="plan-hero-media" data-float>
        <img src="/media/young-rider.jpg" alt="A young surfer riding a wave at sunset in Tamarin" width="1200" height="1600" loading="eager" />
        <figcaption>Tamarin · Mauritius · First proof community</figcaption>
      </figure>

      <div class="plan-hero-panel" data-float>
        <div class="plan-hero-topline">
          <span>Sunset Duckies / Project Molt</span>
          <span>Aug 2026 – Feb 2027</span>
        </div>
        <div class="plan-hero-content">
          <p class="plan-overline">Project Molt brief</p>
          <h1>Build here. <span>Prepare to travel.</span></h1>
          <p class="plan-hero-lead">Build Sunset Duckies into a high-quality surf brand with a real purpose, a strong community behind it and a model that can grow beyond Tamarin.</p>
          <p class="plan-hero-copy">Project Molt is the first build phase: choose and launch one product by 31 October, improve it through a live Tamarin pilot and finish the global rollout plan by 28 February 2027.</p>
        </div>
        <div class="plan-hero-data" aria-label="Project deadlines">
          <div><strong>NOW</strong><span>Detail four ideas</span></div>
          <div><strong>31.10</strong><span>Launch + pilot plan</span></div>
          <div><strong>28.02</strong><span>Global rollout plan</span></div>
        </div>
      </div>
    </section>

    <nav class="plan-index" aria-label="Project brief sections">
      <a href="#goal"><span>01</span> Overall goal</a>
      <a href="#goals"><span>02</span> Project goals</a>
      <a href="#exploration"><span>03</span> To October</a>
      <a href="#method"><span>04</span> Method</a>
      <a href="#pilot"><span>05</span> To February</a>
      <a href="#delivery"><span>06</span> Delivery</a>
    </nav>

    <section id="goal" class="plan-section plan-brief-section" data-reveal>
      <div class="plan-section-head">
        <p class="plan-overline">01 / Overall project goal</p>
        <h2>Build a surf brand people choose for the product.</h2>
        <p>Product quality comes first. Purpose and community give people more reason to care, contribute and stay involved.</p>
      </div>
      <div class="plan-goal-statement">
        <p>Sunset Duckies will make high-quality products for surfers and surf families. It will develop them with local communities, create paid local work and give those communities a real role in the brand. Tamarin is the first proof; the model must be able to grow globally without flattening the people and identity of each place.</p>
      </div>
    </section>

    <div class="plan-divider" aria-hidden="true"></div>

    <section id="goals" class="plan-section plan-brief-section" data-reveal>
      <div class="plan-section-head">
        <p class="plan-overline">02 / Project goals</p>
        <h2>What Project Molt must prove.</h2>
        <p>These goals guide every product choice, community agreement and decision about what happens after Tamarin.</p>
      </div>
      <div class="plan-compact-grid">
        {projectGoals.map((goal) => (
          <article class="plan-compact-card"><span>{goal.code}</span><h3>{goal.name}</h3><p>{goal.text}</p></article>
        ))}
      </div>
    </section>

    <div class="plan-divider" aria-hidden="true"></div>

    <section id="exploration" class="plan-section plan-brief-section" data-reveal>
      <div class="plan-section-head">
        <p class="plan-overline">03 / Phase 1 · Initial exploration</p>
        <h2>Now to 31 October.</h2>
        <p>Detail four product ideas, choose one from evidence, build the smallest useful proof and launch it at the end-of-October surf competition.</p>
      </div>
      <div class="plan-phase-result"><span>Due 31 October</span><strong>One launched product, a 48-hour event report and an approved plan through February.</strong></div>
      <ol class="plan-timeline">
        {explorationSteps.map((step, index) => (
          <li class:list={["plan-step", step.status === "now" && "is-current"]}>
            <div class="plan-step-rail"><span>{String(index + 1).padStart(2, "0")}</span><time>{step.date}</time>{step.status === "now" && <em>Do this now</em>}</div>
            <div class="plan-step-body">
              <h3>{step.title}</h3>
              <p class="plan-step-deliverable"><span>Deliverable</span>{step.deliverable}</p>
              <ul>{step.tasks.map((task) => <li>{task}</li>)}</ul>
              {step.links.length > 0 && <div class="plan-step-links">{step.links.map((link) => <a href={link.file} target="_blank" rel="noreferrer">{link.label} ↗</a>)}</div>}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <div class="plan-divider" aria-hidden="true"></div>

    <section id="method" class="plan-section plan-brief-section" data-reveal>
      <div class="plan-section-head">
        <p class="plan-overline">04 / Method and approach</p>
        <h2>How decisions are made.</h2>
        <p>The team uses the same method from the first product drafts through the second live test. Evidence decides whether the work continues, changes or stops.</p>
      </div>
      <dl class="plan-access-list plan-method-list">
        {methodology.map((item) => <div><dt>{item.name}</dt><dd>{item.text}</dd></div>)}
      </dl>
      <div class="plan-community-approach">
        <p class="plan-overline">Community approach</p>
        <ol>{communityApproach.map((item, index) => <li><span>{String(index + 1).padStart(2, "0")}</span>{item}</li>)}</ol>
      </div>
    </section>

    <div class="plan-divider" aria-hidden="true"></div>

    <section id="pilot" class="plan-section plan-brief-section" data-reveal>
      <div class="plan-section-head">
        <p class="plan-overline">05 / Phase 2 · Live Tamarin pilot</p>
        <h2>November to February.</h2>
        <p>Improve after the launch, prove repeat demand, move agreed work into local hands and turn the Tamarin evidence into the global rollout plan.</p>
      </div>
      <div class="plan-phase-result"><span>Due 28 February</span><strong>Two product cycles, tested local ownership, actual economics and a costed rollout plan.</strong></div>
      <ol class="plan-timeline">
        {pilotSteps.map((step, index) => (
          <li class="plan-step">
            <div class="plan-step-rail"><span>P{String(index + 1).padStart(2, "0")}</span><time>{step.date}</time></div>
            <div class="plan-step-body">
              <h3>{step.title}</h3>
              <p class="plan-step-deliverable"><span>Deliverable</span>{step.deliverable}</p>
              <ul>{step.tasks.map((task) => <li>{task}</li>)}</ul>
              <div class="plan-step-links">{step.links.map((link) => <a href={link.file} target="_blank" rel="noreferrer">{link.label} ↗</a>)}</div>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <div class="plan-divider" aria-hidden="true"></div>

    <section id="delivery" class="plan-section plan-brief-section" data-reveal>
      <div class="plan-section-head">
        <p class="plan-overline">06 / Delivery gates and templates</p>
        <h2>The final checklists.</h2>
        <p>A deadline is complete only when every item below exists. The template table shows which working document to use and when.</p>
      </div>
      <div class="plan-gates">
        <article class="plan-gate"><time>31 October 2026</time><h3>Initial exploration complete</h3><ul>{octoberGate.map((item) => <li>{item}</li>)}</ul></article>
        <article class="plan-gate"><time>28 February 2027</time><h3>Tamarin pilot complete</h3><ul>{februaryGate.map((item) => <li>{item}</li>)}</ul></article>
      </div>
      <div class="plan-template-wrap">
        <table class="plan-template-table">
          <thead><tr><th scope="col">When</th><th scope="col">Template</th><th scope="col">Use it for</th></tr></thead>
          <tbody>{templates.map((item) => <tr><td>{item.when}</td><td><a href={item.file} target="_blank" rel="noreferrer">{item.name} ↗</a></td><td>{item.use}</td></tr>)}</tbody>
        </table>
      </div>
    </section>
  </div>
</BaseLayout>
