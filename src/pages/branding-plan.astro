---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const title = `Choosing the first product | ${site.name}`;
const description =
  "Four directions: everyday wear, surf wear, surf gear, surf nutrition. We test them with the club's families and decide by 31 October which one becomes the first Sunset Duckies product.";

const audience = [
  {
    emoji: "🌱",
    title: "The kids",
    accent: "sticker-teal",
    text: "They test everything. Look, feel and taste are their call, and what they actually use counts for more than any concept sheet.",
  },
  {
    emoji: "🏄",
    title: "The parents",
    accent: "sticker-sun",
    text: "They know what they bought, what stopped getting used and what they wish existed. Their answers name the problem in each category.",
  },
  {
    emoji: "🤝",
    title: "The club around them",
    accent: "sticker-pink",
    text: "A small community that helps choose and test the product, then sees exactly what each sale gives back.",
  },
];

const principles = [
  {
    name: "Solves a real problem",
    accent: "sticker-teal",
    emoji: "🎯",
    text: "Start from a problem families name themselves. No problem, no product.",
  },
  {
    name: "Built for years",
    accent: "sticker-sun",
    emoji: "🛠️",
    text: "Materials and construction that survive salt, sun and repeat use. Repair and hand-me-downs are part of the brief.",
  },
  {
    name: "The club is in the price",
    accent: "sticker-pink",
    emoji: "🌊",
    text: "Every product carries a fixed, visible contribution to the club: gear, sessions, events, whatever else we agree.",
  },
];

const categories = [
  {
    code: "01",
    name: "Everyday wear",
    context: "Off the water",
    text: "Clothes for ordinary days. It has to get worn often, look good, and last long enough to justify the price.",
  },
  {
    code: "02",
    name: "Surf wear",
    context: "In the water",
    text: "Lycras, wetsuits, anything worn in the water. Fit, movement, comfort, sun, salt and growing bodies shape the brief.",
  },
  {
    code: "03",
    name: "Surf gear",
    context: "Boards and equipment",
    text: "The technical end. A first board has to be useful, durable and realistic to make, test, ship and pass on.",
  },
  {
    code: "04",
    name: "Surf nutrition",
    context: "Before and after",
    text: "Granola, porridge, breakfast and recovery food. Families rebuy it every few weeks, and a batch is quicker to make and test than a garment or a board.",
  },
];

const steps = [
  {
    date: "28 Aug – 7 Sep",
    emoji: "🗣️",
    accent: "sticker-teal",
    status: "now",
    title: "Find the first real product problem",
    text: "Start with their first six months in surfing, then the next two years.",
    tasks: [
      "Ask parents what they bought in their child's first six months, what gets used every session and what stays at home.",
      "Record what has stopped fitting, broken, turned uncomfortable or been replaced, and why.",
      "Ask what is hard about buying for growing kids: fit, comfort, durability, style, price, availability.",
      "Ask what the next two years bring: more sessions, bigger waves, changing bodies, independence, travel, different equipment.",
      "List what they will buy or replace in that time, under the four headings.",
      "Ask which item in each category they hope lasts through it.",
      "Ask what kids eat before a session and what parents pack: what gets refused, what is bought for convenience, what they wish existed.",
      "Ask the kids what they reach for, what they avoid and what they would be proud to own.",
      "Ask coaches which problems they see every week at training.",
      "List the club costs a contribution could cover: shared gear, sessions, events.",
    ],
    links: [
      { label: "Questions for parents", file: "/templates/brand-parent-questionnaire.html" },
      { label: "Talking to the kids", file: "/templates/brand-kid-conversations.html" },
    ],
  },
  {
    date: "8 – 14 Sep",
    emoji: "📚",
    accent: "sticker-teal",
    title: "Read, compare and write down the rules",
    text: "Turn the answers into a one-page brief.",
    tasks: [
      "Read Yvon Chouinard’s “Let My People Go Surfing” on product quality, culture and responsibility.",
      "Read “The Future of the Responsible Company” (Chouinard and Stanley) for its tests of a legitimate, long-life product and a responsible supply chain.",
      "Review premium wear and gear for kids and family surfers: materials, sizing, useful life, repair options, prices.",
      "Review premium breakfast and sports nutrition: ingredients, sugar and protein per serving, allergens, shelf life, packaging, batch size, price.",
      "Find the Mauritian food, hygiene and labelling rules for a granola or porridge made and sold here, and what a small kitchen or co-packer needs.",
      "Compare the four on how often families buy, the problem each solves, production difficulty, regulation, likely price and what a sale returns to the club.",
      "Look at how purpose-led companies explain where the money goes.",
      "Write the one page of rules: quality, useful life, customer, club contribution, accountability.",
    ],
    links: [],
  },
  {
    date: "15 – 28 Sep",
    emoji: "✏️",
    accent: "sticker-sun",
    title: "Make one rough concept in each category",
    text: "Four concepts at the same level of detail, so the comparison is fair.",
    tasks: [
      "Finish the brief: customer, problem, promise to the club.",
      "Everyday wear: the item families named most often.",
      "Surf wear: a long-life lycra, if the research supports it.",
      "Surf gear: a durable first board, if the research supports it.",
      "Nutrition: a club granola or porridge mix, if the research supports it.",
      "Use the same concept sheet for all four.",
      "For each one: user, use case, fit or growth, materials, expected life, repair or pass-on plan, and how it looks.",
      "For food, swap fit, life and repair for ingredients and sourcing, nutrition per serving, allergens, shelf life, packaging, serving size.",
      "Add a provisional retail price, cost, margin and fixed club contribution. Flag every number that still needs a supplier quote.",
      "Keep all four equally rough, but visual enough for kids and parents to react to.",
    ],
    links: [
      { label: "Product and purpose brief", file: "/templates/brand-concept.html" },
      { label: "Product concept sheet", file: "/templates/brand-direction-sheet.html" },
    ],
  },
  {
    date: "29 Sep – 12 Oct",
    emoji: "🏄",
    accent: "sticker-pink",
    title: "Choose the product with families",
    text: "Put the four in front of the people who would buy and use them.",
    tasks: [
      "Show the same four to parents on WhatsApp and at training.",
      "Ask which fits their next two years, which they would buy, what they expect at that price and what would stop them.",
      "Show the club contribution as its own number and ask whether what it funds feels worth it.",
      "Let kids handle samples or comparable products. Record fit, comfort, look and whether they would actually use it.",
      "Taste-test the food concept against something comparable. Check allergies and permission first, then record what they finish, leave or ask for again.",
      "Keep younger kids, older kids and parents separate. Do not average them.",
      "Choose one with Estelle, the coaches and the founding families. Write down the evidence and the risks left.",
    ],
    links: [
      { label: "Questions for parents", file: "/templates/brand-parent-questionnaire.html" },
      { label: "Talking to the kids", file: "/templates/brand-kid-conversations.html" },
    ],
  },
  {
    date: "13 – 26 Oct",
    emoji: "🧪",
    accent: "sticker-coral",
    title: "Check whether the first product can work",
    text: "Push the product, price and contribution far enough to make an honest call.",
    tasks: [
      "Get a sample, a sourced reference product or a detailed prototype spec.",
      "Talk to suppliers: materials, sampling, minimum order, production time, packaging, delivery.",
      "For food: kitchen or co-packer, ingredient sourcing, batch size, shelf-life testing, labelling, hygiene approval, storage and delivery.",
      "Test fit, comfort and use with the club, and define the durability testing implementation will need.",
      "Build the unit economics: product cost, shipping, duties, margin, retail price, club contribution.",
      "Write the one sentence customers will read: how much goes to the club, what it funds, how we report it.",
      "Show it to likely buyers outside the founding families. Record pre-orders, not likes.",
    ],
    links: [
      { label: "Product clarity check", file: "/templates/brand-stranger-test.html" },
    ],
  },
  {
    date: "27 – 31 Oct",
    emoji: "📋",
    accent: "sticker-lilac",
    title: "Complete the initial assessment",
    text: "Say whether there is a real first product, and what making it properly takes.",
    tasks: [
      "Name the category, the product, the problem it solves and the evidence behind the choice.",
      "Set the requirements: quality, fit, growth, useful life, repair and pass-on, or for food, ingredients, nutrition, allergens, shelf life and packaging.",
      "Summarise supplier feasibility, open production risks and the testing still to do.",
      "Present the provisional price, costs, margin and club contribution, with the assumptions marked.",
      "Summarise what families said and what buyers outside the club would pay for.",
      "Recommend: build, change direction or stop. Then scope, owners, budget and dates.",
    ],
    links: [],
  },
  {
    date: "After 31 Oct",
    emoji: "🛠️",
    accent: "sticker-teal",
    title: "Develop, test and launch the first product",
    text: "Starts once the club approves the assessment and the budget.",
    tasks: [
      "Work through supplier samples, revising materials, construction, fit and design.",
      "Run real wear and durability tests with kids and parents, or taste, batch and shelf-life tests for food. Fix what fails and repeat until it meets the brief.",
      "Confirm production, minimum order, quality control, delivery, returns, repair and pass-on.",
      "Finish the identity, packaging, product page and the club-contribution explainer.",
      "Keep a simple record: money collected, money transferred, what the club spent it on.",
      "Make a limited first run and launch it through the Tamarin community.",
      "Review quality, sell-through, returns and club impact before picking the next product or the next club.",
    ],
    links: [],
  },
];

const kit = [
  {
    emoji: "🧭",
    title: "Product and purpose brief",
    phase: "Estelle",
    file: "/templates/brand-concept.html",
    window: "Opens 8 Sep",
    desc: "Who we are building for, the product standard, why it costs what it costs and the promise to the club.",
  },
  {
    emoji: "✏️",
    title: "Product concept sheet",
    phase: "Estelle",
    file: "/templates/brand-direction-sheet.html",
    window: "Opens 15 Sep",
    desc: "One sheet for any of the four: use, fit or ingredients, useful life or shelf life, price, club contribution, testing.",
  },
  {
    emoji: "💬",
    title: "Questions for parents",
    phase: "Families",
    file: "/templates/brand-parent-questionnaire.html",
    open: true,
    window: "Open now · closes 7 Sep",
    now: "Every founding family fills one in. Parts 1 and 2 now, part 3 once the concepts exist.",
    desc: "Their first six months in surfing, the next two years, and what they want from a product that funds the club.",
  },
  {
    emoji: "🏄",
    title: "Talking to the kids",
    phase: "Coaches",
    file: "/templates/brand-kid-conversations.html",
    open: true,
    window: "Open now · closes 7 Sep",
    now: "Coaches run these at training, one child at a time. Sections 1 and 2 now, concepts and taste test later.",
    desc: "What kids use, avoid and want to be seen with, then their verdict on the concepts.",
  },
  {
    emoji: "⏱️",
    title: "Product clarity check",
    phase: "Testing",
    file: "/templates/brand-stranger-test.html",
    window: "Opens 13 Oct",
    desc: "Does an outside buyer get who it is for, why it costs more and what the contribution does?",
  },
  {
    emoji: "📸",
    title: "Photo permission",
    phase: "Families",
    file: "/templates/brand-photo-permission.html",
    open: true,
    window: "Open now · closes 7 Sep",
    now: "Signed once per child, before any photo or video is used. Needed before concept testing.",
    desc: "Where each child may appear in product work and club communications.",
  },
];

const openNow = kit.filter((item) => item.open);
---

<BaseLayout title={title} description={description} variant="performance">
  <div class="performance-plan">
    <section class="plan-hero">
      <figure class="plan-hero-media" data-float>
        <img
          src="/media/young-rider.jpg"
          alt="A young surfer riding a wave at sunset in Tamarin"
          width="1200"
          height="1600"
          loading="eager"
        />
        <figcaption>Tamarin · Mauritius · First product community</figcaption>
      </figure>

      <div class="plan-hero-panel" data-float>
        <div class="plan-hero-topline">
          <span>Sunset Duckies / Product development</span>
          <span>Assessment 2026</span>
        </div>

        <div class="plan-hero-content">
          <p class="plan-overline">What this exercise is for</p>
          <h1>Find the <span>first product.</span></h1>
          <p class="plan-hero-lead">
            One product, obsessive about quality, that solves a real problem for the club's
            kids and families and pays the club back on every sale.
          </p>
          <p class="plan-hero-copy">
            Which of the four directions it comes from is still open. The families answer
            that between now and 31 October. We don't.
          </p>
        </div>

        <div class="plan-hero-data" aria-label="Project facts">
          <div><strong>04</strong><span>Product categories</span></div>
          <div><strong>01</strong><span>Core community</span></div>
          <div><strong>31.10</strong><span>Initial assessment</span></div>
        </div>
      </div>
    </section>

    <nav class="plan-index" aria-label="Brand development sections">
      <a href="#product-focus"><span>01</span> Product focus</a>
      <a href="#product-standard"><span>02</span> Product standard</a>
      <a href="#assessment"><span>03</span> Assessment</a>
      <a href="#working-documents"><span>04</span> Working documents</a>
    </nav>

    <section id="product-focus" class="plan-section plan-category-section" data-reveal>
      <div class="plan-section-head">
        <p class="plan-overline">01 / Product focus</p>
        <h2>Choose the category before the product.</h2>
        <p>
          One rough concept per category, then compare: need, repeat use or repeat purchase,
          growth, product life, production difficulty, price, and what each sale returns to
          the club.
        </p>
      </div>

      <div class="plan-category-grid">
        {categories.map((category) => (
          <article class="plan-category-card">
            <div class="plan-card-code"><span>{category.code}</span><span>{category.context}</span></div>
            <h3>{category.name}</h3>
            <p>{category.text}</p>
            <span class="plan-card-line" aria-hidden="true"></span>
          </article>
        ))}
      </div>
    </section>

  <section class="plan-section plan-audience-section" data-reveal>
    <div class="plan-section-head plan-section-head-wide">
      <p class="plan-overline">The customer and the community</p>
      <h2>The club decides what we make.</h2>
    </div>

    <div class="plan-three-grid">
      {
        audience.map((item, i) => (
          <article class="plan-info-card">
            <span class="plan-info-number">0{i + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))
      }
    </div>

    <p class="plan-note">
      Who the product is for — which child, which parent, which surf moment — is for the
      research to answer. Whatever it turns out to be, it earns its price on quality and
      usefulness. Competition-performance gear sits outside this first brief.
    </p>
  </section>

  <div class="plan-divider" aria-hidden="true"></div>

  <section id="product-standard" class="plan-section plan-standard-section" data-reveal>
    <div class="plan-section-head">
      <p class="plan-overline">02 / Product standard</p>
      <h2>Purpose has to show up in the product.</h2>
    </div>
    <p class="plan-reference-copy">
      Two books are working references:
      <a href="https://www.patagonia.com/product/let-my-people-go-surfing-revised-paperback-book/BK067.html" target="_blank" rel="noreferrer">Let My People Go Surfing</a>
      and
      <a href="https://www.patagonia.com/product/the-future-of-the-responsible-company-paperback/BK235.html" target="_blank" rel="noreferrer">The Future of the Responsible Company</a>.
      The challenge they set is practical: make a legitimate product that lasts, know how it
      is made, respect the people around it, and build the purpose into how the company runs.
    </p>

    <div class="plan-three-grid plan-principles-grid">
      {
        principles.map((principle, i) => (
          <article class="plan-info-card plan-principle-card">
            <span class="plan-info-number">P-0{i + 1}</span>
            <h3>{principle.name}</h3>
            <p>{principle.text}</p>
          </article>
        ))
      }
    </div>

    <p class="plan-note">
      For food, “built for years” means ingredients we can name, honest nutrition and a shelf
      life a small batch can hold. The other two rules stand.
    </p>

    <p class="plan-note">
      A high price is a promise. The assessment has to name the materials, construction,
      useful life, testing and service that make it fair, then set the club contribution,
      what it funds, and how we report the money.
    </p>
  </section>

  <div class="plan-divider" aria-hidden="true"></div>

  <section id="assessment" class="plan-section plan-assessment-section" data-reveal>
    <div class="plan-section-head">
      <p class="plan-overline">03 / Initial assessment</p>
      <h2>From category decision to launch brief.</h2>
      <p>
        The work to 31 October picks the product, tests the price and the contribution, and
        checks it can be made properly. Development and production start only once the
        assessment is approved.
      </p>
    </div>

    <div class="plan-open-now">
      <div class="plan-open-head">
        <p class="plan-overline">Open now · closes 7 September</p>
        <h3>Three sheets are collecting answers this week.</h3>
        <p>
          Everything after this phase is built on what they say. They close with the research
          phase on 7 September. Fill them in on a phone, or print them.
        </p>
      </div>

      <div class="plan-open-grid">
        {
          openNow.map((item) => (
            <a href={item.file} target="_blank" rel="noreferrer" class="plan-open-card">
              <span class="plan-open-tag">{item.phase}</span>
              <h4>{item.title}</h4>
              <p>{item.now}</p>
              <span class="plan-open-cta">Open sheet ↗</span>
            </a>
          ))
        }
      </div>
    </div>

    <ol class="plan-timeline">
      {
        steps.map((step, index) => (
          <li class:list={["plan-step", step.status === "now" && "is-current"]}>
            <div class="plan-step-rail">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <time>{step.date}</time>
              {step.status === "now" && <em>Current phase</em>}
            </div>
            <div class="plan-step-body">
              <h3>{step.title}</h3>
              <p class="plan-step-intro">{step.text}</p>
              <ul>
                {step.tasks.map((task) => <li>{task}</li>)}
              </ul>
              {step.links.length > 0 && (
                <div class="plan-step-links">
                  {step.links.map((link) => (
                    <a href={link.file} target="_blank" rel="noreferrer">
                      {link.label} <span aria-hidden="true">↗</span>
                    </a>
                  ))}
                </div>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <div class="plan-divider" aria-hidden="true"></div>

  <section id="working-documents" class="plan-section plan-documents-section" data-reveal>
    <div class="plan-section-head">
      <p class="plan-overline">04 / Working documents</p>
      <h2>Evidence, recorded as we go.</h2>
      <p>
        The sheets that turn interviews, product decisions and buyer reactions into the
        assessment. All of them work on a phone or printed.
      </p>
    </div>

    <div class="plan-document-grid">
      {
        kit.map((item, index) => (
          <a href={item.file} target="_blank" rel="noreferrer" class="plan-document-card">
            <div class="plan-document-meta">
              <span>DOC-{String(index + 1).padStart(2, "0")}</span>
              <span>{item.phase}</span>
            </div>
            <span class:list={["plan-document-window", item.open && "is-open"]}>{item.window}</span>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
            <span class="plan-document-open">Open document ↗</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="plan-decision" data-reveal>
    <img
      src="/media/board-lineup.jpg"
      alt="Young surfers and their boards gathered on the beach at sunset"
      width="1600"
      height="1067"
      loading="lazy"
    />
    <div class="plan-decision-overlay">
      <p class="plan-overline">Decision gate / 31 October</p>
      <h2>Does the first product deserve to be made?</h2>
      <p>
        The assessment ends with a product brief, the family evidence, the supplier picture,
        a provisional price, the club contribution and a budget. If the case holds, building
        it starts next.
      </p>
    </div>
  </section>
  </div>
</BaseLayout>

<style is:global>
  .performance-plan {
    --plan-bg: #071015;
    --plan-panel: #0b171d;
    --plan-panel-raised: #0f1e25;
    --plan-text: #f2f4ed;
    --plan-muted: #9ba8a5;
    --plan-line: rgba(242, 244, 237, 0.16);
    --plan-accent: #d7ff3f;
    --plan-warm: #ff6849;
    overflow: hidden;
    color: var(--plan-text);
    background:
      linear-gradient(rgba(242, 244, 237, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(242, 244, 237, 0.035) 1px, transparent 1px),
      radial-gradient(circle at 82% 5%, rgba(68, 113, 109, 0.22), transparent 28rem),
      var(--plan-bg);
    background-size: 64px 64px, 64px 64px, auto, auto;
  }

  .performance-plan a:focus-visible {
    outline: 2px solid var(--plan-accent);
    outline-offset: 4px;
  }

  .plan-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    min-height: calc(100vh - 5rem);
    border-bottom: 1px solid var(--plan-line);
  }

  .plan-hero-media {
    position: relative;
    min-height: 760px;
    overflow: hidden;
    border-right: 1px solid var(--plan-line);
    background: #17272d;
  }

  .plan-hero-media::after {
    position: absolute;
    inset: 0;
    content: "";
    background:
      linear-gradient(180deg, rgba(7, 16, 21, 0.05), rgba(7, 16, 21, 0.55)),
      linear-gradient(90deg, transparent 60%, rgba(7, 16, 21, 0.28));
  }

  .plan-hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.82) contrast(1.08);
  }

  .plan-hero-media figcaption {
    position: absolute;
    z-index: 1;
    right: 2rem;
    bottom: 2rem;
    left: 2rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(242, 244, 237, 0.72);
  }

  .plan-hero-panel {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(2rem, 5vw, 5rem);
  }

  .plan-hero-topline,
  .plan-card-code,
  .plan-document-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--plan-muted);
  }

  .plan-hero-topline {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--plan-line);
  }

  .plan-hero-content {
    max-width: 800px;
    margin: auto 0;
    padding: 4rem 0;
  }

  .plan-overline {
    margin: 0 0 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--plan-accent);
  }

  .plan-hero h1 {
    max-width: 9ch;
    margin: 0;
    font-family: var(--font-brand);
    font-size: clamp(5rem, 8.5vw, 10rem);
    font-weight: 400;
    letter-spacing: 0.005em;
    line-height: 0.82;
    text-transform: uppercase;
    color: var(--plan-text);
  }

  .plan-hero h1 span {
    display: block;
    color: var(--plan-accent);
  }

  .plan-hero-lead {
    max-width: 690px;
    margin: 2.25rem 0 0;
    font-family: var(--font-display);
