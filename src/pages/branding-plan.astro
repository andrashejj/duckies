---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandingNav from "../components/BrandingNav.astro";
import BrandingTeaser from "../components/BrandingTeaser.astro";
import { bKicker, cardTitle, monoMeta, overline, pageLead, pageTitle, sectionHeading } from "../lib/plan-ui";
import { chain, deliverables, endGoal, molt, streams } from "../data/molt";
import { site } from "../data/site";
export const prerender = false;
const approved = Astro.locals.branding?.canView ?? false;

const places = [
  { href: "/branding-plan/board", label: "Board", text: "Every task with an owner and a status." },
  ...deliverables.slice(0, 2),
  { href: "/branding-plan/deliverables", label: "Deliverables", text: "All working documents and the worksheets, with when to use them." },
];
const linkCard = "group flex flex-col gap-3 border-r border-b border-line bg-surface-2/60 p-7 no-underline transition-colors hover:bg-accent/8";
---

<BaseLayout title={`${molt.name} | ${site.name}`} description={approved ? molt.summary : "A surf brand taking shape in Tamarin. Request access to join the working group."} variant="performance">
  {approved ? <><BrandingNav />
  <div class="overflow-clip text-fg">
    <section class="grid border-b border-line lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
      <figure class="relative m-0 min-h-[40vh] overflow-hidden border-b border-line bg-surface-2 after:absolute after:inset-0 after:bg-[linear-gradient(180deg,color-mix(in_oklab,var(--color-ink-950)_5%,transparent),color-mix(in_oklab,var(--color-ink-950)_55%,transparent))] after:content-[''] lg:min-h-0 lg:border-r lg:border-b-0" data-float>
        <img src="/media/young-rider.jpg" alt="A young surfer riding a wave at sunset in Tamarin" width="1200" height="1600" loading="eager" class="h-full w-full object-cover saturate-[0.82] contrast-[1.08]" />
        <figcaption class="absolute inset-x-5 bottom-5 z-[1] font-mono text-[0.66rem] font-semibold uppercase tracking-[0.12em] text-cream-soft/72 sm:inset-x-8 sm:bottom-8">Tamarin · Mauritius · First proof community</figcaption>
      </figure>

      <div class="flex min-w-0 flex-col p-6 sm:p-[clamp(2rem,5vw,4.5rem)]" data-float>
        <div class={`${monoMeta} flex-wrap border-b border-line pb-5`}>
          <span>Sunset Duckies / {molt.name}</span>
          <span>{molt.span}</span>
        </div>
        <div class="my-auto max-w-[760px] py-12 sm:py-16">
          <p class={bKicker}>Overview</p>
          <h1 class={pageTitle}>{molt.name}</h1>
          <p class={`${pageLead} mt-8`}>{molt.summary}</p>
        </div>
        <div class="grid grid-cols-3 border-t border-line [&>div]:flex [&>div]:flex-col [&>div]:gap-1 [&>div]:border-r [&>div]:border-line [&>div]:px-[0.65rem] [&>div]:py-[1.1rem] [&>div:last-child]:border-r-0 sm:[&>div]:px-5 sm:[&>div]:py-[1.4rem] [&_strong]:font-brand [&_strong]:text-[1.75rem] [&_strong]:leading-none [&_strong]:font-normal [&_strong]:text-fg sm:[&_strong]:text-[2.2rem] [&_span]:font-mono [&_span]:text-[0.6rem] [&_span]:uppercase [&_span]:tracking-[0.08em] [&_span]:text-fg-muted" aria-label="Project deadlines">
          {molt.dates.map(date => <div><strong>{date.code}</strong><span>{date.label}</span></div>)}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-[1400px] px-[clamp(1.5rem,5vw,5rem)] py-[clamp(3.5rem,6vw,6rem)]" data-reveal aria-labelledby="chain-title">
      <p class={overline}>September to February</p>
      <h2 id="chain-title" class={`${sectionHeading} mb-10`}>How it fits together</h2>
      <ol class="m-0 grid list-none grid-cols-1 border-t border-l border-line p-0 sm:grid-cols-2 lg:grid-cols-4">
        {chain.map((step, index) => (
          <li class="relative flex flex-col border-r border-b border-line bg-surface-2/60 p-7 lg:after:absolute lg:after:top-7 lg:after:-right-[0.55rem] lg:after:z-[1] lg:after:font-mono lg:after:text-[0.8rem] lg:after:text-accent-text lg:after:content-['→'] lg:last:after:content-none">
            <span class="font-mono text-[0.66rem] font-semibold uppercase tracking-[0.12em] text-accent-text">{String(index + 1).padStart(2, "0")} · {step.when}</span>
            <h3 class={`${cardTitle} mt-8 mb-3 text-[1.35rem]`}>{step.title}</h3>
            <p class="m-0 mb-6 text-[0.92rem] leading-[1.55] text-fg-muted">{step.text}</p>
            <a href={step.href} class="mt-auto font-mono text-[0.66rem] font-semibold uppercase tracking-[0.1em] text-fg underline underline-offset-4 hover:text-accent-text">{step.link} →</a>
          </li>
        ))}
      </ol>
    </section>

    <section class="border-y border-line bg-surface/60" data-reveal aria-label="The end goal and the next three weeks">
      <div class="mx-auto grid max-w-[1400px] lg:grid-cols-2">
        <div class="border-b border-line px-[clamp(1.5rem,5vw,5rem)] py-[clamp(3rem,5vw,5rem)] lg:border-r lg:border-b-0">
          <p class={overline}>The end goal · 28 February</p>
          <p class="m-0 font-display text-[clamp(1.4rem,2.3vw,2rem)] font-[550] leading-[1.3] tracking-[-0.03em] text-fg">{endGoal}</p>
          <a href="/branding-plan/vision" class="mt-8 inline-block font-mono text-[0.66rem] font-semibold uppercase tracking-[0.1em] text-fg underline underline-offset-4 hover:text-accent-text">Vision →</a>
        </div>
        <div class="px-[clamp(1.5rem,5vw,5rem)] py-[clamp(3rem,5vw,5rem)]">
          <p class={overline}>Estelle's three weeks · 29 Sep – 19 Oct</p>
          <ol class="m-0 list-none p-0">
            {streams.map(stream => (
              <li class="grid grid-cols-[2rem_minmax(0,1fr)] items-baseline gap-x-3 border-t border-line py-[0.8rem] first:border-t-0">
                <span class="font-brand text-[1.4rem] leading-none text-fg/40">{stream.code}</span>
                <div><strong class="font-display text-[1.05rem] font-[650] text-fg">{stream.name}</strong><span class="mt-1 block font-mono text-[0.66rem] uppercase tracking-[0.06em] text-accent-text">{stream.target}</span></div>
              </li>
            ))}
          </ol>
          <a href="/branding-plan/onsite" class="mt-8 inline-block font-mono text-[0.66rem] font-semibold uppercase tracking-[0.1em] text-fg underline underline-offset-4 hover:text-accent-text">On the ground →</a>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-[1400px] px-[clamp(1.5rem,5vw,5rem)] py-[clamp(3.5rem,6vw,6rem)]" data-reveal aria-labelledby="places-title">
      <p class={overline}>Where things live</p>
      <h2 id="places-title" class="sr-only">Where things live</h2>
      <div class="grid grid-cols-1 border-t border-l border-line sm:grid-cols-2 lg:grid-cols-4">
        {places.map(place => (
          <a href={place.href} class={linkCard}>
            <span class={`${cardTitle} text-[1.25rem] group-hover:text-accent-text`}>{place.label} →</span>
            <span class="text-[0.9rem] leading-[1.55] text-fg-muted">{place.text}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
  <script is:inline>
    // Older links point at the granola sheet on this page; it has its own page now.
    if (location.hash === "#granola-business-case") location.replace("/branding-plan/business-case");
  </script>
</> : <BrandingTeaser />}
</BaseLayout>
