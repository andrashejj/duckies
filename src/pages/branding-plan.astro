---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/plan.css";
import { site } from "../data/site";

const title = `From Tamarin to local surf communities everywhere | ${site.name}`;
const description =
  "A plan to build the Sunset Duckies brand, test its product and community model in Tamarin, and produce an evidence-backed global rollout plan by February 2027.";

const goals = [
  {
    code: "G-01",
    context: "Product",
    name: "A product with a reason to exist",
    text: "Choose something people will pay for because it is good. Prove the customer problem, quality standard, maker route and price in Tamarin.",
  },
  {
    code: "G-02",
    context: "Local ownership",
    name: "A community that can run without us",
    text: "Define the local roles, decisions, assets and routines, then show how Sunset Duckies steps back without the activity or relationships collapsing.",
  },
  {
    code: "G-03",
    context: "Value",
    name: "Decide how value moves",
    text: "Compare local paid work, a contribution per sale, revenue share, a shared fund and hybrids. Choose the model after the product economics and community needs are known.",
  },
  {
    code: "G-04",
    context: "Brand",
    name: "A model another place can use",
    text: "By February 2027, turn the Tamarin evidence into a rollout plan covering readiness, start-up support, handover, brand rules, economics and the ongoing relationship.",
  },
];

const communityStages = [
  {
    name: "Meet the community",
    accent: "sticker-teal",
    emoji: "🎯",
    text: "Start with an existing local group, a trusted local lead, a real place and a reason to gather. Sunset Duckies does not arrive with a ready-made club.",
  },
  {
    name: "Start something together",
    accent: "sticker-sun",
    emoji: "🛠️",
    text: "Agree the first useful activity, product or event with the people who will run it. Set roles, safeguarding, money, credit and what Sunset Duckies supplies.",
  },
  {
    name: "Hand over the work",
    accent: "sticker-pink",
    emoji: "🌊",
    text: "Move the schedule, decisions, relationships, assets, accounts and approvals to local hands. Handover starts at the beginning, not after dependency has formed.",
  },
  {
    name: "Stay connected",
    accent: "sticker-coral",
    emoji: "🤝",
    text: "The community keeps its name, people and voice while using the shared brand rules. The wider network shares products, learning and proof without centralising local decisions.",
  },
];

const problem = [
  {
    title: "A real place to learn",
    text: "Tamarin already has kids, families, coaches, surf sessions, relationships and access problems. The concept starts with reality rather than a brand workshop.",
  },
  {
    title: "Products carry the brand",
    text: "High-quality products can create paid local work, reach buyers outside the community and make the people and place behind them visible.",
  },
  {
    title: "The test is whether it travels",
    text: "Mauritius proves the first version. The useful result is a model another local surf community can adapt, own and sustain without becoming a Sunset Duckies franchise.",
  },
];

const octoberDeliverables = [
  {
    code: "D-01",
    name: "Tamarin baseline",
    context: "What exists now",
    text: "The people, routines, assets, costs, product needs and dependencies that already shape the first community.",
  },
  {
    code: "D-02",
    name: "Chosen hypotheses",
    context: "What to test",
    text: "A product direction, maker route, community lifecycle and value model selected for testing, with rejected options and open assumptions recorded.",
  },
  {
    code: "D-03",
    name: "Pilot delivery plan",
    context: "November to February",
    text: "Monthly milestones, owners, budget, product tests, community work, decision gates and the evidence expected by February 2027.",
  },
  {
    code: "D-04",
    name: "Approval to continue",
    context: "31 October gate",
    text: "A clear recommendation on what to build in Tamarin, what it will cost and which assumptions could still stop or change the work.",
  },
];

const pilotOutcomes = [
  {
    code: "P-01",
    name: "A product tested in the market",
    context: "Product proof",
    text: "At least one real product run tested for quality, demand, price, repeat interest, production reliability and customer response.",
  },
  {
    code: "P-02",
    name: "A Tamarin model that works",
    context: "Community proof",
    text: "Evidence of what local people can own and run, what Sunset Duckies still needs to provide and where handover does or does not work.",
  },
  {
    code: "P-03",
    name: "Economics and standards",
    context: "Brand proof",
    text: "Actual product economics, local paid work, central costs, quality rules, safeguards and environmental claims supported by the pilot.",
  },
  {
    code: "P-04",
    name: "A global rollout plan",
    context: "Next communities",
    text: "Where to go next, how to choose a community, how to start and hand over, what support and budget are required, and what every new place must measure.",
  },
];

const steps = [
  {
    date: "28 Aug – 7 Sep",
    emoji: "🗣️",
    accent: "sticker-teal",
    status: "now",
    title: "Document how Tamarin works now",
    text: "Show the people, relationships, routines and assets that already make the first community real, including where it still depends on outside help.",
    tasks: [
      "Collect the parent questionnaires and kid conversations.",
      "Map the kids, families, coaches, local leads, makers, places, activities and existing responsibilities.",
      "Record which decisions and tasks already sit locally and which still rely on Sunset Duckies or one individual.",
      "Record the product and access problems families and coaches see, without assuming how product money should solve them.",
      "Map Mauritian kitchens, textile makers, printers, shapers and other relevant producers, including their limits.",
    ],
    links: [
      { label: "Questions for parents", file: "/templates/brand-parent-questionnaire.html" },
      { label: "Talking to the kids", file: "/templates/brand-kid-conversations.html" },
    ],
  },
  {
    date: "8 – 21 Sep",
    emoji: "📚",
    accent: "sticker-teal",
    title: "Design the community lifecycle",
    text: "Define what Sunset Duckies does from first contact to handover, and what a local community must bring and own.",
    tasks: [
      "Read “Let My People Go Surfing” and “The Future of the Responsible Company,” then keep the product and responsibility rules that apply here.",
      "Write the readiness test for a new microcommunity: local lead, real group, safe place, time, trust and a reason to start.",
      "Define what Sunset Duckies may supply at the start and what the local community supplies from day one.",
      "Separate shared brand decisions from local decisions about people, activities, stories, money and approvals.",
      "List the roles, assets, accounts, knowledge and relationships that must move into local hands.",
      "Define what staying connected means after handover, without turning the community into a centrally managed chapter.",
    ],
    links: [
      { label: "Brand and community model", file: "/templates/brand-concept.html" },
    ],
  },
  {
    date: "22 Sep – 12 Oct",
    emoji: "⚖️",
    accent: "sticker-pink",
    title: "Test the product and value options in Tamarin",
    text: "Use the proof community to test what people want, what can be made and how value could stay local or support the wider model.",
    tasks: [
      "Turn the four product directions into specific candidates and test them with kids, parents and buyers outside the community.",
      "Confirm what local makers can produce, at what quality, volume, cost and level of ownership.",
      "Compare paid local work, a fixed contribution, revenue share, a shared fund and hybrid value models using the same unit economics.",
      "Record who carries stock, compliance and financial risk under each option.",
      "Show the community model to people from another local surf community and record what would not translate.",
    ],
    links: [
      { label: "Product candidates", file: "/product-ideas" },
      { label: "Questions for parents", file: "/templates/brand-parent-questionnaire.html" },
      { label: "Talking to the kids", file: "/templates/brand-kid-conversations.html" },
    ],
  },
  {
    date: "13 – 26 Oct",
    emoji: "🧪",
    accent: "sticker-coral",
    title: "Build the proof-of-concept package",
    text: "Turn the Tamarin learning into a product direction, a handover model and a brand system another place can challenge.",
    tasks: [
      "Choose the product direction or next product experiment and document the quality, maker and demand evidence behind it.",
      "Walk through the handover with the Tamarin leads and remove work they cannot or should not own.",
      "Write the playbook for meeting, starting with, handing over to and staying connected with a microcommunity.",
      "Set the shared brand rules and the space each community keeps for its own name, voice, people and products.",
      "Test whether the financial, social, operational and environmental parts can continue after central support steps back.",
    ],
    links: [
      { label: "Product clarity check", file: "/templates/brand-stranger-test.html" },
    ],
  },
  {
    date: "27 – 31 Oct",
    emoji: "📋",
    accent: "sticker-lilac",
    title: "Approve the Tamarin pilot",
    text: "Choose what to build and test from November to February, then give the work an owner, budget and decision gates.",
    tasks: [
      "Present the Tamarin baseline and every assumption the exploration has not resolved.",
      "Choose the product direction, maker route, community model and value option to test in the pilot.",
      "Set the product, community, financial and handover evidence required by February.",
      "Approve the monthly plan, owners, budget, safeguards and decisions that could change or stop the pilot.",
    ],
    links: [],
  },
];

const pilotSteps = [
  {
    date: "November 2026",
    title: "Build the Tamarin pilot",
    text: "Turn the October decisions into something people can use, buy and run.",
    tasks: [
      "Set the product specification, quality tests, price, production route and first-run budget.",
      "Agree paid work, credit, approvals and risk with local makers and contributors.",
      "Set the Tamarin roles, baseline measures and the responsibilities to hand over during the pilot.",
      "Build and test prototypes before committing to the first run.",
    ],
  },
  {
    date: "Dec 2026 – Jan 2027",
    title: "Run the first live test",
    text: "Put the product and community model into real use in Tamarin and record what happens.",
    tasks: [
      "Produce and release the first run without using the club story to excuse a weak product.",
      "Track quality, demand, price objections, repeat interest, returns, production problems and actual unit economics.",
      "Track who does the local work, who makes decisions and where the pilot still depends on central help.",
      "Review the evidence monthly and change the product or operating model when the facts require it.",
    ],
  },
  {
    date: "February 2027",
    title: "Decide what is ready to travel",
    text: "Use the live test to improve the model, test the handover and write the global rollout plan.",
    tasks: [
      "Revise the product, production process, price or value model using the first-run evidence.",
      "Move the agreed roles, assets, accounts, approvals and relationships to the Tamarin leads.",
      "Challenge the model with people from at least two potential communities outside Mauritius.",
      "Set the community readiness test, first 90 days, local roles, handover test and ongoing brand relationship.",
      "Set the shared brand rules, product standards, safeguards, data, credit, economics and measures required everywhere.",
      "Recommend the next community, sequence, team, budget and decisions needed to begin rollout.",
    ],
  },
];

const kit = [
  {
    emoji: "🧭",
    title: "Brand and community model",
    phase: "Estelle",
    file: "/templates/brand-concept.html",
    window: "Opens 8 Sep",
    desc: "What Tamarin proves, how a microcommunity starts, what gets handed over, what stays shared and how value could move.",
  },
  {
    emoji: "✏️",
    title: "Product concept sheet",
    phase: "Estelle",
    file: "/templates/brand-direction-sheet.html",
    window: "Opens 15 Sep",
    desc: "One sheet per candidate: customer, product, maker route, useful life or shelf life, price, community value options and testing.",
  },
  {
    emoji: "💬",
    title: "Questions for parents",
    phase: "Families",
    file: "/templates/brand-parent-questionnaire.html",
    open: true,
    window: "Open now · closes 7 Sep",
    now: "Every founding family fills one in. Parts 1 and 2 now, part 3 once the four candidates are worked up.",
    desc: "What families buy, use and replace, what keeps them out of the water, and what they would pay for.",
  },
  {
    emoji: "🏄",
    title: "Talking to the kids",
    phase: "Coaches",
    file: "/templates/brand-kid-conversations.html",
    open: true,
    window: "Open now · closes 7 Sep",
    now: "Coaches run these at training, one child at a time. Sections 1 and 2 now, the candidates later.",
    desc: "What kids use, avoid and want to be seen with, then their verdict on the four candidates.",
  },
  {
    emoji: "⏱️",
    title: "Product clarity check",
    phase: "Testing",
    file: "/templates/brand-stranger-test.html",
    window: "Opens 13 Oct",
    desc: "Does a buyer outside Tamarin understand the product, price, maker, community connection and claims without a sales pitch?",
  },
  {
    emoji: "📸",
    title: "Photo permission",
    phase: "Families",
    file: "/templates/brand-photo-permission.html",
    open: true,
    window: "Open now · closes 7 Sep",
    now: "Signed once per child, before any photo or video is used. Needed before product testing.",
    desc: "Where each child may appear in product work and club communications.",
  },
];

const openNow = kit.filter((item) => item.open);
---

<BaseLayout title={title} description={description} variant="performance">
  <div class="performance-plan">
    <section class="plan-hero">
      <figure class="plan-hero-media" data-float>
        <img
          src="/media/young-rider.jpg"
          alt="A young surfer riding a wave at sunset in Tamarin"
          width="1200"
          height="1600"
          loading="eager"
        />
        <figcaption>Tamarin · Mauritius · First proof community</figcaption>
      </figure>

      <div class="plan-hero-panel" data-float>
        <div class="plan-hero-topline">
          <span>Sunset Duckies / Community and product model</span>
          <span>Proof programme / Aug 2026 – Feb 2027</span>
        </div>

        <div class="plan-hero-content">
          <p class="plan-overline">Project brief</p>
          <h1>Prove it here. <span>Make it work anywhere.</span></h1>
          <p class="plan-hero-lead">
            Build the brand and test it in Tamarin. The first exploration ends on 31 October
            2026. The live pilot and global rollout plan are due by the end of February 2027.
          </p>
          <p class="plan-hero-copy">
            October produces the plan for the next four months. By February, Sunset Duckies
            needs real product, community and financial evidence from Tamarin, plus a practical
            plan for taking the model to the next communities.
          </p>
        </div>

        <div class="plan-hero-data" aria-label="Project facts">
          <div><strong>01</strong><span>Proof community</span></div>
          <div><strong>31.10</strong><span>Exploration gate</span></div>
          <div><strong>02.27</strong><span>Global rollout plan</span></div>
        </div>
      </div>
    </section>

    <nav class="plan-index" aria-label="Project brief sections">
      <a href="#problem"><span>01</span> Proof of concept</a>
      <a href="#goals"><span>02</span> The brief</a>
      <a href="#product-standard"><span>03</span> Community model</a>
      <a href="#assessment"><span>04</span> To 31 October</a>
      <a href="#pilot"><span>05</span> To February 2027</a>
      <a href="#working-documents"><span>06</span> The outputs</a>
    </nav>

    <section id="problem" class="plan-section plan-problem-section" data-reveal>
      <div class="plan-section-head">
        <p class="plan-overline">01 / Proof of concept</p>
        <h2>Tamarin is the first proof, not the limit.</h2>
        <p>
          Build with one real community, record what happens and turn the useful parts into a
          model. Another place should be able to adapt it without pretending to be Mauritius.
        </p>
      </div>

      <div class="plan-three-grid">
        {
          problem.map((item, i) => (
            <article class="plan-info-card">
              <span class="plan-info-number">0{i + 1}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>

      <p class="plan-note">
        The product has to stand up without the story attached. The community model has to
        stand up after Sunset Duckies steps back. Tamarin is where both claims get tested.
      </p>
    </section>

    <div class="plan-divider" aria-hidden="true"></div>

    <section id="goals" class="plan-section plan-category-section" data-reveal>
      <div class="plan-section-head">
        <p class="plan-overline">02 / The brief</p>
        <h2>Answer four questions.</h2>
        <p>
          Product tests, maker quotes, role handovers, community decisions and a challenge from
          another place count as evidence. A polished global concept does not.
        </p>
      </div>

      <div class="plan-category-grid">
        {goals.map((goal) => (
          <article class="plan-category-card">
            <div class="plan-card-code"><span>{goal.code}</span><span>{goal.context}</span></div>
            <h3>{goal.name}</h3>
            <p>{goal.text}</p>
            <span class="plan-card-line" aria-hidden="true"></span>
          </article>
        ))}
      </div>

      <a class="plan-jump" href="/product-ideas">
        <span class="plan-jump-label">Product thread</span>
        <span class="plan-jump-title">The four product candidates being tested in Tamarin</span>
        <span class="plan-jump-cta">Open the product work <span aria-hidden="true">→</span></span>
      </a>
    </section>

  <div class="plan-divider" aria-hidden="true"></div>

  <section id="product-standard" class="plan-section plan-standard-section" data-reveal>
    <div class="plan-section-head">
      <p class="plan-overline">03 / Community lifecycle</p>
      <h2>Start locally. Hand over deliberately.</h2>
      <p>
        Sunset Duckies brings a shared name, product and brand tools, learning and initial
        support. Local people keep authority over their community, relationships and voice.
      </p>
    </div>

    <div class="plan-category-grid plan-principles-grid">
      {
        communityStages.map((stage, i) => (
          <article class="plan-info-card plan-principle-card">
            <span class="plan-info-number">C-0{i + 1}</span>
            <h3>{stage.name}</h3>
            <p>{stage.text}</p>
          </article>
        ))
      }
    </div>

    <p class="plan-note">
      Sustainability means the local group can keep going, the central brand can afford its
      role, makers and contributors are paid fairly, and products meet a quality and environmental
      standard. The assessment has to show how each part works, not label the model sustainable.
    </p>
  </section>

  <div class="plan-divider" aria-hidden="true"></div>

  <section id="assessment" class="plan-section plan-assessment-section" data-reveal>
      <div class="plan-section-head">
        <p class="plan-overline">04 / Initial exploration</p>
        <h2>Five phases to the 31 October plan.</h2>
        <p>
        This work chooses what Sunset Duckies will build and test. It does not claim that the
        product, handover or global model has already been proven.
      </p>
    </div>

    <div class="plan-open-now">
      <div class="plan-open-head">
        <p class="plan-overline">Open now · closes 7 September</p>
        <h3>Three sheets are collecting answers this week.</h3>
        <p>
          Everything after this phase is built on what they say. They close with the first
          phase on 7 September. Fill them in on a phone, or print them.
        </p>
      </div>

      <div class="plan-open-grid">
        {
          openNow.map((item) => (
            <a href={item.file} target="_blank" rel="noreferrer" class="plan-open-card">
              <span class="plan-open-tag">{item.phase}</span>
              <h4>{item.title}</h4>
              <p>{item.now}</p>
              <span class="plan-open-cta">Open sheet ↗</span>
            </a>
          ))
        }
      </div>
    </div>

    <ol class="plan-timeline">
      {
        steps.map((step, index) => (
          <li class:list={["plan-step", step.status === "now" && "is-current"]}>
            <div class="plan-step-rail">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <time>{step.date}</time>
              {step.status === "now" && <em>Current phase</em>}
            </div>
            <div class="plan-step-body">
              <h3>{step.title}</h3>
              <p class="plan-step-intro">{step.text}</p>
              <ul>
                {step.tasks.map((task) => <li>{task}</li>)}
              </ul>
              {step.links.length > 0 && (
                <div class="plan-step-links">
                  {step.links.map((link) => (
                    <a href={link.file} target="_blank" rel="noreferrer">
                      {link.label} <span aria-hidden="true">↗</span>
                    </a>
                  ))}
                </div>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <div class="plan-divider" aria-hidden="true"></div>

  <section id="pilot" class="plan-section plan-assessment-section" data-reveal>
    <div class="plan-section-head">
      <p class="plan-overline">05 / Build and test in Tamarin</p>
      <h2>Four months from plan to proof.</h2>
      <p>
        The October gate starts the pilot. From November 2026 to February 2027, the team builds
        the product, tests the model in Tamarin, hands over real work and prepares the global rollout.
      </p>
    </div>

    <ol class="plan-timeline plan-pilot-timeline">
      {
        pilotSteps.map((step, index) => (
          <li class="plan-step">
            <div class="plan-step-rail">
              <span>P{String(index + 1).padStart(2, "0")}</span>
              <time>{step.date}</time>
            </div>
            <div class="plan-step-body">
              <h3>{step.title}</h3>
              <p class="plan-step-intro">{step.text}</p>
              <ul>
                {step.tasks.map((task) => <li>{task}</li>)}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <div class="plan-divider" aria-hidden="true"></div>

  <section id="working-documents" class="plan-section plan-documents-section" data-reveal>
    <div class="plan-section-head">
      <p class="plan-overline">06 / Decision gates</p>
      <h2>What each deadline must produce.</h2>
      <p>
        October approves a plan for the pilot. February decides whether the evidence is strong
        enough to take Sunset Duckies beyond Tamarin.
      </p>
    </div>

    <div class="plan-access">
      <div class="plan-access-head">
        <p class="plan-overline">31 October 2026</p>
        <h3>Exploration outputs</h3>
        <p>The team leaves the exploration with a specific, costed plan for November to February.</p>
      </div>
    </div>

    <div class="plan-category-grid">
      {octoberDeliverables.map((deliverable) => (
        <article class="plan-category-card">
          <div class="plan-card-code"><span>{deliverable.code}</span><span>{deliverable.context}</span></div>
          <h3>{deliverable.name}</h3>
          <p>{deliverable.text}</p>
          <span class="plan-card-line" aria-hidden="true"></span>
        </article>
      ))}
    </div>

    <div class="plan-access">
      <div class="plan-access-head">
        <p class="plan-overline">28 February 2027</p>
        <h3>Pilot outcomes</h3>
        <p>The team finishes with Tamarin evidence and a rollout plan another team can price and execute.</p>
      </div>
    </div>

    <div class="plan-category-grid">
      {pilotOutcomes.map((outcome) => (
        <article class="plan-category-card">
          <div class="plan-card-code"><span>{outcome.code}</span><span>{outcome.context}</span></div>
          <h3>{outcome.name}</h3>
          <p>{outcome.text}</p>
          <span class="plan-card-line" aria-hidden="true"></span>
        </article>
      ))}
    </div>

    <div class="plan-access">
      <div class="plan-access-head">
        <p class="plan-overline">Working documents</p>
        <h3>The evidence goes into these sheets.</h3>
        <p>
          The sheets work on a phone or printed. They support the decision pack; completing
          a sheet is not a result unless it contains evidence.
        </p>
      </div>
    </div>

    <div class="plan-document-grid">
      {
        kit.map((item, index) => (
          <a href={item.file} target="_blank" rel="noreferrer" class="plan-document-card">
            <div class="plan-document-meta">
              <span>DOC-{String(index + 1).padStart(2, "0")}</span>
              <span>{item.phase}</span>
            </div>
            <span class:list={["plan-document-window", item.open && "is-open"]}>{item.window}</span>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
            <span class="plan-document-open">Open document ↗</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="plan-decision" data-reveal>
    <img
      src="/media/board-lineup.jpg"
      alt="Young surfers and their boards gathered on the beach at sunset"
      width="1600"
      height="1067"
      loading="lazy"
    />
    <div class="plan-decision-overlay">
      <p class="plan-overline">Pilot gate / 28 February 2027</p>
      <h2>What is ready to travel?</h2>
      <p>
        The global plan must show what Tamarin proved, what Sunset Duckies owns, what each local
        community controls, how a community starts and takes over, how the economics work, and
        what the next place still needs to prove.
      </p>
    </div>
  </section>
  </div>
</BaseLayout>
