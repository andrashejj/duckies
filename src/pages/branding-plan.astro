---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/plan.css";
import { site } from "../data/site";

const title = `The first Sunset Duckies product | ${site.name}`;
const description =
  "Choose and prove the first Sunset Duckies product by 31 October: customer demand, product quality, local production, club contribution and a clear pilot decision.";

const goals = [
  {
    code: "G-01",
    context: "Demand",
    name: "A product people choose",
    text: "Name the buyer and the problem. Test the product and price with kids, parents and people outside the club. Record refusals as well as interest.",
  },
  {
    code: "G-02",
    context: "Production",
    name: "A credible way to make it",
    text: "Find a Mauritian maker or production route, state what must be imported, and record cost, capacity, timing, quality control, payment and credit.",
  },
  {
    code: "G-03",
    context: "Club return",
    name: "A number we can publish",
    text: "Set the contribution per sale, calculate what a realistic first year could fund, and show customers what the club received and bought.",
  },
  {
    code: "G-04",
    context: "Brand",
    name: "Rules for what comes next",
    text: "Define what every Sunset Duckies product must earn, how makers and clubs are credited, and what the brand will refuse to sell or claim.",
  },
];

const principles = [
  {
    name: "A problem families have named",
    accent: "sticker-teal",
    emoji: "🎯",
    text: "The product must fix something families currently buy around, replace too often, cannot find or cannot afford.",
  },
  {
    name: "Quality with a test",
    accent: "sticker-sun",
    emoji: "🛠️",
    text: "Set the material, ingredient, fit, safety, useful-life or shelf-life tests before calling the product high quality.",
  },
  {
    name: "A visible club contribution",
    accent: "sticker-pink",
    emoji: "🌊",
    text: "Every sale carries a stated contribution. The product page shows the amount, its use and the record behind it.",
  },
  {
    name: "Local work described honestly",
    accent: "sticker-coral",
    emoji: "🤝",
    text: "Name the work done in Mauritius, the imported inputs, the maker, their role and how they are paid and credited.",
  },
];

const problem = [
  {
    title: "Two sources of money",
    text: `The club runs on ${site.membership.feeLabel} in dues and on sponsors who cover operations. Both work, and both have a ceiling.`,
  },
  {
    title: "Gear is the other gate",
    text: `Members bring their own ${site.membership.bringYourOwn.join(" and ")}. A family that cannot buy those cannot really join, whatever the fee says.`,
  },
  {
    title: "A third leg",
    text: "Something people buy because it is good, that also pays into the club. It only works if the product stands up without the cause attached.",
  },
];

const deliverables = [
  {
    code: "D-01",
    name: "Customer evidence",
    context: "Demand",
    text: "The buyer, the problem, family and kid feedback, reactions from people outside the club, the tested price and the reasons people said no.",
  },
  {
    code: "D-02",
    name: "Product and maker route",
    context: "Feasibility",
    text: "A sample or specification, quality requirements, a local maker or supplier route, quotes, minimum order, lead time, testing and compliance gaps.",
  },
  {
    code: "D-03",
    name: "Economics and impact",
    context: "Money",
    text: "Unit cost, shipping and duties, retail price, margin, fixed club contribution, a realistic first-year scenario and the reporting method.",
  },
  {
    code: "D-04",
    name: "Brand and pilot brief",
    context: "Next decision",
    text: "The brand promise, what Sunset Duckies will not do, how makers and the club are credited, and a pilot scope with owners, budget and dates.",
  },
];

const steps = [
  {
    date: "28 Aug – 7 Sep",
    emoji: "🗣️",
    accent: "sticker-teal",
    status: "now",
    title: "Find the problem and the people who can help make it",
    text: "Finish with a short list of customer problems, club costs and local production routes worth pursuing.",
    tasks: [
      "Collect the parent questionnaires and kid conversations.",
      "Record what families buy, replace, refuse, cannot find or cannot afford, and why.",
      "Ask coaches which product and access problems they see every week.",
      "Price the boards, wetsuits, sessions and events that more product income could fund.",
      "Map Mauritian kitchens, textile makers, printers, shapers and other relevant producers, including what they can and cannot do.",
    ],
    links: [
      { label: "Questions for parents", file: "/templates/brand-parent-questionnaire.html" },
      { label: "Talking to the kids", file: "/templates/brand-kid-conversations.html" },
    ],
  },
  {
    date: "8 – 21 Sep",
    emoji: "📚",
    accent: "sticker-teal",
    title: "Set the rules and make the candidates concrete",
    text: "Write one scorecard, then turn each product direction into something specific enough to test or reject.",
    tasks: [
      "Read “Let My People Go Surfing” and “The Future of the Responsible Company,” then keep the product and responsibility rules that apply here.",
      "Set the demand, quality, local-production, price, club-return and brand tests.",
      "Name one specific candidate in everyday wear, surf wear, surf gear and surf nutrition.",
      "Complete the same concept sheet for each candidate and talk to a relevant maker or supplier.",
      "Record initial cost, minimum order, lead time, compliance questions and every assumption still unsupported.",
      "Stop a candidate as soon as it fails a non-negotiable.",
    ],
    links: [
      { label: "Product candidates", file: "/product-ideas" },
      { label: "Product and purpose brief", file: "/templates/brand-concept.html" },
      { label: "Product concept sheet", file: "/templates/brand-direction-sheet.html" },
    ],
  },
  {
    date: "22 Sep – 12 Oct",
    emoji: "⚖️",
    accent: "sticker-pink",
    title: "Test the candidates and choose one",
    text: "The winner needs evidence from users, buyers, makers and the club, not the highest score on paper.",
    tasks: [
      "Show the same candidates and prices to kids, parents and likely buyers outside the club.",
      "Let kids handle, wear or taste something real wherever possible.",
      "Record orders, pre-orders, refusals and price objections.",
      "Confirm whether a local maker can meet the proposed product standard.",
      "Choose one candidate with Estelle, the coaches and founding families, then record why it won and why the others did not.",
    ],
    links: [
      { label: "Product candidates", file: "/product-ideas" },
      { label: "Questions for parents", file: "/templates/brand-parent-questionnaire.html" },
      { label: "Talking to the kids", file: "/templates/brand-kid-conversations.html" },
    ],
  },
  {
    date: "13 – 26 Oct",
    emoji: "🧪",
    accent: "sticker-coral",
    title: "Prove the winner can become a pilot",
    text: "Replace the remaining assumptions with a specification or sample, a maker route, quoted economics and buyer evidence.",
    tasks: [
      "Prepare a sample, reference product or detailed specification with pass and fail tests.",
      "Confirm the work done locally, imported inputs, maker payment and credit, minimum order, lead time and quality control.",
      "Build the unit economics from quotes and calculate what a conservative first year could fund.",
      "Write the brand promise and the claims the product has earned.",
      "Test the product, price and contribution with buyers outside the club.",
    ],
    links: [
      { label: "Product clarity check", file: "/templates/brand-stranger-test.html" },
    ],
  },
  {
    date: "27 – 31 Oct",
    emoji: "📋",
    accent: "sticker-lilac",
    title: "Decide: build, change or stop",
    text: "The decision pack shows what was learned, what remains risky and what a pilot would require.",
    tasks: [
      "Present the customer evidence and why the chosen product beat the alternatives.",
      "Present the product standard, maker route, local work, testing plan and open risks.",
      "Present the quoted economics, club contribution and first-year funding scenario.",
      "Set the brand promise, credit rules and claims allowed at launch.",
      "Recommend build, change or stop, with the pilot budget, owners and dates.",
    ],
    links: [],
  },
];

const kit = [
  {
    emoji: "🧭",
    title: "Product and purpose brief",
    phase: "Estelle",
    file: "/templates/brand-concept.html",
    window: "Opens 8 Sep",
    desc: "The customer, product standard, local-production goal, price, club contribution and brand rules.",
  },
  {
    emoji: "✏️",
    title: "Product concept sheet",
    phase: "Estelle",
    file: "/templates/brand-direction-sheet.html",
    window: "Opens 15 Sep",
    desc: "One sheet per candidate: customer, product, maker route, useful life or shelf life, price, club contribution and testing.",
  },
  {
    emoji: "💬",
    title: "Questions for parents",
    phase: "Families",
    file: "/templates/brand-parent-questionnaire.html",
    open: true,
    window: "Open now · closes 7 Sep",
    now: "Every founding family fills one in. Parts 1 and 2 now, part 3 once the four candidates are worked up.",
    desc: "What they have bought, what stopped getting used, what keeps families out of the club, and what they would pay for.",
  },
  {
    emoji: "🏄",
    title: "Talking to the kids",
    phase: "Coaches",
    file: "/templates/brand-kid-conversations.html",
    open: true,
    window: "Open now · closes 7 Sep",
    now: "Coaches run these at training, one child at a time. Sections 1 and 2 now, the candidates later.",
    desc: "What kids use, avoid and want to be seen with, then their verdict on the four candidates.",
  },
  {
    emoji: "⏱️",
    title: "Product clarity check",
    phase: "Testing",
    file: "/templates/brand-stranger-test.html",
    window: "Opens 13 Oct",
    desc: "Does a buyer outside the club get who it is for, why it costs what it costs and what the contribution buys?",
  },
  {
    emoji: "📸",
    title: "Photo permission",
    phase: "Families",
    file: "/templates/brand-photo-permission.html",
    open: true,
    window: "Open now · closes 7 Sep",
    now: "Signed once per child, before any photo or video is used. Needed before product testing.",
    desc: "Where each child may appear in product work and club communications.",
  },
];

const openNow = kit.filter((item) => item.open);
---

<BaseLayout title={title} description={description} variant="performance">
  <div class="performance-plan">
    <section class="plan-hero">
      <figure class="plan-hero-media" data-float>
        <img
          src="/media/young-rider.jpg"
          alt="A young surfer riding a wave at sunset in Tamarin"
          width="1200"
          height="1600"
          loading="eager"
        />
        <figcaption>Tamarin · Mauritius · Product and brand project</figcaption>
      </figure>

      <div class="plan-hero-panel" data-float>
        <div class="plan-hero-topline">
          <span>Sunset Duckies / Product development</span>
          <span>Assessment 2026</span>
        </div>

        <div class="plan-hero-content">
          <p class="plan-overline">Project brief</p>
          <h1>Choose and prove <span>the first product.</span></h1>
          <p class="plan-hero-lead">
            By 31 October, choose one product people will pay for, show how it can be made
            fairly in Mauritius, and prove what each sale can fund at the club.
          </p>
          <p class="plan-hero-copy">
            The outcome is a build, change or stop recommendation backed by customer evidence,
            a product standard, a maker route, quoted economics and a pilot plan. The current
            product directions are hypotheses.
          </p>
        </div>

        <div class="plan-hero-data" aria-label="Project facts">
          <div><strong>04</strong><span>Project goals</span></div>
          <div><strong>01</strong><span>First product</span></div>
          <div><strong>31.10</strong><span>Build / change / stop</span></div>
        </div>
      </div>
    </section>

    <nav class="plan-index" aria-label="Project brief sections">
      <a href="#problem"><span>01</span> The problem</a>
      <a href="#goals"><span>02</span> The brief</a>
      <a href="#product-standard"><span>03</span> Non-negotiables</a>
      <a href="#assessment"><span>04</span> The work</a>
      <a href="#working-documents"><span>05</span> The outputs</a>
    </nav>

    <section id="problem" class="plan-section plan-problem-section" data-reveal>
      <div class="plan-section-head">
        <p class="plan-overline">01 / The problem</p>
        <h2>Money decides who gets in the water.</h2>
        <p>
          Not talent, not interest. The club can only take the kids its funding and its
          spare boards can carry, and a product is one way to change that.
        </p>
      </div>

      <div class="plan-three-grid">
        {
          problem.map((item, i) => (
            <article class="plan-info-card">
              <span class="plan-info-number">0{i + 1}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>

      <p class="plan-note">
        The trap is obvious: a mediocre product with a good cause stapled to it. Nobody
        rebuys that. Whatever we make has to be worth buying on its own, and the money it
        sends back to the club has to be a number we publish rather than a feeling.
      </p>
    </section>

    <div class="plan-divider" aria-hidden="true"></div>

    <section id="goals" class="plan-section plan-category-section" data-reveal>
      <div class="plan-section-head">
        <p class="plan-overline">02 / The brief</p>
        <h2>Prove four things.</h2>
        <p>
          Interviews, product tests, maker conversations, quotes and orders count as evidence.
          A polished concept on its own does not.
        </p>
      </div>

      <div class="plan-category-grid">
        {goals.map((goal) => (
          <article class="plan-category-card">
            <div class="plan-card-code"><span>{goal.code}</span><span>{goal.context}</span></div>
            <h3>{goal.name}</h3>
            <p>{goal.text}</p>
            <span class="plan-card-line" aria-hidden="true"></span>
          </article>
        ))}
      </div>

      <a class="plan-jump" href="/product-ideas">
        <span class="plan-jump-label">Working hypotheses</span>
        <span class="plan-jump-title">The product directions being tested against these goals</span>
        <span class="plan-jump-cta">Open the candidate work <span aria-hidden="true">→</span></span>
      </a>
    </section>

  <div class="plan-divider" aria-hidden="true"></div>

  <section id="product-standard" class="plan-section plan-standard-section" data-reveal>
    <div class="plan-section-head">
      <p class="plan-overline">03 / Non-negotiables</p>
      <h2>What the product must earn.</h2>
      <p>
        Kids can reject the product. Buyers can reject the price. Makers can reject the
        production plan. The club can reject the funding promise or use of its identity.
      </p>
    </div>

    <div class="plan-category-grid plan-principles-grid">
      {
        principles.map((principle, i) => (
          <article class="plan-info-card plan-principle-card">
            <span class="plan-info-number">P-0{i + 1}</span>
            <h3>{principle.name}</h3>
            <p>{principle.text}</p>
          </article>
        ))
      }
    </div>

    <p class="plan-note">
      For food, quality means named ingredients, clear nutrition and a tested shelf life. For
      gear and clothing, it means materials, fit and construction tested against salt, sun and
      repeat use. The brief does not allow claims the product has not earned.
    </p>
  </section>

  <div class="plan-divider" aria-hidden="true"></div>

  <section id="assessment" class="plan-section plan-assessment-section" data-reveal>
    <div class="plan-section-head">
      <p class="plan-overline">04 / The work</p>
      <h2>Five phases to a decision.</h2>
      <p>
        Each phase closes with evidence or a clear reason to stop. Unsupported claims stay
        marked as assumptions in the final decision.
      </p>
    </div>

    <div class="plan-open-now">
      <div class="plan-open-head">
        <p class="plan-overline">Open now · closes 7 September</p>
        <h3>Three sheets are collecting answers this week.</h3>
        <p>
          Everything after this phase is built on what they say. They close with the first
          phase on 7 September. Fill them in on a phone, or print them.
        </p>
      </div>

      <div class="plan-open-grid">
        {
          openNow.map((item) => (
            <a href={item.file} target="_blank" rel="noreferrer" class="plan-open-card">
              <span class="plan-open-tag">{item.phase}</span>
              <h4>{item.title}</h4>
              <p>{item.now}</p>
              <span class="plan-open-cta">Open sheet ↗</span>
            </a>
          ))
        }
      </div>
    </div>

    <ol class="plan-timeline">
      {
        steps.map((step, index) => (
          <li class:list={["plan-step", step.status === "now" && "is-current"]}>
            <div class="plan-step-rail">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <time>{step.date}</time>
              {step.status === "now" && <em>Current phase</em>}
            </div>
            <div class="plan-step-body">
              <h3>{step.title}</h3>
              <p class="plan-step-intro">{step.text}</p>
              <ul>
                {step.tasks.map((task) => <li>{task}</li>)}
              </ul>
              {step.links.length > 0 && (
                <div class="plan-step-links">
                  {step.links.map((link) => (
                    <a href={link.file} target="_blank" rel="noreferrer">
                      {link.label} <span aria-hidden="true">↗</span>
                    </a>
                  ))}
                </div>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <div class="plan-divider" aria-hidden="true"></div>

  <section id="working-documents" class="plan-section plan-documents-section" data-reveal>
    <div class="plan-section-head">
      <p class="plan-overline">05 / Required outputs</p>
      <h2>What must exist by 31 October.</h2>
      <p>
        These are the decision pack. Missing evidence stays marked as a risk; it does not
        become a confident sentence in the final recommendation.
      </p>
    </div>

    <div class="plan-category-grid">
      {deliverables.map((deliverable) => (
        <article class="plan-category-card">
          <div class="plan-card-code"><span>{deliverable.code}</span><span>{deliverable.context}</span></div>
          <h3>{deliverable.name}</h3>
          <p>{deliverable.text}</p>
          <span class="plan-card-line" aria-hidden="true"></span>
        </article>
      ))}
    </div>

    <div class="plan-access">
      <div class="plan-access-head">
        <p class="plan-overline">Working documents</p>
        <h3>The evidence goes into these sheets.</h3>
        <p>
          The sheets work on a phone or printed. They support the decision pack; completing
          a sheet is not a result unless it contains evidence.
        </p>
      </div>
    </div>

    <div class="plan-document-grid">
      {
        kit.map((item, index) => (
          <a href={item.file} target="_blank" rel="noreferrer" class="plan-document-card">
            <div class="plan-document-meta">
              <span>DOC-{String(index + 1).padStart(2, "0")}</span>
              <span>{item.phase}</span>
            </div>
            <span class:list={["plan-document-window", item.open && "is-open"]}>{item.window}</span>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
            <span class="plan-document-open">Open document ↗</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="plan-decision" data-reveal>
    <img
      src="/media/board-lineup.jpg"
      alt="Young surfers and their boards gathered on the beach at sunset"
      width="1600"
      height="1067"
      loading="lazy"
    />
    <div class="plan-decision-overlay">
      <p class="plan-overline">Decision gate / 31 October</p>
      <h2>Build, change or stop?</h2>
      <p>
        The decision pack must show customer demand, a product that can meet its quality
        standard, a fair maker route, quoted economics, a fixed club contribution and a
        funded pilot plan. If the evidence holds, the club can approve pilot development.
        Otherwise the product changes or stops.
      </p>
    </div>
  </section>
  </div>
</BaseLayout>
