---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const title = `A product brand for surf families | ${site.name}`;
const description =
  "The plan for Sunset Duckies: premium, long-life surf products for growing kids and everyday surf families, with a contribution from every sale going back to the club.";

const audience = [
  {
    emoji: "🌱",
    title: "Kids who grow",
    accent: "sticker-teal",
    text: "Gear designed around changing bodies, regular use and the possibility of passing it on when a child outgrows it.",
  },
  {
    emoji: "🏄",
    title: "Mums and dads who surf",
    accent: "sticker-sun",
    text: "Reliable, good-looking products for family surf life: school mornings, weekend sessions, holidays and time in the water together.",
  },
  {
    emoji: "🤝",
    title: "The club around them",
    accent: "sticker-pink",
    text: "A close community that helps choose and test the products, then sees exactly what each product gives back to the club.",
  },
];

const principles = [
  {
    name: "Designed for growth",
    accent: "sticker-teal",
    emoji: "📏",
    text: "Use fit, adjustment and sizing carefully so a child gets more useful time from the product.",
  },
  {
    name: "Built for years",
    accent: "sticker-sun",
    emoji: "🛠️",
    text: "Choose materials and construction for salt, sun and repeat use. Repair and hand-me-down life are part of the brief.",
  },
  {
    name: "The club is in the price",
    accent: "sticker-pink",
    emoji: "🌊",
    text: "Every product includes a fixed, visible club contribution for equipment, sessions, events and other agreed club costs.",
  },
];

const steps = [
  {
    date: "August",
    emoji: "🗣️",
    accent: "sticker-teal",
    status: "now",
    title: "Find the first real product problem",
    text: "Look at their first six months in surfing, then ask how they expect their surfing and equipment needs to change over the next two years.",
    tasks: [
      "Ask parents which surf products they bought during their child's first six months, what gets used every session and what already stays at home.",
      "Record anything that has already stopped fitting, broken, become uncomfortable or been replaced, and why.",
      "Ask what is hard about buying for growing kids: fit, comfort, durability, style, price, availability or something else.",
      "Ask families what they expect the next two years to bring: more sessions, bigger waves, changing bodies, more independence, travel or different equipment.",
      "List what they think they will buy or replace during those two years under three headings: everyday wear, surf wear and surf gear.",
      "Ask which item in each category they hope could last through most of that change.",
      "Talk to the kids about the gear they reach for, the gear they avoid and what they would be proud to wear or use.",
      "Ask coaches which product problems they see repeatedly at training.",
      "List the club costs a product contribution could pay for, including shared gear, sessions and events.",
    ],
    links: [
      { label: "Questions for parents", file: "/templates/brand-parent-questionnaire.html" },
      { label: "Talking to the kids", file: "/templates/brand-kid-conversations.html" },
    ],
  },
  {
    date: "By 6 Sep",
    emoji: "📚",
    accent: "sticker-teal",
    title: "Read, compare and write down the rules",
    text: "Turn the research into a short product and purpose brief for Sunset Duckies.",
    tasks: [
      "Read “Let My People Go Surfing” by Yvon Chouinard and note what it says about product quality, culture and responsibility.",
      "Read “The Future of the Responsible Company” by Yvon Chouinard and Vincent Stanley and note its tests for a legitimate, long-life product and a responsible supply chain.",
      "Review premium everyday wear, surf wear and surf gear for growing children and family surfers. Record materials, sizing, useful life, repair options and prices.",
      "Compare the three categories on frequency of use, growth problems, production difficulty, likely price and the amount a sale could return to the club.",
      "Look at purpose-led product companies and record how they explain where the money goes.",
      "Write one page of Sunset Duckies rules covering quality, useful life, customer, club contribution and community accountability.",
    ],
    links: [],
  },
  {
    date: "By 20 Sep",
    emoji: "✏️",
    accent: "sticker-sun",
    title: "Make one rough concept in each category",
    text: "Compare everyday wear, surf wear and surf gear before choosing where Sunset Duckies should start.",
    tasks: [
      "Complete the product and purpose brief with the customer, the problem and the promise to the club.",
      "Make one everyday-wear concept, using the item families name most often.",
      "Make one surf-wear concept, such as a long-life lycra if the research supports it.",
      "Make one surf-gear concept, such as a durable first surfboard if the research supports it.",
      "Fill in the same product concept sheet for all three categories.",
      "For every concept, define the user, use case, fit or growth idea, materials, expected life, repair or pass-on plan and product look.",
      "Add a provisional retail price, product cost, margin and fixed club contribution. Mark every number that still needs a supplier quote.",
      "Show all three at the same rough level, with enough visual detail for kids and parents to react to them.",
    ],
    links: [
      { label: "Product and purpose brief", file: "/templates/brand-concept.html" },
      { label: "Product concept sheet", file: "/templates/brand-direction-sheet.html" },
    ],
  },
  {
    date: "21 Sep – 4 Oct",
    emoji: "🏄",
    accent: "sticker-pink",
    title: "Choose the product with families",
    text: "Put the three concepts in front of the people who would buy and use them.",
    tasks: [
      "Show the same three concepts to parents in WhatsApp and at training.",
      "Ask which category fits their next two years, which product they need, what they would expect at the proposed price and what would stop them buying it.",
      "Explain the club contribution as a separate number and ask whether the use of that money feels clear and worthwhile.",
      "Let kids handle comparable products or samples. Record reactions to fit, comfort, look and whether they would choose to use it.",
      "Compare answers from younger kids, older kids and parents instead of averaging them together.",
      "Choose one product with Estelle, the coaches and founding families, then write down the evidence and the remaining risks.",
    ],
    links: [
      { label: "Questions for parents", file: "/templates/brand-parent-questionnaire.html" },
      { label: "Talking to the kids", file: "/templates/brand-kid-conversations.html" },
    ],
  },
  {
    date: "5 Oct – 1 Nov",
    emoji: "🧪",
    accent: "sticker-coral",
    title: "Check whether the first product can work",
    text: "Test the product, price and contribution far enough to make an honest implementation decision.",
    tasks: [
      "Prepare a sample, sourced reference product or detailed prototype specification for the chosen concept.",
      "Get supplier conversations or quotes for materials, sampling, minimum order, production time, packaging and delivery.",
      "Test fit, comfort and use with the club. Define what durability testing will be required during implementation.",
      "Build provisional unit economics showing product cost, shipping, duties, margin, retail price and the club contribution.",
      "Write the one-sentence explanation customers will see: how much goes to the club, what it can fund and how Sunset Duckies will report it.",
      "Show the product and price to likely buyers outside the founding families and record purchase or pre-order interest without treating likes as demand.",
    ],
    links: [
      { label: "Product clarity check", file: "/templates/brand-stranger-test.html" },
    ],
  },
  {
    date: "1 Nov",
    emoji: "📋",
    accent: "sticker-lilac",
    title: "Complete the initial assessment",
    text: "Decide whether there is a credible first product and define the work required to make it properly.",
    tasks: [
      "Name the chosen category and first product, the customer problem it solves and the evidence behind the choice.",
      "Set the quality, fit, growth, useful-life, repair and pass-on requirements.",
      "Summarise supplier feasibility, open production risks and the testing still required.",
      "Present the provisional price, costs, margin and club contribution, with assumptions clearly marked.",
      "Summarise family feedback and outside purchase interest.",
      "Recommend whether to implement, change direction or stop, then set the proposed scope, owners, budget and dates.",
    ],
    links: [],
  },
  {
    date: "After 1 Nov",
    emoji: "🛠️",
    accent: "sticker-teal",
    title: "Develop, test and launch the first product",
    text: "Implementation begins after the club approves the assessment and its budget.",
    tasks: [
      "Develop supplier samples and revise the materials, construction, fit and design.",
      "Run real wear and durability tests with kids and parents, fix failures and repeat until the product meets the brief.",
      "Confirm production, minimum order, quality control, delivery, returns, repair and pass-on arrangements.",
      "Finish the identity, packaging, product page and customer explanation of the club contribution.",
      "Set up a simple record showing money collected, money transferred and what the club used it for.",
      "Make a limited first production run and launch it through the core Tamarin community.",
      "Review product quality, sell-through, returns and club impact before choosing the next product or another local club.",
    ],
    links: [],
  },
];

const kit = [
  {
    emoji: "🧭",
    title: "Product and purpose brief",
    phase: "Estelle",
    file: "/templates/brand-concept.html",
    desc: "Defines the family we are building for, the product standard, the reason for the premium price and the promise to the club.",
  },
  {
    emoji: "✏️",
    title: "Product concept sheet",
    phase: "Estelle",
    file: "/templates/brand-direction-sheet.html",
    desc: "The same practical sheet for an everyday-wear, surf-wear and surf-gear idea: use, fit, useful life, price, club contribution and testing.",
  },
  {
    emoji: "💬",
    title: "Questions for parents",
    phase: "Families",
    file: "/templates/brand-parent-questionnaire.html",
    desc: "Covers their first six months in surfing, the changes they expect over the next two years and what they want from a premium product that funds the club.",
  },
  {
    emoji: "🏄",
    title: "Talking to the kids",
    phase: "Coaches",
    file: "/templates/brand-kid-conversations.html",
    desc: "A run sheet for learning which gear kids use, avoid and want to be seen with, then testing product concepts with them.",
  },
  {
    emoji: "⏱️",
    title: "Product clarity check",
    phase: "Testing",
    file: "/templates/brand-stranger-test.html",
    desc: "Checks whether an outside buyer understands who the product is for, why it costs more and what the club contribution does.",
  },
  {
    emoji: "📸",
    title: "Photo permission",
    phase: "Families",
    file: "/templates/brand-photo-permission.html",
    desc: "A clear record of whether and where each child may appear in product development and Sunset Duckies communications.",
  },
];
---

<BaseLayout title={title} description={description}>
  <section class="relative mx-auto max-w-7xl px-6 pb-10 pt-14 lg:px-10">
    <div class="surface-card p-8 md:p-12" data-float>
      <div class="flex flex-wrap items-center gap-3">
        <p class="section-kicker">Better surf products for families</p>
        <span class="tag-pill lilac">Initial assessment · August–1 November 2026</span>
        <span class="tag-pill">Product development follows</span>
      </div>
      <h1
        class="section-title mt-6 max-w-4xl"
        style="font-size: clamp(2.4rem, 5.5vw, 4.6rem); line-height: 0.95;"
      >
        Products for
        <span class="font-accent italic" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">kids who grow</span>.
      </h1>
      <p class="body-copy mt-6 max-w-3xl">
        Sunset Duckies wants to build high-quality surf products for children and the mums
        and dads who surf with them. The first decision is where to start: everyday wear they
        can use anywhere, surf wear they use in the water, or surf gear such as a board. In
        every category, the product should look good, work hard and stay useful for as long as
        possible.
      </p>
      <p class="body-copy mt-4 max-w-3xl">
        The price will reflect the materials, construction, testing and a fixed contribution
        to the club. That contribution should be visible when someone buys the product. It can
        help pay for shared boards and gear, regular sessions, events and other costs agreed by
        the club.
      </p>
      <p class="body-copy mt-4 max-w-3xl">
        Tamarin is the starting community. The kids and parents help decide what is worth
        making, test it in real surf life and see where the club money goes. If that works,
        Sunset Duckies has the foundation for a global product brand built from strong local
        surf communities.
      </p>
    </div>
  </section>

  <section class="relative mx-auto max-w-7xl px-6 py-10 lg:px-10" data-reveal>
    <p class="section-kicker">Who we are building for</p>
    <h2 class="section-title mt-5" style="font-size: clamp(1.8rem, 3.4vw, 2.8rem);">
      Everyday surf life,
      <span class="font-accent italic" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">made better</span>.
    </h2>

    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {
        audience.map((item, i) => (
          <div class:list={["surface-card p-6", item.accent, i === 0 ? "tilt-left" : i === 2 ? "tilt-right" : ""]}>
            <span class="text-3xl" aria-hidden="true">{item.emoji}</span>
            <h3 class="mt-3 text-xl font-bold text-[var(--color-ink-950)]" style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;">
              {item.title}
            </h3>
            <p class="body-copy mt-2 text-sm">{item.text}</p>
          </div>
        ))
      }
    </div>

    <p class="body-copy mt-8 max-w-3xl text-sm">
      The customer is the child learning to surf, the parent fitting in a morning session and
      the family buying gear that has to survive sun, salt, sand and hand-me-down life. The
      product has to earn a premium price through its quality and usefulness.
      Competition-performance gear sits outside this first brief.
    </p>
  </section>

  <div class="wave-divider mx-auto max-w-7xl px-6"></div>

  <section class="relative mx-auto max-w-7xl px-6 py-10 lg:px-10" data-reveal>
    <p class="section-kicker">The product rules</p>
    <h2 class="section-title mt-5" style="font-size: clamp(1.8rem, 3.4vw, 2.8rem);">
      Purpose has to show up in
      <span class="font-accent italic" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">the product</span>.
    </h2>
    <p class="body-copy mt-4 max-w-3xl text-sm">
      Two books are working references for the assessment:
      <a class="font-bold underline decoration-[var(--color-coral-500)] decoration-2 underline-offset-2" href="https://www.patagonia.com/product/let-my-people-go-surfing-revised-paperback-book/BK067.html" target="_blank" rel="noreferrer">Let My People Go Surfing</a>
      and
      <a class="font-bold underline decoration-[var(--color-coral-500)] decoration-2 underline-offset-2" href="https://www.patagonia.com/product/the-future-of-the-responsible-company-paperback/BK235.html" target="_blank" rel="noreferrer">The Future of the Responsible Company</a>.
      Their useful challenge for Sunset Duckies is practical: make a legitimate product that
      lasts, understand how it is made, respect the people around the business and make the
      purpose part of how the company operates.
    </p>

    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {
        principles.map((principle, i) => (
          <div class:list={["surface-card p-6", principle.accent, i === 0 ? "tilt-left" : i === 2 ? "tilt-right" : ""]}>
            <span class="text-3xl" aria-hidden="true">{principle.emoji}</span>
            <h3 class="mt-3 text-2xl font-bold text-[var(--color-ink-950)]" style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;">
              {principle.name}
            </h3>
            <p class="body-copy mt-2 text-sm">{principle.text}</p>
          </div>
        ))
      }
    </div>

    <p class="body-copy mt-8 max-w-3xl text-sm">
      A premium price is a promise. The assessment has to define the materials, construction,
      useful life, testing and service that make the price fair. It also has to choose a clear
      club contribution, state what it funds and set up a simple way to report the money.
    </p>
  </section>

  <div class="wave-divider mx-auto max-w-7xl px-6"></div>

  <section class="relative mx-auto max-w-7xl px-6 py-10 lg:px-10" data-reveal>
    <p class="section-kicker">How the project works</p>
    <h2 class="section-title mt-5" style="font-size: clamp(1.8rem, 3.4vw, 2.8rem);">
      The
      <span class="font-accent italic" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">schedule</span>.
    </h2>
    <p class="body-copy mt-4 max-w-3xl text-sm">
      The work through 1 November is an assessment. It identifies the customer, chooses a
      first product, tests the price and contribution, and checks whether production looks
      credible. The approved product is developed, wear-tested and produced afterward.
    </p>

    <div class="relative mx-auto mt-10 max-w-3xl">
      <div class="absolute bottom-8 top-2 border-l-2 border-dashed border-[var(--color-ink-950)]/35" style="left: calc(1.5rem - 1px);" aria-hidden="true"></div>
      <ol class="space-y-6">
        {
          steps.map((step) => (
            <li class="relative grid grid-cols-[3rem_1fr] gap-4 sm:gap-6">
              <span
                class:list={[
                  "relative z-10 mt-1 inline-flex h-12 w-12 items-center justify-center rounded-full border-2 border-[var(--color-ink-950)] text-xl shadow-[3px_3px_0_0_var(--color-ink-950)]",
                  step.status === "now" ? "bg-[var(--color-coral-500)]" : "bg-[var(--color-sun-500)]",
                ]}
                aria-hidden="true"
              >
                {step.emoji}
              </span>
              <div class:list={["surface-card p-5 md:p-6", step.accent, step.status === "now" ? "dashed" : ""]}>
                <div class="flex flex-wrap items-center gap-2">
                  <span class="tag-pill sun">{step.date}</span>
                  {step.status === "now" && <span class="tag-pill pink">we are here</span>}
                </div>
                <h3 class="mt-3 text-xl font-bold text-[var(--color-ink-950)]" style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;">
                  {step.title}
                </h3>
                <p class="body-copy mt-1 text-sm">{step.text}</p>
                <ul class="mt-4 space-y-2">
                  {step.tasks.map((task) => (
                    <li class="flex items-start gap-3 text-sm leading-relaxed text-[var(--color-ink-950)]/80">
                      <span class="mt-[0.1rem] font-mono font-bold text-[var(--color-coral-500)]" aria-hidden="true">→</span>
                      <span>{task}</span>
                    </li>
                  ))}
                </ul>
                {step.links.length > 0 && (
                  <div class="mt-5 flex flex-wrap gap-2 border-t border-[var(--color-ink-950)]/15 pt-4">
                    {step.links.map((link) => (
                      <a href={link.file} target="_blank" rel="noreferrer" class="tag-pill transition hover:-translate-y-0.5 hover:bg-[var(--color-teal-500)]">
                        Open {link.label} ↗
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <div class="wave-divider mx-auto max-w-7xl px-6"></div>

  <section class="relative mx-auto max-w-7xl px-6 py-10 lg:px-10" data-reveal>
    <p class="section-kicker">The templates</p>
    <h2 class="section-title mt-5" style="font-size: clamp(1.8rem, 3.4vw, 2.8rem);">
      The documents we are
      <span class="font-accent italic" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">working with</span>.
    </h2>
    <p class="body-copy mt-4 max-w-3xl text-sm">
      These are working sheets, linked to the steps above. They collect the product decisions,
      family evidence, kid feedback and outside-buyer reactions needed for the assessment.
      They work on a phone and can also be printed.
    </p>

    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        kit.map((item) => (
          <a href={item.file} target="_blank" rel="noreferrer" class="surface-card group block p-6 transition hover:-translate-y-1">
            <div class="flex items-start justify-between gap-3">
              <span class="text-2xl" aria-hidden="true">{item.emoji}</span>
              <span class="tag-pill">{item.phase}</span>
            </div>
            <h3 class="mt-3 text-xl font-bold text-[var(--color-ink-950)] transition group-hover:text-[var(--color-coral-500)]" style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;">
              {item.title}
            </h3>
            <p class="body-copy mt-2 text-sm">{item.desc}</p>
            <p class="mt-4 font-mono text-xs font-bold uppercase tracking-[0.14em] text-[var(--color-coral-500)]">→ Open</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="relative mx-auto max-w-7xl px-6 pb-20 pt-6 lg:px-10" data-reveal>
    <div class="glass-panel p-8 md:p-12">
      <p class="eyebrow-badge">1 November · initial assessment</p>
      <h2 class="mt-6 max-w-3xl text-3xl font-bold leading-tight md:text-4xl" style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;">
        On 1 November, we decide whether the first product deserves to be made.
      </h2>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-[var(--color-cream)]/85">
        The assessment provides the product brief, family evidence, supplier picture, price,
        club contribution and implementation budget. Product development, wear testing,
        production and launch come next, after approval.
      </p>
    </div>
  </section>
</BaseLayout>
