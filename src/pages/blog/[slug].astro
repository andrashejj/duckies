---
import { site } from "../../data/site";
import { blog } from "../../data/blog";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LogbookIllustration from "../../components/LogbookIllustration.astro";
import LogbookGif from "../../components/LogbookGif.astro";
import Lightbox from "../../components/Lightbox.astro";
import Cta from "../../components/ui/Cta.astro";
import Kicker from "../../components/ui/Kicker.astro";
import SectionTitle from "../../components/ui/SectionTitle.astro";
import StickerCard from "../../components/ui/StickerCard.astro";
import Underline from "../../components/ui/Underline.astro";
import { bodyCopy, mediaFrame } from "../../lib/ui";
import {
  isVideo,
  loadShareFiles,
  sharePreviewUrl,
  shareDownloadUrl,
} from "../../lib/share-media";

export async function getStaticPaths() {
  return blog.posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;

const title = `${post.title} ${post.titleAccent} — ${blog.name} | ${site.name}`;
const description = post.excerpt;

// Enumerated from the Nextcloud share at build time (falls back to
// post.media.files if the share is unreachable from the build environment).
const mediaFiles = post.media ? await loadShareFiles(post.media) : [];
const imageFiles = mediaFiles.filter((file) => !isVideo(file));
const photos = imageFiles.map((file, i) => ({
  alt: `${post.title} ${post.titleAccent} — photo ${i + 1} of ${imageFiles.length}`,
  thumb: sharePreviewUrl(post.media!, file, 700),
  full: sharePreviewUrl(post.media!, file, 2048),
}));
const clips = (post.media?.imagesOnly ? [] : mediaFiles.filter(isVideo)).map((file) => ({
  src: shareDownloadUrl(post.media!, file),
  poster: sharePreviewUrl(post.media!, file, 1200),
}));

const heroImage = post.cover?.src ?? post.heroImage ?? photos[0]?.full;
const ogImage = heroImage ?? "/media/tamarin-shore.jpg";
---

<BaseLayout title={title} description={description} image={ogImage} imageAlt={post.cover?.alt ?? `${post.title} ${post.titleAccent}`} imageWidth={post.cover ? 1536 : undefined} imageHeight={post.cover ? 1024 : undefined}>
  <!-- ===================== HERO ===================== -->
  <article>
    <section class="mx-auto max-w-7xl px-4 py-[clamp(2.5rem,6vw,5rem)] sm:px-6 lg:px-10">
      <div class="grid items-center gap-10 lg:grid-cols-[0.85fr_1.15fr]">
        <div>
          <Kicker as="a" href="/blog" class="no-underline">← The Logbook</Kicker>
          <p class="mt-7 font-mono text-xs uppercase tracking-widest">{post.kicker}</p>
          <h1 class="mt-5 font-display text-[clamp(2.4rem,5.2vw,4.7rem)] font-[650] leading-[0.98] tracking-[-0.045em]">
            {post.title}
            <span class="mt-[0.12em] block font-accent italic text-accent-text">{post.titleAccent}</span>
          </h1>
          <p class={`mt-6 ${bodyCopy}`}>{post.excerpt}</p>
          <p class="mt-6 font-mono text-xs leading-6 uppercase tracking-wider">{post.dateLabel} · {post.location}</p>
          {post.media && <Cta variant="secondary" href="#gallery" class="mt-6">↓ The trip, in photos</Cta>}
        </div>
        {post.cover ? <LogbookIllustration image={post.cover} eager class="rotate-[1deg]" /> : heroImage && <img src={heroImage} alt={`${post.title} ${post.titleAccent}`} width="1536" height="1024" class="rounded-xl" />}
      </div>
    </section>

    <!-- ===================== FACTS STRIP ===================== -->
    <section class="relative border-y-2 border-edge bg-sun-500 text-ink-950">
      <div class="mx-auto grid max-w-7xl grid-cols-2 px-4 sm:px-6 lg:grid-cols-4 lg:px-10">
        {post.facts.map((fact, i) => (
          <div class:list={[
            "flex flex-col items-start gap-1 py-6 pr-6",
            i % 2 === 0 && "border-r-2 border-ink-950/25",
            i % 2 === 1 && i < post.facts.length - 1 && "lg:border-r-2 lg:border-ink-950/25",
          ]}>
            <p class="font-display text-2xl font-extrabold leading-none [font-variation-settings:'wdth'_118] md:text-3xl">
              {fact.value}
            </p>
            <p class="font-mono text-[0.66rem] uppercase tracking-[0.18em] text-ink-950/80">{fact.label}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ===================== STORY ===================== -->
    <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-10">
      <div class="max-w-3xl" data-reveal>
        {post.intro.map((paragraph, i) => (
          <p class:list={[bodyCopy, i === 0 ? "text-lg leading-8 sm:text-xl sm:leading-9" : "mt-5"]}>
            {i === 0 ? <span class="font-accent text-3xl italic text-accent-text">{paragraph.slice(0, 1)}</span> : null}{i === 0 ? paragraph.slice(1) : paragraph}
          </p>
        ))}
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {post.sections.map((section, i) => (
          <Fragment>
          <StickerCard tone={section.accent} tilt={i % 2 === 0 ? "left" : "right"} class:list={["p-7 md:p-8", post.sections.length % 2 === 1 && i === post.sections.length - 1 && "md:col-span-2"]} data-reveal>
            <div class="flex items-center gap-3">
              <SectionTitle size="none" class="text-[clamp(1.4rem,2.4vw,1.9rem)]">{section.title}</SectionTitle>
            </div>
            <p class={`mt-4 ${bodyCopy}`}>{section.body}</p>
          </StickerCard>
          {i === 1 && post.storyImage && <div class="col-span-full my-5 mb-6" data-reveal><LogbookIllustration image={post.storyImage} /></div>}
          </Fragment>
        ))}
      </div>

      {post.gif && <LogbookGif gif={post.gif} />}
      <div class="mt-12 max-w-3xl" data-reveal>
        <p class={`text-lg leading-8 ${bodyCopy}`}>{post.outro}</p>
      </div>
    </section>

    <!-- ===================== CLIPS ===================== -->
    {clips.length > 0 && (
      <section class="mx-auto max-w-7xl px-4 pb-4 sm:px-6 lg:px-10">
        <div class="mb-8" data-reveal>
          <Kicker>🎬 Rolling clips</Kicker>
        </div>
        <div class="grid gap-7 md:grid-cols-2 lg:grid-cols-3" data-reveal>
          {clips.map((clip) => (
            <div class={mediaFrame}>
              <video
                src={clip.src}
                poster={clip.poster}
                muted
                loop
                playsinline
                controls
                preload="none"
                class="aspect-video w-full"
              ></video>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- ===================== GALLERY ===================== -->
    {post.media && <section id="gallery" class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-10">
      <div class="mb-9 flex flex-wrap items-end justify-between gap-5" data-reveal>
        <div class="max-w-2xl">
          <Kicker>📸 The day, in pictures</Kicker>
          <SectionTitle class="mt-4">
            Straight off the
            <span class="font-accent italic">boat</span>.
          </SectionTitle>
          {photos.length > 0 ? (
            <p class={`mt-4 ${bodyCopy}`}>Tap a photo to open it full-size.</p>
          ) : (
            <p class={`mt-4 ${bodyCopy}`}>
              The roll is still uploading — in the meantime, the full album lives on the club drive.
            </p>
          )}
        </div>
        <Cta variant="secondary" href={post.media.shareUrl} target="_blank" rel="noreferrer" class="shrink-0">↗ Full album</Cta>
      </div>

      {photos.length > 0 && (
        <div class="columns-2 gap-4 sm:columns-3 sm:gap-[1.15rem] lg:columns-4 lg:gap-5" data-reveal>
          {photos.map((photo, i) => (
            <button
              type="button"
              class="mb-4 block w-full cursor-zoom-in break-inside-avoid overflow-hidden rounded-[1.1rem] border-2 border-edge bg-surface p-0 shadow-sticker-md transition-[translate,rotate,box-shadow] duration-200 nth-[3n]:-rotate-[1.1deg] nth-[4n]:rotate-[0.9deg] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:rotate-0 hover:shadow-[7px_7px_0_0_var(--edge)] focus-visible:-translate-x-0.5 focus-visible:-translate-y-0.5 focus-visible:rotate-0 focus-visible:shadow-[7px_7px_0_0_var(--edge)] focus-visible:outline-none"
              data-lb-trigger
              data-full={photo.full}
              data-alt={photo.alt}
              aria-label={`Open photo ${i + 1} of ${photos.length}`}
            >
              <img
                src={photo.thumb}
                alt={photo.alt}
                loading="lazy"
                decoding="async"
                class="block h-auto w-full"
                onerror="this.closest('[data-lb-trigger]')?.remove()"
              />
            </button>
          ))}
        </div>
      )}
    </section>}

    {post.media && <Lightbox id="post-lightbox" label="Photo viewer" />}

    {post.cover && <p class="mx-auto max-w-7xl px-4 pb-8 font-mono text-[0.65rem] leading-[1.7] opacity-65 sm:px-6 lg:px-10">Photos by club parents and the club drone. {post.media && "The trip gallery contains the club’s original photos and videos."}</p>}

    <!-- ===================== CTA ===================== -->
    <section class="mx-auto max-w-7xl px-4 pb-24 pt-6 sm:px-6 lg:px-10">
      <StickerCard tone="coral" class="p-8 md:p-12" data-reveal>
        <div class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
          <div>
            <Kicker>{post.cta.kicker}</Kicker>
            <SectionTitle class="mt-4">
              {post.cta.title} <Underline>{post.cta.titleAccent}</Underline>
            </SectionTitle>
            <p class={`mt-4 max-w-2xl ${bodyCopy}`}>{post.cta.body}</p>
          </div>
          <div class="flex flex-col gap-3">
            <Cta href={post.cta.primary.href} target={post.cta.primary.external ? "_blank" : undefined} rel={post.cta.primary.external ? "noreferrer" : undefined}>
              {post.cta.primary.label}
            </Cta>
            {post.cta.secondary && <Cta variant="secondary" href={post.cta.secondary.href}>{post.cta.secondary.label}</Cta>}
          </div>
        </div>
      </StickerCard>
    </section>
  </article>
</BaseLayout>
