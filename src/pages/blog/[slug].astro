---
import { site } from "../../data/site";
import { blog } from "../../data/blog";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  isVideo,
  loadShareFiles,
  sharePreviewUrl,
  shareDownloadUrl,
} from "../../lib/share-media";

export async function getStaticPaths() {
  return blog.posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;

const title = `${post.title} ${post.titleAccent} — ${blog.name} | ${site.name}`;
const description = post.excerpt;

// Enumerated from the Nextcloud share at build time (falls back to
// post.media.files if the share is unreachable from the build environment).
const mediaFiles = await loadShareFiles(post.media);
const imageFiles = mediaFiles.filter((file) => !isVideo(file));
const photos = imageFiles.map((file, i) => ({
  alt: `${post.title} ${post.titleAccent} — photo ${i + 1} of ${imageFiles.length}`,
  thumb: sharePreviewUrl(post.media, file, 700),
  full: sharePreviewUrl(post.media, file, 2048),
}));
const clips = mediaFiles.filter(isVideo).map((file) => ({
  src: shareDownloadUrl(post.media, file),
  poster: sharePreviewUrl(post.media, file, 1200),
}));

const heroImage = photos[0]?.full;
const ogImage = heroImage ?? "/media/tamarin-shore.jpg";
---

<BaseLayout title={title} description={description} image={ogImage} imageAlt={`${post.title} ${post.titleAccent}`}>
  <!-- ===================== HERO ===================== -->
  <article>
    <section class="relative isolate overflow-hidden">
      <div class="absolute inset-0 -z-10">
        <div class="absolute inset-0 bg-[var(--color-ink-950)]"></div>
        {heroImage && (
          <img
            src={heroImage}
            alt=""
            class="h-full w-full object-cover opacity-50"
            aria-hidden="true"
            onerror="this.remove()"
          />
        )}
        <div class="absolute inset-0 bg-[linear-gradient(150deg,rgba(11,22,32,0.88)_0%,rgba(7,201,182,0.4)_55%,rgba(255,210,63,0.5)_100%)]"></div>
      </div>

      <div class="pointer-events-none absolute -right-3 top-28 hidden lg:block" aria-hidden="true">
        <div class="floating">
          <div class="rounded-full border-2 border-[var(--color-ink-950)] bg-[var(--color-teal-500)] px-5 py-3 shadow-[5px_5px_0_0_var(--color-ink-950)]" style="transform: rotate(7deg);">
            <p class="font-display text-lg font-bold text-[var(--color-ink-950)]" style="font-variation-settings: 'wdth' 112;">
              ⛰️ → 🚤 → 🤿
            </p>
          </div>
        </div>
      </div>

      <div class="relative mx-auto flex min-h-[66vh] max-w-7xl flex-col justify-end px-4 pb-14 pt-28 sm:px-6 sm:pb-18 sm:pt-32 lg:px-10 lg:pb-20 lg:pt-36">
        <div data-float class="mb-5 flex flex-wrap items-center gap-3">
          <span class="eyebrow-badge">{post.kicker}</span>
          <span class="font-mono text-[0.7rem] uppercase tracking-[0.22em] text-white/80">
            {post.dateLabel} · 📍 {post.location}
          </span>
        </div>

        <h1
          data-float
          class="font-display max-w-4xl text-white"
          style="font-size: clamp(2.5rem, 7.5vw, 5.8rem); line-height: 0.92; letter-spacing: -0.045em; font-variation-settings: 'wdth' 112, 'opsz' 96; font-weight: 600;"
        >
          {post.title}
          <span class="font-accent italic text-[var(--color-sun-500)]" style="font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144; font-weight: 500;">{post.titleAccent}</span>
        </h1>

        <p data-float class="mt-6 max-w-3xl text-base leading-7 text-white/90 sm:text-lg sm:leading-8">
          {post.excerpt}
        </p>

        <div data-float class="mt-8 flex flex-wrap gap-3">
          <a class="cta-secondary" href="#gallery">↓ Straight to the photos</a>
          <a class="cta-secondary" href="/blog">← All logbook pages</a>
        </div>
      </div>
    </section>

    <!-- ===================== FACTS STRIP ===================== -->
    <section class="relative border-y-2 border-[var(--color-ink-950)] bg-[var(--color-sun-500)] text-[var(--color-ink-950)]">
      <div class="mx-auto grid max-w-7xl grid-cols-2 px-4 sm:px-6 lg:grid-cols-4 lg:px-10">
        {post.facts.map((fact, i) => (
          <div class:list={[
            "flex flex-col items-start gap-1 py-6 pr-6",
            i % 2 === 0 && "border-r-2 border-[var(--color-ink-950)]/25",
            i % 2 === 1 && i < post.facts.length - 1 && "lg:border-r-2 lg:border-[var(--color-ink-950)]/25",
          ]}>
            <p class="font-display text-2xl font-black leading-none md:text-3xl" style="font-variation-settings: 'wdth' 118; font-weight: 800;">
              {fact.emoji} {fact.value}
            </p>
            <p class="font-mono text-[0.66rem] uppercase tracking-[0.18em] text-[var(--color-ink-950)]/80">{fact.label}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ===================== STORY ===================== -->
    <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-10">
      <div class="max-w-3xl" data-reveal>
        {post.intro.map((paragraph, i) => (
          <p class:list={["body-copy", i === 0 ? "text-lg leading-8 sm:text-xl sm:leading-9" : "mt-5"]}>
            {i === 0 ? <span class="font-accent text-3xl italic text-[var(--color-coral-500)]" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">{paragraph.slice(0, 1)}</span> : null}{i === 0 ? paragraph.slice(1) : paragraph}
          </p>
        ))}
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {post.sections.map((section, i) => (
          <div class:list={["surface-card p-7 md:p-8", section.accent, i % 2 === 0 ? "tilt-left" : "tilt-right"]} data-reveal>
            <div class="flex items-center gap-3">
              <span class="text-3xl" aria-hidden="true">{section.emoji}</span>
              <h2 class="section-title" style="font-size: clamp(1.4rem, 2.4vw, 1.9rem);">{section.title}</h2>
            </div>
            <p class="body-copy mt-4">{section.body}</p>
          </div>
        ))}
      </div>

      <div class="mt-12 max-w-3xl" data-reveal>
        <p class="body-copy text-lg leading-8">{post.outro}</p>
      </div>
    </section>

    <!-- ===================== CLIPS ===================== -->
    {clips.length > 0 && (
      <section class="mx-auto max-w-7xl px-4 pb-4 sm:px-6 lg:px-10">
        <div class="mb-8" data-reveal>
          <p class="section-kicker">🎬 Rolling clips</p>
        </div>
        <div class="grid gap-7 md:grid-cols-2 lg:grid-cols-3" data-reveal>
          {clips.map((clip) => (
            <div class="media-frame">
              <video
                src={clip.src}
                poster={clip.poster}
                autoplay
                muted
                loop
                playsinline
                controls
                preload="auto"
                class="aspect-video w-full"
              ></video>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- ===================== GALLERY ===================== -->
    <section id="gallery" class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-10">
      <div class="mb-9 flex flex-wrap items-end justify-between gap-5" data-reveal>
        <div class="max-w-2xl">
          <p class="section-kicker">📸 The day, in pictures</p>
          <h2 class="section-title mt-4">
            Straight off the
            <span class="font-accent italic" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">boat</span>.
          </h2>
          {photos.length > 0 ? (
            <p class="body-copy mt-4">Tap a photo to open it full-size.</p>
          ) : (
            <p class="body-copy mt-4">
              The roll is still uploading — in the meantime, the full album lives on the club drive.
            </p>
          )}
        </div>
        <a class="cta-secondary shrink-0" href={post.media.shareUrl} target="_blank" rel="noreferrer">
          ↗ Full album
        </a>
      </div>

      {photos.length > 0 && (
        <div class="gallery-grid" data-reveal>
          {photos.map((photo, i) => (
            <button
              type="button"
              class="gallery-tile"
              data-lb-trigger
              data-full={photo.full}
              data-alt={photo.alt}
              aria-label={`Open photo ${i + 1} of ${photos.length}`}
            >
              <img
                src={photo.thumb}
                alt={photo.alt}
                loading="lazy"
                decoding="async"
                onerror="this.closest('.gallery-tile')?.remove()"
              />
            </button>
          ))}
        </div>
      )}
    </section>

    <dialog id="post-lightbox" class="lightbox" aria-label="Photo viewer">
      <button class="lightbox-close" data-lb-close aria-label="Close gallery">✕</button>
      <button class="lightbox-nav lightbox-prev" data-lb-prev aria-label="Previous photo">‹</button>
      <figure class="lightbox-figure">
        <img id="lightbox-img" src="" alt="" />
      </figure>
      <button class="lightbox-nav lightbox-next" data-lb-next aria-label="Next photo">›</button>
      <p class="lightbox-count" data-lb-count></p>
    </dialog>

    <!-- ===================== CTA ===================== -->
    <section class="mx-auto max-w-7xl px-4 pb-24 pt-6 sm:px-6 lg:px-10">
      <div class="surface-card sticker-coral p-8 md:p-12" data-reveal>
        <div class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
          <div>
            <p class="section-kicker">Next trip</p>
            <h2 class="section-title mt-4">
              Your duckie on the <span class="ink-underline">next boat</span>?
            </h2>
            <p class="body-copy mt-4 max-w-2xl">
              Club trips are for members — and joining is four short steps. Say hi in the
              WhatsApp group and we'll take it from there.
            </p>
          </div>
          <div class="flex flex-col gap-3">
            <a class="cta-primary" href={site.whatsappUrl} target="_blank" rel="noreferrer">
              Join the crew
            </a>
            <a class="cta-secondary" href="/#join">How to join the club</a>
          </div>
        </div>
      </div>
    </section>
  </article>

<style>
  /* ---- gallery grid (CSS masonry via columns) ---- */
  .gallery-grid {
    columns: 2;
    column-gap: 1rem;
  }
  @media (min-width: 640px) { .gallery-grid { columns: 3; column-gap: 1.15rem; } }
  @media (min-width: 1024px) { .gallery-grid { columns: 4; column-gap: 1.25rem; } }

  .gallery-tile {
    display: block;
    width: 100%;
    margin: 0 0 1rem;
    padding: 0;
    border: 2px solid var(--color-ink-950);
    border-radius: 1.1rem;
    overflow: hidden;
    background: var(--color-cream-soft);
    box-shadow: 4px 4px 0 0 var(--color-ink-950);
    cursor: zoom-in;
    break-inside: avoid;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .gallery-tile:nth-child(3n) { transform: rotate(-1.1deg); }
  .gallery-tile:nth-child(4n) { transform: rotate(0.9deg); }
  .gallery-tile:hover,
  .gallery-tile:focus-visible {
    transform: translate(-2px, -2px) rotate(0);
    box-shadow: 7px 7px 0 0 var(--color-ink-950);
    outline: none;
  }
  .gallery-tile img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---- lightbox ---- */
  .lightbox {
    inset: 0;
    width: 100vw;
    max-width: 100vw;
    height: 100vh;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    overflow: hidden;
  }
  .lightbox[open] {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    justify-items: center;
    gap: 0.5rem;
    padding: clamp(0.75rem, 3vw, 2.5rem);
  }
  .lightbox::backdrop {
    background: rgba(11, 22, 32, 0.92);
    backdrop-filter: blur(4px);
  }
  .lightbox-figure {
    grid-column: 2;
    margin: 0;
    max-width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox-figure img {
    max-width: 100%;
    max-height: 86vh;
    width: auto;
    height: auto;
    border: 3px solid var(--color-ink-950);
    border-radius: 0.6rem;
    box-shadow: 8px 8px 0 0 var(--color-sun-500);
    background: var(--color-ink-950);
  }
  .lightbox-nav,
  .lightbox-close {
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--color-ink-950);
    background: var(--color-cream-soft);
    color: var(--color-ink-950);
    border-radius: 999px;
    box-shadow: 3px 3px 0 0 var(--color-ink-950);
    cursor: pointer;
    font-family: var(--font-display);
    line-height: 1;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .lightbox-nav { width: 3rem; height: 3rem; font-size: 1.9rem; }
  .lightbox-nav:hover { transform: translateY(-2px); box-shadow: 4px 5px 0 0 var(--color-ink-950); }
  .lightbox-prev { grid-column: 1; }
  .lightbox-next { grid-column: 3; }
  .lightbox-close {
    position: fixed;
    top: clamp(0.75rem, 3vw, 1.5rem);
    right: clamp(0.75rem, 3vw, 1.5rem);
    width: 2.75rem;
    height: 2.75rem;
    font-size: 1.05rem;
    background: var(--color-coral-500);
  }
  .lightbox-count {
    position: fixed;
    left: 50%;
    bottom: clamp(0.75rem, 3vw, 1.5rem);
    transform: translateX(-50%);
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-cream-soft);
    background: var(--color-ink-950);
    border: 2px solid var(--color-cream-soft);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
  }
  @media (max-width: 640px) {
    .lightbox-nav { width: 2.5rem; height: 2.5rem; font-size: 1.5rem; }
  }
</style>

<script>
  const dialog = document.getElementById("post-lightbox");
  const img = document.getElementById("lightbox-img");

  if (dialog instanceof HTMLDialogElement && img instanceof HTMLImageElement) {
    const triggers = Array.from(
      document.querySelectorAll("[data-lb-trigger]"),
    ) as HTMLElement[];
    const countEl = dialog.querySelector("[data-lb-count]");
    const items = triggers.map((t) => ({
      full: t.dataset.full ?? "",
      alt: t.dataset.alt ?? "",
    }));
    let index = 0;

    const render = () => {
      const item = items[index];
      if (!item) return;
      img.src = item.full;
      img.alt = item.alt;
      if (countEl) countEl.textContent = `${index + 1} / ${items.length}`;
    };
    const open = (i: number) => {
      index = i;
      render();
      if (!dialog.open) dialog.showModal();
    };
    const move = (delta: number) => {
      index = (index + delta + items.length) % items.length;
      render();
    };

    triggers.forEach((t, i) => t.addEventListener("click", () => open(i)));
    dialog
      .querySelector("[data-lb-close]")
      ?.addEventListener("click", () => dialog.close());
    dialog
      .querySelector("[data-lb-prev]")
      ?.addEventListener("click", () => move(-1));
    dialog
      .querySelector("[data-lb-next]")
      ?.addEventListener("click", () => move(1));
    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") move(1);
      else if (event.key === "ArrowLeft") move(-1);
    });
    // Click on the backdrop / empty area closes.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
</BaseLayout>
