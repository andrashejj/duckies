---
import BrandingLayout from "../../layouts/BrandingLayout.astro";
import PlanBoard from "../../components/react/PlanBoard";
export const prerender=false;
if(!Astro.locals.branding?.canView)return Astro.redirect("/branding-plan");
const view=Astro.url.searchParams.get("view")==="timeline"?"timeline":"board";
---
<BrandingLayout title="Plan board" description="Project Molt milestones and tasks: who does what, by when, and where it stands." kicker="Project Molt / Board" heading="Who does what.">
 <p slot="lead">One row per milestone, soonest due first, with the next one marked. To do, doing, review and done across: Estelle moves her work to review, Dori signs it off or sends it back. Late tasks and tasks due this week are flagged. Drag a card, or use its status menu on a phone. The <a href="/branding-plan/plan">plan</a> and <a href="/branding-plan/onsite">on the ground</a> read the same rows.</p>
 <p class="mb-6 text-fg-muted">Click a task to see its details, edit the description or add a comment and files. Comment and file counts appear on the cards.</p>
 <PlanBoard client:load initialView={view}/>
</BrandingLayout>
