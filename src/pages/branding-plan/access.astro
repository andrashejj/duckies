---
import BrandingLayout from "../../layouts/BrandingLayout.astro";
import BrandingApprovals from "../../components/react/BrandingApprovals";
export const prerender=false;
if(!Astro.locals.branding?.owner)return Astro.redirect(Astro.locals.branding?.session?"/branding-plan":"/login?next=%2Fbranding-plan%2Faccess");
---
<BrandingLayout title="Branding access" description="Manage invitations to the Project Molt workspace." kicker="Project Molt / Andras’s desk" heading="Access requests">
 <p slot="lead">Approve people to read the plans and try the granola sheet. Enable recipe saving and AI when they need to contribute edits. Only verified email requests appear here; people check their decision on the teaser page.</p>
 <div class="max-w-[1040px]"><BrandingApprovals client:load/></div>
</BrandingLayout>
