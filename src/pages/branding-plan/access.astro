---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BrandingToolbar from "../../components/BrandingToolbar.astro";
import BrandingApprovals from "../../components/react/BrandingApprovals";
import "../../styles/plan.css";
import "../../styles/branding-access.css";
export const prerender=false;
if(!Astro.locals.branding?.owner)return Astro.redirect(Astro.locals.branding?.session?"/branding-plan":"/login?next=%2Fbranding-plan%2Faccess");
---
<BaseLayout title="Branding access | Sunset Duckies" description="Manage invitations to the Project Molt workspace." variant="performance">
 <BrandingToolbar/>
 <section class="b-admin"><p class="b-kicker">Project Molt / Andras’s desk</p><h1>Who’s in.</h1><p class="b-lead">Approve people to read the plans and try the simulator. Enable recipe saving and AI when they need to contribute edits.</p><p>Only verified email requests appear here. People can check their decision on the teaser page.</p><BrandingApprovals client:load/></section>
</BaseLayout>
