---
import BrandingLayout from "../../layouts/BrandingLayout.astro";
import PlanSectionHead from "../../components/plan/PlanSectionHead.astro";
import PlanTimeline from "../../components/plan/PlanTimeline.astro";
import { cardTitle, outlineButton } from "../../lib/plan-ui";
import { after } from "../../data/molt";
import { nextMilestone, progress } from "../../lib/plan";
import { milestoneSteps, todayIso } from "../../lib/plan-view";
import { loadPlanForPages } from "../../lib/server/plan";
export const prerender = false;
if (!Astro.locals.branding?.canView) return Astro.redirect("/branding-plan");
const { plan, live } = await loadPlanForPages();
const today = todayIso();
const { steps, codes } = milestoneSteps(plan, today);
const next = nextMilestone(plan.milestones);
const done = progress(plan.milestones);
---

<BrandingLayout title="Plan" description="Project Molt: seven milestones with a due date each, and the tasks under them with owners." kicker="Project Molt / Plan" heading="Seven milestones">
  <p slot="lead">Each milestone has one due date, one owner and a line that says when it is done. The tasks under it have owners too. Estelle does the work and moves it to review; Dori signs it off. Move a task on the <a href="/branding-plan/board">board</a> and it moves here. → in progress, ○ in review, ✔ done: {done.done} of {done.total}.{next && ` Up next: ${next.title}, due ${next.dateLabel}.`}{!live && " The database is unreachable right now, so this shows the seed plan without live status."}</p>

  <section id="milestones" class="scroll-mt-24" data-reveal>
    <PlanTimeline steps={steps} codes={codes} />
  </section>

  <section id="after" class="mt-[clamp(3.5rem,6vw,6rem)] scroll-mt-24" data-reveal>
    <PlanSectionHead size="md" overline="After the Cup" title="November to February" class="mb-8">
      <p>Not planned in tasks yet. What happens next depends on what the Cup shows.</p>
    </PlanSectionHead>
    <ol class="m-0 grid list-none grid-cols-1 border-t border-l border-line p-0 md:grid-cols-3">
      {after.map(item => (
        <li class="flex flex-col border-r border-b border-line bg-surface-2/60 p-7">
          <span class="font-mono text-[0.66rem] font-semibold uppercase tracking-[0.12em] text-accent-text">{item.when}</span>
          <h3 class={`${cardTitle} mt-6 mb-3 text-[1.35rem]`}>{item.title}</h3>
          <p class="m-0 text-[0.92rem] leading-[1.55] text-fg-muted">{item.text}</p>
          {"link" in item && item.link && <a href={item.link.file} target="_blank" rel="noreferrer" class={`${outlineButton} mt-6 self-start`}>{item.link.label} ↗</a>}
        </li>
      ))}
    </ol>
  </section>
</BrandingLayout>
