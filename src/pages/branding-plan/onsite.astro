---
import BrandingLayout from "../../layouts/BrandingLayout.astro";
import PlanDefinitions from "../../components/plan/PlanDefinitions.astro";
import PlanSectionHead from "../../components/plan/PlanSectionHead.astro";
import PlanTimeline from "../../components/plan/PlanTimeline.astro";
import { onsite, rhythm } from "../../data/molt";
import { todayIso, weekSteps } from "../../lib/plan-view";
import { loadPlanForPages } from "../../lib/server/plan";
export const prerender = false;
if (!Astro.locals.branding?.canView) return Astro.redirect("/branding-plan");
const { plan, live } = await loadPlanForPages();
const { steps, codes } = weekSteps(plan, "estelle", todayIso());
const count = steps.reduce((n, step) => n + step.tasks.length, 0);
---

<BrandingLayout title="On the ground" description="Estelle's three weeks in Tamarin: her tasks week by week, and how the team works around her." kicker={`Project Molt / On the ground · ${onsite.dates}`} heading="Three weeks on the ground">
  <p slot="lead">{onsite.intro} {onsite.handover}</p>

  <section data-reveal>
    <PlanSectionHead size="md" overline="Week by week" title="Her tasks, in order" class="mb-10">
      <p>The {count} tasks on the <a href="/branding-plan/plan">plan</a> that Estelle owns, by the week they fall due. The tag on the right is the milestone. Status comes from the <a href="/branding-plan/board">board</a>.{!live && " The database is unreachable right now, so this shows the seed plan without live status."}</p>
    </PlanSectionHead>
    <PlanTimeline steps={steps} codes={codes} />
  </section>

  <section class="mt-[clamp(3.5rem,6vw,6rem)]" data-reveal>
    <PlanSectionHead size="md" overline="Working rhythm" title="Who is around, and when" class="mb-10">
      <p>Estelle does not wait on anyone. These are the fixed points in the week.</p>
    </PlanSectionHead>
    <PlanDefinitions items={rhythm} signal class="lg:grid-cols-4" />
  </section>
</BrandingLayout>
