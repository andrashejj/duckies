---
import { site } from "../data/site";
import { blog } from "../data/blog";
import BaseLayout from "../layouts/BaseLayout.astro";
import Cta from "../components/ui/Cta.astro";
import Kicker from "../components/ui/Kicker.astro";
import SectionTitle from "../components/ui/SectionTitle.astro";
const posts = [...blog.posts].sort((a, b) => b.dateISO.localeCompare(a.dateISO)).slice(0, 2);
const title = `${site.name} | Kids surfing in Tamarin Bay`;
---
<BaseLayout title={title} description={site.description} image="/media/og-home.jpg" imageAlt="The Sunset Duckies with their boards at Tamarin Bay." imageWidth={1200} imageHeight={630}>
  <section class="surf-home-hero">
    <img src="/media/og-home.jpg" alt="The Sunset Duckies lined up with their colourful boards on the beach." width="1200" height="630" fetchpriority="high" />
    <div class="surf-home-intro">
      <p class="surf-home-eyebrow">Tamarin Bay, Mauritius · Kids’ surf club</p>
      <h1>More waves.<br/><em>More friends.</em></h1>
      <p>A small crew of kids, parents in the water, and a couple of afternoons a week to get better at surfing together.</p>
      <Cta href="#how-to-join">Come for a surf</Cta>
      <p class="surf-home-rhythm">Monday + Friday · 4–6pm</p>
    </div>
  </section>

  <section id="how-to-join" class="surf-home-section surf-home-join">
    <div>
      <Kicker>New to the crew?</Kicker>
      <SectionTitle class="mt-4">First surf?<br/><span class="font-accent italic">Come say hello.</span></SectionTitle>
      <p class="mt-5">Message us before your first session. We’ll talk about your child’s swimming and what to bring, then get their registration and waiver sorted.</p>
      <p class="mt-4">The first session is free. After that, membership is {site.membership.feeLabelLong}.</p>
      <div class="mt-6"><Cta href={site.whatsappUrl} target="_blank" rel="noreferrer">Say hello on WhatsApp</Cta></div>
      <a href="/join" class="surf-home-text-link">Already spoken to us? Register your duckie →</a>
    </div>
    <div id="how-it-works" class="surf-home-essentials">
      <h2>Before you paddle out</h2>
      <dl>
        <div id="age-guide"><dt>Confident swimmers</dt><dd>Usually age 7 and up. Kids need to swim well on their own in open water. For younger children, discuss readiness with the head coach.</dd></div>
        <div><dt>Parents get wet too</dt><dd>One parent or guardian from every family stays in the water for the full session, including the free first session.</dd></div>
        <div><dt>Bring your board</dt><dd>A surfboard and a wetsuit or rashie for every session. The club doesn’t lend, rent or store gear.</dd></div>
      </dl>
      <p>Volunteer-run and member-funded. Coaches run the training; families provide their children’s supervision.</p>
      <details class="surf-home-details"><summary>Fees, sessions & the waiver</summary>
        <p>{site.membership.fundingNote} Pay the semester fee to Andras after your free first session; he confirms your membership.</p>
        <ul>{site.howToJoin.waiverSummary.map(line => <li>{line}</li>)}</ul>
        <a href="/join" class="surf-home-text-link">Registration & full waiver →</a>
      </details>
    </div>
  </section>

  <section id="schedule" class="surf-home-session">
    <div class="surf-home-section">
      <div><Kicker>Meet us at the bay</Kicker><h2>Monday + Friday.<br/><span class="font-accent italic">4–6pm, Tamarin.</span></h2><p>Choose one or two sessions a week. Check WhatsApp for the latest surf call before heading down.</p></div>
      <div class="surf-home-event"><p class="surf-home-eyebrow">Beach days with the whole crew</p><h3>{site.cupVol2.name}</h3><p>Heats, cheering from the sand, and a reason to get everyone together.</p><a href="/sunset-duckies-cup-vol-2" class="surf-home-text-link">Cup details & registration →</a><a href="/sunset-duckies-cup" class="surf-home-text-link">Look back at the first Cup →</a></div>
    </div>
  </section>

  <section class="surf-home-section surf-home-stories">
    <div class="surf-home-section-heading"><div><Kicker>From the beach</Kicker><SectionTitle class="mt-4">The <span class="font-accent italic">logbook.</span></SectionTitle></div><a href="/blog" class="surf-home-text-link">All stories →</a></div>
    <div class="surf-home-story-grid">{posts.map(post => <a href={`/blog/${post.slug}`} class="surf-home-story">
      {post.cover && <img src={post.cover.src} alt={post.cover.alt} width="1536" height="1024" loading="lazy" />}
      <p>{post.dateLabel}</p><h3>{post.title} {post.titleAccent}</h3>
    </a>)}</div>
    <div class="club-useful-links"><a href="/training-materials">Surf tips for your next session</a><a href={`mailto:${site.contact.coordinatorEmail}`}>Contact {site.contact.coordinatorName}</a></div>
  </section>
  <section id="sponsors" aria-labelledby="sponsors-title" class="mx-auto max-w-7xl px-6 pb-20 pt-8 lg:px-10">
    <div class="border-t-2 border-b border-edge pt-7 pb-8">
      <h2 id="sponsors-title" class="text-center font-mono text-[0.7rem] uppercase tracking-[0.18em]">Backed by</h2>
      <ul class="mt-6 grid list-none grid-cols-2 items-center gap-x-8 gap-y-5 p-0 max-sm:[&>li:last-child]:col-span-full sm:grid-cols-5 sm:gap-8" aria-label="Club sponsors">
        {site.sponsors.map(sponsor => {
          const Tag = sponsor.href ? "a" : "span";
          return (
            <li>
              <Tag href={sponsor.href ?? undefined} target={sponsor.href ? "_blank" : undefined} rel={sponsor.href ? "noreferrer" : undefined} class:list={["flex min-h-16 items-center justify-center text-fg focus-visible:rounded focus-visible:outline-3 focus-visible:outline-offset-6 focus-visible:outline-teal-600", sponsor.href && "hover:opacity-65"]}>
                {sponsor.logo ? (
                  <img src={sponsor.logo} alt={sponsor.name} loading="lazy" width="180" height="48" class="block h-[38px] w-full max-w-[132px] object-contain dark:invert sm:h-11 sm:max-w-[155px]" />
                ) : sponsor.wordmark === "nbk" ? (
                  <span class="font-display text-[2rem] font-[750] leading-none tracking-[-0.06em]" role="img" aria-label={sponsor.name}>NBK<span class="ml-2 font-mono text-[0.72rem] tracking-[0.16em]">LABS</span></span>
                ) : (
                  <span class="text-center font-display text-[2rem] font-semibold leading-none" role="img" aria-label={sponsor.name}>A<span class="italic text-accent-text">·</span>H<small class="mt-[0.45rem] block font-mono text-[0.6rem] tracking-[0.03em]">andrashejj.com</small></span>
                )}
              </Tag>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</BaseLayout>
