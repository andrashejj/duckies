---
import QRCode from "qrcode";

import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const qrCode = await QRCode.toDataURL(site.whatsappUrl, {
  margin: 1,
  width: 320,
  color: {
    dark: "#082032",
    light: "#F6FBFF",
  },
});

const title = `${site.name} | Free surf club for kids in Tamarin`;
const description =
  "A free surf club in Tamarin Bay helping kids build confidence, community, and competition-ready momentum through weekly sessions.";
---

<BaseLayout title={title} description={description} image="/media/board-lineup.jpg" page="home">
  <section class="mx-auto max-w-7xl px-6 pb-10 pt-8 lg:px-10 lg:pt-10">
    <div class="relative isolate overflow-hidden rounded-[2.25rem] border border-white/60 bg-[var(--color-ocean-950)] shadow-[0_34px_100px_-50px_rgba(8,32,50,0.85)]">
      <div class="absolute inset-0">
        <video
          data-hero-video
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster="/media/hero-poster.jpg"
          class="h-full w-full object-cover opacity-75 saturate-[0.88] brightness-[0.7]"
        >
          <source src="/media/hero-wave.mp4" type="video/mp4" />
        </video>
        <div class="absolute inset-0 bg-[linear-gradient(120deg,rgba(8,32,50,0.9)_8%,rgba(8,32,50,0.6)_38%,rgba(8,32,50,0.68)_100%)]"></div>
        <div class="absolute inset-x-0 bottom-0 h-48 bg-[linear-gradient(180deg,transparent,rgba(8,32,50,0.72))]"></div>
      </div>

      <div class="relative px-6 py-8 lg:px-10 lg:py-10">
        <div class="hero-grid min-h-[42rem]">
          <div class="space-y-8">
            <div data-float class="eyebrow-badge">
              <span class="h-2 w-2 rounded-full bg-[var(--color-sun-300)]"></span>
              Free of charge for local kids
            </div>

            <div data-float class="max-w-3xl space-y-6">
              <p class="section-kicker text-[var(--color-seafoam-300)]">Tamarin Bay · Mauritius</p>
              <h1 class="font-display text-5xl leading-none text-white md:text-7xl">
                Confidence in the water. Community on the beach.
              </h1>
              <p class="max-w-2xl text-lg leading-8 text-white/78 md:text-xl">
                {site.name} is a founder-led surf club for kids in Tamarin. Weekly sessions are
                designed to feel serious in quality, light in spirit, and completely free for
                families.
              </p>
            </div>

            <div data-float class="flex flex-wrap gap-3">
              <a class="cta-primary" href={site.whatsappUrl} target="_blank" rel="noreferrer">
                Apply via WhatsApp
              </a>
              <a class="cta-secondary border-white/20 bg-white/10 text-white hover:border-white/55 hover:text-white" href="/training-materials">
                Explore training materials
              </a>
              <a class="cta-secondary border-white/20 bg-transparent text-white hover:border-white/55 hover:text-white" href="#sponsors">
                Become a sponsor
              </a>
            </div>

            <div data-float class="flex flex-wrap gap-3 text-sm text-white/82">
              <span class="chip border-white/15 bg-white/8 text-white">Wednesday & Friday</span>
              <span class="chip border-white/15 bg-white/8 text-white">4:00-6:00pm</span>
              <span class="chip border-white/15 bg-white/8 text-white">{site.location}</span>
            </div>
          </div>

          <div class="grid gap-4 self-stretch lg:justify-items-end">
            <div data-float class="glass-panel max-w-md p-6 text-white">
              <p class="section-kicker text-[var(--color-seafoam-300)]">Why it matters</p>
              <div class="mt-4 grid gap-4 sm:grid-cols-2">
                {site.stats.map((stat) => (
                  <div class="rounded-[1.35rem] border border-white/14 bg-white/8 p-4">
                    <p class="font-display text-3xl text-white">{stat.value}</p>
                    <p class="mt-2 text-sm leading-6 text-white/72">{stat.label}</p>
                  </div>
                ))}
              </div>
            </div>

            <div data-float class="glass-panel max-w-md p-6 text-white">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="section-kicker text-[var(--color-seafoam-300)]">Next training rhythm</p>
                  <h2 class="mt-3 font-display text-2xl text-white">Built to become a habit.</h2>
                </div>
                <div class="rounded-full border border-white/15 bg-white/10 px-4 py-2 text-sm font-semibold">
                  Free
                </div>
              </div>

              <div class="mt-5 space-y-4">
                {site.schedule.map((session) => (
                  <div class="rounded-[1.35rem] border border-white/14 bg-white/8 p-4">
                    <div class="flex items-center justify-between gap-4">
                      <p class="font-semibold text-white">{session.day}</p>
                      <p class="text-sm text-white/72">{session.time}</p>
                    </div>
                    <p class="mt-2 text-sm leading-6 text-white/72">{session.focus}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="why-duckies" class="mx-auto max-w-7xl px-6 py-10 lg:px-10">
    <div class="story-grid items-center">
      <div class="space-y-6" data-reveal>
        <p class="section-kicker">Why Duckies</p>
        <h2 class="section-title max-w-2xl">
          A surf club that feels polished, joyful, and genuinely accessible.
        </h2>
        <p class="body-copy max-w-2xl">
          The goal is simple: give kids a consistent place to grow stronger in the water, connect
          with each other, and build memories that feel bigger than a single surf lesson. The club
          is intentionally free of charge so access stays open.
        </p>

        <div class="grid gap-4">
          {site.pillars.map((pillar) => (
            <div class="surface-card p-5">
              <p class="font-display text-xl text-[var(--color-ocean-950)]">{pillar.title}</p>
              <p class="mt-2 text-sm leading-7 text-slate-600">{pillar.text}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="grid gap-5" data-reveal>
        <div class="media-frame aspect-[1.02/1.05]">
          <img
            src="/media/board-lineup.jpg"
            alt="Young surfers standing with boards by the ocean at sunset."
            loading="eager"
          />
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <div class="media-frame aspect-[1/1.02]">
            <img
              src="/media/young-rider.jpg"
              alt="A young surfer catching a small wave."
              loading="lazy"
            />
          </div>
          <div class="media-frame aspect-[1/1.02]">
            <img
              src="/media/balance-training.jpg"
              alt="Balance board training indoors."
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-10 lg:px-10">
    <div class="surface-card overflow-hidden p-6 md:p-8">
      <div class="grid gap-6 lg:grid-cols-[0.8fr_1.2fr]">
        <div data-reveal class="space-y-4">
          <p class="section-kicker">What the club feels like</p>
          <h2 class="section-title">A visual identity already worth rallying behind.</h2>
          <p class="body-copy">
            Duckies already has the raw ingredients of a real brand: warm light, colourful boards,
            local kids, and a bay that feels instantly cinematic. The site leans into that instead
            of flattening it.
          </p>
        </div>

        <div class="grid gap-5 md:grid-cols-2">
          {site.gallery.map((item) => (
            <article class="surface-card overflow-hidden" data-reveal>
              <div class="media-frame aspect-[1.15/1] rounded-none border-0 shadow-none">
                <img src={item.image} alt={item.alt} loading="lazy" />
              </div>
              <div class="p-5">
                <p class="font-display text-xl text-[var(--color-ocean-950)]">{item.title}</p>
                <p class="mt-2 text-sm leading-7 text-slate-600">{item.caption}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="schedule" class="mx-auto max-w-7xl px-6 py-10 lg:px-10">
    <div class="grid gap-6 lg:grid-cols-[0.95fr_1.05fr]">
      <div class="surface-card p-6 md:p-8" data-reveal>
        <p class="section-kicker">Weekly rhythm</p>
        <h2 class="section-title mt-4">Wednesday and Friday, 4:00-6:00pm.</h2>
        <p class="body-copy mt-4">
          Training happens in Tamarin Bay and is structured to balance repetition, fun, and
          confidence-building. Families know when to show up. Kids know what to look forward to.
        </p>

        <div class="mt-6 grid gap-4">
          {site.schedule.map((session) => (
            <div class="rounded-[1.5rem] bg-[var(--color-sand-50)] p-5">
              <div class="flex items-center justify-between gap-4">
                <p class="font-display text-xl text-[var(--color-ocean-950)]">{session.day}</p>
                <p class="font-semibold text-[var(--color-ocean-700)]">{session.time}</p>
              </div>
              <p class="mt-2 text-sm leading-7 text-slate-600">{session.focus}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="surface-card relative overflow-hidden p-6 md:p-8" data-reveal>
        <div class="absolute inset-0 bg-[linear-gradient(160deg,rgba(143,215,212,0.12),transparent_40%,rgba(245,164,99,0.12))]"></div>
        <div class="relative">
          <p class="section-kicker">{site.competition.label}</p>
          <h2 class="section-title mt-4">{site.competition.title}</h2>
          <p class="body-copy mt-4 max-w-2xl">{site.competition.description}</p>

          <div class="mt-6 grid gap-4 sm:grid-cols-3">
            <div class="rounded-[1.4rem] border border-slate-200/75 bg-white/80 p-5">
              <p class="font-display text-lg text-[var(--color-ocean-950)]">Progress</p>
              <p class="mt-2 text-sm leading-7 text-slate-600">
                Each comp gives kids a reason to train with intent.
              </p>
            </div>
            <div class="rounded-[1.4rem] border border-slate-200/75 bg-white/80 p-5">
              <p class="font-display text-lg text-[var(--color-ocean-950)]">Family energy</p>
              <p class="mt-2 text-sm leading-7 text-slate-600">
                The atmosphere becomes a celebration, not a pressure cooker.
              </p>
            </div>
            <div class="rounded-[1.4rem] border border-slate-200/75 bg-white/80 p-5">
              <p class="font-display text-lg text-[var(--color-ocean-950)]">Sponsor visibility</p>
              <p class="mt-2 text-sm leading-7 text-slate-600">
                Brands show up in a setting people genuinely care about.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-10 lg:px-10">
    <div class="grid gap-6 lg:grid-cols-[1.05fr_0.95fr]">
      <div class="surface-card p-6 md:p-8" data-reveal>
        <p class="section-kicker">Training materials</p>
        <h2 class="section-title mt-4">Keep the momentum between sessions.</h2>
        <p class="body-copy mt-4 max-w-2xl">
          The training materials page is where Duckies can collect surf videos, drills, ocean
          knowledge, and at-home exercises in one place. It is public, practical, and built to
          grow with the club.
        </p>

        <div class="mt-6 flex flex-wrap gap-3">
          <span class="chip">Surf videos</span>
          <span class="chip">Pop-up drills</span>
          <span class="chip">Balance work</span>
          <span class="chip">Ocean knowledge</span>
          <span class="chip">Competition prep</span>
        </div>

        <div class="mt-8">
          <a class="cta-primary" href="/training-materials">
            Open the training library
          </a>
        </div>
      </div>

      <div class="media-frame min-h-[23rem]" data-reveal>
        <img
          src="/media/tamarin-shore.jpg"
          alt="Children enjoying the water at Tamarin Bay."
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-10 lg:px-10">
    <div class="grid gap-6 lg:grid-cols-[1fr_1fr]">
      <div class="surface-card p-6 md:p-8" data-reveal>
        <p class="section-kicker">Founders</p>
        <h2 class="section-title mt-4">Built by people who care about the long game.</h2>
        <div class="mt-6 grid gap-4">
          {site.founders.map((founder) => (
            <article class="rounded-[1.5rem] bg-[var(--color-sand-50)] p-5">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="font-display text-xl text-[var(--color-ocean-950)]">{founder.name}</p>
                  <p class="mt-1 text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-ocean-700)]">
                    {founder.role}
                  </p>
                </div>
                {founder.href && (
                  <a
                    class="text-sm font-semibold text-[var(--color-ocean-700)] transition hover:text-[var(--color-ocean-950)]"
                    href={founder.href}
                    target="_blank"
                    rel="noreferrer"
                  >
                    Visit site
                  </a>
                )}
              </div>
              <p class="mt-3 text-sm leading-7 text-slate-600">{founder.bio}</p>
            </article>
          ))}
        </div>
      </div>

      <div class="surface-card p-6 md:p-8" data-reveal>
        <p class="section-kicker">WhatsApp community</p>
        <h2 class="section-title mt-4">Application is simple by design.</h2>
        <p class="body-copy mt-4">
          Join through WhatsApp, get the next updates, and stay close to the rhythm of the club.
          For launch, this is the fastest path for families and supporters alike.
        </p>

        <div class="mt-6 flex flex-col gap-5 sm:flex-row sm:items-center">
          <div class="rounded-[1.75rem] border border-slate-200/80 bg-[var(--color-sand-50)] p-4">
            <img
              src={qrCode}
              alt="QR code linking to the Duckies Surf Club WhatsApp group."
              class="h-40 w-40 rounded-2xl"
            />
          </div>
          <div class="space-y-3">
            <p class="text-sm leading-7 text-slate-600">
              Scan to open the club WhatsApp directly on your phone.
            </p>
            <a class="cta-primary" href={site.whatsappUrl} target="_blank" rel="noreferrer">
              Open WhatsApp invite
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="sponsors" class="mx-auto max-w-7xl px-6 py-10 lg:px-10">
    <div class="surface-card overflow-hidden p-6 md:p-8">
      <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr]">
        <div data-reveal class="space-y-5">
          <p class="section-kicker">Sponsors</p>
          <h2 class="section-title">Become a founding sponsor for something genuinely local.</h2>
          <p class="body-copy max-w-2xl">
            Duckies is still early, which is exactly what makes support meaningful. A sponsor is
            helping shape a free surf club that feels ambitious, warm, and durable from the start,
            while becoming part of a story families in Tamarin will actually remember.
          </p>

          <div class="rounded-[1.5rem] border border-dashed border-[var(--color-ocean-500)]/45 bg-[var(--color-ocean-950)] px-5 py-4 text-white">
            <p class="font-semibold">Current sponsor CTA fallback</p>
            <p class="mt-2 text-sm leading-7 text-white/72">{site.sponsorContactNote}</p>
          </div>
        </div>

        <div class="grid gap-4">
          {site.sponsors.map((sponsor) => (
            <article class="surface-card p-5" data-reveal>
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="font-display text-2xl text-[var(--color-ocean-950)]">{sponsor.name}</p>
                  <p class="mt-2 text-sm leading-7 text-slate-600">{sponsor.blurb}</p>
                </div>
                <a
                  href={sponsor.href}
                  target="_blank"
                  rel="noreferrer"
                  class="text-sm font-semibold text-[var(--color-ocean-700)] transition hover:text-[var(--color-ocean-950)]"
                >
                  Visit
                </a>
              </div>
            </article>
          ))}

          <article class="rounded-[1.75rem] border border-[var(--color-ocean-950)] bg-[var(--color-ocean-950)] p-6 text-white" data-reveal>
            <p class="section-kicker text-[var(--color-seafoam-300)]">Support the next chapter</p>
            <h3 class="mt-4 font-display text-2xl">Keep the club free. Start the conversation.</h3>
            <p class="mt-3 text-sm leading-7 text-white/72">
              If the club resonates with your brand, reach out directly. We will keep the first
              conversation simple and personal.
            </p>
            <div class="mt-6 flex flex-wrap gap-3">
              <a
                class="cta-primary bg-white text-[var(--color-ocean-950)] hover:bg-[var(--color-sand-50)]"
                href={site.sponsorContactUrl}
                target="_blank"
                rel="noreferrer"
              >
                Become a founding sponsor
              </a>
              <a class="cta-secondary border-white/20 bg-transparent text-white hover:border-white/55 hover:text-white" href={site.whatsappUrl} target="_blank" rel="noreferrer">
                Join the WhatsApp first
              </a>
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
