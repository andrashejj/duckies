---
import QRCode from "qrcode";

import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const qrCode = await QRCode.toDataURL(site.whatsappUrl, {
  margin: 1,
  width: 320,
  color: {
    dark: "#082032",
    light: "#F6FBFF",
  },
});

const title = `${site.name} | Free surf club for kids in Tamarin`;
const description =
  "A free surf club in Tamarin Bay helping kids build confidence, community, and competition-ready momentum through weekly sessions.";
---

<BaseLayout title={title} description={description} image="/media/hero-poster.jpg" page="home">
  <section class="relative isolate min-h-[calc(100vh-4.5rem)] overflow-hidden">
    <div class="absolute inset-0">
      <video
        data-hero-video
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster="/media/hero-poster.jpg"
        class="h-full w-full object-cover brightness-[0.6] saturate-[0.8]"
      >
        <source src="/media/hero-wave.mp4" type="video/mp4" />
      </video>
      <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(8,32,50,0.78)_0%,rgba(8,32,50,0.52)_42%,rgba(8,32,50,0.36)_100%)]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(255,210,124,0.16),transparent_28%)]"></div>
    </div>

    <div class="relative mx-auto flex min-h-[calc(100vh-4.25rem)] max-w-7xl items-end px-4 pb-12 pt-20 sm:px-6 sm:pb-14 sm:pt-24 lg:min-h-[calc(100vh-4.5rem)] lg:px-10 lg:pb-18 lg:pt-28">
      <div class="grid w-full gap-10 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-end lg:gap-8">
        <div class="max-w-4xl space-y-4 sm:space-y-6">
          <div data-float class="space-y-4 sm:space-y-6">
            <p class="section-kicker text-[var(--color-seafoam-300)]">Tamarin Bay · Mauritius</p>
            <h1 class="font-display max-w-5xl text-[3.25rem] leading-[0.94] text-white sm:text-[4.5rem] md:text-7xl lg:text-[6.25rem]">
              Confidence in the water. Community on the beach.
            </h1>
            <p class="max-w-3xl text-base leading-7 text-white/80 sm:text-lg sm:leading-8 md:text-2xl md:leading-10">
              {site.name} is a founder-led surf club for kids in Tamarin. Weekly sessions are
              designed to feel high quality, inviting, and completely free for families.
            </p>
          </div>
        </div>

        <div data-float class="flex flex-col gap-3 lg:items-stretch lg:pb-6">
          <a class="cta-primary w-full" href={site.whatsappUrl} target="_blank" rel="noreferrer">
            Apply via WhatsApp
          </a>
          <a class="cta-secondary w-full border-white/25 bg-white text-[var(--color-ocean-950)] hover:border-white hover:text-[var(--color-ocean-950)]" href="#sponsors">
            Become a sponsor
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="why-duckies" class="mx-auto max-w-7xl px-6 py-18 lg:px-10">
    <div class="grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
      <div class="space-y-6" data-reveal>
        <p class="section-kicker">Why Duckies</p>
        <h2 class="section-title max-w-2xl">
          A surf club that feels calm, credible, and easy to say yes to.
        </h2>
        <p class="body-copy max-w-2xl">
          The aim is not to create a busy website. It is to make the club itself legible: a free,
          consistent rhythm in Tamarin where kids build confidence, improve through repetition, and
          feel part of something real.
        </p>

        <div class="grid gap-3 sm:gap-4">
          {site.pillars.map((pillar) => (
            <div class="rounded-[1.6rem] border border-[var(--color-ocean-500)]/14 bg-[linear-gradient(180deg,rgba(255,255,255,0.58),rgba(255,255,255,0.34))] px-5 py-5 shadow-[0_18px_50px_-40px_rgba(16,49,77,0.22)] backdrop-blur-[3px] sm:px-6">
              <div class="mb-4 h-px w-14 bg-[linear-gradient(90deg,var(--color-ocean-700),transparent)]"></div>
              <p class="font-display text-[1.7rem] leading-tight text-[var(--color-ocean-950)]">
                {pillar.title}
              </p>
              <p class="mt-3 max-w-xl text-[1rem] leading-8 text-slate-600">{pillar.text}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="media-frame aspect-[1.08/0.95]" data-reveal>
        <img
          src="/media/board-lineup.jpg"
          alt="Young surfers standing with their boards at the shoreline in Tamarin."
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section id="schedule" class="mx-auto max-w-7xl px-6 py-6 lg:px-10">
    <div class="grid gap-6 lg:grid-cols-[1fr_1fr]">
      <div class="surface-card p-6 md:p-8" data-reveal>
        <p class="section-kicker">Weekly rhythm</p>
        <h2 class="section-title mt-4">Wednesday and Friday, 4:00-6:00pm.</h2>
        <div class="mt-6 grid gap-4">
          {site.schedule.map((session) => (
            <div class="rounded-[1.5rem] bg-[var(--color-sand-50)] p-5">
              <div class="flex items-center justify-between gap-4">
                <p class="font-display text-xl text-[var(--color-ocean-950)]">{session.day}</p>
                <p class="font-semibold text-[var(--color-ocean-700)]">{session.time}</p>
              </div>
              <p class="mt-2 text-sm leading-7 text-slate-600">{session.focus}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="surface-card p-6 md:p-8" data-reveal>
        <p class="section-kicker">{site.competition.label}</p>
        <h2 class="section-title mt-4">{site.competition.title}</h2>
        <p class="body-copy mt-4">
          {site.competition.description}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <span class="chip">Milestones kids can work toward</span>
          <span class="chip">A strong family beach atmosphere</span>
          <span class="chip">Great visibility for founding sponsors</span>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-6 lg:px-10">
    <div class="grid gap-6 lg:grid-cols-[1fr_1fr]">
      <div class="surface-card p-6 md:p-8" data-reveal>
        <p class="section-kicker">Training materials</p>
        <h2 class="section-title mt-4">A separate page for surf videos, drills, and exercises.</h2>
        <p class="body-copy mt-4 max-w-2xl">
          The training materials page is where Duckies can steadily build a public resource library:
          pop-up practice, balance work, ocean knowledge, and useful surf videos in one place.
        </p>
        <div class="mt-8">
          <a class="cta-primary" href="/training-materials">
            Open the training library
          </a>
        </div>
      </div>

      <div class="surface-card p-6 md:p-8" data-reveal>
        <p class="section-kicker">WhatsApp community</p>
        <h2 class="section-title mt-4">Application stays simple.</h2>
        <p class="body-copy mt-4">
          Join through WhatsApp, get updates quickly, and stay close to the club's weekly rhythm.
          For launch, this is the fastest and clearest path for families.
        </p>
        <div class="mt-6 flex flex-col gap-5 sm:flex-row sm:items-center">
          <div class="rounded-[1.75rem] border border-slate-200/80 bg-[var(--color-sand-50)] p-4">
            <img
              src={qrCode}
              alt="QR code linking to the Duckies Surf Club WhatsApp group."
              class="h-40 w-40 rounded-2xl"
            />
          </div>
          <div class="space-y-3">
            <p class="text-sm leading-7 text-slate-600">
              Scan to open the club WhatsApp directly on your phone.
            </p>
            <a class="cta-primary" href={site.whatsappUrl} target="_blank" rel="noreferrer">
              Open WhatsApp invite
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-18 lg:px-10">
    <div class="space-y-8" data-reveal>
      <div class="max-w-3xl">
        <p class="section-kicker">Founders</p>
        <h2 class="section-title mt-4">Built by people who care about the long game.</h2>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {site.founders.map((founder) => (
          <article class="surface-card overflow-hidden">
            <div class:list={founder.image ? "grid gap-0 md:grid-cols-[0.92fr_1.08fr]" : "block"}>
              {founder.image && (
                <div class="bg-[var(--color-sand-100)]">
                  <img
                    src={founder.image}
                    alt={founder.name}
                    class="h-full w-full object-cover"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="p-6 md:p-7">
                <p class="font-display text-2xl text-[var(--color-ocean-950)]">{founder.name}</p>
                <p class="mt-2 text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-ocean-700)]">
                  {founder.role}
                </p>
                <p class="mt-4 text-sm leading-7 text-slate-600">{founder.bio}</p>
                {founder.href && (
                  <a
                    class="mt-6 inline-flex text-sm font-semibold text-[var(--color-ocean-700)] transition hover:text-[var(--color-ocean-950)]"
                    href={founder.href}
                    target="_blank"
                    rel="noreferrer"
                  >
                    Visit site
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="sponsors" class="mx-auto max-w-7xl px-6 pb-18 pt-6 lg:px-10">
    <div class="surface-card p-6 md:p-8">
      <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <div data-reveal class="space-y-5">
          <p class="section-kicker">Sponsors</p>
          <h2 class="section-title">Become a founding sponsor for something genuinely local.</h2>
          <p class="body-copy max-w-2xl">
            Duckies is still early, which is exactly what makes support meaningful. A founding
            sponsor helps keep the club free while becoming part of a story families in Tamarin
            will actually remember.
          </p>
          <a
            class="cta-primary"
            href={site.sponsorContactUrl}
            target="_blank"
            rel="noreferrer"
          >
            Become a founding sponsor
          </a>
        </div>

        <div class="grid gap-4">
          {site.sponsors.map((sponsor) => (
            <article class="surface-card overflow-hidden" data-reveal>
              {sponsor.image && (
                <div class="border-b border-slate-200/70 bg-slate-100">
                  <img
                    src={sponsor.image}
                    alt={`${sponsor.name} website social preview`}
                    class="h-44 w-full object-cover object-center"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="flex items-start justify-between gap-4 p-5">
                <div class="min-w-0">
                  {sponsor.logo && (
                    <img
                      src={sponsor.logo}
                      alt={sponsor.logoAlt ?? sponsor.name}
                      class="mb-4 h-8 w-auto max-w-[12rem] object-contain"
                      loading="lazy"
                    />
                  )}
                  <p class="font-display text-2xl text-[var(--color-ocean-950)]">{sponsor.name}</p>
                  <p class="mt-2 text-sm leading-7 text-slate-600">{sponsor.blurb}</p>
                </div>
                <a
                  href={sponsor.href}
                  target="_blank"
                  rel="noreferrer"
                  class="text-sm font-semibold text-[var(--color-ocean-700)] transition hover:text-[var(--color-ocean-950)]"
                >
                  Visit
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
