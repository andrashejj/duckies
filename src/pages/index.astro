---
import QRCode from "qrcode";

import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const qrCode = await QRCode.toDataURL(site.whatsappUrl, {
  margin: 1,
  width: 320,
  color: {
    dark: "#0b1620",
    light: "#fff5de",
  },
});

const title = `${site.name} | Kids surfing into the sunset in Tamarin Bay`;
const description =
  "A kids' surf club in Tamarin Bay. Young duckies paddling out, getting amazing at surfing, and riding into the sunset week after week.";

const pillarAccents = ["sticker-teal", "sticker-sun", "sticker-coral"];
const pillarTilts = ["tilt-left", "tilt-right", "tilt-left"];
---

<BaseLayout title={title} description={description} page="home">
  <!-- ===================== HERO ===================== -->
  <section class="relative isolate overflow-hidden">
    <div class="absolute inset-0 -z-10">
      <video
        data-hero-video
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster="/media/hero-poster.jpg"
        class="h-full w-full object-cover brightness-[0.5] saturate-[1.15]"
      >
        <source src="/media/hero-wave.mp4" type="video/mp4" />
      </video>
      <div class="absolute inset-0 bg-[linear-gradient(120deg,rgba(11,22,32,0.8)_0%,rgba(20,38,58,0.55)_45%,rgba(7,201,182,0.25)_100%)]"></div>
      <div class="absolute inset-0 mix-blend-overlay opacity-60 bg-[radial-gradient(circle_at_80%_20%,rgba(255,210,63,0.4),transparent_45%)]"></div>
    </div>

    <!-- Floating sticker decorations -->
    <div class="pointer-events-none absolute right-8 top-28 hidden lg:block" aria-hidden="true">
      <div class="floating">
        <div class="relative h-20 w-20">
          <div class="absolute inset-0 rounded-full border-2 border-[var(--color-ink-950)] bg-[var(--color-sun-500)] shadow-[4px_4px_0_0_var(--color-ink-950)]"></div>
          <div class="spin-slow absolute inset-0 flex items-center justify-center font-mono text-[0.58rem] font-semibold uppercase tracking-[0.12em] text-[var(--color-ink-950)]">
            <svg viewBox="0 0 100 100" class="h-full w-full">
              <defs>
                <path id="circle-text" d="M 50,50 m -36,0 a 36,36 0 1,1 72,0 a 36,36 0 1,1 -72,0" />
              </defs>
              <text font-size="12" fill="#0b1620" letter-spacing="2">
                <textPath href="#circle-text">★ tamarin bay · tamarin bay · </textPath>
              </text>
            </svg>
          </div>
        </div>
      </div>
    </div>

    <div class="relative mx-auto flex min-h-[82vh] max-w-7xl flex-col justify-end px-4 pb-14 pt-28 sm:px-6 sm:pb-20 sm:pt-32 lg:px-10 lg:pb-24 lg:pt-36">
      <div data-float class="mb-6">
        <span class="eyebrow-badge">
          <span class="inline-block h-2 w-2 animate-pulse rounded-full bg-[var(--color-coral-500)]"></span>
          Tamarin Bay · Mauritius
        </span>
      </div>

      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-end lg:gap-10">
        <div data-float class="max-w-5xl space-y-6">
          <h1
            class="font-display text-white"
            style="font-size: clamp(3rem, 8.5vw, 7.25rem); line-height: 0.88; letter-spacing: -0.045em; font-variation-settings: 'wdth' 112, 'opsz' 96; font-weight: 600;"
          >
            <span class="block">Salty hair,</span>
            <span class="block">
              <span class="font-accent italic text-[var(--color-sun-500)]" style="font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144; font-weight: 500;">real</span>
              grit.
            </span>
            <span class="block">No <span class="ink-underline text-[var(--color-ink-950)]">cap</span>.</span>
          </h1>
          <p class="max-w-2xl text-base leading-7 text-white/88 sm:text-lg sm:leading-8 md:text-xl md:leading-9">
            {site.name} is a surf club for kids in Tamarin. Two sessions a week, kids training
            together, paddling out and riding home into the sunset.
          </p>
        </div>

        <div data-float class="flex flex-col gap-3">
          <a class="cta-primary w-full" href={site.whatsappUrl} target="_blank" rel="noreferrer">
            Join via WhatsApp
          </a>
          <a class="cta-secondary w-full" href="#sponsors">
            Become a sponsor
          </a>
          <p class="mt-1 text-center font-mono text-[0.68rem] uppercase tracking-[0.22em] text-white/65">
            Mon + Fri · 4-6pm · Tamarin Bay
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== STATS STRIP ===================== -->
  <section class="relative border-b-2 border-[var(--color-ink-950)] bg-[var(--color-coral-500)] text-[var(--color-ink-950)]">
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-0 px-4 sm:px-6 lg:grid-cols-4 lg:px-10">
      {site.stats.map((stat, i) => (
        <div class:list={[
          "flex flex-col items-start gap-1 py-6 pr-6",
          i < site.stats.length - 1 ? "border-r-2 border-[var(--color-ink-950)]/25" : "",
        ]}>
          <p class="font-display text-4xl font-black leading-none md:text-5xl" style="font-variation-settings: 'wdth' 118; font-weight: 800;">
            {stat.value}
          </p>
          <p class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-[var(--color-ink-950)]/80">
            {stat.label}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- ===================== HOW THE CLUB WORKS ===================== -->
  <section id="how-it-works" class="relative border-b-2 border-[var(--color-ink-950)] bg-[var(--color-cream-soft)] py-16 lg:py-20">
    <div class="absolute inset-0 -z-10 opacity-60" aria-hidden="true" style="background-image: radial-gradient(circle at 12% 25%, #ffe1d4, transparent 55%), radial-gradient(circle at 88% 75%, #fff0b3, transparent 55%);"></div>

    <div class="mx-auto max-w-7xl px-6 lg:px-10">
      <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start lg:gap-14">
        <div class="space-y-5" data-reveal>
          <p class="section-kicker">{site.clubRules.kicker}</p>
          <h2 class="section-title" style="font-size: clamp(2rem, 4.5vw, 3.6rem);">
            It's a <span class="font-accent italic text-[var(--color-coral-500)]" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">club</span>.
            <span class="block">Not a <span class="ink-underline">lesson</span>.</span>
          </h2>
          <p class="body-copy max-w-md">
            {site.clubRules.intro}
          </p>
          <div class="flex flex-wrap gap-2 pt-1">
            <span class="chip">BYO surfboard</span>
            <span class="chip">BYO wetsuit</span>
            <span class="chip">Parents responsible</span>
            <span class="chip">No drop-off</span>
          </div>
        </div>

        <div class="grid gap-4 sm:gap-5" data-reveal>
          {site.clubRules.rules.map((rule, i) => (
            <div class:list={["surface-card p-6 sm:p-7", pillarAccents[i % pillarAccents.length]]}>
              <div class="flex items-start gap-4">
                <span class="step-bubble">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <p class="font-display text-xl leading-tight text-[var(--color-ink-950)] sm:text-2xl" style="font-variation-settings: 'wdth' 110; font-weight: 700;">
                    {rule.title}
                  </p>
                  <p class="mt-2 text-[0.98rem] leading-7 text-[var(--color-ink-950)]/80">
                    {rule.text}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== EVENT SPOTLIGHT — SUNSET DUCKIES CUP ===================== -->
  <section class="relative overflow-hidden border-b-2 border-[var(--color-ink-950)] bg-[var(--color-ink-950)] text-[var(--color-cream-soft)]">
    <div class="absolute inset-0 -z-10 opacity-[0.18]" aria-hidden="true" style="background-image: radial-gradient(circle at 18% 20%, var(--color-coral-500), transparent 45%), radial-gradient(circle at 82% 80%, var(--color-sun-500), transparent 45%), radial-gradient(circle at 50% 50%, var(--color-teal-500), transparent 55%);"></div>

    <a href="/sunset-duckies-cup" class="group relative block">
      <div class="mx-auto grid max-w-7xl gap-8 px-6 py-10 lg:grid-cols-[auto_1fr_auto] lg:items-center lg:gap-10 lg:px-10 lg:py-12">
        <div class="flex items-center gap-4">
          <span class="floating inline-flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl border-2 border-[var(--color-cream-soft)] bg-[var(--color-coral-500)] text-3xl shadow-[4px_4px_0_0_var(--color-sun-500)]" aria-hidden="true">
            🦆
          </span>
          <div>
            <p class="font-mono text-[0.66rem] uppercase tracking-[0.28em] text-[var(--color-sun-500)]">
              ★ first ever · vol. 01
            </p>
            <p class="mt-1 font-display text-2xl font-bold leading-tight text-[var(--color-cream-soft)] sm:text-3xl" style="font-variation-settings: 'wdth' 114;">
              Sunset Duckies <span class="font-accent italic text-[var(--color-sun-500)]" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">Cup</span>
            </p>
          </div>
        </div>

        <div class="space-y-3">
          <p class="text-base leading-7 text-[var(--color-cream-soft)]/90 sm:text-lg">
            {site.cup.tagline} Saturday <strong>30 May 2026</strong>, Tamarin Bay, 13:00–17:30.
          </p>
          <div class="flex flex-wrap gap-2">
            <span class="inline-flex items-center gap-1 rounded-full border border-[var(--color-cream-soft)]/40 bg-white/10 px-3 py-1 font-mono text-[0.68rem] uppercase tracking-[0.16em] text-[var(--color-cream-soft)]">🐤 Duckling + 🦆 Duck</span>
            <span class="inline-flex items-center gap-1 rounded-full border border-[var(--color-cream-soft)]/40 bg-white/10 px-3 py-1 font-mono text-[0.68rem] uppercase tracking-[0.16em] text-[var(--color-cream-soft)]">🍔 BBQ + 🏆 prizes</span>
            <span class="inline-flex items-center gap-1 rounded-full border border-[var(--color-cream-soft)]/40 bg-white/10 px-3 py-1 font-mono text-[0.68rem] uppercase tracking-[0.16em] text-[var(--color-cream-soft)]">💸 {site.cup.entryFeeLabel}</span>
          </div>
        </div>

        <div class="flex flex-col gap-2 sm:flex-row lg:flex-col">
          <span class="cta-primary inline-flex">
            See the cup
          </span>
          <span class="font-mono text-[0.66rem] uppercase tracking-[0.2em] text-[var(--color-cream-soft)]/60 lg:text-right">
            ↓ templates + sign-up
          </span>
        </div>
      </div>
    </a>
  </section>

  <!-- ===================== WHY SUNSET DUCKIES ===================== -->
  <section id="why-sunset-duckies" class="relative mx-auto max-w-7xl px-6 pb-14 pt-20 lg:px-10">
    <div class="blob-teal absolute -left-32 top-20 -z-0"></div>
    <div class="blob-coral absolute -right-20 bottom-0 -z-0"></div>

    <div class="relative grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
      <div class="space-y-6" data-reveal>
        <p class="section-kicker">Why Sunset Duckies</p>
        <h2 class="section-title max-w-2xl">
          A
          <span class="ink-underline">steady</span>
          <span class="font-accent italic" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">weekly</span>
          rhythm in Tamarin.
        </h2>
        <p class="body-copy max-w-2xl">
          Two sessions a week. Kids build confidence in the water and become part of the local crew.
        </p>

        <div class="grid gap-4 sm:gap-5">
          {site.pillars.map((pillar, i) => (
            <div class:list={["surface-card p-6", pillarAccents[i % pillarAccents.length]]}>
              <div class="flex items-start gap-4">
                <span class="step-bubble">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <p class="font-display text-2xl leading-tight text-[var(--color-ink-950)]" style="font-variation-settings: 'wdth' 108; font-weight: 600;">
                    {pillar.title}
                  </p>
                  <p class="mt-2 text-[0.98rem] leading-7 text-[var(--color-ink-950)]/75">{pillar.text}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="relative" data-reveal>
        <div class="media-frame aspect-[1.08/0.95] tilt-right transition-transform duration-500">
          <img
            src="/media/board-lineup.jpg"
            alt="Young surfers standing with their boards at the shoreline in Tamarin."
            loading="eager"
          />
        </div>
        <div class="absolute -bottom-6 -left-6 wobble hidden md:block">
          <div class="rounded-full border-2 border-[var(--color-ink-950)] bg-[var(--color-teal-500)] px-5 py-3 shadow-[4px_4px_0_0_var(--color-ink-950)]">
            <p class="font-display text-lg font-bold text-[var(--color-ink-950)]" style="font-variation-settings: 'wdth' 110;">
              ✦ Tamarin Bay
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== SCHEDULE + COMPETITION ===================== -->
  <section id="schedule" class="mx-auto max-w-7xl px-6 py-14 lg:px-10">
    <div class="grid gap-6 lg:grid-cols-[1fr_1fr]">
      <div class="surface-card sticker-sun p-8" data-reveal>
        <p class="section-kicker">Weekly rhythm</p>
        <h2 class="section-title mt-4" style="font-size: clamp(1.7rem, 3vw, 2.6rem);">
          Monday <span class="font-accent italic">+</span> Friday, 4-6pm.
        </h2>
        <div class="mt-6 grid gap-4">
          {site.schedule.map((session) => (
            <div class="rounded-[1.4rem] border-2 border-[var(--color-ink-950)] bg-[var(--color-cream-soft)] p-5 shadow-[3px_3px_0_0_var(--color-ink-950)]">
              <div class="flex items-center justify-between gap-4">
                <p class="font-display text-2xl text-[var(--color-ink-950)]" style="font-variation-settings: 'wdth' 110; font-weight: 700;">
                  {session.day}
                </p>
                <p class="font-mono text-sm font-semibold text-[var(--color-coral-500)]">
                  {session.time}
                </p>
              </div>
              <p class="mt-2 text-[0.95rem] leading-7 text-[var(--color-ink-950)]/72">{session.focus}</p>
            </div>
          ))}
        </div>

        <p class="mt-6 font-mono text-[0.7rem] uppercase tracking-[0.2em] text-[var(--color-ink-950)]/65">
          ↑ <a href="#how-it-works" class="underline decoration-[var(--color-coral-500)] decoration-2 underline-offset-4 hover:text-[var(--color-coral-500)]">How the club works</a> — BYO board + wetsuit, parents responsible.
        </p>
      </div>

      <div class="surface-card sticker-coral p-8" data-reveal>
        <p class="section-kicker">{site.competition.label}</p>
        <h2 class="section-title mt-4" style="font-size: clamp(1.7rem, 3vw, 2.6rem);">
          {site.competition.title}
        </h2>
        <p class="body-copy mt-4">
          {site.competition.description}
        </p>
        <div class="mt-6 rounded-[1.4rem] border-2 border-[var(--color-ink-950)] bg-[var(--color-ink-950)] p-5 text-[var(--color-cream-soft)] shadow-[4px_4px_0_0_var(--color-sun-500)]">
          <p class="font-mono text-[0.66rem] uppercase tracking-[0.22em] text-[var(--color-sun-500)]">
            ★ Next up — first ever
          </p>
          <p class="mt-2 font-display text-xl leading-tight text-[var(--color-cream-soft)] sm:text-2xl" style="font-variation-settings: 'wdth' 112; font-weight: 700;">
            Sunset Duckies <span class="font-accent italic text-[var(--color-sun-500)]" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">Cup</span> — Sat 30 May 2026 🦆
          </p>
          <p class="mt-2 text-[0.92rem] leading-6 text-[var(--color-cream-soft)]/85">
            Tamarin Bay, 13:00–17:30. Heats of 4, two divisions, BBQ on the sand, parent heat at 16:30.
          </p>
          <a href="/sunset-duckies-cup" class="mt-4 inline-flex items-center gap-2 rounded-full border-2 border-[var(--color-cream-soft)] bg-[var(--color-coral-500)] px-4 py-2 font-display text-sm font-bold uppercase tracking-wide text-[var(--color-ink-950)] shadow-[3px_3px_0_0_var(--color-sun-500)] transition-transform hover:-translate-y-0.5" style="font-variation-settings: 'wdth' 108;">
            See the cup →
          </a>
        </div>
        <div class="mt-6 flex flex-wrap gap-3">
          <span class="chip">Milestones to train towards</span>
          <span class="chip">Beach day for the families</span>
          <span class="chip">Sponsor visibility</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== THE PATH / PROGRESSION ===================== -->
  <section id="how-it-works" class="mx-auto max-w-7xl px-6 py-14 lg:px-10">
    <div class="surface-card sticker-lilac p-8 md:p-10" data-reveal>
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <div class="space-y-5">
          <p class="section-kicker">The path</p>
          <h2 class="section-title">
            From first
            <span class="font-accent italic" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">whitewater</span>
            to <span class="ink-underline">chasing</span> the sunset line.
          </h2>
          <p class="body-copy max-w-xl">
            Every duckie starts in the whitewater. Week by week the kids progress at their own pace,
            until they're paddling out with the crew.
          </p>
        </div>

        <div class="grid gap-4">
          <div class="rounded-[1.4rem] border-2 border-[var(--color-ink-950)] bg-[var(--color-cream-soft)] p-5 shadow-[3px_3px_0_0_var(--color-ink-950)]">
            <p class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-[var(--color-coral-500)]">
              Two sessions a week
            </p>
            <p class="mt-2 font-display text-xl text-[var(--color-ink-950)]" style="font-variation-settings: 'wdth' 110; font-weight: 700;">
              Monday + Friday, 4-6pm.
            </p>
            <p class="mt-2 text-[0.95rem] leading-7 text-[var(--color-ink-950)]/78">
              Technique, whitewater reps, and sunset paddle-outs.
            </p>
          </div>

          <div class="rounded-[1.4rem] border-2 border-[var(--color-ink-950)] bg-[var(--color-cream-soft)] p-5 shadow-[3px_3px_0_0_var(--color-ink-950)]">
            <p class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-[var(--color-coral-500)]">
              Bring your own kit
            </p>
            <p class="mt-2 font-display text-xl text-[var(--color-ink-950)]" style="font-variation-settings: 'wdth' 110; font-weight: 700;">
              Surfboard + wetsuit, on the family.
            </p>
            <p class="mt-2 text-[0.95rem] leading-7 text-[var(--color-ink-950)]/78">
              Buy or borrow — we'll point you to the right shape and size, no guesswork.
            </p>
          </div>

          <div class="rounded-[1.4rem] border-2 border-[var(--color-ink-950)] bg-[var(--color-cream-soft)] p-5 shadow-[3px_3px_0_0_var(--color-ink-950)]">
            <p class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-[var(--color-coral-500)]">
              Annual dues
            </p>
            <p class="mt-2 flex items-baseline gap-2 font-display text-xl text-[var(--color-ink-950)]" style="font-variation-settings: 'wdth' 110; font-weight: 700;">
              {site.membership.feeLabel}
              <span class="font-mono text-[0.7rem] font-normal uppercase tracking-[0.18em] text-[var(--color-ink-950)]/55">
                ≈ ${site.membership.annualFeeUsdApprox} USD
              </span>
            </p>
            <p class="mt-2 text-[0.95rem] leading-7 text-[var(--color-ink-950)]/78">
              {site.membership.fundingNote}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== TRAINING + WHATSAPP ===================== -->
  <section class="mx-auto max-w-7xl px-6 py-10 lg:px-10">
    <div class="grid gap-6 lg:grid-cols-[1fr_1fr]">
      <div class="surface-card sticker-teal p-8" data-reveal>
        <p class="section-kicker">Training materials</p>
        <h2 class="section-title mt-4" style="font-size: clamp(1.7rem, 3vw, 2.6rem);">
          A <span class="ink-underline">library</span> for home practice.
        </h2>
        <p class="body-copy mt-4 max-w-2xl">
          Pop-up practice, balance work, ocean knowledge, and surf videos — all in one spot.
        </p>
        <div class="mt-8">
          <a class="cta-primary" href="/training-materials">
            Open the training library
          </a>
        </div>
      </div>

      <div class="surface-card sticker-lilac p-8" data-reveal>
        <p class="section-kicker">WhatsApp</p>
        <h2 class="section-title mt-4" style="font-size: clamp(1.7rem, 3vw, 2.6rem);">
          The club group.
        </h2>
        <p class="body-copy mt-4">
          Join the WhatsApp to get session updates and stay in the loop.
        </p>
        <div class="mt-6 flex flex-col gap-5 sm:flex-row sm:items-center">
          <div class="rounded-[1.5rem] border-2 border-[var(--color-ink-950)] bg-[var(--color-cream-soft)] p-4 shadow-[4px_4px_0_0_var(--color-ink-950)]">
            <img
              src={qrCode}
              alt="QR code linking to the Sunset Duckies WhatsApp group."
              class="h-40 w-40 rounded-xl"
            />
          </div>
          <div class="space-y-3">
            <p class="text-sm leading-7 text-[var(--color-ink-950)]/72">
              Scan to open the club WhatsApp directly on your phone.
            </p>
            <a class="cta-primary" href={site.whatsappUrl} target="_blank" rel="noreferrer">
              Open WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== FOUNDERS ===================== -->
  <section class="mx-auto max-w-7xl px-6 py-18 lg:px-10">
    <div class="space-y-10" data-reveal>
      <div class="max-w-3xl">
        <p class="section-kicker">Founder</p>
        <h2 class="section-title mt-4">
          Who runs the
          <span class="font-accent italic" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">club</span>.
        </h2>
      </div>

      <div class="mx-auto grid w-full max-w-3xl gap-6">
        {site.founders.map((founder, i) => (
          <article class:list={[
            "surface-card overflow-hidden",
            i % 2 === 0 ? "tilt-left" : "tilt-right",
            "transition-transform duration-500",
          ]}>
            <div class:list={founder.image ? "grid gap-0 md:grid-cols-[0.92fr_1.08fr]" : "block"}>
              {founder.image && (
                <div class="bg-[var(--color-cream-deep)]">
                  <img
                    src={founder.image}
                    alt={founder.name}
                    class="h-full w-full object-cover"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="p-6 md:p-7">
                <p class="font-display text-3xl text-[var(--color-ink-950)]" style="font-variation-settings: 'wdth' 112; font-weight: 700;">
                  {founder.name}
                </p>
                <p class="mt-2 font-mono text-xs font-semibold uppercase tracking-[0.22em] text-[var(--color-coral-500)]">
                  ✦ {founder.role}
                </p>
                <p class="mt-4 text-[0.95rem] leading-7 text-[var(--color-ink-950)]/75">{founder.bio}</p>
                {founder.href && (
                  <a
                    class="mt-6 inline-flex font-mono text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-ink-950)] underline decoration-[var(--color-coral-500)] decoration-2 underline-offset-4 transition hover:text-[var(--color-coral-500)]"
                    href={founder.href}
                    target="_blank"
                    rel="noreferrer"
                  >
                    Visit site →
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== SPONSORS ===================== -->
  <section id="sponsors" class="mx-auto max-w-7xl px-6 pb-24 pt-8 lg:px-10">
    <div class="surface-card p-8 md:p-10">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <div data-reveal class="space-y-5">
          <p class="section-kicker">Sponsors</p>
          <h2 class="section-title">
            Become a <span class="ink-underline">founding</span> sponsor.
          </h2>
          <p class="body-copy max-w-2xl">
            A founding sponsor helps the club run bigger comp days, fund club lycras, and offer
            scholarships for kids who otherwise couldn't paddle out.
          </p>
          <a
            class="cta-primary"
            href={site.sponsorContactUrl}
            target="_blank"
            rel="noreferrer"
          >
            Become a founding sponsor
          </a>
        </div>

        <div class="grid gap-5">
          {site.sponsors.map((sponsor, i) => (
            <article class:list={[
              "surface-card overflow-hidden",
              i % 2 === 0 ? "sticker-sun" : "sticker-teal",
            ]} data-reveal>
              {sponsor.image && (
                <div class="border-b-2 border-[var(--color-ink-950)] bg-[var(--color-cream-deep)]">
                  <img
                    src={sponsor.image}
                    alt={`${sponsor.name} website social preview`}
                    class="h-44 w-full object-cover object-center"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="flex items-start justify-between gap-4 p-6">
                <div class="min-w-0">
                  {sponsor.logo && (
                    <img
                      src={sponsor.logo}
                      alt={sponsor.logoAlt ?? sponsor.name}
                      class="mb-4 h-8 w-auto max-w-[12rem] object-contain"
                      loading="lazy"
                    />
                  )}
                  <p class="font-display text-2xl text-[var(--color-ink-950)]" style="font-variation-settings: 'wdth' 110; font-weight: 700;">
                    {sponsor.name}
                  </p>
                  <p class="mt-2 text-[0.95rem] leading-7 text-[var(--color-ink-950)]/75">{sponsor.blurb}</p>
                </div>
                <a
                  href={sponsor.href}
                  target="_blank"
                  rel="noreferrer"
                  class="shrink-0 font-mono text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-ink-950)] underline decoration-[var(--color-coral-500)] decoration-2 underline-offset-4 transition hover:text-[var(--color-coral-500)]"
                >
                  Visit →
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
