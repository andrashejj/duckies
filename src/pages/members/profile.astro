---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import FamilyDeck from "../../components/react/FamilyDeck";
import { site } from "../../data/site";
import { upcomingEvents } from "../../lib/club-events";
import { familyProfile, type FamilyProfile } from "../../lib/registration/family";
import { membershipCovers } from "../../lib/registration/policy";
const session = Astro.locals.session!;
const email = session.user.email.trim().toLowerCase();
let profile: FamilyProfile | null = null;
try { profile = await familyProfile({ email, name: session.user.name }); }
catch (error) { Astro.response.status = 503; console.error("[members/profile] load failed:", error); }
const events = upcomingEvents({ term: profile?.term ?? null });
---
<BaseLayout title={`My family · ${site.name}`} description="Your parents, duckies and private club records." workspace="member" section="family">
  <section class="family-page">
    <header class="social-page-header">
      <div><h1>My family</h1><p>Your people and their club records. Only shared with your family and organisers.</p></div>
      {(session.member || session.archivedAt) && <a href="/members/me" class="journal-button">Our photos & moments</a>}
    </header>
    {!profile ? <div role="alert"><p>Your family's page couldn't load. Please try again.</p><a href="/members/profile" class="family-text-link">Try again</a></div> : <>
      <FamilyDeck client:load profile={profile} />
      <details class="family-reference">
        <summary>Club dates & semester fees</summary>
        {session.member && <>
          <h3>Upcoming club dates</h3>
          <ul class="family-dates" aria-label="Upcoming club dates">{events.map(event => <li>
            <strong>{event.title}</strong><p>{event.dayLabel} · {event.timeLabel}</p><p>{event.detail}</p>
            {event.href && <a class="family-text-link" href={event.href}>Read more</a>}
          </li>)}</ul>
          {!events.length && <p>No dates on the board right now. The club posts the next semester on WhatsApp.</p>}
        </>}
        <h3>{profile.term.label}</h3>
        <p>Rs {profile.term.childFeeMur.toLocaleString("en-US")} per child · Rs {profile.term.familyFeeMur.toLocaleString("en-US")} for the whole family.</p>
        <h3>What it covers</h3>
        <ul>{membershipCovers.included.map(line => <li>{line}</li>)}</ul>
        <h3>Bring your own</h3>
        <p>A surfboard and a wetsuit or rashie, every session. The club doesn't lend, rent or store gear.</p>
        <a class="family-text-link" href={site.whatsappUrl} target="_blank" rel="noreferrer">Questions? Message the club</a>
      </details>
    </>}
  </section>
</BaseLayout>
