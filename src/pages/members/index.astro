---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import SocialFeed from '../../components/react/SocialFeed';
import { listPosts, socialPerson } from '../../lib/server/social';
import { photoKids } from '../../lib/server/photo-profiles';
import { site } from '../../data/site';
const session = Astro.locals.session!;
const actor = { ...session.member!, userId: session.user.id };
const cupComing = site.cupVol2.dateISO >= new Intl.DateTimeFormat('en-CA', { timeZone: 'Indian/Mauritius', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
let data;
try {
  const [feed, person, kids] = await Promise.all([listPosts(actor), socialPerson(actor.userId), photoKids(actor)]);
  data = { feed, person: person!, kids: kids.filter(k => k.canManage) };
} catch { Astro.response.status = 503; }
---
<BaseLayout title="The club · Sunset Duckies" variant="journal">
  <section class="club-home club-home-simple">
    <header class="social-page-header"><div><h1>The club</h1><p>See you in the water.</p></div><span class="social-private">Members only</span></header>
    <section class="club-session" aria-labelledby="session-title">
      <p class="club-session-eyebrow">Our weekly surf</p>
      <h2 id="session-title">Monday & Friday <span>4–6pm</span></h2>
      <p>Tamarin Bay · Bring your board and a wetsuit or rashie. One parent from each family stays in the water for the full session.</p>
      <a href={site.whatsappUrl} target="_blank" rel="noreferrer">Check the latest surf call on WhatsApp ↗</a>
    </section>
    {cupComing && <a href="/sunset-duckies-cup-vol-2" class="club-event-link"><span><strong>{site.cupVol2.name} · {site.cupVol2.edition}</strong><span>{site.cupVol2.dateLabel}</span></span><span aria-hidden="true">→</span></a>}
    <div class="club-useful-links" aria-label="Around the club">
      <a href="/members/lineup">Meet the crew</a>
      <a href="/training-materials">Surf tips</a>
      {!cupComing && <a href="/sunset-duckies-cup-vol-2">The Cup</a>}
    </div>
    {!data ? <p role="alert" class="social-error">The club is temporarily unavailable. Please reload to try again.</p> : <section class="club-moments" aria-labelledby="club-moments-heading">
      <h2 id="club-moments-heading">From the crew</h2>
      <SocialFeed client:load initialPosts={data.feed.posts} next={data.feed.next} person={data.person} compose kids={data.kids} />
    </section>}
  </section>
</BaseLayout>
