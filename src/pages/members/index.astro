---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import SocialFeed from '../../components/react/SocialFeed';
import { listPosts, socialPerson } from '../../lib/server/social';
import { photoKids } from '../../lib/server/photo-profiles';
import { site } from '../../data/site';
const session = Astro.locals.session!;
const actor = { ...session.member!, userId: session.user.id };
const cupComing = site.cupVol2.dateISO >= new Intl.DateTimeFormat('en-CA', { timeZone: 'Indian/Mauritius', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
let data;
try {
  const [feed, person, kids] = await Promise.all([listPosts(actor), socialPerson(actor.userId), photoKids(actor)]);
  data = { feed, person: person!, kids: kids.filter(k => k.canManage) };
} catch { Astro.response.status = 503; }
---
<BaseLayout title="My Feed · Sunset Duckies" variant="journal">
  <section class="club-home club-feed-home">
    <header class="social-page-header"><div><h1>My Feed</h1><p>Good waves, small wins and life with the crew.</p></div><span class="social-private">Members only</span></header>
    <div class="club-feed-layout">
      <aside class="club-noticeboard" aria-label="Club information">
        <details class="club-at-bay" open data-club-info>
          <summary><span>At the bay<span>Monday & Friday · 4–6pm</span></span><span class="club-info-toggle" aria-hidden="true">＋</span></summary>
          <div class="club-info-body">
            <section class="club-session" aria-labelledby="session-title">
              <p class="club-session-eyebrow">Our weekly surf</p>
              <h2 id="session-title">Monday & Friday</h2>
              <p class="club-session-time">4–6pm <span>· Tamarin Bay</span></p>
              <p>Bring your board and a wetsuit or rashie. One parent from each family stays in the water for the full session.</p>
              <a href={site.whatsappUrl} target="_blank" rel="noreferrer">Latest surf call on WhatsApp ↗</a>
            </section>
            <section class="club-next-event" aria-labelledby="cup-title">
              <p class="club-session-eyebrow">{cupComing ? 'Next up' : 'From the club'}</p>
              <a href="/sunset-duckies-cup-vol-2"><h2 id="cup-title">Sunset Duckies Cup <span>{site.cupVol2.edition}</span></h2><p>{site.cupVol2.dateLabel}</p><span class="club-event-more">{cupComing ? 'See the programme' : 'Revisit the Cup'} <span aria-hidden="true">→</span></span></a>
              <a href="/members/cup" class="club-event-more">Heats, timetable &amp; lineup <span aria-hidden="true">→</span></a>
            </section>
            <a class="club-surf-tips" href="/members/training">Roll call & leaderboard <span aria-hidden="true">→</span></a>
            <a class="club-surf-tips" href="/training-materials">Surf tips & training <span aria-hidden="true">↗</span></a>
          </div>
        </details>
      </aside>
      <section class="club-feed-column" aria-label="Crew moments">
        {!data ? <p role="alert" class="social-error">The feed is temporarily unavailable. Please reload to try again.</p> : <SocialFeed client:load initialPosts={data.feed.posts} next={data.feed.next} person={data.person} compose kids={data.kids} />}
      </section>
    </div>
  </section>
</BaseLayout>
<script>
  const info = document.querySelector<HTMLDetailsElement>('[data-club-info]');
  const compact = window.matchMedia('(max-width: 1100px)');
  function setInfoLayout() { if (info) info.open = !compact.matches; }
  setInfoLayout();
  compact.addEventListener('change', setInfoLayout);
</script>
