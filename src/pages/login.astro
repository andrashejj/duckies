---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import Cta from "../components/ui/Cta.astro";
import Kicker from "../components/ui/Kicker.astro";
import SectionTitle from "../components/ui/SectionTitle.astro";
import StickerCard from "../components/ui/StickerCard.astro";
import { bodyCopy } from "../lib/ui";
import { memberForm, memberStatus, textButton } from "../lib/members-ui";
---

<BaseLayout title="Sign in | Sunset Duckies" description="Sign in to the Sunset Duckies members area.">
  <section class="mx-auto max-w-xl px-6 py-16 sm:py-24">
    <Kicker id="login-kicker">For our surf families</Kicker>
    <SectionTitle as="h1" class="mt-4">Back with the <span class="font-accent italic">crew.</span></SectionTitle>
    <p id="login-intro" class={`mt-6 ${bodyCopy}`}>Sign in to the club’s members area to see the duckies. We’ll email you a six-digit code — no password to remember.</p>
    <StickerCard class="mt-8 p-6 sm:p-8">
      <form id="email-form" class={memberForm}>
        <label for="email">Your email address</label>
        <input id="email" type="email" name="email" autocomplete="email" required maxlength="254" placeholder="you@example.com" />
        <Cta type="submit">Email me a code</Cta>
      </form>
      <form id="code-form" class={memberForm} hidden>
        <p id="code-help" class="text-sm leading-6">If your email has access, a code is on its way. It’s valid for 10 minutes.</p>
        <label for="code">Your six-digit code</label>
        <input id="code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" minlength="6" maxlength="6" required aria-describedby="code-help" />
        <Cta type="submit">Sign in</Cta>
        <button id="change-email" class={textButton} type="button">Use another email or request a new code</button>
      </form>
      <p id="login-status" class={memberStatus} role="status" aria-live="polite"></p>
      <noscript><p class="mt-4">Please enable JavaScript to sign in.</p></noscript>
    </StickerCard>
    <p class="mt-7 text-sm leading-6">Use your club-approved email address. Need club access? <a class="underline underline-offset-4" href={site.whatsappUrl} target="_blank" rel="noreferrer">Contact the club on WhatsApp.</a></p>
  </section>
</BaseLayout>

<script>
  import { authClient } from "../lib/auth-client";

  const emailForm = document.querySelector<HTMLFormElement>("#email-form")!;
  const codeForm = document.querySelector<HTMLFormElement>("#code-form")!;
  const emailInput = document.querySelector<HTMLInputElement>("#email")!;
  const codeInput = document.querySelector<HTMLInputElement>("#code")!;
  const status = document.querySelector<HTMLElement>("#login-status")!;
  let email = "";

  const requestedPath = new URLSearchParams(window.location.search).get("next");
  const destination = requestedPath && /^\/(account|admin|members|branding-plan|product-ideas|sunset-duckies-cup-vol-2|cup\/judge)([/?#]|$)/.test(requestedPath) && !/[\\\r\n]/.test(requestedPath)
    ? requestedPath : null;
  if (destination?.startsWith("/branding-plan") || destination?.startsWith("/product-ideas")) {
    document.querySelector("#login-kicker")!.textContent="Project Molt / Private workspace";
    document.querySelector("#login-intro")!.textContent="Sign in with your approved email. We’ll send a six-digit code.";
  } else if (destination?.startsWith("/sunset-duckies-cup-vol-2")) {
    document.querySelector("#login-kicker")!.textContent="Cup Vol. 02 · members";
    document.querySelector("#login-intro")!.textContent="Sign in with the email on your club registration and we’ll take you back to the Cup page to pick who’s coming. No code arriving? Your email isn’t approved for sign-in yet — ping Andras on WhatsApp.";
  } else if (destination?.startsWith("/cup/judge")) {
    document.querySelector("#login-kicker")!.textContent="Cup Vol. 02 · Judges";
    document.querySelector("#login-intro")!.textContent="Sign in with the email on your child’s registration or your club invitation. We’ll send a six-digit code so you can volunteer to judge a heat.";
  }
  authClient.getSession().then(({ data }) => {
    if (data) void finishSignIn();
  }).catch(() => {});

  async function finishSignIn() {
    if (destination) { window.location.replace(destination); return; }
    const response = await fetch("/api/session", { cache: "no-store" });
    if (!response.ok) throw new Error("Couldn't load your account. Please try again.");
    const session = await response.json();
    window.location.replace(session.home);
  }

  async function submit(form: HTMLFormElement, action: () => Promise<void>) {
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    button.disabled = true;
    status.textContent = "";
    try { await action(); }
    catch { status.textContent = "Couldn't connect. Please try again."; }
    finally { button.disabled = false; }
  }
  emailForm.addEventListener("submit", (event) => {
    event.preventDefault();
    void submit(emailForm, async () => {
      email = emailInput.value.trim().toLowerCase();
      const { error } = await authClient.emailOtp.sendVerificationOtp({ email, type: "sign-in" });
      if (error) {
        status.textContent = error.status === 429 ? "Please wait a minute before requesting another code." : "Couldn't send a code right now. Please try again shortly.";
        return;
      }
      emailForm.hidden = true;
      codeForm.hidden = false;
      codeInput.focus();
    });
  });
  codeForm.addEventListener("submit", (event) => {
    event.preventDefault();
    void submit(codeForm, async () => {
      const { error } = await authClient.signIn.emailOtp({ email, otp: codeInput.value.trim() });
      if (error) {
        status.textContent = "That code couldn’t sign you in. Check it or request a new one. If you still need access, contact the club.";
        return;
      }
      await finishSignIn();
    });
  });
  document.querySelector("#change-email")!.addEventListener("click", () => {
    codeForm.hidden = true;
    emailForm.hidden = false;
    codeInput.value = "";
    status.textContent = "";
    emailInput.focus();
  });
</script>
