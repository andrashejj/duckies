---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/plan.css";
import { site } from "../data/site";

const title = `Common Water product candidates | ${site.name}`;
const description =
  "Four Sunset Duckies product concepts to draft, interview, compare and narrow to one proof of concept for an end-of-October launch in Tamarin.";

const ideas = [
  {
    code: "01",
    category: "Surf nutrition",
    name: "A healthy granola",
    depth: "Leading hypothesis",
    lead:
      "Granola is the current front-runner. A small-batch product made locally still has to beat the other three concepts in interviews and maker checks.",
    fields: [
      {
        label: "The idea",
        text: "A breakfast and recovery granola sold in bags and made locally in small batches. The concept must define what makes it healthy instead of using the word as an unsupported claim.",
      },
      {
        label: "Who for",
        text: "Families around the club who already buy breakfast every few weeks, and kids eating before or after a session.",
      },
      {
        label: "What it takes",
        text: "A kitchen or co-packer, ingredient sourcing, hygiene approval, nutrition information, allowed claims, shelf-life testing and packaging that survives a school bag. Cheaper and quicker to trial than a garment or a board.",
      },
      {
        label: "Value model to test",
        text: "Ingredients, packaging, kitchen time and paid local work come out of the price first. What happens after that is open: a Tamarin contribution, revenue share, a shared fund or a mix.",
      },
      {
        label: "The link to test",
        text: "The product has a credible local maker story and repeat purchase, but the assessment still has to prove whether it can carry the wider Sunset Duckies community model beyond Tamarin.",
      },
    ],
    unknowns: [
      "Which local maker wants to develop it, and how their role, time, payment, approval and credit work.",
      "What healthy means in the recipe and nutrition information, and what the packaging may claim.",
      "What a bag costs to make, what it sells for, and the surplus left per bag.",
      "Which value model is clear to buyers, fair to the people doing the work and viable at small volume.",
      "Who carries production, stock and compliance risk.",
      "Whether another microcommunity could adapt the product without copying the Tamarin story.",
    ],
  },
  {
    code: "02",
    category: "Surf gear",
    name: "A first surfboard",
    depth: "Sketch",
    lead:
      "The technical end of the range, and the piece of gear that most often decides whether a kid can join at all.",
    fields: [
      {
        label: "The idea",
        text: "A durable first board for kids learning in Tamarin, built to be handed down rather than outgrown and replaced.",
      },
      {
        label: "Who for",
        text: "Families buying a first board, and the club itself, which needs boards to lend to kids who do not have one.",
      },
      {
        label: "What it takes",
        text: "The hardest of the four to produce, test, transport and store. Highest price, slowest cycle, most capital tied up per unit.",
      },
      {
        label: "Value model to test",
        text: "Not worked out. Options include paid local shaping, a contribution linked to each board, a community purchase programme or a mix.",
      },
      {
        label: "The tension",
        text: "It solves the gear barrier most directly and is the least realistic thing for a small club to make first. Worth drilling into precisely because those two pull against each other.",
      },
    ],
    unknowns: [
      "Whether we make boards, commission them, or buy them well.",
      "What a first board should cost a family here, and what that leaves.",
      "Whether a shaper locally would work with the club.",
      "How a hand-me-down scheme would actually run.",
    ],
  },
  {
    code: "03",
    category: "Everyday wear",
    name: "Not yet ideated",
    depth: "Heading only",
    lead:
      "Clothes for ordinary days, off the water. No concrete idea attached yet, which is a gap to close rather than a verdict.",
    fields: [
      {
        label: "The idea",
        text: "Open. The research should name the item families keep buying, then this becomes a specific product rather than a category.",
      },
      {
        label: "Who for",
        text: "Kids and parents, worn on days with no surfing in them. The widest audience of the four and the least specific problem.",
      },
      {
        label: "What it takes",
        text: "Sizing across growing kids, minimum orders, stock sitting in boxes. Easy to design, easy to get wrong, easy to end up with unsold sizes.",
      },
      {
        label: "Value model to test",
        text: "Not worked out. Local production income, a per-sale contribution and a shared brand margin need to be compared rather than assumed.",
      },
      {
        label: "The risk",
        text: "This is the category a club drifts into by default: a logo on a t-shirt. It only earns its place if it solves something the research actually surfaced.",
      },
    ],
    unknowns: [
      "Which item families name most often.",
      "Whether anyone outside the club would buy it.",
      "How to avoid sizing waste at small volumes.",
    ],
  },
  {
    code: "04",
    category: "Surf wear",
    name: "Not yet ideated",
    depth: "Heading only",
    lead:
      "Worn in the water: lycras, wetsuits, anything that has to survive salt, sun and a growing body.",
    fields: [
      {
        label: "The idea",
        text: "Open. A long-life lycra is the obvious candidate, but nothing has been worked up.",
      },
      {
        label: "Who for",
        text: "Every kid in the club already wears one, and the club buys club lycras out of dues today.",
      },
      {
        label: "What it takes",
        text: "Technical fabric, fit across sizes, minimum orders. Harder than food, easier than a board.",
      },
      {
        label: "Value model to test",
        text: "Not worked out. The product could create local paid work, reduce what the Tamarin group already spends, return value per sale or combine those routes.",
      },
      {
        label: "The angle",
        text: "The only category where the club is already a customer of itself. Worth checking whether that changes the maths.",
      },
    ],
    unknowns: [
      "What the club currently spends on lycras, and with whom.",
      "Whether growth-friendly fit is real or a marketing line.",
      "Minimum order against the size of the club.",
    ],
  },
];

const criteria = [
  {
    name: "The problem it solves",
    note: "Named by families in the research, not by us.",
  },
  {
    name: "Evidence people will buy",
    note: "Orders, pre-orders and refusals at a tested price.",
  },
  {
    name: "The quality standard",
    note: "A claim with a test, not an adjective.",
  },
  {
    name: "Local production",
    note: "Maker, work done here, imported inputs, capacity and quality control.",
  },
  {
    name: "Fair maker involvement",
    note: "Payment, credit, approval and ownership agreed before launch.",
  },
  {
    name: "Production risk",
    note: "Rules, minimums, lead time, storage, delivery and cash tied up.",
  },
  {
    name: "Economics and community value",
    note: "Quoted unit cost, retail price, margin, local paid work and the value option being tested.",
  },
  {
    name: "Would the kids use it",
    note: "The one criterion no adult can answer.",
  },
  {
    name: "Can the model travel",
    note: "Another microcommunity can adapt it without borrowing Tamarin's identity or relationships.",
  },
];
---

<BaseLayout title={title} description={description} variant="performance">
  <div class="performance-plan">
    <section class="plan-section plan-ideas-hero" data-reveal>
      <div class="plan-section-head">
        <p class="plan-overline">Common Water · product candidates</p>
        <h2>Draft four. Then choose one.</h2>
        <p>
          Complete all four concepts by 7 September. Interview against the same four, choose
          one from the evidence, then build it for the end-of-October competition and launch.
          Granola leads today, but it has not won. The <a href="/branding-plan">project brief</a>
          defines the full sequence.
        </p>
      </div>

      <div class="plan-access">
        <div class="plan-access-head">
          <p class="plan-overline">How to read this</p>
          <h3>The same evidence is required for every candidate.</h3>
        </div>
        <dl class="plan-access-list">
          <div>
            <dt>Leading hypothesis</dt>
            <dd>The most likely route going in. It still competes on the same evidence.</dd>
          </div>
          <div>
            <dt>Sketch</dt>
            <dd>A direction and a tension, no detail underneath it yet.</dd>
          </div>
          <div>
            <dt>Heading only</dt>
            <dd>A category with nothing in it. The gap is the point.</dd>
          </div>
        </dl>
      </div>
    </section>

    <div class="plan-divider" aria-hidden="true"></div>

    {
      ideas.map((idea) => (
        <section class="plan-section plan-idea" data-reveal>
          <div class="plan-idea-head">
            <div class="plan-card-code">
              <span>{idea.code}</span>
              <span>{idea.category}</span>
            </div>
            <h2>{idea.name}</h2>
            <p class="plan-idea-lead">{idea.lead}</p>
            <span class:list={["plan-idea-depth", idea.depth === "Leading hypothesis" && "is-full"]}>
              {idea.depth}
            </span>
          </div>

          <dl class="plan-idea-fields">
            {
              idea.fields.map((field) => (
                <div>
                  <dt>{field.label}</dt>
                  <dd>{field.text}</dd>
                </div>
              ))
            }
          </dl>

          <div class="plan-questions">
            <p class="plan-overline">Unknown</p>
            <ul>
              {idea.unknowns.map((unknown) => <li>{unknown}</li>)}
            </ul>
          </div>
        </section>
      ))
    }

    <div class="plan-divider" aria-hidden="true"></div>

    <section id="evaluation" class="plan-section" data-reveal>
      <div class="plan-section-head">
        <p class="plan-overline">Evaluation</p>
        <h2>The same nine tests for all four.</h2>
        <p>
          Filled in during the research, not now. A candidate that wins on paper and loses at
          training has lost.
        </p>
      </div>

      <div class="plan-matrix-scroll">
        <table class="plan-matrix">
          <thead>
            <tr>
              <th scope="col">Criterion</th>
              {ideas.map((idea) => <th scope="col">{idea.category}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              criteria.map((criterion) => (
                <tr>
                  <th scope="row">
                    {criterion.name}
                    <span>{criterion.note}</span>
                  </th>
                  {ideas.map(() => <td aria-label="Not yet assessed">—</td>)}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="plan-note">
        Interviews run from 8 to 18 September and the product decision closes on 25 September.
        Families, kids, outside buyers and makers supply the evidence. The winner moves into proof-of-concept
        work and an end-of-October launch; the other three stay here with the reasons they did not pass.
      </p>

      <a class="plan-jump" href="/branding-plan">
        <span class="plan-jump-label">Back to the project brief</span>
        <span class="plan-jump-title">How these get tested, compared and decided</span>
        <span class="plan-jump-cta">Open the project brief <span aria-hidden="true">→</span></span>
      </a>
    </section>
  </div>
</BaseLayout>
