---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Kicker from "../../components/ui/Kicker.astro";
import CupLive from "../../components/react/CupLive";
import { site } from "../../data/site";
import { eyebrowBadge } from "../../lib/ui";

// Static shell; the board itself polls /api/cup/live and stays dark until the
// organisers switch it live on the day.
const cup = site.cupVol2;
const title = `Live leaderboard — ${cup.name} Vol. 02 | ${site.name}`;
const description = `Live heats, scores and the leaderboard from the Sunset Duckies Cup Vol. 02 at Tamarin Bay, updated wave by wave on ${cup.dateLabel}.`;
---

<BaseLayout title={title} description={description} image="/media/cup/vol-2-og.jpg" imageAlt="The Final of Cup Vol. 01 at sunset, Tamarin Bay." imageWidth={1200} imageHeight={630}>
  <section class="relative isolate overflow-hidden border-b-2 border-edge bg-ink-950 text-cream">
    <div class="absolute inset-0 -z-10 bg-linear-135 from-ink-950 via-teal-500/30 via-60% to-coral-500/40"></div>
    <div class="mx-auto flex max-w-7xl flex-wrap items-end justify-between gap-6 px-6 pb-10 pt-12 lg:px-10 lg:pb-14 lg:pt-16">
      <div class="max-w-3xl space-y-4">
        <span class={eyebrowBadge}><span class="inline-block h-2 w-2 animate-pulse rounded-full bg-coral-500"></span> Live · {cup.dateLabel}</span>
        <h1 class="font-display text-[clamp(2.4rem,7vw,5rem)] font-semibold leading-[0.92] tracking-[-0.04em] [font-variation-settings:'wdth'_112,'opsz'_96]">
          <span class="block">{cup.name}</span>
          <span class="block"><span class="font-accent font-medium italic text-sun-500">Vol. 02</span> · <span class="font-accent font-medium italic text-teal-500">the board</span></span>
        </h1>
        <p class="max-w-2xl text-base leading-7 text-white/85 sm:text-lg">Heats of four, one rashie colour each. Judges rate each run from 1–5 stars. Each kid’s best two runs are averaged; the final is scored separately. Refreshes on its own.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/cup/judge" class="underline">Judge a heat →</a>
        <a href="/sunset-duckies-cup-vol-2" class="font-mono text-[0.72rem] uppercase tracking-[0.2em] text-white/80 underline decoration-sun-500 decoration-2 underline-offset-4 hover:text-white">← The Cup page</a>
      </div>
    </div>
  </section>
  <div class="py-8 lg:py-10">
    <CupLive client:load dateLabel={cup.dateLabel} />
  </div>
  <div class="mx-auto max-w-7xl px-6 pb-16 lg:px-10"><Kicker tone="outline">Parents: results are provisional until the organisers call them.</Kicker></div>
</BaseLayout>
