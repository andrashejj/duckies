---
export const prerender = false;
import SignOutButton from "../../components/react/SignOutButton";
import { site } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { prisma } from "../../lib/prisma";
import Cta from "../../components/ui/Cta.astro";
import Kicker from "../../components/ui/Kicker.astro";
import StickerCard from "../../components/ui/StickerCard.astro";
import { bodyCopy } from "../../lib/ui";

const session = Astro.locals.session;
const user = session!.user;

let recentOrderCount = 0;
try {
  recentOrderCount = await prisma.order.count({
    where: { OR: [{ userId: user.id }, { email: user.email ?? "" }] },
  });
} catch (err) {
  console.error("[account] order count failed:", err);
}

const title = `Your account | ${site.name}`;
const description = "Your Sunset Duckies account dashboard.";
---

<BaseLayout title={title} description={description}>
  <section class="mx-auto max-w-5xl px-6 pb-24 pt-12 lg:px-10 lg:pt-16">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4" data-float>
      <div class="space-y-3">
        <Kicker>✦ Your account</Kicker>
        <h1 class="font-display text-fg text-[clamp(2.25rem,5vw,3.75rem)] leading-[1] tracking-[-0.03em] [font-variation-settings:'wdth'_114] font-bold"
        >
          Welcome back, {user.name?.split(" ")[0] ?? "Duckie"}.
        </h1>
        <p class={`max-w-xl ${bodyCopy}`}>
          Your reservations and account details live here.
        </p>
      </div>
      <SignOutButton client:load />
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      <StickerCard href="/account/orders" as="a" class="block space-y-2 p-6 hover:-translate-y-0.5 transition-transform">
        <Kicker>Orders</Kicker>
        <p class="font-display text-3xl text-fg [font-variation-settings:'wdth'_112] font-bold"
        >
          {recentOrderCount}
        </p>
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-fg/60">
          All orders linked to {user.email}
        </p>
        <p class="font-mono text-[0.7rem] uppercase tracking-[0.2em] text-coral-500">
          View history →
        </p>
      </StickerCard>

      <StickerCard href="/shop" as="a" class="block space-y-2 p-6 hover:-translate-y-0.5 transition-transform">
        <Kicker>Shop</Kicker>
        <p class="font-display text-2xl text-fg [font-variation-settings:'wdth'_112] font-bold"
        >
          Browse the current kit
        </p>
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-fg/60">
          Pickup Mon/Fri at Tamarin.
        </p>
        <p class="font-mono text-[0.7rem] uppercase tracking-[0.2em] text-coral-500">
          Browse →
        </p>
      </StickerCard>

      {session?.member && <StickerCard href="/#our-duckies" as="a" class="block space-y-2 p-6 hover:-translate-y-0.5 transition-transform">
        <Kicker>Members</Kicker>
        <p class="font-display text-2xl text-fg [font-variation-settings:'wdth'_112] font-bold"
        >
          Our duckies
        </p>
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-fg/60">
          The club’s private kids list.
        </p>
        <p class="font-mono text-[0.7rem] uppercase tracking-[0.2em] text-coral-500">
          View the lineup →
        </p>
      </StickerCard>}
    </div>

    {Astro.locals.isAdmin && (
      <div class="mt-10">
        <div class="rounded-card border-2 border-ink-950 bg-sun-500 p-6 text-ink-950 shadow-[4px_4px_0_0_var(--color-ink-950)]">
          <p class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-ink-950/80">
            ✦ Admin crew
          </p>
          <p class="mt-1 font-display text-2xl font-bold [font-variation-settings:'wdth'_112]">
            Jump to the club backstage.
          </p>
          <Cta class="mt-4" href="/admin">Open admin →</Cta>
        </div>
      </div>
    )}
  </section>
</BaseLayout>
