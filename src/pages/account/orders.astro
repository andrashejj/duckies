---
export const prerender = false;
import type { Order, OrderItem } from "../../generated/prisma/client";

import { familyOrderWhere } from "../../lib/server/family-access";
import { site } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { shortOrderId } from "../../lib/format";
import { STATUS_COLOR, STATUS_LABEL } from "../../lib/admin-orders";
import { prisma } from "../../lib/prisma";
import Cta from "../../components/ui/Cta.astro";
import StickerCard from "../../components/ui/StickerCard.astro";

const session = Astro.locals.session;
const user = session!.user;

type OrderWithItems = Order & { items: OrderItem[] };

let orders: OrderWithItems[] = [];
let loadError: string | null = null;

try {
  orders = await prisma.order.findMany({
    where: await familyOrderWhere(user),
    orderBy: { createdAt: "desc" },
    include: { items: true },
  });
} catch (err) {
  loadError = "Could not load reservations.";
  Astro.response.status = 503;
  console.error("[account/orders] load failed:", err);
}

const title = `Your reservations | ${site.name}`;
const description = "Your Sunset Duckies reservations.";
---

<BaseLayout title={title} description={description} workspace="member">
  <section class="mx-auto max-w-5xl px-6 pb-24 pt-12 lg:px-10 lg:pt-16">
    <header class="social-page-header"><div><h1>Family orders</h1><p>Your reservations and orders shared with your duckies’ legal guardians.</p></div></header>

    {loadError ? (
      <StickerCard class="p-8">
        <p class="font-mono text-[0.7rem] uppercase tracking-[0.22em] text-coral-500">
          Could not load reservations
        </p>
        <p class="mt-3 text-[0.95rem] leading-7 text-fg/75">
          {loadError}
        </p>
      </StickerCard>
    ) : orders.length === 0 ? (
      <StickerCard class="p-8 text-center">
        <p class="font-mono text-[0.7rem] uppercase tracking-[0.22em] text-coral-500">
          Clean slate
        </p>
        <p class="mt-3 font-display text-2xl text-fg [font-variation-settings:'wdth'_110] font-bold"
        >
          No reservations yet.
        </p>
        <Cta class="mt-6" href="/shop">See the drop</Cta>
      </StickerCard>
    ) : (
      <ul class="space-y-4">
        {orders.map((order) => (
          <StickerCard as="li" class="p-5">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div class="min-w-0 space-y-1">
                <p class="font-display text-xl text-fg [font-variation-settings:'wdth'_110] font-bold"
                >
                  Reservation {shortOrderId(order.id)}
                </p>
                <p class="font-mono text-[0.66rem] uppercase tracking-[0.18em] text-fg/60">
                  {new Date(order.createdAt).toLocaleDateString("en-GB", {
                    day: "2-digit",
                    month: "short",
                    year: "numeric",
                  })}
                  {" · "}
                  {order.items.length} item{order.items.length === 1 ? "" : "s"}
                </p>
              </div>
              <div class="flex items-center gap-3">
                <span class:list={["rounded-full border-2 border-ink-950 px-3 py-1 font-mono text-[0.66rem] uppercase tracking-[0.18em] shadow-[2px_2px_0_0_var(--color-ink-950)]", STATUS_COLOR[order.status] ?? "bg-surface text-fg"]}>
                  {STATUS_LABEL[order.status] ?? order.status}
                </span>
              </div>
            </div>
            <ul class="mt-4 flex flex-wrap gap-2">
              {order.items.map((item) => (
                <li class="rounded-full border border-edge/30 bg-surface px-3 py-1 font-mono text-[0.66rem] uppercase tracking-[0.14em] text-fg/75">
                  {item.quantity} × {item.nameSnapshot}
                  {item.size ? ` · ${item.size}` : ""}
                  {item.kidName ? ` · for ${item.kidName}` : ""}
                </li>
              ))}
            </ul>
            <div class="mt-4">
              <a class="font-mono text-[0.7rem] uppercase tracking-[0.2em] text-coral-500 hover:underline"
                href={`/orders/${order.id}`}
              >
                View reservation →
              </a>
            </div>
          </StickerCard>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
