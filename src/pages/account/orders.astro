---
import type { Order, OrderItem } from "@prisma/client";

import { site } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatPrice, shortOrderId } from "../../lib/format";
import { prisma } from "../../lib/prisma";

const session = Astro.locals.session;
const user = session!.user;

type OrderWithItems = Order & { items: OrderItem[] };

let orders: OrderWithItems[] = [];
let loadError: string | null = null;

try {
  orders = await prisma.order.findMany({
    where: { OR: [{ userId: user.id }, { email: user.email ?? "" }] },
    orderBy: { createdAt: "desc" },
    include: { items: true },
  });
} catch (err) {
  loadError = err instanceof Error ? err.message : "Could not load orders.";
  console.error("[account/orders] load failed:", err);
}

const statusLabel: Record<string, string> = {
  PENDING: "Awaiting confirmation",
  AWAITING_PAYMENT: "Awaiting payment",
  PAID: "Paid · preparing",
  READY: "Ready for pickup",
  FULFILLED: "Fulfilled",
  CANCELLED: "Cancelled",
};

const statusColor: Record<string, string> = {
  PENDING: "var(--color-sun-500)",
  AWAITING_PAYMENT: "var(--color-sun-500)",
  PAID: "var(--color-teal-500)",
  READY: "var(--color-teal-500)",
  FULFILLED: "var(--color-lilac-400)",
  CANCELLED: "var(--color-coral-500)",
};

const title = `Your orders | ${site.name}`;
const description = "Your Sunset Duckies order history.";
---

<BaseLayout title={title} description={description}>
  <section class="mx-auto max-w-5xl px-6 pb-24 pt-12 lg:px-10 lg:pt-16">
    <div class="mb-10 space-y-3" data-float>
      <p class="section-kicker">Order history</p>
      <h1
        class="font-display text-[var(--color-ink-950)]"
        style="font-size: clamp(2rem, 4.5vw, 3.25rem); line-height: 1; letter-spacing: -0.03em; font-variation-settings: 'wdth' 114; font-weight: 700;"
      >
        Every sesh, every receipt.
      </h1>
      <p class="body-copy max-w-xl">
        All orders linked to this account or placed under <span class="font-mono">{user.email}</span>.
      </p>
    </div>

    {loadError ? (
      <div class="surface-card p-8">
        <p class="font-mono text-[0.7rem] uppercase tracking-[0.22em] text-[var(--color-coral-500)]">
          Could not load orders
        </p>
        <p class="mt-3 text-[0.95rem] leading-7 text-[var(--color-ink-950)]/75">
          {loadError}
        </p>
      </div>
    ) : orders.length === 0 ? (
      <div class="surface-card p-8 text-center">
        <p class="font-mono text-[0.7rem] uppercase tracking-[0.22em] text-[var(--color-coral-500)]">
          Clean slate
        </p>
        <p
          class="mt-3 font-display text-2xl text-[var(--color-ink-950)]"
          style="font-variation-settings: 'wdth' 110; font-weight: 700;"
        >
          No orders yet.
        </p>
        <a class="cta-primary mt-6 inline-flex" href="/shop">
          See the drop
        </a>
      </div>
    ) : (
      <ul class="space-y-4">
        {orders.map((order) => (
          <li class="surface-card p-5">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div class="min-w-0 space-y-1">
                <p
                  class="font-display text-xl text-[var(--color-ink-950)]"
                  style="font-variation-settings: 'wdth' 110; font-weight: 700;"
                >
                  Order {shortOrderId(order.id)}
                </p>
                <p class="font-mono text-[0.66rem] uppercase tracking-[0.18em] text-[var(--color-ink-950)]/60">
                  {new Date(order.createdAt).toLocaleDateString("en-GB", {
                    day: "2-digit",
                    month: "short",
                    year: "numeric",
                  })}
                  {" · "}
                  {order.items.length} item{order.items.length === 1 ? "" : "s"}
                </p>
              </div>
              <div class="flex items-center gap-3">
                <span
                  class="rounded-full border-2 border-[var(--color-ink-950)] px-3 py-1 font-mono text-[0.66rem] uppercase tracking-[0.18em] text-[var(--color-ink-950)] shadow-[2px_2px_0_0_var(--color-ink-950)]"
                  style={`background:${statusColor[order.status] ?? "var(--color-cream-soft)"};`}
                >
                  {statusLabel[order.status] ?? order.status}
                </span>
                <span
                  class="font-display text-xl text-[var(--color-ink-950)]"
                  style="font-variation-settings: 'wdth' 110; font-weight: 700;"
                >
                  {formatPrice(order.totalCents, order.currency)}
                </span>
              </div>
            </div>
            <ul class="mt-4 flex flex-wrap gap-2">
              {order.items.map((item) => (
                <li class="rounded-full border border-[var(--color-ink-950)]/30 bg-[var(--color-cream-soft)] px-3 py-1 font-mono text-[0.66rem] uppercase tracking-[0.14em] text-[var(--color-ink-950)]/75">
                  {item.quantity} × {item.nameSnapshot}
                  {item.size ? ` · ${item.size}` : ""}
                </li>
              ))}
            </ul>
            <div class="mt-4">
              <a
                class="font-mono text-[0.7rem] uppercase tracking-[0.2em] text-[var(--color-coral-500)] hover:underline"
                href={`/orders/${order.id}?t=${order.guestToken}`}
              >
                View receipt →
              </a>
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
