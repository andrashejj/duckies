---
export const prerender = false;
import "../styles/global.css";
import { membershipCovers, RECOMMENDED_AGE, youngerChildWarning, waiver, WAIVER_VERSION } from "../lib/registration/policy";
import { CUP_ENTRY_FEE_MUR, CUP_LABEL } from "../lib/registration/cup";
import Cta from "../components/ui/Cta.astro";
import Kicker from "../components/ui/Kicker.astro";
import SectionTitle from "../components/ui/SectionTitle.astro";
import { site } from "../data/site";
import { bodyCopy } from "../lib/ui";
import { largeAvatar, memberForm, memberStatus, registrationCheck, registrationGrid, registrationPage, registrationPanel, registrationSheet, signaturePad, textButton } from "../lib/members-ui";
const panel = `${registrationPanel} ${memberForm}`;
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><meta name="referrer" content="no-referrer" /><title>Private registration | Sunset Duckies</title></head>
<body class={registrationPage}>
  <main class={registrationSheet}>
    <Kicker as="a" href="/">Sunset Duckies · Tamarin Bay</Kicker>
    <SectionTitle as="h1" class="mt-6">Ready for the <span class="font-accent italic">water.</span></SectionTitle>
    <p id="registration-intro" data-paid="One form for the whole family: add every duckie, then sign once for all of them. Your membership is paid, so this completes the registration. A parent or legal guardian can fill it in and sign without an account." data-pending="One form for the whole family: add every duckie, then sign once for all of them. Fill it in and sign now; each place is confirmed once the semester fee is paid — Rs {child} for one child or Rs {family} for a family — and Andras marks it in the club records. A parent or legal guardian can fill it in and sign without an account." data-cup={`One form for the whole family: add every child coming, then sign once for all of them. This completes their entry for the ${CUP_LABEL}. A parent or legal guardian can fill it in and sign without an account.`} class={`mt-4 ${bodyCopy}`}>One form for the whole family: add every duckie, then sign once for all of them. A parent or legal guardian can fill it in and sign without an account.</p>
    <p id="registration-status" class={memberStatus} role="status" aria-live="polite">Opening your private invitation…</p>
    <section id="signed-result" hidden class={registrationPanel}>
      <SectionTitle size="none" class="text-2xl">Signed and safely stored.</SectionTitle>
      <p id="signed-summary" data-one="Your registration and signed waiver are saved with the club. Download your copy now; this private download is available for one hour." data-many="Each duckie's registration and signed waiver are saved with the club — one record per child, all from your single signature. Download your copy now; this private download is available for one hour.">Your registration and signed waiver are saved with the club. Download your copy now; this private download is available for one hour.</p>
      <div class="mt-4 flex flex-wrap gap-4"><Cta id="download-waiver" type="button" data-one="Download signed waiver" data-many="Download signed waivers">Download signed waiver</Cta><button id="download-audit" class={textButton} type="button">Download signature record</button></div>
      <p class="mt-6">Spotted a mistake — a date of birth, a phone number, the photo? Forgot a brother or sister? You can correct the details, add another duckie and sign again while this link is valid. The corrected version replaces the earlier one; the club keeps both.</p>
      <button id="edit-registration" class={`mt-3 ${textButton}`} type="button">Edit details, add a duckie, sign again</button>
      <div class="mt-7 border-t-2 border-dashed border-edge pt-6">
        <SectionTitle size="none" class="text-2xl">Once this link expires</SectionTitle>
        <p id="another-child-copy" class="mt-2" data-club={`A duckie who comes along later starts a fresh form of their own — and Rs ${site.membership.familyFeeMur.toLocaleString("en-US")} still covers a whole family for the semester. Your name and number carry over, so it takes about two minutes.`} data-cup="A child who comes along later starts a fresh entry of their own. Your name and number carry over, so it takes about two minutes.">A duckie who comes along later starts a fresh form of their own.</p>
        <Cta id="register-another" href="/join" variant="secondary" class="mt-4">Register another child</Cta>
      </div>
    </section>
    <form id="registration-form" data-waiver-version={WAIVER_VERSION} class={`${memberForm} [&_[aria-invalid=true]]:border-alert! [&_[aria-invalid=true]]:outline-alert!`} hidden>
      <p id="invitation-label" class={registrationPanel}></p>
      <section id="cup-covers" hidden class={registrationPanel}>
        <h2 class="font-display text-2xl">What you're signing up for</h2>
        <ul class="mt-3 list-disc space-y-2 pl-5">
          <li>Entry to the {CUP_LABEL} — Friday 16 October 2026 at Tamarin Bay. Arrival from 12:00, first heat at 14:00, bonfire from 18:30.</li>
          <li>Rs {CUP_ENTRY_FEE_MUR.toLocaleString("en-US")} entry fee for non-members, settled with the club before or on the day — we'll message you on WhatsApp.</li>
          <li>Your child brings their own surfboard. Surfboards only, no boogie boards.</li>
        </ul>
        <h3 class="mt-5 font-bold">Not included</h3>
        <ul class="mt-2 list-disc space-y-2 pl-5">
          <li>Club membership and regular training. The Cup is a one-day event; joining the club is a separate step.</li>
          <li>Gear: the club does not lend, rent or store boards, wetsuits or rashies.</li>
        </ul>
        <p class="mt-4 text-sm">The Cup welcomes younger children too. Every child must swim confidently in open water, and at least one parent or guardian from every family stays on the beach for the whole afternoon.</p>
      </section>
      <section id="membership-covers" class={registrationPanel}>
        <h2 class="font-display text-2xl">What your membership covers</h2>
        <ul class="mt-3 list-disc space-y-2 pl-5">{membershipCovers.included.map(text => <li>{text}</li>)}<li id="cup-included" hidden>Entry to the {CUP_LABEL} on Friday 16 October at Tamarin Bay — free for members, no separate form.</li></ul>
        <h3 class="mt-5 font-bold">Nothing else is included</h3>
        <ul class="mt-2 list-disc space-y-2 pl-5">{membershipCovers.excluded.map(text => <li>{text}</li>)}</ul>
        <p class="mt-4 text-sm">Sunset Duckies welcomes younger children too. Every child must swim confidently in open water, and at least one parent or guardian from every family joins them in the water for the full session.</p>
      </section>
      <div id="children" class={memberForm}></div>
      <div class={registrationPanel}>
        <h2 class="font-display text-2xl">Brothers and sisters</h2>
        <p id="siblings-copy" class="mt-2" data-club={`Add every duckie from your family here. Everything below — guardians, emergency contact, the waiver and your signature — is filled in once and covers all of them, and one family fee of Rs ${site.membership.familyFeeMur.toLocaleString("en-US")} covers the semester for the whole family.`} data-cup="Add every child from your family here. Everything below — guardians, emergency contact, the waiver and your signature — is filled in once and covers all of them.">Add every duckie from your family here; you sign once for all of them.</p>
        <Cta id="add-child" type="button" variant="secondary" size="sm" class="mt-4">Add another child</Cta>
        <p id="children-status" class={memberStatus} role="status" aria-live="polite"></p>
      </div>
      <fieldset class={panel}>
        <legend>02 · Legal guardians</legend>
        <p>The first guardian listed signs this form, for every child listed above. You can add other legal guardians below.</p>
        <div id="guardians" class={memberForm}></div>
        <button id="add-guardian" type="button" class={`justify-self-start ${textButton}`}>Add another legal guardian</button>
      </fieldset>
      <fieldset class={panel}>
        <legend>03 · Emergency contact</legend>
        <p>Usually the first legal guardian. Untick to name someone else we can reach during sessions.</p>
        <label class={registrationCheck}><input id="emergency-same" type="checkbox" checked />Same as the first legal guardian</label>
        <label>Emergency contact name<input name="emergencyName" required maxlength="120" /></label>
        <div class={registrationGrid}><label>Relationship to child<input name="emergencyRelationship" required maxlength="60" /></label><label>Emergency number<input name="emergencyPhone" type="tel" required maxlength="40" placeholder="+230 …" /></label></div>
      </fieldset>
      <fieldset class={panel}>
        <legend>04 · Read the waiver</legend>
        <h2 class="font-display text-2xl">{waiver.title}</h2><p>{waiver.introduction}</p>
        <h3 class="font-bold">I acknowledge that:</h3><ul class="list-disc pl-5 space-y-3">{waiver.acknowledgements.map(text => <li>{text}</li>)}</ul>
        <h3 class="font-bold">I agree to:</h3><ul class="list-disc pl-5 space-y-3">{waiver.agreements.map(text => <li>{text}</li>)}</ul>
        <p id="waiver-scope" class="text-sm">You accept this once; it applies to every duckie you listed above, and each of them gets their own signed record.</p>
        <label class={registrationCheck}><input name="waiverAccepted" type="checkbox" required />I have read and accept the waiver above, for every child listed on this form.</label>
        <label class={registrationCheck}><input name="parentInWater" type="checkbox" required />At least one parent or guardian from our family will be in the water for the full session, every session.</label>
        <label class={registrationCheck}><input name="swimming" type="checkbox" required />Every child listed above swims confidently in open water, including waves up to around 2 m and currents, as agreed with the head coach.</label>
        <p class="text-sm">If you cannot confirm this, speak with the head coach before signing.</p>
        <label class={registrationCheck}><input name="reef" type="checkbox" required />{waiver.reef}</label>
        <label class={registrationCheck}><input name="gear" type="checkbox" required />{waiver.gear}</label>
      </fieldset>
      <fieldset class={panel}>
        <legend>05 · Photos and video</legend>
        <p>Both answers are fine, and your answer applies to every child listed above. This choice does not affect their membership.</p>
        <label class={registrationCheck}><input name="media" type="radio" value="yes" required />{waiver.mediaYes}</label>
        <label class={registrationCheck}><input name="media" type="radio" value="no" required />{waiver.mediaNo}</label>
      </fieldset>
      <fieldset class={panel}>
        <legend>06 · Your signature</legend>
        <p>Check the details above before signing. The club keeps the submitted details, exact waiver wording, your choices and signature as a permanent signed record. Corrections create a new record.</p>
        <label>Type your full name to sign<input name="signerName" required maxlength="120" autocomplete="name" /></label>
        <p class="text-sm">Use the name of the first legal guardian listed above. Your typed name is your electronic signature.</p>
        <label for="signature-pad">Draw your signature (optional)</label>
        <canvas id="signature-pad" width="660" height="220" tabindex="0" aria-label="Optional drawn signature. You can use your typed signature instead." class={signaturePad}></canvas>
        <button id="clear-signature" type="button" class={`justify-self-start ${textButton}`}>Clear drawing</button>
        <label class={registrationCheck}><input name="electronicConsent" type="checkbox" required />{waiver.electronic}</label>
        <p class="text-sm">Your signing time, browser details and IP address are kept in the private audit record. This link does not independently verify your identity.</p>
        <Cta id="submit-registration" type="submit" class="justify-self-start">Sign and submit</Cta>
        <p id="validation-summary" class="text-sm font-bold text-alert" role="alert"></p>
        <p id="submit-status" class={memberStatus} role="status" aria-live="polite"></p>
      </fieldset>
    </form>
    <!-- One of these per child. Cloned rather than built in script so the
         panel's markup and classes stay next to the rest of the form. -->
    <template id="child-template">
      <fieldset class={panel} data-child>
        <legend data-child-legend>01 · The surfer</legend>
        <label data-label="childName">Child’s full name<input data-field="childName" required maxlength="80" autocomplete="off" /></label>
        <label data-label="photo">Profile photo (optional)<input data-field="photo" type="file" accept="image/jpeg,image/png,image/webp" /></label>
        <p class="text-sm">A recognisable photo for club organisers. It stays private and does not grant permission for social media. JPEG, PNG or WebP up to 4 MB / 20 megapixels. The photo is saved to the profile when you sign.</p>
        <img data-photo-preview hidden width="128" height="128" alt="Selected profile photo" class={largeAvatar} />
        <button data-remove-photo type="button" class={textButton} hidden>Remove selected photo</button>
        <p data-photo-status role="status"></p>
        <label data-label="dateOfBirth">Date of birth<input data-field="dateOfBirth" type="date" required /></label>
        <p class="text-sm">Most Duckies are {RECOMMENDED_AGE} or older. Younger children can join too.</p>
        <p data-age-warning hidden class="rounded-xl border-2 border-alert p-3 text-sm font-bold text-alert" role="status" aria-live="polite">{youngerChildWarning}</p>
        <div data-rhythm class="contents">
          <label data-label="sessionsPerWeek">Training rhythm<select aria-label="Training rhythm" data-field="sessionsPerWeek" required><option value="">Choose…</option><option value="2">Twice a week — Monday + Friday</option><option value="1">Once a week — Monday or Friday</option></select></label>
          <p class="text-sm">Membership covers training and nothing else. You can change the rhythm with the coach during the semester.</p>
        </div>
        <label data-label="medicalNotes">Medical conditions, allergies or medication<textarea data-field="medicalNotes" maxlength="2000" rows="3" placeholder="Write none if there is nothing to flag."></textarea></label>
        <p class="text-sm">These details are available to club organisers. Please tell the head coach if anything changes.</p>
        <button data-remove-child type="button" class={`justify-self-start ${textButton}`} hidden>Remove this child</button>
      </fieldset>
    </template>
    <p class="mt-8 text-sm">Sunset Duckies · Monday + Friday, 4–6pm · Tamarin Bay</p>
  </main>
</body>
</html>
<script>
  import { recallFamily, rememberFamily } from "../lib/family-contact";
  import { guardianFields, textButton } from "../lib/members-ui";
  import { ageAt } from "../lib/registration/age";
  import { RECOMMENDED_AGE } from "../lib/registration/policy";
  import { registrationValidation } from "../lib/registration/form-validation";
  type Guardian = { name: string; relationship: string; phone: string; email: string };
  type Registration = Record<string, any> & { guardians: Guardian[] };
  type SignedChild = { kidId: string; registration: Registration; hasPhoto: boolean };
  type Signed = { id: string; registration: Registration; children: SignedChild[] } | null;
  const token = new URLSearchParams(location.hash.slice(1)).get("token") ?? "";
  const form = document.querySelector<HTMLFormElement>("#registration-form")!;
  const status = document.querySelector<HTMLElement>("#registration-status")!;
  const submitStatus = document.querySelector<HTMLElement>("#submit-status")!;
  const submit = document.querySelector<HTMLButtonElement>("#submit-registration")!;
  const result = document.querySelector<HTMLElement>("#signed-result")!;
  const editButton = document.querySelector<HTMLButtonElement>("#edit-registration")!;
  const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
  const validation = registrationValidation(form, document.querySelector<HTMLElement>("#validation-summary")!);
  let version = "";
  let cup = false;
  let signed: Signed = null;
  let supersedes = "";
  let signature: [number, number][][] = [];
  let current: [number, number][] | null = null;
  let submitting = false;
  let photoBusy = 0;
  let maxChildren = 6;
  const headers = { Authorization: `Bearer ${token}` };
  // Age is guidance, not a registration gate. Only future birthdays are invalid.
  const latestBirthdayValue = new Date().toISOString().slice(0, 10);
  const guardians = document.querySelector<HTMLElement>("#guardians")!;
  const addButton = document.querySelector<HTMLButtonElement>("#add-guardian")!;
  function addGuardian(values?: Guardian) {
    const index = guardians.children.length;
    if (index >= 4) return;
    const block = document.createElement("fieldset"); block.className = guardianFields; block.dataset.guardian = "";
    const legend = document.createElement("legend"); legend.textContent = `Legal guardian ${index + 1}`; block.append(legend);
    for (const [key, labelText, type, max] of [["name", "Full name", "text", 120], ["relationship", "Relationship", "text", 60], ["phone", "Phone", "tel", 40], ["email", "Email", "email", 200]] as const) {
      const label = document.createElement("label"); label.textContent = `${labelText} · guardian ${index + 1}`;
      const input = document.createElement("input"); input.name = `guardian-${index}-${key}`; input.dataset.field = key; input.type = type; input.required = true; input.maxLength = max; input.value = values?.[key] ?? "";
      label.append(input); block.append(label);
    }
    if (index > 0) { const remove = document.createElement("button"); remove.type = "button"; remove.className = textButton; remove.textContent = "Remove this guardian"; remove.onclick = () => { block.remove(); addButton.disabled = false; }; block.append(remove); }
    guardians.append(block); addButton.disabled = guardians.children.length >= 4;
  }
  const familyContact = recallFamily();
  addGuardian(familyContact ? { name: familyContact.contactName, phone: familyContact.contactPhone, email: familyContact.contactEmail ?? "", relationship: "" } : undefined);
  addButton.addEventListener("click", () => addGuardian());
  // Emergency contact mirrors guardian 1 until the family unticks "same as".
  const emergencySame = document.querySelector<HTMLInputElement>("#emergency-same")!;
  const emergency = { emergencyName: "name", emergencyRelationship: "relationship", emergencyPhone: "phone" } as const;
  function syncEmergency() {
    const first = guardians.firstElementChild;
    for (const [target, source] of Object.entries(emergency)) {
      const input = field(target); input.readOnly = emergencySame.checked;
      if (emergencySame.checked) input.value = first?.querySelector<HTMLInputElement>(`[data-field="${source}"]`)?.value ?? "";
    }
  }
  guardians.addEventListener("input", () => { if (emergencySame.checked) syncEmergency(); });
  emergencySame.addEventListener("change", () => { syncEmergency(); if (!emergencySame.checked) field("emergencyName").focus(); });
  syncEmergency();
  // Signature pad. No pointer capture: capturing a touch pointer on iOS can
  // swallow the taps that follow (Clear drawing, Sign and submit), so strokes
  // are tracked on the window instead and clamped to the pad.
  const canvas = document.querySelector<HTMLCanvasElement>("#signature-pad")!;
  const ctx = canvas.getContext("2d")!; ctx.strokeStyle = "#0b1620"; ctx.lineWidth = 3; ctx.lineCap = "round";
  function point(event: PointerEvent): [number, number] { const bounds = canvas.getBoundingClientRect(); return [Math.min(1, Math.max(0, (event.clientX-bounds.left)/bounds.width)), Math.min(1, Math.max(0, (event.clientY-bounds.top)/bounds.height))]; }
  canvas.addEventListener("pointerdown", event => { if (signature.length >= 30 || !event.isPrimary) return; event.preventDefault(); current = [point(event)]; });
  window.addEventListener("pointermove", event => { if (!current || current.length >= 600) return; const last = current[current.length-1]; const p = point(event); current.push(p); ctx.beginPath(); ctx.moveTo(last[0]*660,last[1]*220); ctx.lineTo(p[0]*660,p[1]*220); ctx.stroke(); });
  function endStroke() { if (current && current.length > 1) signature.push(current); current = null; }
  window.addEventListener("pointerup", endStroke); window.addEventListener("pointercancel", endStroke);
  function clearSignature() { signature=[]; current=null; ctx.clearRect(0,0,660,220); }
  document.querySelector("#clear-signature")!.addEventListener("click", clearSignature);
  // One block per child. Guardians, the waiver and the signature below are
  // filled in once and cover every duckie listed here.
  const children = document.querySelector<HTMLElement>("#children")!;
  const childTemplate = document.querySelector<HTMLTemplateElement>("#child-template")!;
  const addChild = document.querySelector<HTMLButtonElement>("#add-child")!;
  const childrenStatus = document.querySelector<HTMLElement>("#children-status")!;
  const childBlocks = () => Array.from(children.querySelectorAll<HTMLFieldSetElement>("[data-child]"));
  const childField = (block: HTMLElement, name: string) =>
    block.querySelector<HTMLInputElement>(`[data-field="${name}"]`)!;
  // Stable for as long as the form is open, so a staged photo keeps finding
  // its child even as blocks are added and removed around it.
  let nextSlot = 0;
  function renumberChildren() {
    const blocks = childBlocks();
    blocks.forEach((block, index) => {
      const only = blocks.length === 1;
      block.querySelector("[data-child-legend]")!.textContent = only ? "01 · The surfer" : `01 · Duckie ${index + 1}`;
      const suffix = only ? "" : ` · duckie ${index + 1}`;
      for (const label of block.querySelectorAll<HTMLElement>("[data-label]")) {
        const input = label.querySelector<HTMLInputElement>("input,select,textarea");
        label.firstChild!.textContent = `${label.dataset.text}${suffix}`;
        if (!input) continue;
        input.name = `child-${block.dataset.slot}-${label.dataset.label}`;
        // A <select> inside a <label> folds its options into the accessible
        // name, so the rhythm keeps naming itself.
        if (input.hasAttribute("aria-label")) input.setAttribute("aria-label", `${label.dataset.text}${suffix}`);
      }
      // A child whose waiver is already signed stays on the form: only the
      // club archives a duckie.
      const remove = block.querySelector<HTMLButtonElement>("[data-remove-child]")!;
      remove.hidden = blocks.length < 2 || Boolean(block.dataset.kidId);
    });
    addChild.disabled = blocks.length >= maxChildren;
    childrenStatus.textContent = blocks.length >= maxChildren
      ? `That's ${maxChildren} duckies on one form — message the club if there are more.`
      : blocks.length > 1
        ? `${blocks.length} duckies on this form. One waiver, one signature, all of them.`
        : "";
  }
  function addChildBlock(values?: Record<string, any>, kidId?: string) {
    if (childBlocks().length >= maxChildren) return null;
    const block = childTemplate.content.firstElementChild!.cloneNode(true) as HTMLFieldSetElement;
    block.dataset.slot = String(nextSlot++);
    if (kidId) block.dataset.kidId = kidId;
    for (const label of block.querySelectorAll<HTMLElement>("[data-label]"))
      label.dataset.text = label.firstChild!.textContent ?? "";
    const birthday = childField(block, "dateOfBirth");
    birthday.max = latestBirthdayValue;
    const ageWarning = block.querySelector<HTMLElement>("[data-age-warning]")!;
    ageWarning.id = `child-${block.dataset.slot}-age-warning`;
    function updateAgeWarning() {
      const age = ageAt(birthday.value);
      ageWarning.hidden = !birthday.value || !birthday.validity.valid || age < 0 || age >= RECOMMENDED_AGE || !Number.isFinite(age);
      const descriptions = (birthday.getAttribute("aria-describedby") ?? "").split(/\s+/).filter(id => id && id !== ageWarning.id);
      if (!ageWarning.hidden) descriptions.push(ageWarning.id);
      if (descriptions.length) birthday.setAttribute("aria-describedby", descriptions.join(" "));
      else birthday.removeAttribute("aria-describedby");
    }
    birthday.addEventListener("input", updateAgeWarning);
    birthday.addEventListener("change", updateAgeWarning);
    if (values) {
      for (const name of ["childName", "dateOfBirth", "medicalNotes"])
        childField(block, name).value = values[name] ?? "";
      (block.querySelector('[data-field="sessionsPerWeek"]') as HTMLSelectElement).value = values.sessionsPerWeek ?? "";
    }
    updateAgeWarning();
    block.querySelector<HTMLButtonElement>("[data-remove-child]")!.addEventListener("click", () => {
      // Drop the staged photo with the block, or it would follow the slot.
      void uploadPhoto(block, true).catch(() => {});
      block.remove();
      renumberChildren();
      (childBlocks().at(-1) ?? children).scrollIntoView({ behavior: "smooth", block: "center" });
    });
    block.querySelector<HTMLInputElement>('[data-field="photo"]')!.addEventListener("change", () => void uploadPhoto(block));
    block.querySelector<HTMLButtonElement>("[data-remove-photo]")!.addEventListener("click", () => void uploadPhoto(block, true));
    children.append(block);
    applyTerm(block);
    renumberChildren();
    return block;
  }
  addChild.addEventListener("click", () => {
    const block = addChildBlock();
    if (!block) return;
    block.scrollIntoView({ behavior: "smooth", block: "center" });
    childField(block, "childName").focus({ preventScroll: true });
  });
  // A cup entry buys one afternoon, not training, so it has no rhythm to pick.
  function applyTerm(block: HTMLElement) {
    const rhythm = block.querySelector<HTMLElement>("[data-rhythm]")!;
    rhythm.hidden = cup;
    rhythm.classList.toggle("contents", !cup);
    (block.querySelector('[data-field="sessionsPerWeek"]') as HTMLSelectElement).required = !cup;
  }
  // A cup entry sends the next sibling back to the cup form; a semester
  // registration starts the next one at the club's join form.
  function offerAnotherChild() {
    document.querySelector<HTMLAnchorElement>("#register-another")!.href = cup ? "/sunset-duckies-cup-vol-2#register" : "/join";
    const copy = document.querySelector<HTMLElement>("#another-child-copy")!;
    copy.textContent = cup ? copy.dataset.cup! : copy.dataset.club!;
  }
  function completed(canDownload: boolean) {
    form.hidden=true; result.hidden=false; supersedes="";
    offerAnotherChild();
    // One record per child, from the one signature; the copy follows suit.
    const count = signed?.children?.length ?? 1;
    for (const element of result.querySelectorAll<HTMLElement>("[data-one]"))
      element.textContent = count > 1 ? element.dataset.many! : element.dataset.one!;
    document.querySelector<HTMLButtonElement>("#download-waiver")!.hidden = !canDownload;
    document.querySelector<HTMLButtonElement>("#download-audit")!.hidden = !canDownload;
    status.textContent = canDownload
      ? count > 1 ? `All ${count} registrations are complete. Thank you.` : "Registration complete. Thank you."
      : "Already signed. Ask the club for a saved copy.";
    result.scrollIntoView({ behavior: "smooth" });
  }
  function prefill(signedGroup: NonNullable<Signed>) {
    const r = signedGroup.registration;
    children.replaceChildren();
    for (const child of signedGroup.children) {
      const block = addChildBlock(child.registration, child.kidId);
      if (block && child.hasPhoto)
        block.querySelector<HTMLElement>("[data-photo-status]")!.textContent =
          "A profile photo is already on file. Choose a new one to replace it, or leave this empty to keep it.";
    }
    if (!childBlocks().length) addChildBlock();
    guardians.replaceChildren(); (r.guardians ?? []).forEach(g => addGuardian(g)); if (!guardians.children.length) addGuardian();
    const first = r.guardians?.[0];
    emergencySame.checked = Boolean(first) && r.emergencyName === first.name && r.emergencyRelationship === first.relationship && r.emergencyPhone === first.phone;
    for (const key of ["emergencyName","emergencyRelationship","emergencyPhone"]) field(key).value = r[key] ?? "";
    syncEmergency();
    const media = form.querySelector<HTMLInputElement>(`input[name="media"][value="${r.media}"]`); if (media) media.checked = true;
    field("signerName").value = r.signerName ?? "";
    // Acknowledgements are re-confirmed on every signature; the drawing starts fresh.
    for (const box of form.querySelectorAll<HTMLInputElement>('input[type="checkbox"][required]')) box.checked = false;
    clearSignature();
  }
  function edit() {
    if (!signed) return;
    validation.reset();
    supersedes = signed.id; prefill(signed);
    result.hidden = true; form.hidden = false; submitStatus.textContent = "";
    status.textContent = "Editing the signed details. Signing again creates a corrected record, and you can add a duckie you missed.";
    form.scrollIntoView({ behavior: "smooth" });
  }
  editButton.addEventListener("click", edit);
  async function load() {
    if (!token) { status.textContent = "Open the individual invitation link sent by the club to register your child."; return; }
    try {
      const response = await fetch("/api/registration", { headers, cache: "no-store" }); const data = await response.json();
      if (!response.ok) throw new Error(data.error);
      version = form.dataset.waiverVersion ?? "";
      if (data.version !== version) throw new Error("The waiver has changed. Refresh this page before signing.");
      signed = data.signed;
      maxChildren = Number(data.maxChildren) || maxChildren;
      // The signing guardian, kept for the next child's sign-up form.
      const signer = signed?.registration?.guardians?.[0];
      if (signer) rememberFamily({ contactName: signer.name, contactPhone: signer.phone, contactEmail: signer.email });
      // A cup link signs the same waiver, but there is no membership or training rhythm to choose.
      cup = Boolean(data.cup);
      const intro = document.querySelector<HTMLElement>("#registration-intro")!;
      const fee = (value: number) => value.toLocaleString("en-US");
      intro.textContent = cup ? intro.dataset.cup! : data.paid ? intro.dataset.paid! : intro.dataset.pending!.replace("{child}", fee(data.childFeeMur)).replace("{family}", fee(data.familyFeeMur));
      document.querySelector<HTMLElement>("#cup-covers")!.hidden = !cup;
      document.querySelector<HTMLElement>("#membership-covers")!.hidden = cup;
      document.querySelector<HTMLElement>("#cup-included")!.hidden = !data.cupIncluded;
      const siblings = document.querySelector<HTMLElement>("#siblings-copy")!;
      siblings.textContent = cup ? siblings.dataset.cup! : siblings.dataset.club!;
      // The invited child opens the form; the family adds their siblings to it.
      children.replaceChildren();
      const firstChild = addChildBlock()!;
      childField(firstChild, "childName").value = data.childName;
      document.querySelector("#invitation-label")!.textContent = `Invitation for ${data.childName} and any brothers or sisters · ${data.termLabel}. Expires ${new Date(data.expiresAt).toLocaleDateString()}.`;
      if (data.completedAt) { completed(Boolean(data.canDownload)); editButton.hidden = !signed; return; }
      status.textContent=""; form.hidden=false;
    } catch (error) { status.textContent = error instanceof Error ? error.message : "Couldn't open this invitation. Try again."; }
  }
  form.addEventListener("submit", async event => {
    event.preventDefault(); if (submitting || photoBusy) return;
    submitStatus.textContent = "";
    if (!validation.validate()) return;
    submitting=true;
    submit.disabled=true; submit.textContent = "Saving…";
    const values = new FormData(form);
    const body: Record<string, unknown> = { version, signature };
    for (const key of ["emergencyName","emergencyRelationship","emergencyPhone","media","signerName"]) body[key] = values.get(key);
    for (const key of ["waiverAccepted","parentInWater","swimming","reef","gear","electronicConsent"]) body[key] = values.get(key) === "on";
    body.children = childBlocks().map(block => ({
      slot: Number(block.dataset.slot),
      ...(block.dataset.kidId ? { kidId: block.dataset.kidId } : {}),
      childName: childField(block, "childName").value,
      dateOfBirth: childField(block, "dateOfBirth").value,
      medicalNotes: childField(block, "medicalNotes").value,
      ...(cup ? {} : { sessionsPerWeek: childField(block, "sessionsPerWeek").value }),
    }));
    body.guardians = Array.from(document.querySelectorAll("[data-guardian]")).map(block => Object.fromEntries(Array.from(block.querySelectorAll<HTMLInputElement>("input")).map(input => [input.dataset.field, input.value])));
    if (supersedes) body.supersedes = supersedes;
    const count = childBlocks().length;
    submitStatus.textContent = count > 1
      ? `Saving signed registrations for all ${count} duckies… this can take a few seconds.`
      : "Saving your signed registration… this can take a few seconds.";
    try {
      const response = await fetch("/api/registration", { method:"POST", headers:{ ...headers, "Content-Type":"application/json" }, body:JSON.stringify(body) }); const data=await response.json();
      if (response.status===409) { await load(); return; }
      if (!response.ok) throw new Error(data.error);
      submitStatus.textContent=""; await load();
    } catch(error) { submitStatus.textContent = error instanceof Error ? error.message : "Couldn't save your registration. Please try again."; submitStatus.scrollIntoView({ behavior: "smooth", block: "center" }); }
    finally { submitting=false; submit.disabled=false; submit.textContent = "Sign and submit"; }
  });
  async function download(audit=false) {
    try { const response = await fetch(`/api/registration/document${audit ? "?format=audit" : ""}`, { headers, cache:"no-store" });
      if (!response.ok) throw new Error((await response.json()).error);
      const url=URL.createObjectURL(await response.blob()); const a=document.createElement("a"); a.href=url; a.download=`sunset-duckies-signed-waiver.${audit ? "json" : "pdf"}`; a.click(); setTimeout(()=>URL.revokeObjectURL(url),10000);
    } catch(error) { status.textContent=error instanceof Error ? error.message : "Download failed."; }
  }
  document.querySelector("#download-waiver")!.addEventListener("click",()=>void download()); document.querySelector("#download-audit")!.addEventListener("click",()=>void download(true));
  // Staged against this child's slot, so each duckie's photo lands on their
  // own profile when the guardian signs.
  async function uploadPhoto(block: HTMLElement, remove=false) {
    const photoInput = block.querySelector<HTMLInputElement>('[data-field="photo"]')!;
    const photoStatus = block.querySelector<HTMLElement>("[data-photo-status]")!;
    const photoPreview = block.querySelector<HTMLImageElement>("[data-photo-preview]")!;
    const removePhoto = block.querySelector<HTMLButtonElement>("[data-remove-photo]")!;
    const file = photoInput.files?.[0]; if (!remove && !file) return;
    if (remove && !file && photoPreview.hidden) return;
    if (file && file.size > 4*1024*1024) { photoStatus.textContent = "Choose a photo smaller than 4 MB."; photoInput.value=""; return; }
    photoBusy++; photoInput.disabled=true; removePhoto.disabled=true; submit.disabled=true;
    photoStatus.textContent=remove ? "Removing photo…" : "Uploading photo…";
    const slot = `?slot=${block.dataset.slot}`;
    try { const response=await fetch(`/api/registration/photo${slot}`, {method:remove?"DELETE":"PUT",headers:{...headers,...(file&&!remove?{"Content-Type":file.type}:{})},...(remove?{}:{body:file})}); const data=await response.json(); if(!response.ok)throw new Error(data.error);
      if(photoPreview.dataset.blob)URL.revokeObjectURL(photoPreview.dataset.blob); photoPreview.dataset.blob=remove?"":URL.createObjectURL(file!); photoPreview.src=photoPreview.dataset.blob; photoPreview.hidden=remove; removePhoto.hidden=remove; photoStatus.textContent=remove?"Photo removed.":"Photo uploaded. Sign below to save it with the profile."; if(remove)photoInput.value="";
    }catch(e){photoStatus.textContent=e instanceof Error?e.message:"Photo upload failed. Please try again.";photoInput.value="";}
    finally{photoBusy--;photoInput.disabled=false;removePhoto.disabled=false;submit.disabled=photoBusy>0;}
  }
  void load();
</script>
