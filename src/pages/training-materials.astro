---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const title = `Training Materials | ${site.name}`;
const description =
  "At-home training videos for young Sunset Duckies surfers: mobility, strength, technique, and breathing.";

type Video = {
  name: string;
  href: string;
  image: string;
};

type Pillar = {
  kicker: string;
  title: string;
  blurb: string;
  accent: string;
  videos: Video[];
};

const kaiLennyImage = "/media/video-thumb-superhero.jpg";
const ytThumb = (id: string) => `https://img.youtube.com/vi/${id}/hqdefault.jpg`;

const pillars: Pillar[] = [
  {
    kicker: "Pillar 01",
    title: "Mobility",
    blurb: "Loose hips, open shoulders, springy spine — so paddling feels easy and the pop-up lands clean.",
    accent: "sticker-teal",
    videos: [
      {
        name: "Kai Lenny warm-up flow",
        href: "https://www.instagram.com/reel/DQcm4DsEhuA/",
        image: kaiLennyImage,
      },
    ],
  },
  {
    kicker: "Pillar 02",
    title: "Strength",
    blurb: "Bodyweight reps that build the paddle, the push-up, and the legs underneath the stance.",
    accent: "sticker-coral",
    videos: [
      {
        name: "Hydromind knee pop-ups",
        href: "https://www.youtube.com/shorts/0FjVJB-ZUw0",
        image: ytThumb("0FjVJB-ZUw0"),
      },
      {
        name: "Surf strength session",
        href: "https://www.youtube.com/watch?v=-UD25_kIpRY",
        image: ytThumb("-UD25_kIpRY"),
      },
      {
        name: "Surf-specific workout",
        href: "https://youtu.be/0rAtw0MsFq4",
        image: ytThumb("0rAtw0MsFq4"),
      },
    ],
  },
  {
    kicker: "Pillar 03",
    title: "Technique",
    blurb: "Pop-up and paddle mechanics drilled on the rug. Slow reps, clean shape.",
    accent: "sticker-sun",
    videos: [
      {
        name: "Kai Lenny warm-up practice",
        href: "https://www.instagram.com/reel/DQcm4DsEhuA/",
        image: kaiLennyImage,
      },
      {
        name: "Hydromind knee pop-ups",
        href: "https://www.youtube.com/shorts/0FjVJB-ZUw0",
        image: ytThumb("0FjVJB-ZUw0"),
      },
    ],
  },
  {
    kicker: "Pillar 04",
    title: "Breathing & mind",
    blurb: "Qigong and Wim Hof to start the day calm, energised, and ready for big sets.",
    accent: "sticker-lilac",
    videos: [
      {
        name: "Qigong morning practice",
        href: "https://youtu.be/1mzttMHlr20",
        image: ytThumb("1mzttMHlr20"),
      },
      {
        name: "Wim Hof breathing",
        href: "https://www.youtube.com/watch?v=avZ_5Cot0wY",
        image: ytThumb("avZ_5Cot0wY"),
      },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  image="/media/balance-training.jpg"
  imageAlt="Young Sunset Duckies surfers training between sessions."
  imageWidth={1920}
  imageHeight={1080}
  page="materials"
>
  <!-- ===================== HERO ===================== -->
  <section class="relative mx-auto max-w-7xl px-6 pb-10 pt-14 lg:px-10">
    <div class="grid gap-8 lg:grid-cols-[1fr_0.85fr]">
      <div class="surface-card p-8 md:p-10" data-float>
        <p class="section-kicker">Train at home</p>
        <h1 class="section-title mt-5 max-w-3xl" style="font-size: clamp(2.4rem, 5.5vw, 4.8rem); line-height: 0.95;">
          Four pillars,
          <span class="font-accent italic" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">between</span>
          <span class="ink-underline">sessions</span>.
        </h1>
        <p class="body-copy mt-6 max-w-3xl">
          A short library of videos kids can press play on at home — mobility, strength,
          pop-up and paddle technique, and a breathing practice to start the day right.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          {pillars.map((p) => <span class="chip">{p.title}</span>)}
        </div>
      </div>

      <div class="relative" data-float>
        <div class="media-frame min-h-[22rem] tilt-right transition-transform duration-500">
          <img
            src="/media/sunset-training.jpg"
            alt="Young Sunset Duckies surfers on the beach at sunset."
            loading="eager"
          />
        </div>
        <div class="wobble absolute -bottom-5 -right-4 hidden md:block">
          <div class="rounded-full border-2 border-[var(--color-ink-950)] bg-[var(--color-sun-500)] px-4 py-2.5 shadow-[4px_4px_0_0_var(--color-ink-950)]">
            <p class="font-display text-sm font-bold text-[var(--color-ink-950)]" style="font-variation-settings: 'wdth' 112;">
              ✦ press play.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== PILLARS ===================== -->
  {pillars.map((pillar) => (
    <section class="mx-auto max-w-7xl px-6 py-6 lg:px-10">
      <div class:list={["surface-card p-8 md:p-10", pillar.accent]} data-reveal>
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div class="max-w-2xl">
            <p class="section-kicker">{pillar.kicker}</p>
            <h2 class="section-title mt-4" style="font-size: clamp(1.9rem, 3.5vw, 3rem);">
              {pillar.title}
            </h2>
            <p class="body-copy mt-4">{pillar.blurb}</p>
          </div>
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--color-ink-950)]/55">
            {pillar.videos.length} {pillar.videos.length === 1 ? "video" : "videos"}
          </p>
        </div>

        <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {pillar.videos.map((video) => (
            <a
              href={video.href}
              target="_blank"
              rel="noreferrer"
              class="group overflow-hidden rounded-[1.4rem] border-2 border-[var(--color-ink-950)] bg-[var(--color-cream-soft)] shadow-[4px_4px_0_0_var(--color-ink-950)] transition-all hover:-translate-y-1 hover:shadow-[6px_6px_0_0_var(--color-ink-950)]"
            >
              <div class="relative aspect-video w-full overflow-hidden border-b-2 border-[var(--color-ink-950)] bg-[var(--color-ink-900)]">
                <img
                  src={video.image}
                  alt={video.name}
                  class="h-full w-full object-cover"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-[linear-gradient(180deg,transparent_55%,rgba(11,22,32,0.6))]"></div>
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-[var(--color-ink-950)] bg-[var(--color-sun-500)] text-[var(--color-ink-950)] transition-transform group-hover:scale-110">
                    <span class="ml-0.5 text-sm">▶</span>
                  </div>
                </div>
              </div>
              <div class="p-4">
                <p class="font-display text-lg leading-tight text-[var(--color-ink-950)]" style="font-variation-settings: 'wdth' 110; font-weight: 700;">
                  {video.name}
                </p>
                <p class="mt-1 truncate font-mono text-[0.7rem] uppercase tracking-[0.14em] text-[var(--color-ink-950)]/55">
                  {new URL(video.href).hostname.replace("www.", "")}
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}
</BaseLayout>
