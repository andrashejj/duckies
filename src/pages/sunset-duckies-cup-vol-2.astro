---
import SurfPhoto from "../components/SurfPhoto.astro";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import Chip from "../components/ui/Chip.astro";
import Cta from "../components/ui/Cta.astro";
import Kicker from "../components/ui/Kicker.astro";
import SectionTitle from "../components/ui/SectionTitle.astro";
import StickerCard from "../components/ui/StickerCard.astro";
import Underline from "../components/ui/Underline.astro";
import CupLineup from "../components/react/CupLineup";
import { bodyCopy, eyebrowBadge, field, label, miniCard, stickerTones, type StickerTone } from "../lib/ui";
import { textButton } from "../lib/members-ui";

const cup = site.cupVol2;
const title = `${cup.name} — Vol. 02 | ${site.name}`;
const description = `Sunset Duckies Cup Vol. 02 — Friday 16 October 2026 at Tamarin Bay. Free for club members, Rs 1,000 for non-members. Arrival from 12:00, first heat 14:00, bonfire 18:30. Music, BBQ, age 7+, no divisions — every surfer gets their own score. Bring your own board. Register on the page.`;
// The two ways in, as equal-height pills: a title plus the one fact that decides it (free vs. Rs 1,000).
const toggle = "flex h-full w-full cursor-pointer flex-col items-center justify-center gap-1 rounded-full border-2 border-edge bg-surface px-4 py-3 text-center text-fg transition peer-checked:bg-highlight peer-checked:text-highlight-fg peer-checked:shadow-sticker-sm peer-focus-visible:ring-4 peer-focus-visible:ring-accent/40";
const toggleTitle = "font-display text-[0.95rem] font-bold leading-tight [font-variation-settings:'wdth'_108]";
const toggleSub = "font-mono text-[0.58rem] uppercase tracking-[0.16em] opacity-75";
const plan = "grid h-full cursor-pointer content-start gap-1 rounded-2xl border-2 border-edge bg-canvas p-4 text-left transition peer-checked:bg-highlight peer-checked:text-highlight-fg peer-checked:shadow-sticker-sm peer-focus-visible:ring-4 peer-focus-visible:ring-accent/40";
---

<BaseLayout title={title} description={description} image="/media/cup/vol-2-og.jpg" imageAlt="The Final of Cup Vol. 01 at sunset, Tamarin Bay." imageWidth={1200} imageHeight={630}>
  <!-- ===================== HERO ===================== -->
  <section class="relative isolate overflow-hidden">
    <div class="absolute inset-0 -z-10">
      <div class="absolute inset-0 bg-ink-950"></div>
      <img
        src="/media/cup/vol-2-hero.webp"
        alt=""
        width="2000" height="1125"
        class="h-full w-full object-cover opacity-55"
        aria-hidden="true"
      />
      <div class="absolute inset-0 bg-linear-135 from-ink-950/85 via-teal-500/42 via-52% to-sun-500/55"></div>
    </div>

    <!-- Sticker flairs -->
    <div class="pointer-events-none absolute -right-4 top-32 hidden lg:block" aria-hidden="true">
      <div class="animate-float motion-reduce:animate-none">
        <div class="-rotate-[8deg] rounded-full border-2 border-ink-950 bg-teal-500 px-5 py-3 shadow-[5px_5px_0_0_var(--color-ink-950)]">
          <p class="font-display text-lg font-bold text-ink-950 [font-variation-settings:'wdth'_112]">
            ✦ free for duckies
          </p>
        </div>
      </div>
    </div>
    <div class="pointer-events-none absolute left-8 top-40 hidden lg:block" aria-hidden="true">
      <div class="animate-wobble motion-reduce:animate-none">
        <div class="rotate-[6deg] rounded-full border-2 border-ink-950 bg-sun-500 px-4 py-2 shadow-[4px_4px_0_0_var(--color-ink-950)]">
          <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-ink-950">
            byo board · no boogies
          </p>
        </div>
      </div>
    </div>

    <div class="relative mx-auto flex min-h-[74vh] max-w-7xl flex-col justify-end px-4 pb-14 pt-28 sm:px-6 sm:pb-20 sm:pt-32 lg:px-10 lg:pb-24 lg:pt-36">
      <div data-float class="mb-5 flex flex-wrap items-center gap-x-4 gap-y-2">
        <span class={eyebrowBadge}>
          <span class="inline-block h-2 w-2 animate-pulse rounded-full bg-teal-500"></span>
          {cup.dateLabel}
        </span>
        <a
          href={cup.previousEdition.href}
          class="font-mono text-[0.7rem] uppercase tracking-[0.2em] text-white/75 underline decoration-sun-500 decoration-2 underline-offset-4 transition hover:text-white"
        >
          ← {cup.previousEdition.label}
        </a>
      </div>

      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-end lg:gap-12">
        <div data-float class="max-w-4xl space-y-6">
          <h1 class="font-display text-[clamp(2.6rem,8vw,6.4rem)] font-semibold leading-[0.9] tracking-[-0.045em] text-white [font-variation-settings:'wdth'_112,'opsz'_96]">
            <span class="block">Sunset Duckies</span>
            <span class="block">
              <span class="font-accent font-medium italic text-sun-500">Cup</span>
              ·
              <span class="font-accent font-medium italic text-teal-500">Vol.&nbsp;02</span>
            </span>
          </h1>
          <p class="max-w-3xl text-base leading-7 text-white/90 sm:text-lg sm:leading-8 md:text-xl md:leading-9">
            {cup.blurb}
          </p>
          <p class="font-mono text-[0.78rem] uppercase tracking-[0.22em] text-white/75">
            {cup.location} · {cup.timeLabel}
          </p>
        </div>

        <div data-float class="flex flex-col gap-3">
          <Cta href="#register" class="w-full">{cup.registerCtaLabel}</Cta>
          <Cta variant="secondary" href="#day" class="w-full">↓ The plan for the day</Cta>
          <a href="/sunset-duckies-cup-vol-2/live" class="text-center font-mono text-[0.72rem] uppercase tracking-[0.2em] text-white/80 underline decoration-teal-500 decoration-2 underline-offset-4 transition hover:text-white">● Live heats + leaderboard on the day</a>
          <p class="mt-1 text-center font-mono text-[0.68rem] uppercase tracking-[0.22em] text-white/70">
            friends + family welcome ★ age 7+ ★ surf only
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== TICKER STRIP ===================== -->
  <section class="relative border-b-2 border-edge bg-teal-500 text-ink-950">
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-0 px-4 sm:px-6 lg:grid-cols-4 lg:px-10">
      <div class="flex flex-col items-start gap-1 py-6 pr-6 border-r-2 border-ink-950/25">
        <p class="font-display text-3xl font-extrabold leading-none [font-variation-settings:'wdth'_118] md:text-4xl">16 Oct</p>
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-ink-950/80">Friday · from 12:00</p>
      </div>
      <div class="flex flex-col items-start gap-1 py-6 pr-6 lg:border-r-2 lg:border-ink-950/25">
        <p class="font-display text-3xl font-extrabold leading-none [font-variation-settings:'wdth'_118] md:text-4xl">{cup.memberFeeLabel}</p>
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-ink-950/80">for club members</p>
      </div>
      <div class="flex flex-col items-start gap-1 py-6 pr-6 border-r-2 border-ink-950/25">
        <p class="font-display text-3xl font-extrabold leading-none [font-variation-settings:'wdth'_118] md:text-4xl">{cup.entryFeeLabel}</p>
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-ink-950/80">non-members</p>
      </div>
      <div class="flex flex-col items-start gap-1 py-6 pr-6">
        <p class="font-display text-3xl font-extrabold leading-none [font-variation-settings:'wdth'_118] md:text-4xl">Age 7+</p>
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-ink-950/80">surf only · byo board</p>
      </div>
    </div>
  </section>

  <!-- ===================== THE ESSENTIALS ===================== -->
  <section id="essentials" class="relative mx-auto max-w-7xl px-6 pb-12 pt-20 lg:px-10">
    <div class="pointer-events-none absolute top-12 -left-20 -z-0 h-[280px] w-[280px] rounded-[60%_40%_55%_45%/42%_58%_42%_58%] bg-teal-500 opacity-50 blur-[44px]"></div>
    <div class="pointer-events-none absolute -right-24 bottom-10 -z-0 h-[320px] w-[320px] rounded-[52%_48%_40%_60%/55%_45%_55%_45%] bg-coral-500 opacity-45 blur-[40px]"></div>

    <div class="relative space-y-10">
      <div class="max-w-3xl space-y-5" data-reveal>
        <Kicker>The essentials</Kicker>
        <SectionTitle>
          The stuff you
          <span class="font-accent italic">actually</span>
          need to know.
        </SectionTitle>
        <p class={`max-w-2xl ${bodyCopy}`}>
          Six cards, no fine print. Then scroll down and register — it takes a minute.
        </p>
      </div>

      <ul class="grid gap-4 md:grid-cols-2 xl:grid-cols-3" data-reveal>
        {cup.essentials.map((item) => (
          <li class:list={["flex flex-col gap-4 rounded-sticker border-2 border-edge p-5 shadow-sticker-sm sm:p-6", stickerTones[item.accent as StickerTone]]}>
            <div class="flex items-center justify-between gap-4">
              <span class="rounded-full border-[1.5px] border-edge bg-surface px-3 py-1 font-mono text-[0.58rem] font-semibold uppercase tracking-[0.16em] text-fg/80">
                {item.tag}
              </span>
              <SurfPhoto scene={item.photo} />
            </div>
            <div>
              <p class="font-display text-xl font-bold leading-tight text-fg [font-variation-settings:'wdth'_110] sm:text-2xl">
                {item.title}
              </p>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-fg/80">
                {item.text}
              </p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===================== RUN OF SHOW ===================== -->
  <section id="day" class="mx-auto max-w-7xl scroll-mt-24 px-6 py-12 lg:px-10">
    <StickerCard class="p-8 md:p-10" data-reveal>
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <Kicker>The plan for the day</Kicker>
          <SectionTitle size="none" class="mt-4 text-[clamp(1.9rem,3.5vw,3rem)]">
            12:00 to the <Underline>bonfire</Underline>.
          </SectionTitle>
        </div>
        <p class="max-w-sm font-mono text-[0.72rem] uppercase tracking-[0.16em] text-fg/65">
          Times are approximate. Heats run on the waves, not the clock. Follow the heats and the leaderboard <a href="/sunset-duckies-cup-vol-2/live" class="text-fg underline decoration-accent decoration-2 underline-offset-4">live on the day →</a>
        </p>
      </div>

      <div class="mt-8 grid gap-3">
        {cup.runOfShow.map((item) => (
          <div class={`flex items-center gap-4 ${miniCard}`}>
            <p class="w-16 shrink-0 font-mono text-sm font-semibold leading-tight text-accent-text sm:w-24">
              {item.time}
            </p>
            <p class="flex-1 font-display text-[1.05rem] font-semibold leading-6 text-fg/85 [font-variation-settings:'wdth'_108]">
              {item.label}
            </p>
            <span class="hidden sm:block"><SurfPhoto scene={item.photo} /></span>
          </div>
        ))}
      </div>
    </StickerCard>
  </section>

  <!-- ===================== THE LINEUP ===================== -->
  <section id="lineup" class="relative isolate my-12 scroll-mt-24 overflow-hidden border-y-2 border-edge bg-ink-950 py-16 text-cream lg:py-24">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-linear-135 from-ink-950 via-teal-500/25 via-55% to-coral-500/35"></div>
    <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_50%_40%_at_90%_10%,color-mix(in_oklab,var(--color-sun-500)_28%,transparent),transparent_70%)]"></div>
    <div class="pointer-events-none absolute -left-10 bottom-8 -z-10 hidden rotate-[-8deg] lg:block" aria-hidden="true">
      <p class="font-brand text-[11rem] leading-none text-cream/[0.05] select-none">LINEUP</p>
    </div>
    <div class="mx-auto max-w-7xl px-6 lg:px-10">
      <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
        <div class="max-w-2xl space-y-4">
          <Kicker>The lineup</Kicker>
          <SectionTitle class="text-cream">
            Who's <Underline>in</Underline> so far.
          </SectionTitle>
          <p class="max-w-xl text-base leading-7 text-cream/80">
            Every surfer who's locked in, in the order they signed up — straight from the registrations. Heats and rashie colours land on the cards on the day.
          </p>
        </div>
        <a href="/sunset-duckies-cup-vol-2/live" class="font-mono text-[0.72rem] uppercase tracking-[0.2em] text-cream/80 underline decoration-teal-500 decoration-2 underline-offset-4 transition hover:text-cream">● Live board on the day →</a>
      </div>
      <div class="mt-10">
        <CupLineup client:visible />
      </div>
    </div>
  </section>

  <!-- ===================== REGISTER ===================== -->
  <section id="register" class="mx-auto max-w-7xl scroll-mt-24 px-6 py-12 lg:px-10">
    <StickerCard tone="sun" class="p-8 md:p-12" data-reveal>
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <div>
          <Kicker>Register</Kicker>
          <SectionTitle class="mt-4">
            Lock in your <Underline>spot</Underline>.
          </SectionTitle>
          <p class={`mt-4 max-w-xl ${bodyCopy}`}>{cup.form.intro}</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <Chip>{cup.memberFeeLabel} for members</Chip>
            <Chip>{cup.entryFeeLabel} non-members</Chip>
            <Chip>Rs 3,000 join the club</Chip>
            <Chip>Age 7+</Chip>
          </div>
          <p class="mt-6 max-w-xl text-sm leading-6 text-fg/70">{cup.form.footnote}</p>
        </div>

        <form data-cup-register class="grid gap-5 rounded-sticker border-2 border-edge bg-surface p-6 shadow-sticker-md sm:p-8">
          <fieldset class="grid gap-3">
            <legend class={label}>Who's coming?</legend>
            <div class="mt-3 grid gap-3 sm:grid-cols-2">
              <label class="grid">
                <input class="peer sr-only" type="radio" name="member" value="yes" checked />
                <span class={toggle}>
                  <span class={toggleTitle}>{cup.form.memberLabel}</span>
                  <span class={toggleSub}>{cup.form.memberSub}</span>
                </span>
              </label>
              <label class="grid">
                <input class="peer sr-only" type="radio" name="member" value="no" />
                <span class={toggle}>
                  <span class={toggleTitle}>{cup.form.guestLabel}</span>
                  <span class={toggleSub}>{cup.form.guestSub}</span>
                </span>
              </label>
            </div>
          </fieldset>

          <!-- Members: sign in, then tick who's coming. The waiver is already on file. -->
          <div data-member-panel class="grid gap-4">
            <div data-member-signin class="grid gap-4">
              <p class="text-sm leading-6 text-fg/70">{cup.form.memberHint}</p>
              <Cta href="/login?next=%2Fsunset-duckies-cup-vol-2%23register" class="justify-self-start">Sign in to register</Cta>
              <p class="text-sm leading-6 text-fg/70">No code arriving? Your email isn't approved for sign-in yet — <a class="underline underline-offset-4" href={site.whatsappUrl} target="_blank" rel="noreferrer">ping Andras on WhatsApp</a> and he'll sort it.</p>
            </div>
            <div data-member-kids hidden class="grid gap-4">
              <p class="text-sm leading-6 text-fg/70">Signed in as <span data-member-email class="font-semibold text-fg"></span>. <button data-switch-account type="button" class={textButton}>Not you?</button></p>
              <ul data-kid-list class="grid gap-3"></ul>
              <div data-no-kids hidden class="grid gap-4 rounded-2xl border-2 border-dashed border-edge bg-canvas p-5">
                <p class="font-display text-xl font-bold leading-tight text-fg [font-variation-settings:'wdth'_110]">{cup.form.noKidsTitle}</p>
                <p class="text-sm leading-6 text-fg/70">{cup.form.noKidsText}</p>
                <div class="flex flex-wrap gap-3">
                  <Cta size="sm" class="w-full sm:w-auto" data-switch-account>Use another email</Cta>
                  <Cta variant="secondary" size="sm" class="w-full sm:w-auto" data-go-guest>Register your kid</Cta>
                </div>
                <p class="text-sm leading-6 text-fg/70">Sure you're a member? <a class="underline underline-offset-4" href={site.whatsappUrl} target="_blank" rel="noreferrer">Ping Andras on WhatsApp</a> and he'll link your email.</p>
              </div>
            </div>
          </div>

          <!-- New families: name + number, then straight to the form. -->
          <div data-guest-panel hidden class="grid gap-5">
            <fieldset class="grid gap-3">
              <legend class={label}>{cup.form.planLabel}</legend>
              <div class="mt-3 grid gap-3 sm:grid-cols-2">
                {cup.form.plans.map((option, index) => (
                  <label class="grid">
                    <input class="peer sr-only" type="radio" name="plan" value={option.value} data-submit-label={option.submitLabel} checked={index === 0} />
                    <span class={plan}>
                      <span class="font-display text-[1.1rem] font-bold leading-tight [font-variation-settings:'wdth'_108]">{option.title}</span>
                      <span class="font-mono text-[0.62rem] font-semibold uppercase tracking-[0.16em]">{option.price}</span>
                      <span class="mt-1 text-sm leading-5 opacity-80">{option.text}</span>
                    </span>
                  </label>
                ))}
              </div>
            </fieldset>
            <p class="text-sm leading-6 text-fg/70">{cup.form.guestHint}</p>
            <label class="grid gap-2">
              <span class={label}>Kid's name</span>
              <input class={field} name="kidName" maxlength="80" autocomplete="off" placeholder="Full name" />
            </label>
            <div class="grid gap-5 sm:grid-cols-2">
              <label class="grid gap-2">
                <span class={label}>Parent / guardian</span>
                <input class={field} name="contactName" maxlength="120" autocomplete="name" placeholder="Your name" />
              </label>
              <label class="grid gap-2">
                <span class={label}>WhatsApp number</span>
                <input class={field} name="contactPhone" type="tel" maxlength="40" autocomplete="tel" placeholder="+230 5…" />
              </label>
            </div>
            <div class="flex flex-wrap items-center gap-4">
              <Cta type="submit">{cup.form.submitLabel}</Cta>
              <span class="font-mono text-[0.66rem] uppercase tracking-[0.18em] text-fg/60">{cup.dateLabel}</span>
            </div>
          </div>
          <p data-cup-status role="status" aria-live="polite" class="text-[0.95rem] leading-relaxed not-empty:mt-1"></p>
          <a data-cup-link hidden href="#" class="justify-self-start font-display text-[0.95rem] font-bold uppercase tracking-[-0.01em] underline decoration-accent decoration-2 underline-offset-4">Open the registration form →</a>
        </form>
      </div>
    </StickerCard>
  </section>

  <!-- ===================== SEE YOU THERE ===================== -->
  <section class="mx-auto max-w-7xl px-6 pb-24 pt-6 lg:px-10">
    <StickerCard tone="coral" class="p-8 md:p-12" data-reveal>
      <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div>
          <Kicker>See you there</Kicker>
          <SectionTitle class="mt-4">
            Friday <Underline>16 October</Underline>.
          </SectionTitle>
          <p class={`mt-4 max-w-2xl ${bodyCopy}`}>
            Tamarin Bay, from 12:00 until the bonfire dies down. Bring a board, bring the family, bring something for the grill.
          </p>
          <p class="mt-4 font-mono text-[0.72rem] uppercase tracking-[0.16em] text-fg/65">
            {cup.dateLabel} · {cup.location}
          </p>
        </div>
        <div class="flex flex-col gap-3">
          <Cta href="#register">{cup.registerCtaLabel}</Cta>
          <Cta variant="secondary" href={site.whatsappUrl} target="_blank" rel="noreferrer">Join the WhatsApp group</Cta>
        </div>
      </div>
    </StickerCard>
  </section>

</BaseLayout>

<script>
  import { authClient } from "../lib/auth-client";
  import { kidButton, kidRow, kidTag } from "../lib/cup-ui";
  import { prefillFamily, rememberFamily } from "../lib/family-contact";
  // Members sign in and tick their kids (the waiver is on file); new families
  // continue to the private registration link the server issues for them.
  const form = document.querySelector<HTMLFormElement>("[data-cup-register]")!;
  const status = form.querySelector<HTMLElement>("[data-cup-status]")!;
  const next = form.querySelector<HTMLAnchorElement>("[data-cup-link]")!;
  const memberPanel = form.querySelector<HTMLElement>("[data-member-panel]")!;
  const signIn = form.querySelector<HTMLElement>("[data-member-signin]")!;
  const memberKids = form.querySelector<HTMLElement>("[data-member-kids]")!;
  const kidList = form.querySelector<HTMLUListElement>("[data-kid-list]")!;
  const noKids = form.querySelector<HTMLElement>("[data-no-kids]")!;
  const guestPanel = form.querySelector<HTMLElement>("[data-guest-panel]")!;
  const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const guestFields = Array.from(guestPanel.querySelectorAll<HTMLInputElement>('input:not([type="radio"])'));
  const memberChoice = form.elements.namedItem("member") as RadioNodeList;
  const isMember = () => memberChoice.value === "yes";
  const planChoice = form.elements.namedItem("plan") as RadioNodeList;
  const joining = () => planChoice.value === "club";
  const lineupChanged = () => window.dispatchEvent(new CustomEvent("cup:lineup"));
  type GuardianKid = { id: string; name: string; member: boolean; registered: boolean };

  function syncPanels() {
    memberPanel.hidden = !isMember();
    guestPanel.hidden = isMember();
    // Only the visible fields are required, so switching never blocks the other path.
    for (const input of guestFields) input.required = !isMember();
  }
  function choose(member: boolean) {
    memberChoice.value = member ? "yes" : "no";
    status.textContent = "";
    next.hidden = true;
    syncPanels();
  }
  function syncPlan() {
    submit.textContent = form.querySelector<HTMLInputElement>('input[name="plan"]:checked')!.dataset.submitLabel!;
  }
  form.addEventListener("change", (event) => {
    const { name } = event.target as HTMLInputElement;
    if (name === "member") choose(isMember());
    if (name === "plan") syncPlan();
  });
  syncPanels();
  syncPlan();
  // Back for a sibling: the parent's details carry over from the last entry.
  // Only a visit aimed at the form takes the cursor — this is a long page.
  if (prefillFamily(form) && location.hash === "#register")
    form.querySelector<HTMLInputElement>('input[name="kidName"]')!.focus({ preventScroll: true });
  // Wrong email? The login page bounces a live session straight back here, so sign out first.
  for (const button of form.querySelectorAll<HTMLButtonElement>("[data-switch-account]")) {
    button.addEventListener("click", async () => {
      button.disabled = true;
      status.textContent = "";
      try {
        const { error } = await authClient.signOut();
        if (error) throw error;
        window.location.assign("/login?next=%2Fsunset-duckies-cup-vol-2%23register");
      } catch {
        status.textContent = "Couldn't switch account. Try again in a sec.";
        button.disabled = false;
      }
    });
  }
  form.querySelector<HTMLButtonElement>("[data-go-guest]")!.addEventListener("click", () => {
    choose(false);
    guestFields[0].focus();
  });

  async function api(url: string, method = "GET") {
    const response = await fetch(url, { method, cache: "no-store", headers: { "Content-Type": "application/json" } });
    const data = await response.json().catch(() => ({}));
    return { response, data };
  }
  function renderKids(email: string, kids: GuardianKid[]) {
    kidList.replaceChildren();
    memberKids.querySelector("[data-member-email]")!.textContent = email;
    noKids.hidden = kids.length > 0;
    for (const kid of kids) {
      const row = document.createElement("li");
      row.className = kidRow;
      const name = document.createElement("span");
      name.className = "font-display text-lg font-bold [font-variation-settings:'wdth'_110]";
      name.textContent = kid.name;
      const tag = document.createElement("span");
      tag.className = kidTag;
      tag.textContent = kid.registered ? "on the list ✓" : kid.member ? "member · free" : "semester fee pending";
      const button = document.createElement("button");
      button.type = "button";
      button.className = kidButton;
      button.textContent = kid.registered ? "Locked in" : `Count ${kid.name.split(" ")[0]} in`;
      button.disabled = kid.registered;
      button.addEventListener("click", async () => {
        button.disabled = true;
        status.textContent = "Locking it in…";
        try {
          const { response, data } = await api(`/api/cup/kids/${kid.id}`, "POST");
          if (!response.ok) throw new Error(data.error ?? "Couldn't register. Try again in a sec.");
          status.textContent = data.status === "member"
            ? `🔒 ${data.kidName} is locked in — free, you're a member. See you Friday 16 October, from 12:00.`
            : `${data.kidName} is on the list! We don't see this semester's fee yet — sort it with Andras and the Cup is free; otherwise it's Rs 1,000 on the day.`;
          lineupChanged();
          await loadKids();
        } catch (error) {
          status.textContent = error instanceof Error ? error.message : "Couldn't register. Try again in a sec.";
          button.disabled = false;
        }
      });
      row.append(name, tag, button);
      kidList.append(row);
    }
  }
  async function loadKids() {
    const { response, data } = await api("/api/cup/kids");
    const signedIn = response.ok;
    signIn.hidden = signedIn;
    memberKids.hidden = !signedIn;
    if (signedIn) renderKids(data.email, data.kids);
  }
  void loadKids();

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (isMember()) return;
    const values = new FormData(form);
    const body = { kidName: values.get("kidName"), contactName: values.get("contactName"), contactPhone: values.get("contactPhone"), join: joining() };
    submit.disabled = true;
    next.hidden = true;
    status.textContent = "Locking it in…";
    try {
      const response = await fetch("/api/cup/register", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error ?? "Couldn't register. Try again in a sec.");
      rememberFamily({ contactName: String(body.contactName ?? ""), contactPhone: String(body.contactPhone ?? "") });
      if (data.status === "member") {
        status.textContent = `Looks like ${data.kidName} already has a club registration — no form needed. Pick "Already a Sunset Duckie" above and sign in to register.`;
      } else if (data.status === "signed") {
        status.textContent = `${data.kidName} is already fully registered — form and waiver done. See you on the sand!`;
        form.reset(); syncPanels();
      } else {
        status.textContent = joining()
          ? `${data.kidName} is on the list! One last thing: the club registration + waiver (≈5 min, no login) — membership covers the Cup. Taking you there now…`
          : `${data.kidName} is on the list! One last thing: the registration form + waiver (≈5 min, no login). Taking you there now…`;
        lineupChanged();
        next.href = data.url;
        next.hidden = false;
        window.setTimeout(() => window.location.assign(data.url), 2500);
      }
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : "Couldn't register. Try again in a sec.";
    } finally {
      submit.disabled = false;
    }
  });
  form.dataset.ready = "";
</script>
