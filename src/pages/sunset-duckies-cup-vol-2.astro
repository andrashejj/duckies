---
import SurfPhoto from "../components/SurfPhoto.astro";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import Chip from "../components/ui/Chip.astro";
import Cta from "../components/ui/Cta.astro";
import Kicker from "../components/ui/Kicker.astro";
import SectionTitle from "../components/ui/SectionTitle.astro";
import StickerCard from "../components/ui/StickerCard.astro";
import Underline from "../components/ui/Underline.astro";
import { bodyCopy, eyebrowBadge, stickerTones, type StickerTone } from "../lib/ui";

const cup = site.cupVol2;
const title = `${cup.name} — Vol. 02 | ${site.name}`;
const description = `Sunset Duckies Cup Vol. 02 comes to Tamarin Bay on Friday 16 October 2026 — leveled up from the lessons of the first ever cup: colour-coded rashies, heats of 4, smarter scoring, an earlier start, branded gazebos and more food.`;
---

<BaseLayout title={title} description={description} image="/media/cup/vol-2-og.jpg" imageAlt="The Final of Cup Vol. 01 at sunset, Tamarin Bay." imageWidth={1200} imageHeight={630}>
  <!-- ===================== HERO ===================== -->
  <section class="relative isolate overflow-hidden">
    <div class="absolute inset-0 -z-10">
      <div class="absolute inset-0 bg-ink-950"></div>
      <img
        src="/media/cup/vol-2-hero.webp"
        alt=""
        width="2000" height="1125"
        class="h-full w-full object-cover opacity-55"
        aria-hidden="true"
      />
      <div class="absolute inset-0 bg-linear-135 from-ink-950/85 via-teal-500/42 via-52% to-sun-500/55"></div>
    </div>

    <!-- Sticker flairs -->
    <div class="pointer-events-none absolute -right-4 top-32 hidden lg:block" aria-hidden="true">
      <div class="animate-float motion-reduce:animate-none">
        <div class="-rotate-[8deg] rounded-full border-2 border-ink-950 bg-teal-500 px-5 py-3 shadow-[5px_5px_0_0_var(--color-ink-950)]">
          <p class="font-display text-lg font-bold text-ink-950 [font-variation-settings:'wdth'_112]">
            ✦ the glow-up · vol. 02
          </p>
        </div>
      </div>
    </div>
    <div class="pointer-events-none absolute left-6 bottom-24 hidden lg:block" aria-hidden="true">
      <div class="animate-wobble motion-reduce:animate-none">
        <div class="rotate-[6deg] rounded-full border-2 border-ink-950 bg-sun-500 px-4 py-2 shadow-[4px_4px_0_0_var(--color-ink-950)]">
          <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-ink-950">
            lessons → upgrades
          </p>
        </div>
      </div>
    </div>

    <div class="relative mx-auto flex min-h-[74vh] max-w-7xl flex-col justify-end px-4 pb-14 pt-28 sm:px-6 sm:pb-20 sm:pt-32 lg:px-10 lg:pb-24 lg:pt-36">
      <div data-float class="mb-5 flex flex-wrap items-center gap-x-4 gap-y-2">
        <span class={eyebrowBadge}>
          <span class="inline-block h-2 w-2 animate-pulse rounded-full bg-teal-500"></span>
          {cup.dateLabel}
        </span>
        <a
          href={cup.previousEdition.href}
          class="font-mono text-[0.7rem] uppercase tracking-[0.2em] text-white/75 underline decoration-sun-500 decoration-2 underline-offset-4 transition hover:text-white"
        >
          ← {cup.previousEdition.label}
        </a>
      </div>

      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-end lg:gap-12">
        <div data-float class="max-w-4xl space-y-6">
          <h1 class="font-display text-[clamp(2.6rem,8vw,6.4rem)] font-semibold leading-[0.9] tracking-[-0.045em] text-white [font-variation-settings:'wdth'_112,'opsz'_96]">
            <span class="block">Sunset Duckies</span>
            <span class="block">
              <span class="font-accent font-medium italic text-sun-500">Cup</span>
              ·
              <span class="font-accent font-medium italic text-teal-500">Vol.&nbsp;02</span>
            </span>
          </h1>
          <p class="max-w-3xl text-base leading-7 text-white/90 sm:text-lg sm:leading-8 md:text-xl md:leading-9">
            {cup.blurb}
          </p>
          <p class="font-mono text-[0.78rem] uppercase tracking-[0.22em] text-white/75">
             {cup.location}  ·   {cup.timeLabel}
          </p>
        </div>

        <div data-float class="flex flex-col gap-3">
          <Cta href={site.whatsappUrl} target="_blank" rel="noreferrer" class="w-full">{cup.registerCtaLabel}</Cta>
          <Cta variant="secondary" href="#lessons" class="w-full">↓ See what's changing</Cta>
          <p class="mt-1 text-center font-mono text-[0.68rem] uppercase tracking-[0.22em] text-white/70">
            {cup.lessons.length} fixes ★ all from vol. 01
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== TICKER STRIP ===================== -->
  <section class="relative border-b-2 border-edge bg-teal-500 text-ink-950">
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-0 px-4 sm:px-6 lg:grid-cols-4 lg:px-10">
      <div class="flex flex-col items-start gap-1 py-6 pr-6 border-r-2 border-ink-950/25">
        <p class="font-display text-3xl font-extrabold leading-none [font-variation-settings:'wdth'_118] md:text-4xl">16 Oct</p>
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-ink-950/80">Friday · 2026</p>
      </div>
      <div class="flex flex-col items-start gap-1 py-6 pr-6 border-r-2 border-ink-950/25">
        <p class="font-display text-3xl font-extrabold leading-none [font-variation-settings:'wdth'_118] md:text-4xl">Heats of 4</p>
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-ink-950/80">one colour each</p>
      </div>
      <div class="flex flex-col items-start gap-1 py-6 pr-6 border-r-2 border-ink-950/25">
        <p class="font-display text-3xl font-extrabold leading-none [font-variation-settings:'wdth'_118] md:text-4xl">2 scores</p>
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-ink-950/80">playful + serious</p>
      </div>
      <div class="flex flex-col items-start gap-1 py-6 pr-6">
        <p class="font-display text-3xl font-extrabold leading-none [font-variation-settings:'wdth'_118] md:text-4xl">{cup.lessons.length} fixes</p>
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-ink-950/80">learned at vol. 01</p>
      </div>
    </div>
  </section>

  <!-- ===================== LESSONS LEARNED ===================== -->
  <section id="lessons" class="relative mx-auto max-w-7xl px-6 pb-12 pt-20 lg:px-10">
    <div class="pointer-events-none absolute top-12 -left-20 -z-0 h-[280px] w-[280px] rounded-[60%_40%_55%_45%/42%_58%_42%_58%] bg-teal-500 opacity-50 blur-[44px]"></div>
    <div class="pointer-events-none absolute -right-24 bottom-10 -z-0 h-[320px] w-[320px] rounded-[52%_48%_40%_60%/55%_45%_55%_45%] bg-coral-500 opacity-45 blur-[40px]"></div>

    <div class="relative space-y-10">
      <div class="max-w-3xl space-y-5" data-reveal>
        <Kicker>Lessons learned · Vol. 01 → 02</Kicker>
        <SectionTitle>
          What the first cup
          <span class="font-accent italic">taught</span>
          us.
        </SectionTitle>
        <p class={`max-w-2xl ${bodyCopy}`}>
          Every wobble from round one, turned into a fix.
        </p>
      </div>

      <ul class="grid max-w-3xl gap-3" data-reveal>
        {cup.lessons.map((lesson) => (
          <li class:list={["flex items-center gap-4 rounded-[1.3rem] border-2 border-edge p-4 shadow-sticker-sm sm:p-5", stickerTones[lesson.accent as StickerTone]]}>
            <SurfPhoto scene={lesson.photo} />
            <div class="min-w-0 flex-1">
              <p class="font-display text-lg font-bold text-fg [font-variation-settings:'wdth'_110] sm:text-xl">
                {lesson.title}
              </p>
              <p class="mt-0.5 text-[0.88rem] leading-snug text-fg/75">
                {lesson.change}
              </p>
            </div>
            <span class="hidden shrink-0 rounded-full border-[1.5px] border-edge bg-surface px-3 py-1 font-mono text-[0.56rem] font-semibold uppercase tracking-[0.16em] text-fg/80 sm:inline">
              {lesson.tag}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===================== LOCKED IN ===================== -->
  <section class="mx-auto max-w-7xl px-6 py-12 lg:px-10">
    <StickerCard tone="sun" class="p-8 md:p-10" data-reveal>
      <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
        <div>
          <Kicker>Locked in</Kicker>
          <SectionTitle size="md" class="mt-4">
            Already <Underline>nailed down</Underline>.
          </SectionTitle>
          <p class={`mt-4 max-w-md ${bodyCopy}`}>
            Big calls made. Sign-up and draws drop closer to the day.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          {cup.lockedIn.map((item) => (
            <Chip>{item}</Chip>
          ))}
        </div>
      </div>
    </StickerCard>
  </section>

  <!-- ===================== SAVE THE DATE ===================== -->
  <section class="mx-auto max-w-7xl px-6 pb-24 pt-6 lg:px-10">
    <StickerCard tone="coral" class="p-8 md:p-12" data-reveal>
      <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div>
          <Kicker>Save the date</Kicker>
          <SectionTitle class="mt-4">
            Friday <Underline>16 October</Underline>.
          </SectionTitle>
          <p class={`mt-4 max-w-2xl ${bodyCopy}`}>
            Same beach, levelled up. Jump in the WhatsApp group for sign-up and the draw first.
          </p>
          <p class="mt-4 font-mono text-[0.72rem] uppercase tracking-[0.16em] text-fg/65">
            {cup.dateLabel} · {cup.location}
          </p>
        </div>
        <div class="flex flex-col gap-3">
          <Cta href={site.whatsappUrl} target="_blank" rel="noreferrer">{cup.registerCtaLabel}</Cta>
          <Cta variant="secondary" href={cup.previousEdition.href}>← See how Vol. 01 ran</Cta>
        </div>
      </div>
    </StickerCard>
  </section>

</BaseLayout>
