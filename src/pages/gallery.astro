---
export const prerender = false;
import { site } from "../data/site";
import { gallery } from "../data/gallery";
import { listUploads, type GalleryUpload } from "../lib/server/gallery";
import BaseLayout from "../layouts/BaseLayout.astro";
import Cta from "../components/ui/Cta.astro";
import Kicker from "../components/ui/Kicker.astro";
import SectionTitle from "../components/ui/SectionTitle.astro";
import Lightbox from "../components/Lightbox.astro";
import GalleryPhoto from "../components/GalleryPhoto.astro";
import PhotoTagger from "../components/PhotoTagger.astro";
import { photoKids, photoTags } from "../lib/server/photo-profiles";
import { bodyCopy, mediaFrame } from "../lib/ui";

const title = `Club Gallery · ${site.name}`;
const description = gallery.tagline;
const photoCount = gallery.sections.reduce((n, section) => n + section.photos.length, 0);

// Photos members added through /gallery/share (the middleware makes sure only
// a signed-in club member gets this far). The page still renders without them
// if the database is unreachable. New uploads are also attributed in the feed.
let shared: GalleryUpload[] = [];
try { shared = await listUploads("approved"); } catch { console.error("Gallery uploads could not be read; showing the curated set only."); }
const actor = Astro.locals.session!.member!;
let tags: Awaited<ReturnType<typeof photoTags>> = {};
let kids: Awaited<ReturnType<typeof photoKids>> = [];
let taggingError = false;
try { [tags, kids] = await Promise.all([photoTags(actor), photoKids(actor)]); }
catch { taggingError = true; }
const canTag = kids.some(kid => kid.canManage);
const selectedKid = kids.find(kid => kid.id === Astro.url.searchParams.get("duckie") && kid.canManage);
const sharedAlt = (u: GalleryUpload) => u.caption ?? u.note ?? "Photo added by a club member";
---

<BaseLayout variant="journal" title={title} description={description} image="/media/og-home.jpg" imageAlt="The Sunset Duckies lined up behind their colourful boards on Tamarin beach at sunset." imageWidth={1200} imageHeight={630}>
  <header class="social-page-header mx-auto max-w-5xl px-4 pt-10">
    <div><h1>Club Gallery</h1><p>{photoCount + shared.length} photos · {gallery.clips.length} clips · just for the club</p></div><a href="/gallery/share" class="journal-button journal-button-primary">Share photos</a>
  </header>
  <div class="mx-auto max-w-5xl px-4">
    <div class="club-useful-links"><a href="/members/me">Our photos & moments</a><a href="/members/lineup">Find a member</a></div>
    {selectedKid&&<p class="mt-4 text-sm">Choose a photo, tap <strong>Tag +</strong>, then add <strong>{selectedKid.name}</strong>.</p>}
    {taggingError&&<p role="status">Photo tags are temporarily unavailable. Please reload to try again.</p>}
    <label class="photo-album-picker">Jump to an album
      <select data-album-picker><option value="">Choose an album…</option>{gallery.sections.map(section => <option value={section.id}>{section.title}</option>)}{shared.length > 0 && <option value="from-the-members">Members’ photos</option>}<option value="clips">Clips</option></select>
    </label>
  </div>
  <!-- ===================== FROM THE MEMBERS ===================== -->
  {shared.length > 0 && (
    <section id="from-the-members" class="mx-auto max-w-5xl scroll-mt-24 px-4 py-6 sm:px-6 sm:py-10 lg:px-10">
      <div class="mb-4 max-w-2xl">
        <h2 class="font-display text-2xl font-bold">From the members</h2>
        <p class="mt-2 text-sm text-fg-muted">The latest photos from the crew.</p>
      </div>
      <div class="columns-2 gap-4 sm:columns-3 sm:gap-[1.15rem] lg:columns-4 lg:gap-5">
        {shared.map(photo => <GalleryPhoto
          photo={{ key: `upload:${photo.id}`, full: `/gallery/photo/${photo.id}.webp`, thumb: `/gallery/photo/${photo.id}.webp?size=thumb`, caption: sharedAlt(photo), date: photo.createdAt, width: photo.width, height: photo.height }}
          tags={tags[`upload:${photo.id}`]} canTag={canTag}
        />)}
      </div>
    </section>
  )}

  <!-- ===================== SECTIONS ===================== -->
  {gallery.sections.map((section) => (
    <section id={section.id} class="mx-auto max-w-5xl scroll-mt-24 px-4 py-6 sm:px-6 sm:py-10 lg:px-10">
      <div class="mb-4 max-w-2xl">
        <h2 class="font-display text-2xl font-bold">{section.title}</h2>
        <p class={`mt-2 hidden sm:block ${bodyCopy}`}>{section.lead}</p>
      </div>

      <div class="columns-2 gap-4 sm:columns-3 sm:gap-[1.15rem] lg:columns-4 lg:gap-5">
        {section.photos.map(photo => <GalleryPhoto
          photo={{ key: `curated:${photo.slug}`, full: `/gallery/asset/${photo.slug}.webp`, thumb: `/gallery/asset/${photo.slug}-small.webp`, caption: photo.alt, date: photo.date, width: photo.w, height: photo.h }}
          tags={tags[`curated:${photo.slug}`]} canTag={canTag}
        />)}
      </div>
    </section>
  ))}

  <!-- ===================== CLIPS ===================== -->
  <section id="clips" class="mx-auto max-w-5xl scroll-mt-24 px-4 py-6 sm:px-6 sm:py-10 lg:px-10">
    <div class="mb-8 max-w-2xl">
      <Kicker>🎬 Rolling clips</Kicker>
      <SectionTitle class="mt-4">
        Press play, turn the
        <span class="font-accent italic">sound</span>
        up in your head.
      </SectionTitle>
      <p class={`mt-4 ${bodyCopy}`}>Short and silent, straight off a parent's phone (and one drone). They play as you scroll past.</p>
    </div>
    <div class="grid gap-7 sm:grid-cols-2">
      {gallery.clips.map((clip) => (
        <figure class="m-0">
          <div class={mediaFrame}>
            <video
              src={`/gallery/asset/clips/${clip.slug}.mp4`}
              poster={`/gallery/asset/clips/${clip.slug}-poster.webp`}
              muted
              loop
              playsinline
              controls
              preload="metadata"
              class="aspect-video w-full"
              data-autoplay
            ></video>
          </div>
          <figcaption class="mt-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <span class="font-display text-[1.05rem] font-semibold text-fg">{clip.title}</span>
            <span class="font-mono text-[0.66rem] uppercase tracking-[0.18em] text-fg/60">{clip.date} · {clip.credit}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <Lightbox id="gallery-lightbox" label="Photo viewer" />
  {canTag && <PhotoTagger />}

  <!-- ===================== CTA ===================== -->
  <section class="mx-auto max-w-5xl px-4 pb-24 pt-8 sm:px-6 lg:px-10">
    <div class="flex flex-col items-start gap-6 rounded-sticker border-2 border-edge bg-sticker-sun p-[clamp(1.5rem,4vw,3rem)] shadow-sticker md:flex-row md:items-center md:justify-between">
      <div class="max-w-2xl">
        <SectionTitle size="sm">Got a better shot?</SectionTitle>
        <p class={`mt-3 ${bodyCopy}`}>Every photo here was taken by a parent on the sand. Add yours — it goes straight into "From the members", and only members can see this page.</p>
      </div>
      <Cta href="/gallery/share" class="shrink-0">Share a photo</Cta>
    </div>
    <p class="mt-8 font-mono text-[0.65rem] leading-[1.7] opacity-65">A members-only page. Photos and clips by club parents and the club drone; credits per photo are in the club's records. If a family would rather a photo came down, message Andras.</p>
  </section>
</BaseLayout>

<script>
  document.querySelector<HTMLSelectElement>("[data-album-picker]")?.addEventListener("change", event => {
    const id = (event.currentTarget as HTMLSelectElement).value;
    const album = document.getElementById(id);
    if (!album) return;
    location.hash = id;
    album.setAttribute("tabindex", "-1");
    album.focus({ preventScroll: true });
  });
  // Clips play while they are on screen and pause when scrolled away, unless
  // the visitor asked for reduced motion — then they stay as poster + controls.
  const clips = Array.from(document.querySelectorAll<HTMLVideoElement>("[data-autoplay]"));
  if (clips.length && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        const video = entry.target as HTMLVideoElement;
        if (entry.intersectionRatio >= 0.4) video.play().catch(() => {});
        else video.pause();
      }
    }, { threshold: [0, 0.4] });
    clips.forEach((video) => observer.observe(video));
  }
</script>
