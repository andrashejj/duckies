---
export const prerender = false;
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { galleryPhotos, photoKids, photoTags } from "../../../lib/server/photo-profiles";
import PhotoIcon from "../../../components/PhotoIcon.astro";
const member = Astro.locals.session!.member!;
let data;
try {
  const [kids, photos, tags] = await Promise.all([photoKids(member), galleryPhotos(), photoTags(member)]);
  data = kids.map(kid => ({ ...kid, photos: photos.filter(photo => tags[photo.key]?.some(tag => tag.id === kid.id)) }));
} catch { Astro.response.status = 503; }
---
<BaseLayout title="Duckies in pictures · Sunset Duckies" description="The club's photo journals. Only for signed-in club members." variant="journal">
  <section class="journal-shell">
    <header class="journal-directory-header">
      <div><h1>The duckies</h1><p>Little waves. Shared memories.</p></div>
      <a href="/gallery/share" class="journal-button journal-button-primary"><PhotoIcon name="plus" class="h-4 w-4" />Share photos</a>
    </header>
    {!data ? <p role="alert" class="px-4">Photo profiles are temporarily unavailable. Please reload to try again.</p> : data.length === 0 ? <p class="journal-empty">No duckies in the lineup yet.</p> : (
      <div class="journal-directory">
        {data.map(kid => (
          <a href={`/gallery/duckies/${kid.id}`} class="group min-w-0">
            <div class="journal-directory-cover">
              {kid.photos.length ? kid.photos.slice(0,4).map((photo, index) => <img src={photo.thumb} alt="" loading="lazy" class:list={[kid.photos.length === 1 && "col-span-2", kid.photos.length === 3 && index === 0 && "row-span-2"]} />) : <span class="col-span-2 grid place-items-center text-6xl text-fg-muted">{kid.name.slice(0,1)}</span>}
            </div>
            <h2 class="journal-directory-name group-hover:underline">{kid.name}</h2>
            <p class="mt-1 text-xs text-fg-muted">{kid.photos.length} {kid.photos.length === 1 ? "photo" : "photos"}{kid.canManage ? " · Your duckie" : ""}</p>
          </a>
        ))}
      </div>
    )}
    <p class="journal-footer">Sunset Duckies · Tamarin, Mauritius · Members only</p>
  </section>
</BaseLayout>
