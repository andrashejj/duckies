---
import { site } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatPrice, shortOrderId } from "../../lib/format";
import { getOrderForGuest } from "../../lib/orders";

const { id } = Astro.params;
const token = Astro.url.searchParams.get("t");

if (!id || !token) {
  return Astro.redirect("/shop");
}

let order: Awaited<ReturnType<typeof getOrderForGuest>> = null;
let loadError: string | null = null;

try {
  order = await getOrderForGuest(id, token);
} catch (err) {
  loadError = err instanceof Error ? err.message : "Could not load order.";
  console.error("[orders/[id]] load failed:", err);
}

if (!order && !loadError) {
  return new Response(null, { status: 404, statusText: "Order not found" });
}

const title = order
  ? `Order ${shortOrderId(order.id)} | ${site.name}`
  : `Order | ${site.name}`;
const description = "Your Sunset Duckies order confirmation.";

const paymentLabel: Record<string, string> = {
  JUICE: "JUICE by MCB",
  CASH: "Cash at sesh",
  BANK: "Bank transfer",
};

const paymentCopy: Record<string, string> = {
  JUICE:
    "We'll reply shortly with the club's Juice number. Send the payment, screenshot the receipt, reply with the screenshot — your kit is locked in.",
  CASH:
    "Bring Rs to Tamarin Bay, Wednesday or Friday 4-6pm. Pay the coach on pickup.",
  BANK:
    "We'll reply shortly with the club's bank details. Once the transfer lands, your order is confirmed.",
};

const pickupLabel: Record<string, string> = {
  SESH: "Pickup at sesh",
  ARRANGE: "Arrange in chat",
};
---

<BaseLayout title={title} description={description}>
  {loadError || !order ? (
    <section class="mx-auto max-w-3xl px-6 py-32 text-center">
      <p class="font-mono text-[0.7rem] uppercase tracking-[0.22em] text-[var(--color-coral-500)]">
        Not found
      </p>
      <h1 class="mt-4 font-display text-4xl" style="font-variation-settings: 'wdth' 112; font-weight: 700;">
        This order link didn't resolve.
      </h1>
      <p class="mt-3 text-[0.95rem] leading-7 text-[var(--color-ink-950)]/75">
        Either the order doesn't exist, the token is wrong, or the shop is
        having a wobble. Check your confirmation email, or ping us on WhatsApp.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a class="cta-primary" href="/shop">Back to the drop</a>
        <a class="cta-secondary" href={site.whatsappUrl} target="_blank" rel="noreferrer">
          Ask on WhatsApp
        </a>
      </div>
    </section>
  ) : (
    <section class="mx-auto max-w-4xl px-6 pb-24 pt-12 lg:px-10 lg:pt-16">
      <div class="mb-10 space-y-3" data-float>
        <p class="section-kicker">✦ Order received</p>
        <h1
          class="font-display text-[var(--color-ink-950)]"
          style="font-size: clamp(2.25rem, 5vw, 3.75rem); line-height: 1; letter-spacing: -0.03em; font-variation-settings: 'wdth' 114; font-weight: 700;"
        >
          Order {shortOrderId(order.id)} is in.
        </h1>
        <p class="body-copy max-w-xl">
          Thanks, {order.name.split(" ")[0]}. We'll follow up shortly with
          payment instructions — nothing's been charged. Hold on to this link;
          it's your receipt and status page.
        </p>
      </div>

      <div class="grid gap-8 lg:grid-cols-[1.3fr_0.9fr] lg:items-start">
        <div class="surface-card space-y-5 p-6">
          <p class="section-kicker">Your kit</p>
          <ul class="space-y-4">
            {order.items.map((item) => (
              <li class="flex justify-between gap-4 border-b border-dashed border-[var(--color-ink-950)]/20 pb-3 last:border-0">
                <div class="min-w-0">
                  <p class="font-display text-lg text-[var(--color-ink-950)]" style="font-variation-settings:'wdth' 110;font-weight:700;">
                    {item.nameSnapshot}
                  </p>
                  <p class="mt-0.5 font-mono text-[0.66rem] uppercase tracking-[0.18em] text-[var(--color-ink-950)]/60">
                    SKU {item.sku}
                    {item.size ? ` · ${item.size}` : ""} · ×{item.quantity}
                  </p>
                </div>
                <p class="whitespace-nowrap font-mono text-[0.82rem] text-[var(--color-ink-950)]">
                  {formatPrice(item.lineTotalCents, order.currency)}
                </p>
              </li>
            ))}
          </ul>
          <dl class="space-y-2 border-t-2 border-[var(--color-ink-950)] pt-4 font-mono text-[0.82rem]">
            <div class="flex justify-between">
              <dt class="text-[var(--color-ink-950)]/70">Subtotal</dt>
              <dd class="text-[var(--color-ink-950)]">{formatPrice(order.subtotalCents, order.currency)}</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-[var(--color-ink-950)]/70">Shipping</dt>
              <dd class="text-[var(--color-ink-950)]">Pickup · Rs 0</dd>
            </div>
            <div class="mt-2 flex justify-between border-t-2 border-[var(--color-ink-950)] pt-3 text-base">
              <dt class="font-display text-[var(--color-ink-950)]" style="font-variation-settings:'wdth' 110;font-weight:700;">Total</dt>
              <dd class="font-display text-[var(--color-ink-950)]" style="font-variation-settings:'wdth' 110;font-weight:700;">
                {formatPrice(order.totalCents, order.currency)}
              </dd>
            </div>
          </dl>
        </div>

        <aside class="space-y-4">
          <div class="surface-card space-y-3 p-6">
            <p class="section-kicker">How you'll pay</p>
            <p class="font-display text-xl text-[var(--color-ink-950)]" style="font-variation-settings:'wdth' 110;font-weight:700;">
              {paymentLabel[order.paymentMethod]}
            </p>
            <p class="text-[0.92rem] leading-6 text-[var(--color-ink-950)]/78">
              {paymentCopy[order.paymentMethod]}
            </p>
          </div>
          <div class="surface-card space-y-3 p-6">
            <p class="section-kicker">How you'll pick up</p>
            <p class="font-display text-xl text-[var(--color-ink-950)]" style="font-variation-settings:'wdth' 110;font-weight:700;">
              {pickupLabel[order.pickupMethod]}
            </p>
            {order.pickupMethod === "SESH" ? (
              <p class="text-[0.92rem] leading-6 text-[var(--color-ink-950)]/78">
                Wednesday or Friday, 4-6pm, Tamarin Bay.
              </p>
            ) : (
              <p class="text-[0.92rem] leading-6 text-[var(--color-ink-950)]/78">
                We'll message you to line it up.
              </p>
            )}
          </div>
          {order.customerNote && (
            <div class="surface-card space-y-3 p-6">
              <p class="section-kicker">Your note</p>
              <p class="text-[0.92rem] leading-6 text-[var(--color-ink-950)]/78">
                {order.customerNote}
              </p>
            </div>
          )}
          <a class="cta-secondary w-full justify-center" href={site.whatsappUrl} target="_blank" rel="noreferrer">
            Questions? WhatsApp us
          </a>
        </aside>
      </div>

      <p class="mt-10 font-mono text-[0.68rem] uppercase tracking-[0.2em] text-[var(--color-ink-950)]/55">
        ✦ Confirmation sent to {order.email}. This link is your receipt — save
        it for status updates.
      </p>
    </section>
  )}
</BaseLayout>
