---
export const prerender = false;
import { site } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { shortOrderId } from "../../lib/format";
import { buildReservationWhatsappUrl, getOrderForGuest } from "../../lib/orders";
import { STATUS_LABEL } from "../../lib/admin-orders";
import { getActiveDrop } from "../../lib/drops";
import Chip from "../../components/ui/Chip.astro";
import Cta from "../../components/ui/Cta.astro";
import Kicker from "../../components/ui/Kicker.astro";
import StickerCard from "../../components/ui/StickerCard.astro";
import { bodyCopy } from "../../lib/ui";

const { id } = Astro.params;
const token = Astro.url.searchParams.get("t");

if (!id || !token) {
  return Astro.redirect("/shop");
}

let order: Awaited<ReturnType<typeof getOrderForGuest>> = null;
let loadError: string | null = null;
let activeDrop: Awaited<ReturnType<typeof getActiveDrop>> = null;

try {
  [order, activeDrop] = await Promise.all([
    getOrderForGuest(id, token),
    getActiveDrop(),
  ]);
} catch (err) {
  loadError = "Could not load reservation.";
  Astro.response.status = 503;
  console.error("[orders/[id]] load failed:", err);
}

if (!order && !loadError) {
  return new Response(null, { status: 404, statusText: "Reservation not found" });
}

const title = order
  ? `Reservation ${shortOrderId(order.id)} | ${site.name}`
  : `Reservation | ${site.name}`;
const description = "Your Sunset Duckies reservation.";

const pickupLabel: Record<string, string> = {
  SESH: "Pickup at sesh",
  ARRANGE: "Arrange in chat",
};

const whatsappConfirmUrl = order
  ? buildReservationWhatsappUrl(site.whatsappUrl, order)
  : site.whatsappUrl;
---

<BaseLayout title={title} description={description}>
  {loadError || !order ? (
    <section class="mx-auto max-w-3xl px-6 py-32 text-center">
      <p class="font-mono text-[0.7rem] uppercase tracking-[0.22em] text-coral-500">
        Not found
      </p>
      <h1 class="mt-4 font-display text-4xl [font-variation-settings:'wdth'_112] font-bold">
        This reservation link didn't resolve.
      </h1>
      <p class="mt-3 text-[0.95rem] leading-7 text-fg/75">
        Either the reservation doesn't exist, the token is wrong, or the shop
        is having a animate-wobble motion-reduce:animate-none. Check your confirmation email, or ping us on WhatsApp.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Cta href="/shop">Back to the drop</Cta>
        <Cta variant="secondary" href={site.whatsappUrl} target="_blank" rel="noreferrer">Ask on WhatsApp</Cta>
      </div>
    </section>
  ) : (
    <section class="mx-auto max-w-4xl px-6 pb-24 pt-12 lg:px-10 lg:pt-16">
      <div class="mb-10 space-y-3" data-float>
        <Kicker>✦ Reservation locked in</Kicker>
        <h1 class="font-display text-fg text-[clamp(2.25rem,5vw,3.75rem)] leading-[1] tracking-[-0.03em] [font-variation-settings:'wdth'_114] font-bold"
        >
          You're in, {order.name.split(" ")[0]}.
        </h1>
        <p class={`max-w-xl ${bodyCopy}`}>
          Reservation {shortOrderId(order.id)} is on the list. The club will confirm availability and let you know when it is ready for pickup.
        </p>
        <div class="flex flex-wrap items-center gap-2 pt-2">
          <span class="inline-flex items-center gap-2 rounded-full border-2 border-ink-950 bg-sun-500 px-3 py-1 font-mono text-[0.66rem] font-semibold uppercase tracking-[0.18em] text-ink-950 shadow-[2px_2px_0_0_var(--color-ink-950)]">
            {STATUS_LABEL[order.status]}
          </span>
          {order.paidAt && (
            <Chip>Cash collected</Chip>
          )}
        </div>
      </div>

      <div class="grid gap-8 lg:grid-cols-[1.3fr_0.9fr] lg:items-start">
        <StickerCard class="space-y-5 p-6">
          <Kicker>Your kit</Kicker>
          <ul class="space-y-4">
            {order.items.map((item) => (
              <li class="flex flex-col gap-1 border-b border-dashed border-edge/20 pb-3 last:border-0">
                <p class="font-display text-lg text-fg [font-variation-settings:'wdth'_110] font-bold">
                  {item.quantity} × {item.nameSnapshot}
                </p>
                <p class="font-mono text-[0.66rem] uppercase tracking-[0.18em] text-fg/60">
                  {item.size ?? "One size"}
                  {item.kidName ? ` · for ${item.kidName}` : ""}
                </p>
              </li>
            ))}
          </ul>
          <Cta class="w-full justify-center" href={whatsappConfirmUrl} target="_blank" rel="noreferrer">Ask about pickup on WhatsApp</Cta>
          <p class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-fg/55">
            Opens the club WhatsApp group. Quote your reservation number when asking about pickup.
          </p>
        </StickerCard>

        <aside class="space-y-4">
          <StickerCard class="space-y-3 p-6">
            <Kicker>Pickup</Kicker>
            <p class="font-display text-xl text-fg [font-variation-settings:'wdth'_110] font-bold">
              {pickupLabel[order.pickupMethod]}
            </p>
            {order.pickupMethod === "SESH" ? (
              <p class="text-[0.92rem] leading-6 text-fg/78">
                Monday or Friday, 4-6pm, Tamarin Bay.
              </p>
            ) : (
              <p class="text-[0.92rem] leading-6 text-fg/78">
                We'll message you to line it up.
              </p>
            )}
            {activeDrop?.pickupNote && (
              <p class="text-[0.9rem] leading-6 text-fg/70">
                {activeDrop.pickupNote}
              </p>
            )}
          </StickerCard>
          {order.customerNote && (
            <StickerCard class="space-y-3 p-6">
              <Kicker>Your note</Kicker>
              <p class="text-[0.92rem] leading-6 text-fg/78">
                {order.customerNote}
              </p>
            </StickerCard>
          )}
          <Cta variant="secondary" class="w-full justify-center" href={site.whatsappUrl} target="_blank" rel="noreferrer">Questions? WhatsApp us</Cta>
        </aside>
      </div>

      <p class="mt-10 font-mono text-[0.68rem] uppercase tracking-[0.2em] text-fg/55">
        {order.confirmationEmailSent ? `Confirmation sent to ${order.email}.` : "Your reservation is saved, but the confirmation email could not be sent. Bookmark this page."} This link is your reservation receipt.
      </p>
    </section>
  )}
</BaseLayout>
