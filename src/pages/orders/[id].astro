---
import { site } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { shortOrderId } from "../../lib/format";
import { buildReservationWhatsappUrl, getOrderForGuest } from "../../lib/orders";
import { STATUS_LABEL } from "../../lib/admin-orders";
import { getActiveDrop } from "../../lib/drops";

const { id } = Astro.params;
const token = Astro.url.searchParams.get("t");

if (!id || !token) {
  return Astro.redirect("/shop");
}

let order: Awaited<ReturnType<typeof getOrderForGuest>> = null;
let loadError: string | null = null;
let activeDrop: Awaited<ReturnType<typeof getActiveDrop>> = null;

try {
  [order, activeDrop] = await Promise.all([
    getOrderForGuest(id, token),
    getActiveDrop(),
  ]);
} catch (err) {
  loadError = err instanceof Error ? err.message : "Could not load reservation.";
  console.error("[orders/[id]] load failed:", err);
}

if (!order && !loadError) {
  return new Response(null, { status: 404, statusText: "Reservation not found" });
}

const title = order
  ? `Reservation ${shortOrderId(order.id)} | ${site.name}`
  : `Reservation | ${site.name}`;
const description = "Your Sunset Duckies reservation.";

const pickupLabel: Record<string, string> = {
  SESH: "Pickup at sesh",
  ARRANGE: "Arrange in chat",
};

const whatsappConfirmUrl = order
  ? buildReservationWhatsappUrl(site.whatsappUrl, order)
  : site.whatsappUrl;
---

<BaseLayout title={title} description={description}>
  {loadError || !order ? (
    <section class="mx-auto max-w-3xl px-6 py-32 text-center">
      <p class="font-mono text-[0.7rem] uppercase tracking-[0.22em] text-[var(--color-coral-500)]">
        Not found
      </p>
      <h1 class="mt-4 font-display text-4xl" style="font-variation-settings: 'wdth' 112; font-weight: 700;">
        This reservation link didn't resolve.
      </h1>
      <p class="mt-3 text-[0.95rem] leading-7 text-[var(--color-ink-950)]/75">
        Either the reservation doesn't exist, the token is wrong, or the shop
        is having a wobble. Check your confirmation email, or ping us on WhatsApp.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a class="cta-primary" href="/shop">Back to the drop</a>
        <a class="cta-secondary" href={site.whatsappUrl} target="_blank" rel="noreferrer">
          Ask on WhatsApp
        </a>
      </div>
    </section>
  ) : (
    <section class="mx-auto max-w-4xl px-6 pb-24 pt-12 lg:px-10 lg:pt-16">
      <div class="mb-10 space-y-3" data-float>
        <p class="section-kicker">✦ Reservation locked in</p>
        <h1
          class="font-display text-[var(--color-ink-950)]"
          style="font-size: clamp(2.25rem, 5vw, 3.75rem); line-height: 1; letter-spacing: -0.03em; font-variation-settings: 'wdth' 114; font-weight: 700;"
        >
          You're in, {order.name.split(" ")[0]}.
        </h1>
        <p class="body-copy max-w-xl">
          Reservation {shortOrderId(order.id)} is on the list. We'll DM you on
          WhatsApp once the kit is back from the printer and ready at sesh.
        </p>
        <div class="flex flex-wrap items-center gap-2 pt-2">
          <span
            class="inline-flex items-center gap-2 rounded-full border-2 border-[var(--color-ink-950)] px-3 py-1 font-mono text-[0.66rem] font-semibold uppercase tracking-[0.18em] shadow-[2px_2px_0_0_var(--color-ink-950)]"
            style="background:var(--color-sun-500);color:var(--color-ink-950);"
          >
            {STATUS_LABEL[order.status]}
          </span>
          {order.paidAt && (
            <span class="chip">Cash collected</span>
          )}
        </div>
      </div>

      <div class="grid gap-8 lg:grid-cols-[1.3fr_0.9fr] lg:items-start">
        <div class="surface-card space-y-5 p-6">
          <p class="section-kicker">Your kit</p>
          <ul class="space-y-4">
            {order.items.map((item) => (
              <li class="flex flex-col gap-1 border-b border-dashed border-[var(--color-ink-950)]/20 pb-3 last:border-0">
                <p class="font-display text-lg text-[var(--color-ink-950)]" style="font-variation-settings:'wdth' 110;font-weight:700;">
                  {item.quantity} × {item.nameSnapshot}
                </p>
                <p class="font-mono text-[0.66rem] uppercase tracking-[0.18em] text-[var(--color-ink-950)]/60">
                  {item.size ?? "One size"}
                  {item.kidName ? ` · for ${item.kidName}` : ""}
                </p>
              </li>
            ))}
          </ul>
          <a
            class="cta-primary w-full justify-center"
            href={whatsappConfirmUrl}
            target="_blank"
            rel="noreferrer"
          >
            Lock it in via WhatsApp
          </a>
          <p class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-[var(--color-ink-950)]/55">
            Opens WhatsApp with a pre-filled DM. We reply within the day.
          </p>
        </div>

        <aside class="space-y-4">
          <div class="surface-card space-y-3 p-6">
            <p class="section-kicker">Pickup</p>
            <p class="font-display text-xl text-[var(--color-ink-950)]" style="font-variation-settings:'wdth' 110;font-weight:700;">
              {pickupLabel[order.pickupMethod]}
            </p>
            {order.pickupMethod === "SESH" ? (
              <p class="text-[0.92rem] leading-6 text-[var(--color-ink-950)]/78">
                Wednesday or Friday, 4-6pm, Tamarin Bay.
              </p>
            ) : (
              <p class="text-[0.92rem] leading-6 text-[var(--color-ink-950)]/78">
                We'll message you to line it up.
              </p>
            )}
            {activeDrop?.pickupNote && (
              <p class="text-[0.9rem] leading-6 text-[var(--color-ink-950)]/70">
                {activeDrop.pickupNote}
              </p>
            )}
          </div>
          {order.customerNote && (
            <div class="surface-card space-y-3 p-6">
              <p class="section-kicker">Your note</p>
              <p class="text-[0.92rem] leading-6 text-[var(--color-ink-950)]/78">
                {order.customerNote}
              </p>
            </div>
          )}
          <a class="cta-secondary w-full justify-center" href={site.whatsappUrl} target="_blank" rel="noreferrer">
            Questions? WhatsApp us
          </a>
        </aside>
      </div>

      <p class="mt-10 font-mono text-[0.68rem] uppercase tracking-[0.2em] text-[var(--color-ink-950)]/55">
        ✦ Confirmation sent to {order.email}. This link is your reservation receipt.
      </p>
    </section>
  )}
</BaseLayout>
