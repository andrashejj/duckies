---
export const prerender = false;
import { formatPrice } from "../../lib/format";
import { getDatabase } from "../../lib/server/db";
import ReserveForm from "../../components/react/ReserveForm";
import { site } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getProductBySlug,
  listActiveProducts,
  packLabel,
} from "../../lib/products";
import ProductVisual from "../../components/ProductVisual.astro";
import Chip from "../../components/ui/Chip.astro";
import Cta from "../../components/ui/Cta.astro";
import Kicker from "../../components/ui/Kicker.astro";
import SectionTitle from "../../components/ui/SectionTitle.astro";
import StickerCard from "../../components/ui/StickerCard.astro";
import { bodyCopy, eyebrowBadge } from "../../lib/ui";

const { slug } = Astro.params;

// Non-members land on the shop's coming-soon teaser instead of a product.
if (!slug || !Astro.locals.session?.canShop) {
  return Astro.redirect("/shop");
}

let product: Awaited<ReturnType<typeof getProductBySlug>> = null;
let others: Awaited<ReturnType<typeof listActiveProducts>> = [];
let loadError: string | null = null;

try {
  product = await getProductBySlug(slug);
  if (product) {
    const all = await listActiveProducts();
    others = all.filter((p) => p.slug !== slug).slice(0, 3);
  }
} catch (err) {
  loadError = "Could not load product.";
  Astro.response.status = 503;
  console.error("[shop/[slug]] load failed:", err);
}

if (!product && !loadError) {
  return new Response(null, { status: 404, statusText: "Product not found" });
}

const familyKids = (await getDatabase().query("SELECT k.id,k.name FROM club_current_guardian g JOIN club_kid k ON k.id=g.kid_id WHERE g.email=$1 ORDER BY lower(k.name)", [Astro.locals.session!.user.email.toLowerCase()])).rows;
const dropLabel = product?.drop?.name ?? "Club granola";
const pack = product ? packLabel(product) : null;

const title = product
  ? `${product.name} | ${site.name} Shop`
  : `${site.name} Shop`;
const description = product
  ? `${product.name}. ${product.description}`
  : "Sunset Duckies granola. Reserve online and pick up at the session.";
---

<BaseLayout title={title} description={description}>
  {loadError || !product ? (
    <section class="mx-auto max-w-3xl px-6 py-32 text-center">
      <p class="font-mono text-[0.7rem] uppercase tracking-[0.22em] text-coral-500">
        Off the shelf
      </p>
      <h1 class="mt-4 font-display text-4xl font-bold [font-variation-settings:'wdth'_112]">
        Couldn't load this flavour.
      </h1>
      <p class="mt-3 text-[0.95rem] leading-7 text-fg/75">
        Either it's retired, or the shop isn't responding right now. Head back to the drop or ping us on WhatsApp.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Cta href="/shop">Back to the drop</Cta>
        <Cta variant="secondary" href={site.whatsappUrl} target="_blank" rel="noreferrer">Ask on WhatsApp</Cta>
      </div>
    </section>
  ) : (
    <>
      <!-- ============ BREADCRUMB ============ -->
      <div class="mx-auto max-w-7xl px-6 pt-10 lg:px-10">
        <nav class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-fg/60">
          <a href="/shop" class="hover:text-accent-text">✦ {dropLabel}</a>
          <span class="mx-2">/</span>
          <span>{product.name}</span>
        </nav>
      </div>

      <!-- ============ PRODUCT HERO ============ -->
      <section class="mx-auto max-w-7xl px-6 pb-16 pt-8 lg:px-10">
        <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-start">
          <ProductVisual product={product} size="lg" eager class="rounded-[1.6rem] border-2 border-edge shadow-sticker-md" />

          <div class="space-y-6">
            <div class="space-y-3">
              <span class={eyebrowBadge}>{dropLabel}</span>
              <h1 class="font-display text-[clamp(2.25rem,5vw,3.75rem)] font-bold leading-none tracking-[-0.03em] text-fg [font-variation-settings:'wdth'_112]">
                {product.name}
              </h1>
              {product.tagline && (
                <p class="font-mono text-[0.78rem] uppercase tracking-[0.22em] text-accent-text">
                  {product.tagline}
                </p>
              )}
            </div>

            <p class={`max-w-xl ${bodyCopy}`}>{product.description}</p>
            <p class="font-display text-2xl">{formatPrice(product.priceCents, product.currency)}</p>

            <dl class="grid grid-cols-2 gap-4 border-y-2 border-edge py-5">
              <div>
                <dt class="font-mono text-[0.64rem] uppercase tracking-[0.22em] text-fg/60">
                  {pack?.label}
                </dt>
                <dd class="mt-1 text-sm leading-6 text-fg/85">
                  {pack?.value}
                </dd>
              </div>
              <div>
                <dt class="font-mono text-[0.64rem] uppercase tracking-[0.22em] text-fg/60">
                  Pickup
                </dt>
                <dd class="mt-1 text-sm leading-6 text-fg/85">
                  Mon/Fri sesh, Tamarin Bay
                </dd>
              </div>
            </dl>

            <StickerCard class="space-y-4 p-6">
              <Kicker>Reserve your granola</Kicker>
              {product.stock === 0 ? <Chip>Currently sold out</Chip> : <ReserveForm
                familyKids={familyKids}
                client:load
                product={{
                  productId: product.id,
                  name: product.name,
                }}
                sizes={product.sizes}
                whatsappUrl={site.whatsappUrl}
              />}
            </StickerCard>

            <div class="flex flex-wrap gap-3">
              <Cta variant="secondary" href="/shop">Back to the drop</Cta>
            </div>
          </div>
        </div>
      </section>

      {others.length > 0 && (
        <section class="mx-auto max-w-7xl px-6 pb-24 lg:px-10">
          <div class="mb-6 flex items-end justify-between gap-4">
            <SectionTitle>Try the others</SectionTitle>
            <a class="font-mono text-[0.7rem] uppercase tracking-[0.22em] text-fg/70 hover:text-accent-text" href="/shop">
              See full drop →
            </a>
          </div>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {others.map((p) => (
              <StickerCard as="a" href={`/shop/${p.slug}`} class="block overflow-hidden">
                <ProductVisual product={p} size="sm" class="border-b-2 border-edge" />
                <div class="p-5">
                  <p class="font-display text-lg font-bold text-fg [font-variation-settings:'wdth'_110]">
                    {p.name}
                  </p>
                  {p.tagline && (
                    <p class="mt-1 font-mono text-[0.66rem] uppercase tracking-[0.2em] text-accent-text">
                      {p.tagline}
                    </p>
                  )}
                </div>
              </StickerCard>
            ))}
          </div>
        </section>
      )}
    </>
  )}
</BaseLayout>
