---
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  formatPrice,
  listActiveProducts,
  themeFor,
} from "../lib/products";

const title = `${site.name} Shop | Drop 001 · Order via WhatsApp`;
const description =
  "A teaser drop of Sunset Duckies swag. Pre-order via WhatsApp, pay via Juice or cash at sesh in Tamarin Bay, Mauritius.";

const { shop } = site;

let products: Awaited<ReturnType<typeof listActiveProducts>> = [];
let loadError: string | null = null;

try {
  products = await listActiveProducts();
} catch (err) {
  loadError =
    err instanceof Error ? err.message : "Could not load products.";
  console.error("[shop] product load failed:", err);
}

const buildOrderUrl = (productName: string, priceLabel: string) => {
  const message = [
    shop.orderPreamble,
    "",
    `• ${productName} — ${priceLabel}`,
    "",
    shop.orderOutro,
  ].join("\n");
  return `https://wa.me/?text=${encodeURIComponent(message)}`;
};
---

<BaseLayout title={title} description={description}>
  <!-- ===================== SHOP HERO ===================== -->
  <section class="relative isolate overflow-hidden border-b-2 border-[var(--color-ink-950)]">
    <div class="absolute inset-0 -z-10 bg-[var(--color-cream-soft)]"></div>
    <div class="absolute inset-0 -z-10 opacity-90"
      style="background-image:
        radial-gradient(circle at 12% 20%, rgba(255,82,60,0.28), transparent 45%),
        radial-gradient(circle at 90% 10%, rgba(255,210,63,0.55), transparent 50%),
        radial-gradient(circle at 70% 90%, rgba(7,201,182,0.3), transparent 55%);">
    </div>

    <div class="pointer-events-none absolute right-6 top-16 hidden md:block" aria-hidden="true">
      <div class="floating">
        <div class="rounded-full border-2 border-[var(--color-ink-950)] bg-[var(--color-coral-500)] px-5 py-3 shadow-[4px_4px_0_0_var(--color-ink-950)]">
          <p class="font-display text-sm font-bold uppercase tracking-[0.18em] text-[var(--color-cream-soft)]">
            ✦ Tamarin Bay · Drop 001
          </p>
        </div>
      </div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 pb-16 pt-20 sm:px-6 sm:pb-20 sm:pt-24 lg:px-10 lg:pb-24 lg:pt-28">
      <div data-float class="flex flex-wrap items-center gap-3">
        <span class="eyebrow-badge !bg-[var(--color-ink-950)] !border-[var(--color-ink-950)] !text-[var(--color-sun-500)]">
          <span class="inline-block h-2 w-2 animate-pulse rounded-full bg-[var(--color-coral-500)]"></span>
          {shop.dropLabel}
        </span>
        <span class="chip">Pre-order only · {products.length} pieces</span>
      </div>

      <div data-float class="mt-8 grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
        <h1
          class="font-display text-[var(--color-ink-950)]"
          style="font-size: clamp(2.75rem, 8vw, 6.5rem); line-height: 0.9; letter-spacing: -0.045em; font-variation-settings: 'wdth' 114, 'opsz' 96; font-weight: 700;"
        >
          <span class="block">Duckies</span>
          <span class="block">
            <span class="ink-underline">swag</span>,
            <span class="font-accent italic text-[var(--color-coral-500)]" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">teased.</span>
          </span>
        </h1>
        <div class="space-y-5">
          <p class="body-copy max-w-xl">
            {shop.intro}
          </p>
          <div class="flex flex-wrap gap-3">
            <a class="cta-primary" href="#drop">
              See the drop
            </a>
            <a class="cta-secondary" href="#how-it-works">
              How it works
            </a>
          </div>
          <p class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-[var(--color-ink-950)]/65">
            {shop.tagline}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== HOW IT WORKS ===================== -->
  <section id="how-it-works" class="mx-auto max-w-7xl px-6 py-16 lg:px-10">
    <div class="grid gap-6 md:grid-cols-3">
      {shop.steps.map((step, i) => (
        <div class:list={[
          "surface-card p-6",
          i === 0 ? "sticker-sun" : i === 1 ? "sticker-teal" : "sticker-coral",
        ]} data-reveal>
          <span class="step-bubble">{String(i + 1).padStart(2, "0")}</span>
          <p class="mt-4 font-display text-2xl text-[var(--color-ink-950)]" style="font-variation-settings: 'wdth' 110; font-weight: 700;">
            {step.title}
          </p>
          <p class="mt-2 text-[0.95rem] leading-7 text-[var(--color-ink-950)]/78">{step.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ===================== PRODUCT GRID ===================== -->
  <section id="drop" class="mx-auto max-w-7xl px-6 pb-20 lg:px-10">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-6" data-reveal>
      <div class="max-w-2xl space-y-3">
        <p class="section-kicker">The drop</p>
        <h2 class="section-title">
          Pick a piece, <span class="ink-underline">DM</span> the club.
        </h2>
      </div>
      <p class="font-mono text-[0.7rem] uppercase tracking-[0.22em] text-[var(--color-ink-950)]/65 max-w-xs">
        Tap any card — WhatsApp opens with the order pre-written. You pick the recipient.
      </p>
    </div>

    {loadError ? (
      <div class="surface-card p-8 text-center">
        <p class="font-mono text-[0.7rem] uppercase tracking-[0.22em] text-[var(--color-coral-500)]">
          Drop not loaded
        </p>
        <p class="mt-3 font-display text-2xl text-[var(--color-ink-950)]" style="font-variation-settings: 'wdth' 110; font-weight: 700;">
          Kit temporarily off the rack.
        </p>
        <p class="mt-2 text-[0.95rem] leading-7 text-[var(--color-ink-950)]/70">
          The product catalogue couldn't be loaded right now. Ping us on WhatsApp and we'll lock your order in by hand.
        </p>
        <a class="cta-primary mt-6 inline-flex" href={site.whatsappUrl} target="_blank" rel="noreferrer">
          Ask on WhatsApp
        </a>
      </div>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((product) => {
          const theme = themeFor(product.colorway);
          const priceLabel = formatPrice(product.priceCents, product.currency);
          const sizesLabel = product.sizes.length ? product.sizes.join(" · ") : "One size";
          const orderUrl = buildOrderUrl(product.name, priceLabel);
          return (
            <article
              class:list={[
                "surface-card flex flex-col overflow-hidden",
                product.featured ? "sticker-lilac lg:col-span-2" : "",
              ]}
              data-reveal
            >
              <a
                href={`/shop/${product.slug}`}
                class="product-visual relative flex aspect-[4/3] flex-col justify-between border-b-2 border-[var(--color-ink-950)] p-5 outline-none transition-transform duration-300 hover:scale-[1.01] focus-visible:ring-2 focus-visible:ring-[var(--color-sun-500)]"
                style={`background:${theme.bg};color:${theme.ink};`}
                aria-label={`${product.name} details`}
              >
                <div class="flex items-start justify-between gap-3">
                  <span class="font-mono text-[0.66rem] uppercase tracking-[0.22em] opacity-80">
                    {product.kind}
                  </span>
                  <span
                    class="rounded-full border-2 border-[var(--color-ink-950)] px-3 py-1 font-mono text-[0.66rem] font-semibold uppercase tracking-[0.18em] shadow-[2px_2px_0_0_var(--color-ink-950)]"
                    style={`background:${theme.badgeBg};color:${theme.badgeInk};`}
                  >
                    {priceLabel}
                  </span>
                </div>

                <div class="relative flex flex-1 items-center justify-center">
                  <span
                    class="font-display text-center leading-[0.82] tracking-[-0.05em]"
                    style={`font-size:clamp(2.2rem,5.5vw,3.8rem);font-variation-settings:'wdth' 118;font-weight:800;color:${theme.ink};`}
                  >
                    {product.name.split(" ").map((word) => (
                      <span class="block">{word}</span>
                    ))}
                  </span>
                </div>

                <svg
                  class="pointer-events-none absolute inset-x-0 bottom-3 h-6 w-full opacity-90"
                  viewBox="0 0 320 24"
                  aria-hidden="true"
                >
                  <path
                    d="M 0 12 Q 20 0 40 12 T 80 12 T 120 12 T 160 12 T 200 12 T 240 12 T 280 12 T 320 12"
                    fill="none"
                    stroke={theme.waveStroke}
                    stroke-width="2.5"
                    stroke-linecap="round"
                  />
                </svg>

                <span
                  class="pointer-events-none absolute left-3 bottom-3 font-mono text-[0.58rem] uppercase tracking-[0.22em] opacity-70"
                >
                  ✦ Sunset Duckies · MU
                </span>
              </a>

              <div class="flex flex-1 flex-col gap-4 p-6">
                <div class="space-y-1">
                  <a
                    href={`/shop/${product.slug}`}
                    class="font-display text-xl text-[var(--color-ink-950)] hover:text-[var(--color-coral-500)]"
                    style="font-variation-settings:'wdth' 110;font-weight:700;"
                  >
                    {product.name}
                  </a>
                  {product.tagline && (
                    <p class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-[var(--color-coral-500)]">
                      {product.tagline}
                    </p>
                  )}
                </div>
                <p class="text-[0.95rem] leading-7 text-[var(--color-ink-950)]/78">
                  {product.description}
                </p>
                <p class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-[var(--color-ink-950)]/60">
                  Sizes: {sizesLabel}
                </p>
                <div class="mt-auto flex flex-col gap-2">
                  <a
                    class="cta-primary w-full"
                    href={orderUrl}
                    target="_blank"
                    rel="noreferrer"
                    aria-label={`Order ${product.name} via WhatsApp`}
                  >
                    Order via WhatsApp
                  </a>
                  <a
                    class="cta-secondary w-full"
                    href={`/shop/${product.slug}`}
                  >
                    View details
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    )}

    <ul class="mt-10 grid gap-3 sm:grid-cols-3" data-reveal>
      {shop.notes.map((note) => (
        <li class="rounded-[1.2rem] border-2 border-[var(--color-ink-950)] bg-[var(--color-cream-soft)] p-4 font-mono text-[0.72rem] uppercase tracking-[0.16em] text-[var(--color-ink-950)]/75 shadow-[3px_3px_0_0_var(--color-ink-950)]">
          ✦ {note}
        </li>
      ))}
    </ul>
  </section>

  <!-- ===================== PAYMENT METHODS ===================== -->
  <section class="mx-auto max-w-7xl px-6 pb-20 lg:px-10">
    <div class="surface-card p-8 md:p-10" data-reveal>
      <div class="grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
        <div class="space-y-5">
          <p class="section-kicker">Payment</p>
          <h2 class="section-title">
            Pay with
            <span class="font-accent italic" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">Juice</span>,
            cash, or <span class="ink-underline">bank</span>.
          </h2>
          <p class="body-copy max-w-xl">
            We skip the card processors so more of your rupees land in the water. Local, human, low-overhead —
            the same vibe as the club itself.
          </p>
          <a class="cta-primary" href={site.whatsappUrl} target="_blank" rel="noreferrer">
            Ask a question on WhatsApp
          </a>
        </div>

        <div class="grid gap-4">
          {shop.payment.map((method, i) => (
            <div class:list={[
              "rounded-[1.4rem] border-2 border-[var(--color-ink-950)] p-5 shadow-[3px_3px_0_0_var(--color-ink-950)]",
              i === 0 ? "bg-[var(--color-sun-500)]" : i === 1 ? "bg-[var(--color-teal-500)]/30" : "bg-[var(--color-cream-soft)]",
            ]}>
              <div class="flex items-start justify-between gap-4">
                <p class="font-display text-2xl text-[var(--color-ink-950)]" style="font-variation-settings: 'wdth' 110; font-weight: 700;">
                  {method.label}
                </p>
                <span class="tag-pill">{method.tag}</span>
              </div>
              <p class="mt-2 text-[0.95rem] leading-7 text-[var(--color-ink-950)]/78">{method.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== BOTTOM CTA ===================== -->
  <section class="mx-auto max-w-7xl px-6 pb-24 lg:px-10">
    <div class="glass-panel p-10 text-center" data-reveal>
      <p class="font-mono text-[0.7rem] uppercase tracking-[0.24em] text-[var(--color-sun-500)]">
        ✦ Drop 001 closes when it closes
      </p>
      <h2 class="mt-4 font-display text-4xl sm:text-5xl" style="font-variation-settings: 'wdth' 112; font-weight: 700;">
        Slide in. Stack your kit.
      </h2>
      <p class="mt-3 text-sm text-[var(--color-cream)]/80 sm:text-base">
        Questions on sizing, bundling, or delivery — all handled in the club WhatsApp.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a class="cta-primary" href={site.whatsappUrl} target="_blank" rel="noreferrer">
          Slide in ✿ WhatsApp
        </a>
        <a class="cta-secondary" href="/">
          Back to the club
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .product-visual {
    background-image:
      radial-gradient(circle at 85% 15%, rgba(255, 255, 255, 0.18), transparent 45%),
      radial-gradient(circle at 10% 90%, rgba(0, 0, 0, 0.14), transparent 50%);
  }
</style>
