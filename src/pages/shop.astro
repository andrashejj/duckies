---
export const prerender = false;
import { formatPrice } from "../lib/format";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { listActiveProducts, packLabel } from "../lib/products";
import ProductVisual from "../components/ProductVisual.astro";
import Chip from "../components/ui/Chip.astro";
import Cta from "../components/ui/Cta.astro";
import Kicker from "../components/ui/Kicker.astro";
import SectionTitle from "../components/ui/SectionTitle.astro";
import StickerCard from "../components/ui/StickerCard.astro";
import Underline from "../components/ui/Underline.astro";
import { bodyCopy, eyebrowBadge, stepBubble } from "../lib/ui";
import { getActiveDrop } from "../lib/drops";
import ShopTeaser from "../components/ShopTeaser.astro";

const title = `${site.name} Shop`;
const description =
  "Sunset Duckies granola: three flavours baked in Tamarin, Mauritius, in 300 g pouches. Reserve at sesh, pickup at sesh.";

const { shop } = site;

// The drop is for club members; everyone else gets the teaser and no catalogue query.
const session = Astro.locals.session;
const member = Boolean(session?.canShop);

let products: Awaited<ReturnType<typeof listActiveProducts>> = [];
let loadError: string | null = null;
let activeDrop: Awaited<ReturnType<typeof getActiveDrop>> = null;

if (member) {
  try {
    [products, activeDrop] = await Promise.all([
      listActiveProducts(),
      getActiveDrop(),
    ]);
  } catch (err) {
    loadError = "Could not load products. Please try again shortly.";
    Astro.response.status = 503;
    console.error("[shop] product load failed:", err);
  }
}

const dateFormatter = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "short",
});
const closesLabel = activeDrop?.closesAt
  ? `Closes ${dateFormatter.format(activeDrop.closesAt)}`
  : null;
const dropHeading = activeDrop?.name ?? shop.dropLabel;
const dropDescription = activeDrop?.description ?? shop.intro;
---

<BaseLayout title={title} description={description} workspace={member ? "member" : undefined}>
  {!member && <ShopTeaser email={session?.user.email ?? null} />}
  {member && (
  <!-- ===================== SHOP HERO ===================== -->
  <section class="relative isolate overflow-hidden border-b-2 border-edge">
    <div class="absolute inset-0 -z-10 bg-surface"></div>
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_12%_20%,color-mix(in_oklab,var(--color-coral-500)_28%,transparent),transparent_45%),radial-gradient(circle_at_90%_10%,color-mix(in_oklab,var(--color-sun-500)_55%,transparent),transparent_50%),radial-gradient(circle_at_70%_90%,color-mix(in_oklab,var(--color-teal-500)_30%,transparent),transparent_55%)] opacity-90"></div>

    <div class="pointer-events-none absolute top-16 right-6 hidden md:block" aria-hidden="true">
      <div class="animate-float motion-reduce:animate-none">
        <div class="rounded-full border-2 border-ink-950 bg-coral-500 px-5 py-3 shadow-[4px_4px_0_0_var(--color-ink-950)]">
          <p class="font-display text-sm font-bold uppercase tracking-[0.18em] text-cream-soft">
            ✦ Tamarin Bay · {dropHeading}
          </p>
        </div>
      </div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 pb-16 pt-20 sm:px-6 sm:pb-20 sm:pt-24 lg:px-10 lg:pb-24 lg:pt-28">
      <div data-float class="flex flex-wrap items-center gap-3">
        <span class={`${eyebrowBadge} border-edge bg-ink-950`}>
          <span class="inline-block h-2 w-2 animate-pulse rounded-full bg-coral-500"></span>
          {dropHeading}
        </span>
        <Chip>{`${products.length} ${products.length === 1 ? "flavour" : "flavours"} in the lineup`}</Chip>
        {closesLabel && <Chip>{closesLabel}</Chip>}
      </div>

      <div data-float class="mt-8 grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
        <h1 class="font-display text-[clamp(2.75rem,8vw,6.5rem)] font-bold leading-[0.9] tracking-[-0.045em] text-fg [font-variation-settings:'wdth'_114,'opsz'_96]">
          <span class="block">Duckies</span>
          <span class="block">
            <Underline>granola</Underline>,
            <span class="font-accent italic text-accent-text">off the beach.</span>
          </span>
        </h1>
        <div class="space-y-5">
          <p class={`max-w-xl ${bodyCopy}`}>
            {dropDescription}
          </p>
          <div class="flex flex-wrap gap-3">
            <Cta href="#drop">See the drop</Cta>
            <Cta variant="secondary" href="#how-it-works">How it works</Cta>
          </div>
          <p class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-fg/65">
            {shop.tagline}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== HOW IT WORKS ===================== -->
  <section id="how-it-works" class="mx-auto max-w-7xl px-6 py-16 lg:px-10">
    <div class="grid gap-6 md:grid-cols-3">
      {shop.steps.map((step, i) => (
        <StickerCard tone={i === 0 ? "sun" : i === 1 ? "teal" : "coral"} class="p-6" data-reveal>
          <span class={stepBubble}>{String(i + 1).padStart(2, "0")}</span>
          <p class="mt-4 font-display text-2xl font-bold text-fg [font-variation-settings:'wdth'_110]">
            {step.title}
          </p>
          <p class="mt-2 text-[0.95rem] leading-7 text-fg/78">{step.text}</p>
        </StickerCard>
      ))}
    </div>
  </section>

  <!-- ===================== PRODUCT GRID ===================== -->
  <section id="drop" class="mx-auto max-w-7xl px-6 pb-20 lg:px-10">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-6" data-reveal>
      <div class="max-w-2xl space-y-3">
        <Kicker>The drop</Kicker>
        <SectionTitle>
          Pick a flavour, <Underline>reserve</Underline> at sesh.
        </SectionTitle>
      </div>
      <p class="font-mono text-[0.7rem] uppercase tracking-[0.22em] text-fg/65 max-w-xs">
        Tap a card, fill the reservation, we'll DM on WhatsApp to lock it in.
      </p>
    </div>

    {loadError ? (
      <StickerCard class="p-8 text-center">
        <p class="font-mono text-[0.7rem] uppercase tracking-[0.22em] text-accent-text">
          Drop not loaded
        </p>
        <p class="mt-3 font-display text-2xl font-bold text-fg [font-variation-settings:'wdth'_110]">
          Granola temporarily off the shelf.
        </p>
        <p class="mt-2 text-[0.95rem] leading-7 text-fg/70">
          The product catalogue couldn't be loaded right now. Ping us on WhatsApp and we'll lock your reservation in by hand.
        </p>
        <Cta href={site.whatsappUrl} target="_blank" rel="noreferrer" class="mt-6">Ask on WhatsApp</Cta>
      </StickerCard>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((product) => {
          const pack = packLabel(product);
          return (
            <StickerCard as="article" tone={product.featured ? "lilac" : "none"} class:list={["flex flex-col overflow-hidden", product.featured && "lg:col-span-2"]} data-reveal>
              <ProductVisual product={product} href={`/shop/${product.slug}`} class="border-b-2 border-edge" />

              <div class="flex flex-1 flex-col gap-4 p-6">
                <div class="space-y-1">
                  <a href={`/shop/${product.slug}`} class="font-display text-xl font-bold text-fg [font-variation-settings:'wdth'_110] hover:text-accent-text">
                    {product.name}
                  </a>
                  {product.tagline && (
                    <p class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-accent-text">
                      {product.tagline}
                    </p>
                  )}
                </div>
                <p class="text-[0.95rem] leading-7 text-fg/78">
                  {product.description}
                </p>
                <p class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-fg/60">
                  {pack.label}: {pack.value}
                </p>
                <p class="font-display text-xl">{formatPrice(product.priceCents, product.currency)}</p>
                <div class="mt-auto flex flex-col gap-2">
                  <Cta href={`/shop/${product.slug}`} class="w-full text-center">Reserve at sesh</Cta>
                </div>
              </div>
            </StickerCard>
          );
        })}
      </div>
    )}

    <ul class="mt-10 grid gap-3 sm:grid-cols-3" data-reveal>
      {shop.notes.map((note) => (
        <li class="rounded-[1.2rem] border-2 border-edge bg-surface p-4 font-mono text-[0.72rem] uppercase tracking-[0.16em] text-fg/75 shadow-sticker-sm">
          ✦ {note}
        </li>
      ))}
    </ul>
  </section>

  <!-- ===================== BOTTOM CTA ===================== -->
  <section class="mx-auto max-w-7xl px-6 pb-24 lg:px-10">
    <div class="rounded-sticker border-2 border-edge bg-ink-950/55 p-10 text-center text-cream shadow-sticker backdrop-blur-[18px]" data-reveal>
      <p class="font-mono text-[0.7rem] uppercase tracking-[0.24em] text-sun-500">
        ✦ {dropHeading} closes when it closes
      </p>
      <h2 class="mt-4 font-display text-4xl font-bold [font-variation-settings:'wdth'_112] sm:text-5xl">
        Slide in. Stock the pantry.
      </h2>
      <p class="mt-3 text-sm text-cream/80 sm:text-base">
        Questions on ingredients, allergens or pickup? All handled in the club WhatsApp.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Cta href={site.whatsappUrl} target="_blank" rel="noreferrer">Slide in ✿ WhatsApp</Cta>
        <Cta variant="secondary" href="/">Back to the club</Cta>
      </div>
    </div>
  </section>
  )}
</BaseLayout>
