---
import SurfPhoto from "../components/SurfPhoto.astro";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadCupPhotoFiles } from "../lib/cup-photos";
import Lightbox from "../components/Lightbox.astro";
import Chip from "../components/ui/Chip.astro";
import Cta from "../components/ui/Cta.astro";
import Kicker from "../components/ui/Kicker.astro";
import SectionTitle from "../components/ui/SectionTitle.astro";
import StickerCard from "../components/ui/StickerCard.astro";
import Underline from "../components/ui/Underline.astro";
import { bodyCopy, eyebrowBadge, miniCard, stickerTones, type StickerTone } from "../lib/ui";

const cup = site.cup;
const title = `${cup.name} — first ever, 31 May 2026 | ${site.name}`;
const description = `The first ever ${cup.name} happens Sunday 31 May 2026 at Tamarin Bay. Heats of 4, two divisions, parent heat, BBQ, prizes for every duckling. Sign up + download templates.`;

// Build a Nextcloud public-preview URL for one photo, sized server-side.
// `a=true` keeps the aspect ratio; bump `size` for the lightbox.
const cupPreview = (file: string, size: number) =>
  `${cup.photos.base}/index.php/apps/files_sharing/publicpreview/${cup.photos.token}` +
  `?file=/${encodeURIComponent(file)}&x=${size}&y=${size}&a=true`;

// Enumerated from the Nextcloud share at build time (falls back to
// cup.photos.files if the share is unreachable from the build environment).
const photoFiles = await loadCupPhotoFiles();
const photos = photoFiles.map((file, i) => ({
  alt: `Sunset Duckies Cup, first edition — photo ${i + 1} of ${photoFiles.length}`,
  thumb: cupPreview(file, 700),
  full: cupPreview(file, 2048),
}));
const teaser = photos.slice(0, 6);
const tile = "rounded-[1.2rem] border-2 border-edge bg-surface shadow-sticker-sm";
const cardTitle = "font-display font-bold text-fg [font-variation-settings:'wdth'_110]";
---

<BaseLayout title={title} description={description} image="/media/tamarin-shore.jpg" imageAlt="Sunset Duckies Cup — Tamarin Bay">
  <!-- ===================== HERO ===================== -->
  <section class="relative isolate overflow-hidden">
    <div class="absolute inset-0 -z-10">
      <div class="absolute inset-0 bg-ink-950"></div>
      <img
        src="/media/tamarin-shore.jpg"
        alt=""
        class="h-full w-full object-cover opacity-55"
        aria-hidden="true"
      />
      <div class="absolute inset-0 bg-linear-135 from-ink-950/85 via-coral-500/45 via-55% to-sun-500/55"></div>
    </div>

    <!-- Sticker flairs -->
    <div class="pointer-events-none absolute -right-4 top-32 hidden lg:block" aria-hidden="true">
      <div class="animate-float motion-reduce:animate-none">
        <div class="-rotate-[8deg] rounded-full border-2 border-ink-950 bg-sun-500 px-5 py-3 shadow-[5px_5px_0_0_var(--color-ink-950)]">
          <p class="font-display text-lg font-bold text-ink-950 [font-variation-settings:'wdth'_112]">
            ✦ first ever · vol. 01
          </p>
        </div>
      </div>
    </div>
    <div class="pointer-events-none absolute left-6 bottom-24 hidden lg:block" aria-hidden="true">
      <div class="animate-wobble motion-reduce:animate-none">
        <div class="rotate-[6deg] rounded-full border-2 border-ink-950 bg-coral-500 px-4 py-2 shadow-[4px_4px_0_0_var(--color-ink-950)]">
          <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-ink-950">
            First waves → finals
          </p>
        </div>
      </div>
    </div>

    <div class="relative mx-auto flex min-h-[78vh] max-w-7xl flex-col justify-end px-4 pb-14 pt-28 sm:px-6 sm:pb-20 sm:pt-32 lg:px-10 lg:pb-24 lg:pt-36">
      <div data-float class="mb-5">
        <span class={eyebrowBadge}>
          <span class="inline-block h-2 w-2 animate-pulse rounded-full bg-coral-500"></span>
          {cup.dateLabel} · {cup.timeLabel}
        </span>
      </div>

      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-end lg:gap-12">
        <div data-float class="max-w-4xl space-y-6">
          <h1 class="font-display text-[clamp(2.6rem,8vw,6.4rem)] font-semibold leading-[0.9] tracking-[-0.045em] text-white [font-variation-settings:'wdth'_112,'opsz'_96]">
            <span class="block">Sunset Duckies</span>
            <span class="block">
              <span class="font-accent font-medium italic text-sun-500">Cup</span>
              ·
              <span class="font-accent font-medium italic text-coral-400">Vol.&nbsp;01</span>
            </span>
          </h1>
          <p class="max-w-3xl text-base leading-7 text-white/90 sm:text-lg sm:leading-8 md:text-xl md:leading-9">
            {cup.blurb}
          </p>
          <p class="font-mono text-[0.78rem] uppercase tracking-[0.22em] text-white/75">
             {cup.location}  ·   {cup.entryFeeLabel} per kid  ·   sign up by {cup.registerDeadlineLabel}
          </p>
        </div>

        <div data-float class="flex flex-col gap-3">
          <Cta href={site.whatsappUrl} target="_blank" rel="noreferrer" class="w-full">{cup.registerCtaLabel}</Cta>
          <Cta variant="secondary" href="#templates" class="w-full">↓ Grab the templates</Cta>
          <p class="mt-1 text-center font-mono text-[0.68rem] uppercase tracking-[0.22em] text-white/70">
            Heats of 4 ★ best 2 waves count
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== TICKER STRIP ===================== -->
  <section class="relative border-b-2 border-edge bg-sun-500 text-ink-950">
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-0 px-4 sm:px-6 lg:grid-cols-4 lg:px-10">
      <div class="flex flex-col items-start gap-1 py-6 pr-6 border-r-2 border-ink-950/25">
        <p class="font-display text-3xl font-extrabold leading-none [font-variation-settings:'wdth'_118] md:text-4xl">31 May</p>
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-ink-950/80">Sunday · 2026</p>
      </div>
      <div class="flex flex-col items-start gap-1 py-6 pr-6 border-r-2 border-ink-950/25">
        <p class="font-display text-3xl font-extrabold leading-none [font-variation-settings:'wdth'_118] md:text-4xl">13:00–17:30</p>
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-ink-950/80">Tamarin Bay</p>
      </div>
      <div class="flex flex-col items-start gap-1 py-6 pr-6 border-r-2 border-ink-950/25">
        <p class="font-display text-3xl font-extrabold leading-none [font-variation-settings:'wdth'_118] md:text-4xl">2 divs</p>
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-ink-950/80">Duckling  + Duck </p>
      </div>
      <div class="flex flex-col items-start gap-1 py-6 pr-6">
        <p class="font-display text-3xl font-extrabold leading-none [font-variation-settings:'wdth'_118] md:text-4xl">11 prizes</p>
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-ink-950/80">+ a cert for every kid</p>
      </div>
    </div>
  </section>

  <!-- ===================== VOL. 02 CROSS-LINK ===================== -->
  <a
    href="/sunset-duckies-cup-vol-2"
    class="group block border-b-2 border-edge bg-ink-950 text-cream-soft transition hover:bg-ink-900"
  >
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-x-3 gap-y-1 px-4 py-3 text-center sm:px-6 lg:px-10">
      <span class="font-mono text-[0.66rem] uppercase tracking-[0.22em] text-sun-500">★ Next up</span>
      <span class="font-display text-sm font-bold [font-variation-settings:'wdth'_110] sm:text-base">
        Vol. 02 incoming — leveled up from round one
      </span>
      <span class="font-mono text-[0.72rem] font-semibold uppercase tracking-[0.18em] text-teal-500 transition-transform group-hover:translate-x-1">
        See what's changing →
      </span>
    </div>
  </a>

  <!-- ===================== DIVISIONS ===================== -->
  <section id="divisions" class="relative mx-auto max-w-7xl px-6 pb-12 pt-20 lg:px-10">
    <div class="pointer-events-none absolute top-12 -left-20 -z-0 h-[320px] w-[320px] rounded-[52%_48%_40%_60%/55%_45%_55%_45%] bg-coral-500 opacity-45 blur-[40px]"></div>
    <div class="pointer-events-none absolute -right-20 bottom-0 -z-0 h-[280px] w-[280px] rounded-[60%_40%_55%_45%/42%_58%_42%_58%] bg-teal-500 opacity-50 blur-[44px]"></div>

    <div class="relative grid gap-6 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
      <div class="space-y-5" data-reveal>
        <Kicker>Divisions</Kicker>
        <SectionTitle class="max-w-2xl">
          Two divisions.
          <span class="font-accent italic">Both</span>
          get <Underline>crowns</Underline>.
        </SectionTitle>
        <p class={`max-w-xl ${bodyCopy}`}>
          Qualifying heats of 4–6, 10-minute clocks, best 2 waves count. The top ducklings and top
          ducks all surf together in one combined Final (up to 8) — King + Queen still crowned per division.
        </p>
      </div>

      <div class="grid gap-5" data-reveal>
        {cup.divisions.map((division, i) => (
          <StickerCard as="article" tone={i === 0 ? "sun" : "teal"} tilt={i === 0 ? "left" : "right"} class="p-7">
            <div class="flex items-start gap-5">
              <SurfPhoto scene={i === 0 ? "whitewater" : "beach-crew"} />
              <div>
                <p class="font-display text-3xl font-bold text-fg [font-variation-settings:'wdth'_112]">
                  {division.name}
                </p>
                <p class="mt-3 text-[0.98rem] leading-7 text-fg/78">
                  {division.description}
                </p>
              </div>
            </div>
          </StickerCard>
        ))}


      </div>
    </div>
  </section>

  <!-- ===================== RUN OF SHOW ===================== -->
  <section id="run-of-show" class="mx-auto max-w-7xl px-6 py-12 lg:px-10">
    <StickerCard class="p-8 md:p-10" data-reveal>
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <Kicker>Run of show</Kicker>
          <SectionTitle size="none" class="mt-4 text-[clamp(1.9rem,3.5vw,3rem)]">
            13:00 to <Underline>17:30</Underline>.
          </SectionTitle>
        </div>
      </div>

      <div class="mt-8 grid gap-3">
        {cup.runOfShow.map((item) => (
          <div class={`flex items-center gap-4 ${miniCard}`}>
            <p class="w-20 shrink-0 font-mono text-sm font-semibold text-accent-text">
              {item.time}
            </p>
            <p class="font-display text-[1.05rem] font-semibold leading-6 text-fg/85 [font-variation-settings:'wdth'_108]">
              {item.label}
            </p>
          </div>
        ))}
      </div>
    </StickerCard>
  </section>

  <!-- ===================== JUDGING ===================== -->
  <section class="mx-auto max-w-7xl px-6 py-12 lg:px-10">
    <div class="grid gap-6 lg:grid-cols-[0.85fr_1.15fr]">
      <StickerCard tone="coral" class="p-8" data-reveal>
        <Kicker>Judging</Kicker>
        <SectionTitle size="md" class="mt-4">
          Five tick boxes per wave.
        </SectionTitle>
        <p class={`mt-4 ${bodyCopy}`}>
          Three judges, one clipboard each. Per wave they tick the boxes that earned a yes — bias
          toward yes when in doubt. Best 2 waves count, max 10 ticks. Tiebreak by total waves.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          <Chip>10 min heats</Chip>
          <Chip>Best 2 waves</Chip>
          <Chip>Bias toward YES</Chip>
        </div>
      </StickerCard>

      <div class="grid gap-3" data-reveal>
        {cup.judgingCriteria.map((criterion, i) => (
          <article class={miniCard}>
            <div class="flex items-start gap-3">
              <SurfPhoto scene={i === 0 ? "whitewater" : i === 3 ? "hero-wave" : "surf-kit"} />
              <div>
                <p class={`text-xl ${cardTitle}`}>
                  {criterion.title}
                </p>
                <p class="mt-1 text-[0.9rem] leading-6 text-fg/75">{criterion.text}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== PRIZES ===================== -->
  <section id="prizes" class="mx-auto max-w-7xl px-6 py-12 lg:px-10">
    <div class="space-y-8">
      <div class="max-w-3xl" data-reveal>
        <Kicker>Prizes </Kicker>
        <SectionTitle class="mt-4">
          Four crowns.
          <span class="font-accent italic">Seven</span>
          side awards.
        </SectionTitle>
        <p class={`mt-4 max-w-2xl ${bodyCopy}`}>
          {cup.prizes.everyone}
        </p>
      </div>

      <div class="grid gap-5 lg:grid-cols-2" data-reveal>
        <StickerCard tone="sun" class="p-7">
          <p class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-accent-text">
            ★ The crowns
          </p>
          <div class="mt-4 grid gap-3">
            {cup.prizes.crowns.map((prize) => (
              <div class={`p-4 ${tile}`}>
                <p class={`text-xl ${cardTitle}`}>
                  {prize.title}
                </p>
                <p class="mt-1 text-[0.92rem] leading-6 text-fg/75">{prize.text}</p>
              </div>
            ))}
          </div>
        </StickerCard>

        <StickerCard tone="pink" class="p-7">
          <p class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-accent-text">
            ★ Side awards
          </p>
          <div class="mt-4 grid gap-3">
            {cup.prizes.sideAwards.map((prize) => (
              <div class={`p-3 ${tile} shadow-sticker-xs`}>
                <p class="text-[0.95rem]">
                  <strong class="font-display [font-variation-settings:'wdth'_110]">{prize.title}</strong>
                  <span class="text-fg/72"> — {prize.text}</span>
                </p>
              </div>
            ))}
          </div>
        </StickerCard>
      </div>
    </div>
  </section>

  <!-- ===================== PARENT HEAT ===================== -->
  <section class="mx-auto max-w-7xl px-6 py-12 lg:px-10">
    <StickerCard tone="lilac" class="p-8 md:p-10" data-reveal>
      <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div>
          <Kicker>Parent heat · 16:30</Kicker>
          <SectionTitle class="mt-4">
            Watch the <Underline>parents</Underline>
            <span class="font-accent italic">surf</span>.
          </SectionTitle>
          <p class={`mt-4 max-w-xl ${bodyCopy}`}>
            {cup.parentHeat.blurb}
          </p>
        </div>

        <div class="grid grid-cols-1 gap-3">
          {cup.parentHeat.awards.map((award) => (
            <div class={`p-4 ${tile}`}>
              <p class={`text-lg ${cardTitle}`}>
                ✦ {award}
              </p>
            </div>
          ))}
        </div>
      </div>
    </StickerCard>
  </section>

  <!-- ===================== GALLERY ===================== -->
  {photos.length > 0 && (
    <Fragment>
      <section id="gallery" class="mx-auto max-w-7xl px-6 py-12 lg:px-10">
        <div class="mb-9 flex flex-wrap items-end justify-between gap-5" data-reveal>
          <div class="max-w-2xl">
            <Kicker> On the sand</Kicker>
            <SectionTitle class="mt-4">
              The first Cup,
              <span class="font-accent italic">in pictures</span>.
            </SectionTitle>
          </div>
          <Cta variant="secondary" href={cup.photos.shareUrl} target="_blank" rel="noreferrer" class="shrink-0">↗ See all {photos.length} photos</Cta>
        </div>

        <div class="grid grid-cols-2 gap-[0.85rem] sm:grid-cols-3 sm:gap-4" data-reveal>
          {teaser.map((photo, i) => (
            <button
              type="button"
              class="block aspect-[4/3] cursor-zoom-in overflow-hidden rounded-[1.1rem] border-2 border-edge bg-ink-900 p-0 shadow-sticker-md transition-[translate,rotate,box-shadow] duration-200 nth-[3n+2]:-rotate-[0.7deg] nth-[3n]:rotate-[0.6deg] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:rotate-0 hover:shadow-[7px_7px_0_0_var(--edge)] focus-visible:-translate-x-0.5 focus-visible:-translate-y-0.5 focus-visible:rotate-0 focus-visible:shadow-[7px_7px_0_0_var(--edge)] focus-visible:outline-none"
              data-lb-trigger
              data-full={photo.full}
              data-alt={photo.alt}
              aria-label={`Open photo ${i + 1}`}
            >
              <img
                src={photo.thumb}
                alt={photo.alt}
                loading={i < 3 ? "eager" : "lazy"}
                decoding="async"
                class="block h-full w-full object-cover"
                onerror="this.closest('[data-lb-trigger]')?.remove()"
              />
            </button>
          ))}
        </div>

        {photos.length > 6 && (
          <div class="mt-8 flex justify-center" data-reveal>
            <Cta href={cup.photos.shareUrl} target="_blank" rel="noreferrer">↗ See all {photos.length} photos from the day</Cta>
          </div>
        )}
      </section>

      <Lightbox id="cup-lightbox" label="Cup photo viewer" />
    </Fragment>
  )}

  <!-- ===================== BRING + INCLUDED ===================== -->
  <section class="mx-auto max-w-7xl px-6 py-12 lg:px-10">
    <div class="grid gap-6 lg:grid-cols-2">
      <StickerCard tone="teal" class="p-8" data-reveal>
        <Kicker>Bring</Kicker>
        <SectionTitle size="none" class="mt-4 text-[clamp(1.5rem,2.5vw,2.2rem)]">
          What to pack.
        </SectionTitle>
        <ul class="mt-6 grid gap-3">
          {cup.bring.map((item) => (
            <li class={`flex items-start gap-3 p-4 ${tile}`}>
              <span class="font-mono text-sm font-bold text-accent-text">✦</span>
              <span class="text-[0.95rem] leading-6 text-fg/85">{item}</span>
            </li>
          ))}
        </ul>
      </StickerCard>

      <StickerCard tone="sun" class="p-8" data-reveal>
        <Kicker>Included</Kicker>
        <SectionTitle size="none" class="mt-4 text-[clamp(1.5rem,2.5vw,2.2rem)]">
          What's in the fee.
        </SectionTitle>
        <ul class="mt-6 grid gap-3">
          {cup.included.map((item) => (
            <li class={`flex items-start gap-3 p-4 ${tile}`}>
              <span class="font-mono text-sm font-bold text-teal-600">✓</span>
              <span class="text-[0.95rem] leading-6 text-fg/85">{item}</span>
            </li>
          ))}
        </ul>
        <p class="mt-6 font-mono text-[0.72rem] uppercase tracking-[0.16em] text-fg/65">
          Entry · {cup.entryFeeLabel} per kid
        </p>
      </StickerCard>
    </div>
  </section>


  <!-- ===================== SIGN UP CTA ===================== -->
  <section class="mx-auto max-w-7xl px-6 pb-24 pt-6 lg:px-10">
    <StickerCard tone="coral" class="p-8 md:p-12" data-reveal>
      <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div>
          <Kicker>Sign up</Kicker>
          <SectionTitle class="mt-4">
            Lock in your <Underline>spot</Underline>.
          </SectionTitle>
          <p class={`mt-4 max-w-2xl ${bodyCopy}`}>
            Fill in the registration form + waiver below and WhatsApp them to Andras with a
            head-and-shoulders photo of your duckling for the heat billboard. Entry locks in once
            the fee lands.
          </p>
          <p class="mt-4 font-mono text-[0.72rem] uppercase tracking-[0.16em] text-fg/65">
            Deadline: {cup.registerDeadlineLabel} · {cup.entryFeeLabel}
          </p>
        </div>
        <div class="flex flex-col gap-3">
          <Cta href={site.whatsappUrl} target="_blank" rel="noreferrer">{cup.registerCtaLabel}</Cta>
          <Cta variant="secondary" href="/templates/registration-form.html" target="_blank" rel="noreferrer">↓ Open registration form</Cta>
          <Cta variant="secondary" href="/templates/parent-whatsapp-message.txt" target="_blank" rel="noreferrer">Copy parent message</Cta>
        </div>
      </div>
    </StickerCard>
  </section>

  <!-- ===================== TEMPLATES ===================== -->
  <section id="templates" class="mx-auto max-w-7xl px-6 py-14 lg:px-10">
    <StickerCard class="p-8 md:p-10" data-reveal>
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-2xl">
          <Kicker>Templates</Kicker>
          <SectionTitle class="mt-4">
            Print or
            <span class="font-accent italic">save</span>
            as PDF.
          </SectionTitle>
          <p class={`mt-4 ${bodyCopy}`}>
            The forms, scorecards, scripts, and checklists for the day. Each opens in a new tab.
          </p>
        </div>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {cup.templates.map((template) => (
          <a
            href={template.file}
            target="_blank"
            rel="noreferrer"
            class:list={[
              "group relative flex flex-col gap-3 rounded-[1.6rem] border-2 border-edge p-6 shadow-sticker-md transition-all hover:-translate-y-1 hover:shadow-[7px_7px_0_0_var(--edge)]",
              stickerTones[template.accent as StickerTone],
            ]}
          >
            <div class="flex items-center justify-between">
              <SurfPhoto scene={template.photo} />
              <span class="rounded-full border-2 border-edge bg-surface px-3 py-1 font-mono text-[0.62rem] font-semibold uppercase tracking-[0.14em] text-fg shadow-sticker-xs">
                {template.file.endsWith(".txt") ? "TXT" : "HTML"}
              </span>
            </div>
            <p class={`text-xl ${cardTitle}`}>
              {template.title}
            </p>
            <p class="text-[0.9rem] leading-6 text-fg/78">
              {template.description}
            </p>
            <p class="mt-auto pt-2 font-mono text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-accent-text transition-transform group-hover:translate-x-1">
              ↓ Open template
            </p>
          </a>
        ))}
      </div>
    </StickerCard>
  </section>
</BaseLayout>
