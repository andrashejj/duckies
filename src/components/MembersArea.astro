---
import Cta from "./ui/Cta.astro";
import Kicker from "./ui/Kicker.astro";
import SectionTitle from "./ui/SectionTitle.astro";
import { duckiesRoster, memberForm, memberStatus, rosterAdd, rosterHead, rosterToolbar, textButton } from "../lib/members-ui";
---

<section id="our-duckies" data-members hidden class="relative scroll-mt-28 border-b-2 border-edge bg-canvas py-14 motion-safe:animate-crew-arrive sm:py-20">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div class="flex flex-wrap items-start justify-between gap-6">
      <div>
        <Kicker>Members · Tamarin Bay</Kicker>
        <SectionTitle class="mt-4">Our <span class="font-accent italic">duckies.</span></SectionTitle>
        <p class="mt-4 text-base leading-7">The kids we paddle out with. Shared only with signed-in club members.</p>
      </div>
      <div class="max-w-full text-sm">
        <p data-member-email class="break-all"></p>
        <button data-sign-out type="button" class={`mt-2 ${textButton}`}>Sign out</button>
      </div>
    </div>
    <div data-semester-controls hidden class="mt-8"></div>
    <div class={rosterToolbar}>
      <label>Search the lineup<input data-roster-search type="search" placeholder="Kid, guardian or phone…" autocomplete="off" /></label>
      <label data-roster-filter-label hidden>Show<select data-roster-filter aria-label="Show">
        <option value="all">All kids</option>
        <option value="unpaid">Unpaid this semester</option>
        <option value="unsigned">Waiver not signed</option>
        <option value="no-media">No media consent</option>
        <option value="water">Parent in water not acknowledged</option>
      </select></label>
    </div>
    <p data-roster-count role="status" aria-live="polite" class="mt-4 font-mono text-xs uppercase tracking-widest"></p>
    <div data-roster-head hidden class={rosterHead} aria-hidden="true"><span>Duckie</span><span>Age</span><span>Legal guardians</span><span>Waiver</span><span>Media</span><span>Parent in water</span><span>Payment</span></div>
    <ul data-roster class={duckiesRoster} aria-label="Club kids"></ul>
    <p data-empty hidden class="mt-6 text-lg">The lineup is taking shape. The club will add the kids here soon.</p>
    <p data-no-matches hidden class="mt-6">No kids match. Try another name or filter.</p>
    <details data-add-panel hidden class={rosterAdd}><summary>Add a duckie</summary>
    <form data-add-kid hidden class={`${memberForm} mt-8 max-w-lg rounded-2xl border-2 border-edge bg-sun-500 p-5 text-ink-950`}>
      <label for="kid-name">Add a duckie</label>
      <p id="kid-name-help" class="text-sm leading-6">Use the name they go by at the club. A first name and surname initial works well.</p>
      <input id="kid-name" name="name" required maxlength="80" autocomplete="off" aria-describedby="kid-name-help" placeholder="Name at the club" />
      <Cta type="submit">Add to the lineup</Cta>
    </form>
    </details>
    <a data-archived-kids hidden href="/admin/kids/archived" class={`mt-6 inline-block ${textButton}`}>Archived kids and signed records</a>
    <p data-roster-status class={memberStatus} role="status" aria-live="polite"></p>
  </div>
</section>
<p data-member-load-error hidden class="mx-auto max-w-7xl px-6 py-4 text-sm" role="status">The members area couldn’t load. <button type="button" data-retry-members class={textButton}>Try again</button></p>

<script>
  import { duckieAvatar, duckieAvatarEmpty, duckieChevron, duckieEdit, duckieIdentity, duckieIdentityRow, duckieName, duckiePanel, duckieProfile, duckieRow, duckieSummary, duckieActions, textButton } from "../lib/members-ui";
  import { semesterControls } from "../lib/registration/semester-controls";
  import type { Semester } from "../lib/registration/semesters";
  import { authClient } from "../lib/auth-client";
  import { rosterCells, rosterSearch, matchesRosterFilter } from "../lib/registration/roster";
  import { kidOverview } from "../lib/registration/overview";
  import type { OrganiserKid } from "../lib/registration/records";

  type Kid = { id: string; name: string };
  type Roster = { member: { email: string; role: "member" | "organiser"; canManagePayments?: boolean }; term: Semester; semesters: Semester[]; termLabel: string; kids: Kid[] };
  const section = document.querySelector<HTMLElement>("[data-members]")!;
  const list = section.querySelector<HTMLUListElement>("[data-roster]")!;
  const form = section.querySelector<HTMLFormElement>("[data-add-kid]")!;
  const status = section.querySelector<HTMLElement>("[data-roster-status]")!;
  const loadError = document.querySelector<HTMLElement>("[data-member-load-error]")!;
  const memberLinks = document.querySelectorAll<HTMLAnchorElement>("[data-member-link]");
  const search = section.querySelector<HTMLInputElement>("[data-roster-search]")!;
  const filter = section.querySelector<HTMLSelectElement>("[data-roster-filter]")!;
  let currentRoster: Roster | null = null;
  let selectedTerm = "";
  let generation = 0;
  let lastRoster = "";

  function clearRoster() {
    generation++;
    lastRoster = "";
    currentRoster = null;
    section.hidden = true;
    list.replaceChildren();
    section.querySelector("[data-semester-controls]")!.replaceChildren();
    form.reset();
    form.hidden = true;
    section.querySelector("[data-member-email]")!.textContent = "";
    section.querySelector("[data-roster-count]")!.textContent = "";
    status.textContent = "";
    for (const link of memberLinks) { link.href = "/login"; link.textContent = "Member sign-in"; }
  }

  function button(label: string, action: () => void) {
    const element = document.createElement("button");
    element.type = "button";
    element.className = textButton;
    element.textContent = label;
    element.addEventListener("click", action);
    return element;
  }

  async function mutate(url: string, method: string, name?: string) {
    status.textContent = "";
    const response = await fetch(url, {
      method, headers: { "Content-Type": "application/json" },
      ...(name === undefined ? {} : { body: JSON.stringify({ name }) }),
    });
    if (response.status === 401) { clearRoster(); window.location.assign("/login"); return false; }
    if (!response.ok) {
      const data = await response.json();
      throw new Error(data.error ?? "Couldn't save your change. Please try again.");
    }
    await loadRoster();
    return true;
  }

  function filterRoster() {
    if (!currentRoster) return;
    const query = search.value.trim().toLocaleLowerCase();
    let visible = 0;
    currentRoster.kids.forEach((kid, index) => {
      const organiser = currentRoster!.member.role === "organiser";
      const matches = rosterSearch(kid, organiser).includes(query) && (!organiser || matchesRosterFilter(kid as OrganiserKid, filter.value));
      (list.children[index] as HTMLElement).hidden = !matches;
      if (matches) visible++;
    });
    const total = currentRoster.kids.length;
    section.querySelector("[data-roster-count]")!.textContent = `${visible === total ? total : `${visible} of ${total}`} ${total === 1 ? "duckie" : "duckies"} in the lineup · ${currentRoster.termLabel}`;
    section.querySelector<HTMLElement>("[data-no-matches]")!.hidden = visible > 0 || total === 0;
  }
  search.addEventListener("input", filterRoster);
  filter.addEventListener("change", filterRoster);

  function render(data: Roster) {
    const expanded = new Set(Array.from(list.querySelectorAll<HTMLDetailsElement>("details[data-kid-id][open]")).map(row => row.dataset.kidId));
    const focusedKid = document.activeElement?.closest("[data-kid-id]")?.getAttribute("data-kid-id");
    currentRoster = data;
    list.replaceChildren();
    const organiser = data.member.role === "organiser";
    section.querySelector<HTMLElement>("[data-roster-head]")!.hidden = !organiser;
    section.querySelector<HTMLElement>("[data-roster-filter-label]")!.hidden = !organiser;
    const controls = section.querySelector<HTMLElement>("[data-semester-controls]")!;
    controls.hidden = data.member.role !== "organiser";
    controls.replaceChildren();
    if (!controls.hidden) controls.append(semesterControls(data.semesters, data.term, Boolean(data.member.canManagePayments), async id => { selectedTerm = id; await loadRoster(); }, message => { status.textContent = message; }));
    data.kids.forEach((kid) => {
      const row = document.createElement("li");
      row.className = duckieRow;
      const profile = document.createElement("details");
      profile.className = duckieProfile;
      profile.dataset.kidId = kid.id;
      profile.open = expanded.has(kid.id);
      const summary = document.createElement("summary");
      summary.className = duckieSummary;
      summary.setAttribute("aria-label", `${kid.name}, details`);
      const identity = document.createElement("span");
      identity.className = organiser ? duckieIdentity : duckieIdentityRow;
      const name = document.createElement("span");
      name.className = duckieName;
      name.textContent = kid.name;
      if (organiser) {
        const photo = (kid as OrganiserKid).photoVersion;
        if (photo) { const img = document.createElement("img"); img.className = duckieAvatar; img.alt = `${kid.name}'s profile photo`; img.width = 36; img.height = 36; img.loading = "lazy"; img.src = `/api/kids/${kid.id}/photo?v=${encodeURIComponent(photo)}`; identity.append(img); }
        else { const placeholder = document.createElement("span"); placeholder.className = duckieAvatarEmpty; placeholder.setAttribute("aria-hidden", "true"); placeholder.textContent = kid.name.slice(0,1).toUpperCase(); identity.append(placeholder); }
        const chevron = document.createElement("span");
        chevron.className = duckieChevron;
        chevron.textContent = "›";
        chevron.setAttribute("aria-hidden", "true");
        identity.append(name, chevron);
        summary.append(identity, ...rosterCells(kid as OrganiserKid));
        profile.append(summary);
        row.append(profile);
      } else { identity.append(name); row.append(identity); }
      if (data.member.role === "organiser") {
        const actions = document.createElement("div");
        actions.className = duckieActions;
        const edit = document.createElement("form");
        edit.className = duckieEdit;
        edit.hidden = true;
        const input = document.createElement("input");
        input.id = `edit-${kid.id}`;
        input.value = kid.name;
        input.required = true;
        input.maxLength = 80;
        const label = document.createElement("label");
        label.htmlFor = input.id;
        label.textContent = "Name at the club";
        const save = document.createElement("button");
        save.type = "submit";
        save.className = textButton;
        save.textContent = "Save";
        const editButton = button("Edit", () => { edit.hidden = false; input.focus(); });
        editButton.setAttribute("aria-label", `Edit ${kid.name}`);
        edit.append(label, input, save, button("Cancel", () => { edit.hidden = true; input.value = kid.name; editButton.focus(); }));
        edit.addEventListener("submit", async (event) => {
          event.preventDefault();
          save.disabled = true;
          try { await mutate(`/api/kids/${kid.id}`, "PATCH", input.value); }
          catch (error) { status.textContent = error instanceof Error ? error.message : "Couldn't save your change."; }
          finally { save.disabled = false; }
        });
        const remove = button("Remove", async () => {
          if (!window.confirm(`Archive ${kid.name} from the kids list? Signed waivers and payment history will be kept.`)) return;
          remove.disabled = true;
          try { await mutate(`/api/kids/${kid.id}`, "DELETE"); }
          catch (error) { status.textContent = error instanceof Error ? error.message : "Couldn't remove this duckie."; }
          finally { remove.disabled = false; }
        });
        remove.setAttribute("aria-label", `Remove ${kid.name}`);
        actions.append(editButton, remove);
        const panel = document.createElement("div");
        panel.className = duckiePanel;
        panel.append(actions, edit);
        panel.append(kidOverview(kid as OrganiserKid, Boolean(data.member.canManagePayments), data.term, loadRoster, message => { status.textContent = message; }));
        profile.append(panel);
      }
      list.append(row);
      if (focusedKid === kid.id) summary.focus();
    });
    section.querySelector("[data-member-email]")!.textContent = data.member.email;
    filterRoster();
    section.querySelector<HTMLElement>("[data-empty]")!.hidden = data.kids.length > 0;
    form.hidden = data.member.role !== "organiser";
    section.querySelector<HTMLElement>("[data-add-panel]")!.hidden = form.hidden;
    section.querySelector<HTMLElement>("[data-archived-kids]")!.hidden = data.member.role !== "organiser";
  }

  async function loadRoster() {
    const version = ++generation;
    try {
      const response = await fetch(`/api/kids${selectedTerm ? `?term=${encodeURIComponent(selectedTerm)}` : ""}`, { cache: "no-store" });
      if (version !== generation) return;
      if (response.status === 401) { clearRoster(); loadError.hidden = true; return; }
      if (!response.ok) throw new Error("Unavailable");
      const data: Roster = await response.json();
      if (version !== generation) return;
      const snapshot = JSON.stringify(data);
      if (snapshot !== lastRoster) { render(data); lastRoster = snapshot; }
      const wasHidden = section.hidden;
      section.hidden = false;
      loadError.hidden = true;
      for (const link of memberLinks) { link.href = "#our-duckies"; link.textContent = "Our duckies"; }
      if (wasHidden && window.location.hash === "#our-duckies") section.scrollIntoView();
    } catch {
      if (version !== generation) return;
      clearRoster();
      loadError.hidden = false;
    }
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    submit.disabled = true;
    try {
      const input = form.querySelector<HTMLInputElement>("input")!;
      if (await mutate("/api/kids", "POST", input.value)) { form.reset(); status.textContent = "Duckie added to the lineup."; input.focus(); }
    } catch (error) { status.textContent = error instanceof Error ? error.message : "Couldn't add this duckie."; }
    finally { submit.disabled = false; }
  });

  section.querySelector<HTMLButtonElement>("[data-sign-out]")!.addEventListener("click", async (event) => {
    const target = event.currentTarget as HTMLButtonElement;
    target.disabled = true;
    try {
      const { error } = await authClient.signOut();
      if (error) throw new Error("Sign-out failed");
      clearRoster();
      window.location.replace("/");
    } catch { status.textContent = "Couldn't sign out. Please try again."; }
    finally { target.disabled = false; }
  });
  document.querySelector("[data-retry-members]")!.addEventListener("click", () => void loadRoster());
  window.addEventListener("pagehide", clearRoster);
  window.addEventListener("pageshow", () => void loadRoster());
  document.addEventListener("visibilitychange", () => {
    if (document.hidden) clearRoster(); else void loadRoster();
  });
  window.setInterval(() => { if (!document.hidden) void loadRoster(); }, 60000);
</script>
