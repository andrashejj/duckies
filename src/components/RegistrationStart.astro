---
import Cta from "./ui/Cta.astro";
import { site } from "../data/site";
import { CUP_ENTRY_FEE_MUR, CUP_LABEL } from "../lib/registration/cup";
import { memberForm, memberStatus, registrationCheck, registrationGrid, registrationPanel, textButton } from "../lib/members-ui";
const choice = `${registrationCheck} rounded-xl border-2 border-edge p-4 has-checked:border-teal-600 has-checked:bg-teal-600/10`;
---

<form id="registration-start" class={memberForm} hidden>
  <fieldset class={`${registrationPanel} ${memberForm}`}>
    <legend>What are you registering for?</legend>
    <label class={choice}>
      <input type="radio" name="registrationType" value="club" required />
      <span><strong class="block font-display text-xl">Club membership</strong><span class="block mt-1 text-sm font-normal">Regular Monday and Friday training, 4–6pm. Rs {site.membership.oneChildFeeMur.toLocaleString("en-US")} for one child or Rs {site.membership.familyFeeMur.toLocaleString("en-US")} for a family, per semester.</span></span>
    </label>
    <label class={choice}>
      <input type="radio" name="registrationType" value="cup" required />
      <span><strong class="block font-display text-xl">Cup entry only</strong><span class="block mt-1 text-sm font-normal">{CUP_LABEL} · Friday 16 October 2026. Rs {CUP_ENTRY_FEE_MUR.toLocaleString("en-US")} per child for non-members. One event; regular club training is not included.</span></span>
    </label>
    <label class={choice}>
      <input type="radio" name="registrationType" value="both" required />
      <span><strong class="block font-display text-xl">Club membership + Cup</strong><span class="block mt-1 text-sm font-normal">Join regular training and enter the Cup. The semester membership fee covers the Cup entry.</span></span>
    </label>
    <p class="text-sm">Already a club member and entering the Cup? <a href="/sunset-duckies-cup-vol-2#register" class={textButton}>Register on the Cup page</a>.</p>
  </fieldset>
  <section class={`${registrationPanel} ${memberForm}`} aria-labelledby="start-family-title">
    <h2 id="start-family-title" class="font-display text-2xl">Start with your family</h2>
    <label>First child’s name<input name="kidName" required maxlength="80" autocomplete="off" placeholder="Full name" /></label>
    <div class={registrationGrid}>
      <label>Parent / guardian<input name="contactName" required maxlength="120" autocomplete="name" /></label>
      <label>WhatsApp number<input name="contactPhone" type="tel" required maxlength="40" autocomplete="tel" placeholder="+230 5…" /></label>
    </div>
    <p class="text-sm">Next, add any brothers and sisters, upload a required profile photo for each child, and complete each guardian’s profile with their contact details and a recommended photo. Then sign the waiver once for everyone. About five minutes; no account or invitation needed.</p>
    <Cta type="submit" class="justify-self-start">Continue to family details</Cta>
    <p data-start-status class={memberStatus} role="status" aria-live="polite"></p>
    <a data-start-next hidden href="#" class={textButton}>Continue registration</a>
  </section>
</form>

<script>
  import { rememberFamily } from "../lib/family-contact";
  const start = document.querySelector<HTMLFormElement>("#registration-start")!;
  const status = start.querySelector<HTMLElement>("[data-start-status]")!;
  const next = start.querySelector<HTMLAnchorElement>("[data-start-next]")!;
  const submit = start.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  let busy = false;
  // Deliberately start blank: /register is the link families can share.
  start.addEventListener("submit", async event => {
    event.preventDefault();
    if (busy) return;
    busy = true;
    submit.disabled = true;
    next.hidden = true;
    status.textContent = "Opening your family form…";
    const values = new FormData(start);
    const type = values.get("registrationType");
    const body = {
      kidName: String(values.get("kidName") ?? ""),
      contactName: String(values.get("contactName") ?? ""),
      contactPhone: String(values.get("contactPhone") ?? ""),
      ...(type === "both" ? { join: true } : {}),
    };
    try {
      const response = await fetch(type === "club" ? "/api/club/join" : "/api/cup/register", {
        method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body),
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error ?? "Couldn't start your registration. Please try again.");
      rememberFamily({ contactName: body.contactName, contactPhone: body.contactPhone });
      if (data.status === "member") {
        status.textContent = `${data.kidName} already has a club registration. Sign in on the Cup page to enter them.`;
        next.href = "/sunset-duckies-cup-vol-2#register";
        next.textContent = "Go to Cup registration";
        next.hidden = false;
      } else if (data.status === "signed") {
        status.textContent = `${data.kidName}'s ${type === "cup" ? "Cup entry" : "club registration"} and waiver are already complete. To correct details, reopen your private invitation or ask Andras for a fresh link.`;
      } else {
        next.href = data.url;
        next.textContent = "Continue to family details";
        next.hidden = false;
        // A full navigation also handles returning from a private invitation.
        window.location.assign(data.url);
        window.location.reload();
      }
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : "Couldn't start your registration. Please try again.";
    } finally {
      busy = false;
      submit.disabled = false;
    }
  });
</script>
