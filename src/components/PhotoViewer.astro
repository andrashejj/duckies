---
import PhotoIcon from "./PhotoIcon.astro";
interface Props { label: string; name: string; kidId?: string; canManage: boolean }
const { label, name, kidId, canManage } = Astro.props;
---
<dialog data-photo-viewer aria-label={label} class="journal-viewer">
  <button type="button" data-viewer-close class="journal-viewer-close" aria-label="Close photo"><PhotoIcon name="close" /></button>
  <div class="journal-post">
    <div class="journal-post-photo"><img data-viewer-image alt="" /></div>
    <div class="journal-post-detail">
      <header class="journal-post-author"><span class="journal-post-avatar" aria-hidden="true">{name.slice(0,1)}</span><div><a href={kidId ? `/gallery/duckies/${kidId}` : "/members/me"}>{name}</a><p>Sunset Duckies</p></div></header>
      <div class="journal-post-caption"><p data-viewer-caption></p><p class="mt-6 text-xs text-fg-muted">In this photo</p><div data-viewer-tags class="mt-3 flex flex-wrap gap-2"></div></div>
      <footer class="journal-post-footer">
        {canManage && <button type="button" data-tag-open="" data-tag-preview="" class="journal-button w-full"><PhotoIcon name="tag" class="h-4 w-4" />Manage tags</button>}
        <div class="mt-4 flex items-center justify-between gap-3 text-xs text-fg-muted"><time data-viewer-date></time><span data-viewer-count></span></div>
        <div class="journal-viewer-controls"><button type="button" data-viewer-prev aria-label="Previous photo"><PhotoIcon name="back" class="h-5 w-5" /></button><span class="text-xs text-fg-muted">Club members only</span><button type="button" data-viewer-next aria-label="Next photo"><PhotoIcon name="next" class="h-5 w-5" /></button></div>
      </footer>
    </div>
  </div>
</dialog>
<script>
  import type { PhotoTag } from "../lib/server/photo-profiles";
  const root = document.querySelector<HTMLDialogElement>("[data-photo-viewer]");
  if (root) {
    const dialog = root;
    const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-lb-trigger]"));
    const items = triggers.map(button => ({ key: button.dataset.photoKey!, full: button.dataset.full!, thumb: button.dataset.thumb!, caption: button.dataset.alt!, date: button.dataset.date!, tags: JSON.parse(button.dataset.photoTags ?? "[]") as PhotoTag[] }));
    let index = 0;
    const image = dialog.querySelector<HTMLImageElement>("[data-viewer-image]")!;
    const previous = dialog.querySelector<HTMLButtonElement>("[data-viewer-prev]")!, next = dialog.querySelector<HTMLButtonElement>("[data-viewer-next]")!;
    const visible = () => triggers.map((button,i) => button.closest("article")?.hidden ? -1 : i).filter(i => i >= 0);
    function render() {
      const item = items[index]; if (!item) return;
      image.src = item.full; image.alt = item.caption;
      dialog.querySelector("[data-viewer-caption]")!.textContent = item.caption;
      dialog.querySelector("[data-viewer-date]")!.textContent = new Date(item.date).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
      const shown = visible();
      dialog.querySelector("[data-viewer-count]")!.textContent = `${shown.indexOf(index) + 1} / ${shown.length}`;
      previous.disabled = next.disabled = shown.length < 2;
      const tags = dialog.querySelector("[data-viewer-tags]")!; tags.replaceChildren();
      for (const tag of item.tags) { const link = document.createElement("a"); link.href = `/gallery/duckies/${tag.id}`; link.textContent = tag.name; link.className = "journal-person-tag"; tags.append(link); }
      const manage = dialog.querySelector<HTMLButtonElement>("[data-tag-open]");
      if (manage) { manage.dataset.tagOpen = item.key; manage.dataset.tagPreview = item.thumb; }
    }
    function move(delta: number) { const shown = visible(); if (!shown.length) return; index = shown[(shown.indexOf(index) + delta + shown.length) % shown.length]; render(); }
    triggers.forEach((button,i) => button.addEventListener("click", () => { index = i; render(); dialog.showModal(); }));
    previous.addEventListener("click", () => move(-1)); next.addEventListener("click", () => move(1));
    dialog.querySelector("[data-viewer-close]")!.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", event => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener("keydown", event => { if (event.key === "ArrowLeft") { event.preventDefault(); move(-1); } else if (event.key === "ArrowRight") { event.preventDefault(); move(1); } });
    document.addEventListener("photo-tags-updated", event => {
      const tags = (event as CustomEvent<{ tags: Record<string, PhotoTag[]> }>).detail.tags;
      for (const item of items) item.tags = tags[item.key] ?? [];
      // The profile filter updates in the same event; read its final visibility.
      queueMicrotask(() => {
        if (!dialog.open) return;
        const shown = visible();
        if (!shown.length) { dialog.close(); return; }
        if (!shown.includes(index)) index = shown[0];
        render();
      });
    });
  }
</script>
