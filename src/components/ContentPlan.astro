---
import type { ContentPlan } from "../lib/content-plan";
import { videoSeconds, shotTiming } from "../lib/content-plan";
import { formatDay } from "../lib/plan";
import ContentStoryboardScene from "./ContentStoryboardScene.astro";
import Kicker from "./ui/Kicker.astro";
import SectionTitle from "./ui/SectionTitle.astro";
import { bodyCopy } from "../lib/ui";
interface Props { plan: ContentPlan }
const { plan } = Astro.props;
const tones = ["bg-sticker-sun", "bg-sticker-teal", "bg-sticker-coral"];
const chapterDays = (index: number) => {
  const start = plan.days.findIndex(day => day.id === plan.beats[index].dayId);
  const end = index + 1 < plan.beats.length ? plan.days.findIndex(day => day.id === plan.beats[index + 1].dayId) : plan.days.length;
  return plan.days.slice(start, end);
};
const badge = "border border-edge/40 px-2 py-1 font-mono text-[0.65rem] leading-4";
---

<div data-content-plan>
  <section aria-labelledby="plan-overview">
    <Kicker>TL;DR · one short video every day</Kicker>
    <SectionTitle id="plan-overview" class="mt-5">Getting ready for <span class="font-accent italic text-accent-text">16 October.</span></SectionTitle>
    <p class={`mt-5 max-w-3xl ${bodyCopy}`}>{plan.summary}</p>
    <p class="mt-3 font-mono text-xs leading-6 text-fg-muted">2–18 October · 17 daily videos · 30 seconds maximum each. Every video is an Instagram Reel: a vertical short video, filmed on a phone in 9:16. Reuse the same edit in Stories.</p>
    <p class="mt-3 text-sm leading-6 text-fg-muted">The timings below are the planned edit, including opening and closing text. Use straight cuts between clips, with no added transitions. Cast lists are filming suggestions; confirm who is available. Open a chapter for its first day’s tasks.</p>

    <ol class="mt-8 list-none space-y-4 p-0" aria-label="Content storyboard">
      {plan.beats.map((beat, i) => (
        <li class="relative">
          <a href={`#${beat.dayId}`} data-open-day={beat.dayId} class={`flex w-full flex-col gap-4 border-2 border-edge p-4 text-fg no-underline shadow-sticker-sm transition-transform hover:-translate-y-1 focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-accent motion-reduce:transition-none sm:flex-row sm:items-center sm:gap-8 sm:p-5 ${tones[i % tones.length]}`}>
            <div class="w-full shrink-0 border-b border-edge/30 pb-3 sm:w-44 sm:border-r sm:border-b-0 sm:pr-6 sm:pb-0"><ContentStoryboardScene scene={beat.scene} /></div>
            <div class="min-w-0 flex-1">
              <p class="font-mono text-xs uppercase tracking-wide">{String(i + 1).padStart(2, "0")} / {beat.date}</p>
              <h3 class="mt-2 font-display text-xl font-bold leading-tight sm:text-2xl">{beat.title}</h3>
              <p class="mt-2 text-sm leading-6">{beat.shots}</p>
              <p class="mt-3 font-mono text-[0.65rem] uppercase tracking-wider">{beat.purpose}</p>
              <ul class="mt-5 list-none divide-y divide-edge/30 border-t border-edge/30 p-0" aria-label={`Video briefs for ${beat.date}`}>
                {chapterDays(i).map(day => (
                  <li class="py-3 last:pb-0">
                    <p class="text-sm font-semibold">{formatDay(day.date)} · {day.production.edit}</p>
                    <div class="mt-2 flex flex-wrap gap-2">
                      {day.series && <span class={`${badge} bg-surface font-semibold`}>{day.series}</span>}
                      <span class={badge}>Reel · 9:16</span>
                      <span class={badge}>{videoSeconds(day)} sec</span>
                      <span class={badge}>{day.production.shots.length} shots · {day.production.shots.length - 1} cuts</span>
                      <span class={badge}>On-screen text{day.production.subtitles ? " + subtitles" : " · no speech"}</span>
                    </div>
                    <p class="mt-2 text-sm leading-6"><strong>Who:</strong> {day.production.cast}</p>
                    <p class="mt-1 font-mono text-[0.65rem] leading-5">Clip lengths: {day.production.shots.map(shot => `${shot.seconds}s`).join(" → ")}</p>
                  </li>
                ))}
              </ul>
            </div>
            <span aria-hidden="true" class="hidden text-2xl sm:block">↓</span>
          </a>
        </li>
      ))}
      <li class="flex flex-col justify-center border-2 border-dashed border-edge p-3 sm:p-5">
        <p class="font-accent text-xl italic sm:text-2xl">Keep following the same people.</p>
        <p class="mt-3 text-sm leading-6">The surfer at practice becomes the surfer at the Cup. The person baking becomes the maker at the stall. Estelle’s conversations with Abiguelle and local hosts show the people she gets to know along the way.</p>
      </li>
    </ol>
  </section>

  <section class="mt-14" aria-labelledby="daily-plan">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <Kicker>The daily plan</Kicker>
        <SectionTitle id="daily-plan" class="mt-4">Open the day. <span class="font-accent italic">Do the tasks.</span></SectionTitle>
      </div>
      <div class="flex gap-4 font-mono text-xs">
        <button type="button" data-plan-expand class="min-h-11 underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-accent">Expand days</button>
        <button type="button" data-plan-collapse class="min-h-11 underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-accent">Collapse days</button>
      </div>
    </div>
    <p class={`mt-4 max-w-3xl ${bodyCopy}`}>One Reel every day, including weekends, with a hard limit of 30 seconds. “Board work” follows the existing task list. “Content task” is the filming, editing or publishing needed for this daily series. Completion stays on the private board.</p>
    <div class="mt-7 divide-y-2 divide-edge border-y-2 border-edge">
      {plan.days.map(day => (
        <details id={day.id} data-plan-day class="group scroll-mt-28">
          <summary class="flex cursor-pointer list-none items-center gap-4 py-5 text-fg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent [&::-webkit-details-marker]:hidden sm:gap-7">
            <time datetime={day.date} class="w-16 shrink-0 font-mono text-xs font-semibold uppercase leading-5 sm:w-24">{formatDay(day.date)}</time>
            <div class="min-w-0 flex-1">
              <h3 class="font-display text-xl font-bold leading-tight sm:text-2xl">{day.title}</h3>
              <p class="mt-1 text-sm leading-6 text-fg-muted">{day.format}</p>
              {day.series && <p class="mt-2 font-mono text-xs font-semibold text-accent-text">{day.series}</p>}
              <p class="mt-1 font-mono text-[0.65rem] leading-5 text-fg-muted">{day.production.shots.length} shots · {day.production.shots.length - 1} straight cuts · On-screen text{day.production.subtitles ? " + subtitles" : " · no speech"}</p>
            </div>
            <span class="hidden shrink-0 font-mono text-xs sm:block">{day.tasks.length} tasks</span>
            <span aria-hidden="true" class="text-2xl group-open:hidden">+</span>
            <span aria-hidden="true" class="hidden text-2xl group-open:block">−</span>
          </summary>
          <div class="pb-8 sm:pl-31">
            <p class={`max-w-3xl ${bodyCopy}`}><strong>Ready when:</strong> {day.outcome}</p>
            <section class="mt-6 border-2 border-edge bg-surface p-4 sm:p-6" aria-labelledby={`${day.id}-brief`}>
              <h4 id={`${day.id}-brief`} class="font-mono text-xs uppercase tracking-widest">Film this · the production brief</h4>
              <div class="mt-4 flex flex-wrap gap-2">
                <span class={badge}>Instagram Reel · short video · 9:16</span>
                <span class={badge}>{videoSeconds(day)} sec total · max 30 sec</span>
                <span class={badge}>{day.production.shots.length} shots · {day.production.shots.length - 1} straight cuts</span>
              </div>
              <dl class="mt-4 space-y-3 text-sm leading-6">
                <div><dt class="inline font-semibold">Edit: </dt><dd class="inline">{day.production.edit}. Cut directly between the shots below; no transition effects.</dd></div>
                <div><dt class="inline font-semibold">Who is in it: </dt><dd class="inline">{day.production.cast}</dd></div>
                <div><dt class="inline font-semibold">Audio: </dt><dd class="inline">{day.production.audio}</dd></div>
                <div><dt class="inline font-semibold">Text: </dt><dd class="inline">Use the overlays below. {day.production.subtitles ? "Also subtitle the actual spoken words; check them after recording." : "No speech or subtitles needed for this edit."} Keep text clear of faces and the bottom of the frame.</dd></div>
              </dl>
              <h5 class="mt-6 font-mono text-xs uppercase tracking-widest">Shot by shot · timings include text</h5>
              <ol class="mt-3 list-none divide-y divide-line border-y border-line p-0">
                {day.production.shots.map((shot, index) => (
                  <li class="flex flex-col gap-2 py-4 sm:flex-row sm:gap-5">
                    <div class="shrink-0 font-mono text-xs leading-6 sm:w-28">
                      <p class="font-semibold">{shotTiming(day, index)}</p>
                      <p class="text-fg-muted">Shot {index + 1} · {shot.seconds}s</p>
                    </div>
                    <div class="min-w-0 text-sm leading-6">
                      <p>{shot.visual}</p>
                      <p class="mt-2"><strong>On-screen text:</strong> {shot.text ? `“${shot.text}”` : "No headline overlay; subtitle any speech."}</p>
                    </div>
                  </li>
                ))}
              </ol>
              <p class="mt-3 text-xs leading-6 text-fg-muted">Place each overlay on the footage for that shot. Do not add separate title or end cards that extend the total.</p>
            </section>
            <div class="mt-6 space-y-8">
              <div>
                <h4 class="font-mono text-xs uppercase tracking-widest">Tasks for the day</h4>
                <ol class="mt-4 list-none divide-y divide-line border-y border-line p-0">
                  {day.tasks.map((task, i) => (
                    <li class="flex gap-3 py-4">
                      <span aria-hidden="true" class="flex h-7 w-7 shrink-0 items-center justify-center border border-edge font-mono text-xs">{i + 1}</span>
                      <div>
                        <p class="text-sm leading-6">{task.text}</p>
                        <p class="mt-2 font-mono text-[0.65rem] uppercase leading-5 tracking-wide text-fg-muted">{task.owner} · {task.boardTaskId ? "Board work" : "Content task"}</p>
                      </div>
                    </li>
                  ))}
                </ol>
              </div>
              <div class="space-y-6">
                {day.prompts && <div><h4 class="font-mono text-xs uppercase tracking-widest">Ask or say</h4>{day.prompts.map(prompt => <p class="mt-3 text-sm leading-6">“{prompt}”</p>)}</div>}
                {day.caption && <div class="border-l-4 border-accent bg-surface p-5"><h4 class="font-mono text-xs uppercase tracking-widest">Caption to adapt</h4><p class="mt-3 text-sm leading-7">{day.caption}</p></div>}
                {day.notes?.map(note => <p class="text-sm leading-6 text-fg-muted">{note}</p>)}
              </div>
            </div>
          </div>
        </details>
      ))}
    </div>
  </section>

  <details class="group mt-10 border-2 border-edge bg-surface p-5 sm:p-7">
    <summary class="cursor-pointer font-display text-xl font-bold focus-visible:outline-2 focus-visible:outline-accent">The story, filming tips and a simpler fallback</summary>
    <div class="mt-6 max-w-3xl space-y-7">
      {plan.guides.map(guide => <section><h3 class="font-display text-xl font-bold">{guide.title}</h3><p class={`mt-3 ${bodyCopy}`}>{guide.body}</p></section>)}
  </details>
</div>

<script>
  for (const plan of document.querySelectorAll<HTMLElement>("[data-content-plan]")) {
    const days = Array.from(plan.querySelectorAll<HTMLDetailsElement>("[data-plan-day]"));
    const openDay = (id: string) => {
      const day = days.find(day => day.id === id);
      if (day) day.open = true;
    };
    plan.querySelectorAll<HTMLAnchorElement>("[data-open-day]").forEach(link => {
      link.addEventListener("click", () => openDay(link.dataset.openDay!));
    });
    plan.querySelector("[data-plan-expand]")?.addEventListener("click", () => days.forEach(day => { day.open = true; }));
    plan.querySelector("[data-plan-collapse]")?.addEventListener("click", () => days.forEach(day => { day.open = false; }));
    // A shared scene link opens its target; an ordinary visit starts collapsed.
    openDay(window.location.hash.slice(1));
    window.addEventListener("hashchange", () => openDay(window.location.hash.slice(1)));
  }
</script>
