---
// Photo viewer dialog wired to every [data-lb-trigger] button on the page.
interface Props { id: string; label: string; }
const { id, label } = Astro.props;
const button = "z-[2] inline-flex cursor-pointer items-center justify-center rounded-full border-2 border-ink-950 bg-cream-soft font-display leading-none text-ink-950 shadow-[3px_3px_0_0_var(--color-ink-950)] transition-[translate,box-shadow] duration-150";
const nav = `${button} h-10 w-10 text-2xl hover:-translate-y-0.5 hover:shadow-[4px_5px_0_0_var(--color-ink-950)] sm:h-12 sm:w-12 sm:text-[1.9rem]`;
---
<dialog id={id} class="inset-0 m-0 h-dvh max-h-dvh w-screen max-w-screen overflow-hidden border-none bg-transparent p-0 backdrop:bg-ink-950/92 backdrop:backdrop-blur-sm open:grid open:grid-cols-[auto_minmax(0,1fr)_auto] open:items-center open:justify-items-center open:gap-2 open:p-[clamp(0.75rem,3vw,2.5rem)]" aria-label={label} data-lightbox>
  <button class={`${button} fixed top-[clamp(0.75rem,3vw,1.5rem)] right-[clamp(0.75rem,3vw,1.5rem)] h-11 w-11 bg-coral-500 text-[1.05rem]`} data-lb-close aria-label="Close gallery">✕</button>
  <button class={`${nav} col-start-1`} data-lb-prev aria-label="Previous photo">‹</button>
  <figure class="col-start-2 m-0 flex max-w-full items-center justify-center">
    <img src="" alt="" class="h-auto max-h-[86vh] w-auto max-w-full rounded-[0.6rem] border-[3px] border-ink-950 bg-ink-950 shadow-[8px_8px_0_0_var(--color-sun-500)]" data-lb-image />
  </figure>
  <button class={`${nav} col-start-3`} data-lb-next aria-label="Next photo">›</button>
  <p class="fixed bottom-[clamp(0.75rem,3vw,1.5rem)] left-1/2 m-0 -translate-x-1/2 rounded-full border-2 border-cream-soft bg-ink-950 px-[0.85rem] py-[0.35rem] font-mono text-[0.72rem] uppercase tracking-[0.2em] text-cream-soft" data-lb-count></p>
</dialog>
<script>
  const dialog = document.querySelector("[data-lightbox]");
  const img = dialog?.querySelector("[data-lb-image]");

  if (dialog instanceof HTMLDialogElement && img instanceof HTMLImageElement) {
    const triggers = Array.from(document.querySelectorAll("[data-lb-trigger]")) as HTMLElement[];
    const countEl = dialog.querySelector("[data-lb-count]");
    const items = triggers.map((t) => ({ full: t.dataset.full ?? "", alt: t.dataset.alt ?? "" }));
    let index = 0;

    const render = () => {
      const item = items[index];
      if (!item) return;
      img.src = item.full;
      img.alt = item.alt;
      if (countEl) countEl.textContent = `${index + 1} / ${items.length}`;
    };
    const open = (i: number) => {
      index = i;
      render();
      if (!dialog.open) dialog.showModal();
    };
    const move = (delta: number) => {
      index = (index + delta + items.length) % items.length;
      render();
    };

    triggers.forEach((t, i) => t.addEventListener("click", () => open(i)));
    dialog.querySelector("[data-lb-close]")?.addEventListener("click", () => dialog.close());
    dialog.querySelector("[data-lb-prev]")?.addEventListener("click", () => move(-1));
    dialog.querySelector("[data-lb-next]")?.addEventListener("click", () => move(1));
    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") move(1);
      else if (event.key === "ArrowLeft") move(-1);
    });
    // Click on the backdrop / empty area closes.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
