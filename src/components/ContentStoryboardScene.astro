  </>}
  {scene === "invite" && <>
    <path d="M65 20h112v93H65z" class="fill-surface"/><path d="M65 43h112M85 11v21m71-21v21M82 94h78"/>
    <text x="121" y="82" text-anchor="middle" stroke="none" fill="currentColor" class="font-display text-4xl font-bold">16</text>
    <path d="m26 49 20 14-20 14m169-28 20 14-20 14M21 102q10-8 20 0m158 0q10-8 20 0"/>
  </>}
  {scene === "pack" && <>
    <path d="m39 31-9 79h65l-8-79Zm66-12-8 91h65l-9-91Zm64 21-7 70h57l-7-70Z" class="fill-surface"/>
    <path d="M40 41h46m21-10h45m19 19h38"/><circle cx="63" cy="74" r="15"/><circle cx="129" cy="68" r="17"/><circle cx="190" cy="78" r="13"/>
    <path d="m56 73 5 5 9-10m51-1 6 6 11-13m-45 32h19m-70 2h15m119 0h11"/>
  </>}
  {scene === "beach" && <>
    <path d="m22 55 23-29h108l22 29Zm9 0v52m135-52v52M27 80h144M40 106h114" class="fill-surface"/>
    <circle cx="93" cy="63" r="9"/><path d="M78 80V77q15-13 30 0v3M49 68h15v12H49zm80 0h15v12h-15z"/>
    <path d="M197 101c-13-23-9-60 4-69 13 13 16 50 4 69ZM13 118q17-9 34 0t34 0 34 0 34 0 34 0 34 0"/>
  </>}
  {scene === "thanks" && <>
    <path d="m87 50-9-28 26 14 18-26 17 26 25-14-8 28Z" class="fill-surface"/><path d="M87 58h69"/>
    <circle cx="66" cy="86" r="12" class="fill-surface"/><circle cx="122" cy="83" r="14" class="fill-surface"/><circle cx="177" cy="86" r="12" class="fill-surface"/>
    <path d="M41 119q25-42 49 0m2 0q30-47 59 0m1 0q25-42 49 0M31 42l9 4m-1-20 5 8m162 8-9 4m1-20-5 8"/>
  </>}
</svg>
