---
import type { ContentPlan } from "../lib/content-plan";
interface Props { scene: ContentPlan["beats"][number]["scene"] }
const { scene } = Astro.props;
---

<svg viewBox="0 0 240 128" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="h-20 w-full text-fg sm:h-28" aria-hidden="true">
