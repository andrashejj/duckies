    <path d="M28 100C18 73 24 27 42 14c18 13 24 59 14 86Z" class="fill-surface"/><path d="M42 20v84M15 109q15-10 30 0t30 0"/>
    <path d="m99 76 13 29h94l14-29Z" class="fill-surface"/><path d="M99 76h121M112 89h94M128 61c-10-14 9-18 0-33m30 33c-10-14 9-18 0-33m30 33c-10-14 9-18 0-33"/>
    <path d="m73 59 12 7-12 7"/>
  </>}
  {scene === "surf" && <>
    <circle cx="141" cy="29" r="10" class="fill-surface"/><path d="m133 42-21 25 30 12 16 19m-45-31-15 27-22 6m53-54-28-4-20 10m47-5 26 12 23-4"/>
    <path d="M60 102q57-20 119-5-55 23-119 5Z" class="fill-surface"/><path d="M14 115q20-13 40 0t40 0 40 0 40 0 40 0M22 86q14-8 24 0"/>
    <circle cx="201" cy="25" r="13"/>
  </>}
  {scene === "bake" && <>
    <circle cx="106" cy="33" r="15" class="fill-surface"/><path d="M82 20q-6-15 10-17 12-8 21 1 20-3 18 16ZM84 59l-15 26 21 12m37-38 27 20 22-10M91 52l-8 26h53l-15-25M97 58l-5 42h38l-10-42"/>
