---
import SessionNavigation from "./SessionNavigation.astro";
const path = Astro.url.pathname;
const link = "inline-flex min-h-11 items-center justify-center rounded-full px-3 font-display text-sm font-semibold hover:bg-highlight hover:text-highlight-fg aria-[current=page]:bg-highlight aria-[current=page]:text-highlight-fg focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-accent";
---
<nav aria-label="Club navigation" class="flex shrink-0 items-center gap-1">
  <a class={link} href="/" aria-current={path === "/" ? "page" : undefined}>Home</a>
  <a class={link} href="/blog" aria-current={path.startsWith("/blog") ? "page" : undefined}>Blog</a>
  <SessionNavigation />
</nav>
