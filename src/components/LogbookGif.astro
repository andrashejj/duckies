---
import type { BlogGif } from "../data/blog";
import Kicker from "./ui/Kicker.astro";
interface Props { gif: BlogGif; }
const { gif } = Astro.props;
---
<figure class="mx-auto my-14 grid max-w-[850px] items-center gap-6 border-y-2 border-dashed border-edge p-6 md:grid-cols-[0.8fr_1.2fr] md:gap-10" data-logbook-gif>
  <div class="mx-auto w-full max-w-[320px]">
    <img src={gif.poster} data-animation={gif.src} data-poster={gif.poster}
      alt={gif.alt} width={gif.width} height={gif.height} loading="lazy" decoding="async" class="block h-auto w-full rounded-lg border-2 border-edge" />
  </div>
  <figcaption>
    <Kicker as="span">A little intermission</Kicker>
    <p class="my-3 mb-4 font-accent text-[clamp(1.45rem,2.4vw,2rem)] leading-[1.3] italic">{gif.caption}</p>
    <button type="button" class="cursor-pointer rounded-full border-2 border-ink-950 bg-sun-500 px-4 py-2 font-mono text-[0.75rem] text-ink-950 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-coral-500 disabled:cursor-not-allowed disabled:opacity-60" aria-pressed="false" hidden>▶ Play GIF</button>
    <a href={gif.sourceUrl} target="_blank" rel="noreferrer" class="mt-4 block w-fit font-mono text-[0.65rem] underline underline-offset-[0.2em]">{gif.credit} ↗</a>
  </figcaption>
</figure>
<script>
  document.querySelectorAll<HTMLElement>("[data-logbook-gif]").forEach(figure => {
    const img = figure.querySelector("img")!;
    const button = figure.querySelector("button")!;
    button.hidden = false;
    button.addEventListener("click", () => {
      const playing = button.getAttribute("aria-pressed") !== "true";
      img.src = playing ? img.dataset.animation! : img.dataset.poster!;
      button.setAttribute("aria-pressed", String(playing));
      button.textContent = playing ? "■ Stop GIF" : "▶ Play GIF";
    });
    img.addEventListener("error", () => {
      img.src = img.dataset.poster!;
      button.disabled = true;
      button.setAttribute("aria-pressed", "false");
      button.textContent = "GIF unavailable — open source below";
    }, { once: true });
  });
</script>
