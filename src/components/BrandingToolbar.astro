---
import { bMono } from "../lib/plan-ui";
const access=Astro.locals.branding;
---
<nav class={`${bMono} flex flex-wrap items-center gap-[22px] border-b border-line px-7 py-[14px] text-accent-text max-[760px]:gap-3 max-[760px]:px-5 max-[760px]:py-3 [&>a:hover]:underline`} aria-label="Branding workspace"><a href="/branding-plan">Project Molt / Private workspace</a><a href="/branding-plan/board">Plan board</a><span class="ml-auto break-words text-fg-muted max-[760px]:ml-0 max-[760px]:w-full">{access?.email}</span>{access?.owner&&<a href="/branding-plan/access">Manage access →</a>}<button class="min-h-11 cursor-pointer border-0 bg-transparent p-0 font-[inherit] text-accent-text underline underline-offset-4 disabled:cursor-wait disabled:opacity-50" id="branding-signout">Sign out</button></nav>
<script>
import { authClient } from "../lib/auth-client";
document.querySelector<HTMLButtonElement>("#branding-signout")?.addEventListener("click",async event=>{
 const button=event.currentTarget as HTMLButtonElement;button.disabled=true;
 try{const {error}=await authClient.signOut();if(error)throw error;window.location.assign("/branding-plan");}catch{button.textContent="Retry sign out";button.disabled=false;}
});
</script>
