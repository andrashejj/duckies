---
import { chipClass, type Tone } from "../../lib/ui";
interface Props {
  as?: "span" | "a" | "li";
  tone?: Tone;
  class?: string;
  href?: string;
}
const { as, tone = "sticker", class: className, ...rest } = Astro.props as Props;
const Tag = as ?? "span";
---
<Tag class={chipClass(tone, className)} {...rest}><slot /></Tag>
