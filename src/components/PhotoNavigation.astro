---
import PhotoIcon from './PhotoIcon.astro';
import ThemeToggle from './ThemeToggle.astro';
const session = Astro.locals.session;
const active = !!session?.member;
const memories = active || !!session?.archivedAt;
const family = active || !!session?.family;
const path = Astro.url.pathname;
const membersPage = path === '/members/lineup' || path.startsWith('/members/people/') || path.startsWith('/gallery/duckies/');
const photos = (path.startsWith('/gallery') && !membersPage) || path === '/members/me';
const cupPage = path === '/members/cup';
const familyPage = path.startsWith('/account') || path === '/members/profile' || path.startsWith('/orders') || path.startsWith('/shop');
const nav = [
  ...(active ? [{ href: '/members', label: 'My Feed', icon: 'home' as const, current: !photos && !familyPage && !membersPage && !cupPage }] : []),
  ...(memories ? [{ href: active ? '/gallery' : '/members/me', label: active ? 'Club Gallery' : 'Memories', icon: 'camera' as const, current: photos }] : []),
  ...(active ? [{ href: '/members/lineup', label: 'Members', icon: 'users' as const, current: membersPage }] : []),
  ...(active ? [{ href: '/members/cup', label: 'Cup', icon: 'trophy' as const, current: cupPage }] : []),
  { href: family ? '/members/profile' : '/account/profile', label: family ? 'My Family' : 'Account', icon: 'user' as const, current: familyPage },
];
---
<aside class="journal-sidebar" data-member-active={String(active)}>
  <a href="/" class="journal-wordmark" aria-label="Sunset Duckies website"><img src="/brand/sunset-duckies-logo-small.webp" alt="" width="48" height="48" /><span>Sunset ★ Duckies</span></a>
  <nav aria-label="Member navigation" class="journal-desktop-nav">
    {nav.map(item => <a href={item.href} aria-current={item.current ? 'page' : undefined}><PhotoIcon name={item.icon}/><span>{item.label}</span></a>)}
  </nav>
  <div class="journal-sidebar-bottom"><ThemeToggle variant="performance" class="rounded-full border-0"/></div>
</aside>
<header class="journal-mobile-header">
  <a href="/" class="journal-wordmark" aria-label="Sunset Duckies website"><img src="/brand/sunset-duckies-logo-small.webp" alt="" width="48" height="48" /><span>Sunset ★ Duckies</span></a>
  <ThemeToggle variant="performance" class="rounded-full border-0"/>
</header>
<nav aria-label="Mobile member navigation" class="journal-mobile-nav">{nav.map(item => <a href={item.href} aria-current={item.current ? 'page' : undefined}><PhotoIcon name={item.icon}/><span>{item.label}</span></a>)}</nav>

<script>
  // Recheck private screens when returning from another tab or browser history.
  const activeMember = document.querySelector<HTMLElement>('[data-member-active]')?.dataset.memberActive === 'true';
  async function checkAccess() {
    try {
      const response = await fetch('/api/session', { cache: 'no-store' });
      if (!response.ok) return;
      const session = await response.json();
      if (!session.signedIn || (activeMember && !session.member)) {
        document.querySelector<HTMLElement>('main')?.setAttribute('hidden', '');
        location.replace('/account');
      }
    } catch { /* Keep the current screen available through a temporary network failure. */ }
  }
  window.addEventListener('pageshow', () => void checkAccess());
  window.addEventListener('focus', () => void checkAccess());
  document.addEventListener('visibilitychange', () => { if (!document.hidden) void checkAccess(); });
</script>
