---
import { cn } from "../../lib/cn";
// Signal-edged callout: a mono label beside a strong statement.
interface Props { label: string; class?: string; }
const { label, class: className } = Astro.props as Props;
const classes = cn("mb-8 grid grid-cols-1 items-center gap-2 border-l-[3px] border-accent bg-accent/6 px-6 py-5 sm:grid-cols-[190px_minmax(0,1fr)] sm:gap-6", className);
---
<div class={classes}>
  <span class="font-mono text-[0.65rem] font-semibold uppercase tracking-[0.1em] text-accent-text">{label}</span>
  <strong class="font-display text-[1.05rem] font-semibold leading-[1.45] text-fg"><slot /></strong>
</div>
