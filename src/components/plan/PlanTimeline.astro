---
import { outlineButton } from "../../lib/plan-ui";
import type { TaskStatus, Urgency } from "../../lib/plan";
import type { Step, StepTask } from "../../lib/plan-view";
// Numbered timeline: rail with code + date (+ optional owner / "up next" flag),
// body with title, deliverable, task rows and links. A task row carries its
// status, owner, due date and urgency; a plain string is a bare task.
interface Props { steps: Step[]; prefix?: string; start?: number; codes?: string[]; compact?: boolean; class?: string; }
const { steps, prefix = "", start = 1, codes, compact = true, class: className } = Astro.props as Props;
const glyph: Record<TaskStatus, string> = { todo: "/", doing: "→", review: "○", done: "✔" };
const dueTone: Record<NonNullable<Urgency>, string> = { overdue: "text-alert", soon: "text-caution" };
const asTask = (task: string | StepTask): StepTask => (typeof task === "string" ? { text: task } : task);
---
<ol class:list={["m-0 list-none border-t border-line p-0", className]}>
  {steps.map((step, index) => {
    const current = step.status === "now";
    return (
      <li class:list={["grid border-b border-line max-[680px]:block md:grid-cols-[170px_minmax(0,1fr)] lg:grid-cols-[230px_minmax(0,1fr)]", current && "bg-accent/4"]}>
        <div class="flex flex-col items-start border-r border-line py-9 pr-8 max-[680px]:flex-row max-[680px]:flex-wrap max-[680px]:items-center max-[680px]:gap-4 max-[680px]:border-r-0 max-[680px]:border-b max-[680px]:py-6 max-[680px]:pr-0">
          <span class:list={["font-brand text-[3.5rem] leading-none font-normal", current ? "text-accent-text" : "text-fg/28"]}>{codes?.[index] ?? `${prefix}${String(index + start).padStart(2, "0")}`}</span>
          <time class="mt-4 font-mono text-[0.68rem] font-semibold uppercase tracking-[0.1em] text-fg-muted max-[680px]:m-0">{step.date}</time>
          {current && <em class="mt-[0.7rem] bg-accent px-[0.55rem] py-[0.4rem] font-mono text-[0.68rem] font-semibold not-italic uppercase tracking-[0.1em] text-accent-fg max-[680px]:m-0">Up next</em>}
          {step.owner && <em class="mt-[0.7rem] font-mono text-[0.65rem] leading-[1.4] font-semibold not-italic uppercase tracking-[0.1em] text-fg-muted max-[680px]:m-0">{step.owner}</em>}
        </div>
        <div class:list={["pl-12 max-[680px]:px-0 max-[680px]:pt-8 max-[680px]:pb-10 md:pl-8", compact ? "py-8" : "pt-[2.35rem] pb-11"]}>
          <h3 class="m-0 mb-3 max-w-[740px] font-display text-[clamp(1.6rem,2.5vw,2.2rem)] font-[650] leading-[1.05] tracking-[-0.035em] text-fg">{step.title}</h3>
          {step.deliverable && <p class="m-0 flex max-w-[860px] gap-[0.9rem] border-l-2 border-accent bg-accent/4 px-4 py-[0.8rem] text-[0.92rem] leading-[1.5] text-fg max-[680px]:block"><span class="flex-none pt-[0.1rem] font-mono text-[0.65rem] font-semibold uppercase tracking-[0.1em] text-accent-text max-[680px]:mb-[0.4rem] max-[680px]:block">Done when</span>{step.deliverable}</p>}
          <ul class:list={["m-0 mt-5 grid list-none gap-2 p-0", !compact && "gap-x-10 gap-y-[0.8rem] md:grid-cols-2"]}>
            {step.tasks.map(asTask).map(task => (
              <li class:list={["relative grid gap-x-4 gap-y-1 pl-[1.15rem] text-[0.88rem] leading-[1.6] sm:grid-cols-[minmax(0,1fr)_auto]", task.status === "done" ? "text-fg-muted" : "text-fg/78"]} data-status={task.status ?? "todo"}>
                <span class="absolute left-0 font-mono text-accent-text" aria-hidden="true">{glyph[task.status ?? "todo"]}</span>
                <span class:list={[task.status === "done" && "line-through decoration-fg/30"]}>{task.status === "done" && <span class="sr-only">Done: </span>}{task.status === "doing" && <span class="sr-only">In progress: </span>}{task.status === "review" && <span class="sr-only">In review: </span>}{task.text}</span>
                {(task.owner || task.due) && <span class="flex flex-wrap gap-x-3 font-mono text-[0.62rem] font-semibold uppercase tracking-[0.08em] text-fg-muted sm:justify-end">{task.owner && <span>{task.owner}</span>}{task.due && <span class:list={[task.urgency && dueTone[task.urgency]]}>{task.due}{task.urgency === "overdue" && " · late"}</span>}</span>}
              </li>
            ))}
          </ul>
          {step.links && step.links.length > 0 && <div class="mt-5 flex flex-wrap gap-3 border-t border-line pt-[1.1rem]">{step.links.map(link => <a href={link.file} target="_blank" rel="noreferrer" class={outlineButton}>{link.label} ↗</a>)}</div>}
        </div>
      </li>
    );
  })}
</ol>
