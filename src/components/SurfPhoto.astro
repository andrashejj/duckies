---
interface Props {
  scene: "hero-wave" | "whitewater" | "surf-kit" | "beach-crew";
  wide?: boolean;
}
const { scene, wide = false } = Astro.props;
---
<img src={`/media/surf/${scene}-small.webp`} alt="" aria-hidden="true" width="600" height="450" loading="lazy" decoding="async" class:list={["block shrink-0 rounded-lg border border-edge object-cover", wide ? "aspect-video h-auto w-full" : "h-[clamp(5rem,9vw,7.5rem)] w-[clamp(5rem,9vw,7.5rem)]"]} />
