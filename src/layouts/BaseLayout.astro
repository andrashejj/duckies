---
import "../styles/global.css";

import { site } from "../data/site";

const session = Astro.locals?.session ?? null;
const isAdmin = Astro.locals?.isAdmin ?? false;
const signedIn = Boolean(session?.user);

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
}

const {
  title = site.name,
  description = site.description,
  image = site.ogImage.path,
  imageAlt = site.ogImage.alt,
  imageWidth = site.ogImage.width,
  imageHeight = site.ogImage.height,
} = Astro.props;

const siteOrigin = Astro.site ?? new URL(site.url);
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const absoluteImage = new URL(image, siteOrigin).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:secure_url" content={absoluteImage} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..125,400..800&family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,400..800,0..100,0..1;1,9..144,400..800,0..100,0..1&family=Outfit:wght@300..800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <div class="page-shell">
      <header class="site-header border-b-2 border-[var(--color-ink-950)] bg-[var(--color-cream-soft)]/92 backdrop-blur-xl">
        <div class="mx-auto flex max-w-7xl items-center justify-between gap-2 px-4 py-3 sm:gap-4 sm:px-6 lg:px-10 lg:py-4">
          <a href="/" class="group flex min-w-0 items-center gap-2 sm:gap-3">
            <span class="relative inline-flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-2xl border-2 border-[var(--color-ink-950)] bg-[var(--color-coral-500)] text-lg font-black text-[var(--color-ink-950)] shadow-[3px_3px_0_0_var(--color-ink-950)] transition-transform group-hover:rotate-[-6deg] sm:h-12 sm:w-12" aria-hidden="true">
              <span class="absolute inset-x-0 bottom-0 h-1/2 bg-[var(--color-sun-500)]"></span>
              <span class="absolute left-1/2 top-1/2 h-4 w-4 -translate-x-1/2 -translate-y-1/2 rounded-full bg-[var(--color-cream-soft)] ring-2 ring-[var(--color-ink-950)] sm:h-6 sm:w-6"></span>
              <span class="absolute inset-x-0 bottom-0 h-[3px] bg-[var(--color-ink-950)]"></span>
            </span>
            <div class="min-w-0">
              <p class="truncate font-mono text-[0.62rem] uppercase tracking-[0.08em] text-[var(--color-coral-500)] sm:text-xs sm:tracking-[0.28em]">
                Sunset ★ Duckies
              </p>
              <p class="hidden truncate text-sm font-bold text-[var(--color-ink-950)] sm:block sm:text-base" style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;">
                Surf the Bay · Tamarin
              </p>
            </div>
          </a>

          <nav class="flex shrink-0 items-center gap-0.5 sm:gap-2">
            {site.navigation.map((item) => (
              <a
                class="rounded-full px-2 py-1.5 text-[0.72rem] font-semibold text-[var(--color-ink-950)] transition hover:bg-[var(--color-sun-500)] hover:rotate-[-2deg] sm:px-3 sm:py-2 sm:text-sm"
                style="font-family: var(--font-display); font-variation-settings: 'wdth' 106;"
                href={item.href}
              >
                <span class="sm:hidden">{item.label}</span>
                <span class="hidden sm:inline">{item.labelFull ?? item.label}</span>
              </a>
            ))}
          </nav>

          <div class="flex items-center gap-2 sm:gap-3">
            {signedIn ? (
              <a
                class="chip hidden sm:inline-flex !bg-[var(--color-cream-soft)] !text-[var(--color-ink-950)] hover:!bg-[var(--color-lilac-400)]"
                href={isAdmin ? "/admin" : "/account"}
                aria-label={isAdmin ? "Open admin" : "Open account"}
              >
                {isAdmin ? "Admin ✦" : (session!.user!.name?.split(" ")[0] ?? "Account")}
              </a>
            ) : (
              <a
                class="chip hidden sm:inline-flex !bg-[var(--color-cream-soft)] !text-[var(--color-ink-950)] hover:!bg-[var(--color-sun-500)]"
                href="/login"
              >
                Sign in
              </a>
            )}
            <a
              class="cta-primary shrink-0 px-3 py-2 text-[0.72rem] sm:px-5 sm:py-3 sm:text-[0.85rem]"
              href={site.whatsappUrl}
              target="_blank"
              rel="noreferrer"
            >
              <span class="hidden sm:inline">Slide in ✿ WhatsApp</span>
              <span class="sm:hidden">Slide in</span>
            </a>
          </div>
        </div>
      </header>

      <main class="relative">
        <slot />
      </main>

      <div class="marquee mt-20">
        <div class="marquee-track">
          <span>
            Tamarin Bay · Kid-first <span class="star">✦</span>
            <em>Monday + Friday</em> <span class="star">✦</span>
            4 comps a year <span class="star">✦</span>
            <em>Kids only · No cap</em> <span class="star">✦</span>
            Confidence in the water <span class="star">✦</span>
            <em>Community on the beach</em> <span class="star">✦</span>
          </span>
          <span aria-hidden="true">
            Tamarin Bay · Kid-first <span class="star">✦</span>
            <em>Monday + Friday</em> <span class="star">✦</span>
            4 comps a year <span class="star">✦</span>
            <em>Kids only · No cap</em> <span class="star">✦</span>
            Confidence in the water <span class="star">✦</span>
            <em>Community on the beach</em> <span class="star">✦</span>
          </span>
        </div>
      </div>

      <footer class="border-t-2 border-[var(--color-ink-950)] bg-[var(--color-cream-soft)]">
        <div class="mx-auto grid max-w-7xl gap-10 px-6 py-14 lg:grid-cols-[1.3fr_0.7fr] lg:px-10">
          <div class="space-y-5">
            <p class="section-title" style="font-size: clamp(1.6rem, 3vw, 2.4rem);">
              {site.name}
            </p>
            <p class="body-copy max-w-2xl">
              Surf sessions for kids in Tamarin Bay. Young duckies paddling out, getting amazing at
              surfing, and riding home into the sunset together.
            </p>
            <div class="flex flex-wrap gap-3">
              <span class="chip">Monday + Friday</span>
              <span class="chip">4:00-6:00pm</span>
              <span class="chip">{site.location}</span>
            </div>
          </div>

          <div class="space-y-4 text-sm">
            <p class="section-kicker">Quick links</p>
            <div class="grid gap-3">
              <a href="/training-materials" class="font-semibold text-[var(--color-ink-950)] transition hover:text-[var(--color-coral-500)]">
                → Training library
              </a>
              <a href="/blog" class="font-semibold text-[var(--color-ink-950)] transition hover:text-[var(--color-coral-500)]">
                → The logbook
              </a>
              <a href="/shop" class="font-semibold text-[var(--color-ink-950)] transition hover:text-[var(--color-coral-500)]">
                → Duckies shop
              </a>
              {signedIn ? (
                <a href="/account" class="font-semibold text-[var(--color-ink-950)] transition hover:text-[var(--color-coral-500)]">
                  → Your account
                </a>
              ) : (
                <a href="/login" class="font-semibold text-[var(--color-ink-950)] transition hover:text-[var(--color-coral-500)]">
                  → Sign in
                </a>
              )}
              <a
                href={site.whatsappUrl}
                target="_blank"
                rel="noreferrer"
                class="font-semibold text-[var(--color-ink-950)] transition hover:text-[var(--color-coral-500)]"
              >
                → Apply via WhatsApp
              </a>
              <a
                href={site.sponsorContactUrl}
                target="_blank"
                rel="noreferrer"
                class="font-semibold text-[var(--color-ink-950)] transition hover:text-[var(--color-coral-500)]"
              >
                → Sponsor conversations
              </a>
            </div>
          </div>
        </div>
        <div class="border-t border-[var(--color-ink-950)]/20 bg-[var(--color-cream)]/70 px-6 py-4 text-center font-mono text-xs uppercase tracking-[0.22em] text-[var(--color-ink-950)]/60">
          © {new Date().getFullYear()} · Made with salt water & sunshine in Mauritius
        </div>
      </footer>
    </div>

    <script>
      import { animate, inView, stagger } from "motion";

      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const revealAll = () => {
        document.querySelectorAll("[data-reveal]").forEach((element) => {
          element.setAttribute("data-revealed", "true");
        });
      };

      const heroVideo = document.querySelector("[data-hero-video]");
      if (heroVideo instanceof HTMLVideoElement) {
        const applyHeroVideoRate = () => {
          heroVideo.playbackRate = 0.72;
        };

        applyHeroVideoRate();
        heroVideo.addEventListener("loadedmetadata", applyHeroVideoRate);
        heroVideo.addEventListener("play", applyHeroVideoRate);
      }

      if (reducedMotion.matches) {
        revealAll();

        if (heroVideo instanceof HTMLVideoElement) {
          heroVideo.pause();
        }
      } else {
        animate(
          "[data-float]",
          { opacity: [0, 1], y: [32, 0] },
          { delay: stagger(0.1), duration: 0.85, ease: [0.22, 1, 0.36, 1] },
        );

        inView("[data-reveal]", (element) => {
          element.setAttribute("data-revealed", "true");

          animate(
            element,
            { opacity: [0, 1], y: [28, 0], filter: ["blur(10px)", "blur(0px)"] },
            { duration: 0.7, ease: [0.22, 1, 0.36, 1] },
          );
        });
      }
    </script>
  </body>
</html>
