---
import "@fontsource-variable/manrope";
import "@fontsource-variable/sora";
import "../styles/global.css";

import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  page?: "home" | "materials";
}

const {
  title = site.name,
  description = site.description,
  image = "/media/board-lineup.jpg",
  page = "home",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body class="min-h-screen bg-[var(--color-sand-50)] text-slate-900 antialiased">
    <div class="page-shell">
      <header class="sticky top-0 z-50 border-b border-white/45 bg-white/70 backdrop-blur-xl">
        <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-4 lg:px-10">
          <a href="/" class="flex min-w-0 items-center gap-3">
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-[var(--color-ocean-950)] text-lg font-semibold text-white shadow-[0_18px_50px_-26px_rgba(8,32,50,0.85)]">
              D
            </span>
            <div class="min-w-0">
              <p class="font-display text-sm uppercase tracking-[0.28em] text-[var(--color-ocean-700)]">
                Duckies
              </p>
              <p class="truncate text-sm font-semibold text-slate-700">
                Surf Club · Tamarin Bay
              </p>
            </div>
          </a>

          <nav class="hidden items-center gap-7 text-sm font-semibold text-slate-700 lg:flex">
            {site.navigation.map((item) => (
              <a class="transition hover:text-[var(--color-ocean-700)]" href={item.href}>
                {item.label}
              </a>
            ))}
          </nav>

          <a
            class="cta-secondary hidden lg:inline-flex"
            href={site.whatsappUrl}
            target="_blank"
            rel="noreferrer"
          >
            Apply
          </a>
        </div>
      </header>

      <main>
        <slot />
      </main>

      <footer class="mt-24 border-t border-slate-200/80 bg-white/75">
        <div class="mx-auto grid max-w-7xl gap-10 px-6 py-12 lg:grid-cols-[1.3fr_0.7fr] lg:px-10">
          <div class="space-y-4">
            <p class="font-display text-xl text-[var(--color-ocean-950)]">
              {site.name}
            </p>
            <p class="max-w-2xl text-sm leading-7 text-slate-600">
              Free-of-charge surf sessions for kids in Tamarin, built around confidence,
              community, and the joy of being in the water together.
            </p>
            <div class="flex flex-wrap gap-3 text-sm text-slate-600">
              <span class="chip">Wednesday · Friday</span>
              <span class="chip">4:00-6:00pm</span>
              <span class="chip">{site.location}</span>
            </div>
          </div>

          <div class="space-y-4 text-sm text-slate-600">
            <p class="font-semibold uppercase tracking-[0.24em] text-[var(--color-ocean-700)]">
              Quick links
            </p>
            <div class="grid gap-3">
              <a href="/training-materials" class="transition hover:text-[var(--color-ocean-700)]">
                Training materials
              </a>
              <a
                href={site.whatsappUrl}
                target="_blank"
                rel="noreferrer"
                class="transition hover:text-[var(--color-ocean-700)]"
              >
                Apply via WhatsApp
              </a>
              <a
                href={site.sponsorContactUrl}
                target="_blank"
                rel="noreferrer"
                class="transition hover:text-[var(--color-ocean-700)]"
              >
                Sponsor conversations
              </a>
            </div>
            {page === "home" && (
              <p class="text-xs leading-6 text-slate-500">{site.sponsorContactNote}</p>
            )}
          </div>
        </div>
      </footer>
    </div>

    <script>
      import { animate, inView, stagger } from "motion";

      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const revealAll = () => {
        document.querySelectorAll("[data-reveal]").forEach((element) => {
          element.setAttribute("data-revealed", "true");
        });
      };

      if (reducedMotion.matches) {
        revealAll();

        const heroVideo = document.querySelector("[data-hero-video]");
        if (heroVideo instanceof HTMLVideoElement) {
          heroVideo.pause();
        }
      } else {
        animate(
          "[data-float]",
          { opacity: [0, 1], y: [28, 0] },
          { delay: stagger(0.12), duration: 0.82, easing: [0.22, 1, 0.36, 1] },
        );

        inView("[data-reveal]", (element) => {
          element.setAttribute("data-revealed", "true");

          animate(
            element,
            { opacity: [0, 1], y: [26, 0], filter: ["blur(10px)", "blur(0px)"] },
            { duration: 0.72, easing: [0.22, 1, 0.36, 1] },
          );
        });
      }
    </script>
  </body>
</html>
