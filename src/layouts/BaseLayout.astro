---
import "../styles/global.css";
import "../styles/photo-journal.css";
import PublicShareDialog from "../components/PublicShareDialog.astro";
import PhotoNavigation from "../components/PhotoNavigation.astro";
import WorkspaceHeader from "../components/WorkspaceHeader.astro";
import ClubNavigation from "../components/ClubNavigation.astro";
import Chip from "../components/ui/Chip.astro";
import Kicker from "../components/ui/Kicker.astro";
import SectionTitle from "../components/ui/SectionTitle.astro";
import ThemeScript from "../components/ThemeScript.astro";
import ThemeToggle from "../components/ThemeToggle.astro";

import { site } from "../data/site";

interface Props {
  workspace?: "member" | "admin";
  section?: string;
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  page?: "home" | "materials";
  variant?: "default" | "performance" | "journal";
}

const {
  workspace, section,
  title = site.name,
  description = site.description,
  image = site.ogImage.path,
  imageAlt = site.ogImage.alt,
  imageWidth = site.ogImage.width,
  imageHeight = site.ogImage.height,
  variant = "default",
} = Astro.props;

const journal = variant === "journal" || workspace === "member";
const performance = variant === "performance";
const siteOrigin = Astro.site ?? new URL(site.url);
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const absoluteImage = new URL(image, siteOrigin).toString();
---

<!doctype html>
<html lang="en" class:list={["scroll-smooth overflow-x-clip bg-canvas bg-(image:--texture-canvas) bg-fixed motion-reduce:scroll-auto", performance && "theme-performance [background-size:64px_64px,64px_64px,auto]", journal && "theme-journal"]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:secure_url" content={absoluteImage} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png?v=duckies-20260914" />
    <link rel="icon" href="/favicon.ico?v=duckies-20260914" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=duckies-20260914" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..125,400..800&family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,400..800,0..100,0..1;1,9..144,400..800,0..100,0..1&family=Outfit:wght@300..800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <ThemeScript />
  </head>
  <body class:list={[
    "min-h-screen overflow-x-clip font-sans tracking-[-0.005em] text-fg antialiased [font-feature-settings:'ss01','cv11']",
    !journal && "before:pointer-events-none before:fixed before:inset-0 before:z-0 before:bg-(image:--texture-grain) before:opacity-30 before:mix-blend-multiply before:content-[''] dark:before:opacity-[0.12] dark:before:mix-blend-screen",
  ]}>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <div class="relative z-[1] min-h-screen overflow-x-clip">
      {/* Phones drop the translucent blur for an opaque header on its own compositor layer: the glass effect flickers as the address bar resizes. */}
      {journal ? <PhotoNavigation /> : workspace ? <WorkspaceHeader mode={workspace} section={section} /> : <header class:list={[
        "sticky top-0 z-50 border-b-2 backdrop-blur-xl max-sm:transform-gpu max-sm:backface-hidden max-sm:backdrop-blur-none max-sm:will-change-transform",
        performance ? "border-line bg-canvas/92 max-sm:bg-canvas" : "border-edge bg-surface/92 max-sm:bg-surface",
      ]}>
        <div class="mx-auto flex max-w-7xl items-center justify-between gap-2 px-4 py-2 sm:gap-4 sm:px-6 lg:px-10 lg:py-3">
          <a href="/" aria-label="Sunset Duckies home" class="group flex min-w-0 items-center gap-2 sm:gap-3">
            <img src="/brand/sunset-duckies-logo-small.webp" alt="" width="48" height="48" class="h-10 w-10 shrink-0 rounded-full sm:h-12 sm:w-12" />
            <div class="hidden min-w-0 sm:block">
              <p class:list={["truncate font-mono text-[0.62rem] uppercase tracking-[0.08em] sm:text-xs sm:tracking-[0.28em]", performance ? "text-fg" : "text-accent-text"]}>
                {performance ? "Sunset Duckies" : "Sunset ★ Duckies"}
              </p>
              <p class="hidden truncate font-display text-sm font-bold text-fg [font-variation-settings:'wdth'_108] sm:block sm:text-base">
                {performance ? "Branding" : "Surf the Bay · Tamarin"}
              </p>
            </div>
          </a>

          <ClubNavigation />
        </div>
      </header>}

      {journal && <PublicShareDialog />}
      <main id="main-content" tabindex="-1" class:list={["relative", journal && "journal-main"]}>
        <slot />
      </main>

      {!workspace && !journal && <footer class:list={["border-t-2 text-fg", performance ? "border-line bg-surface" : "border-edge bg-surface"]}>
        <div class="mx-auto grid max-w-7xl gap-10 px-6 py-14 lg:grid-cols-[1.3fr_0.7fr] lg:px-10">
          <div class="space-y-5">
            <a href="/" class="inline-flex items-center gap-4">
              <img src="/brand/sunset-duckies-logo-small.webp" alt="" width="64" height="64" loading="lazy" class="h-16 w-16 shrink-0 rounded-full" />
              <SectionTitle as="span" size="sm">{site.name}</SectionTitle>
            </a>
            <p class="max-w-2xl text-[1.02rem] leading-[1.7] text-fg-muted">
              {performance
                ? "Products made with local surf communities, starting in Tamarin."
                : "Surf sessions for kids in Tamarin Bay. Young duckies paddling out, getting amazing at surfing, and riding home into the sunset together."}
            </p>
            <div class="flex flex-wrap gap-3">
              {(performance ? ["Everyday wear", "Surf wear", "Surf gear", "Surf nutrition"] : ["Monday + Friday", "4:00-6:00pm", site.location]).map(label => (
                <Chip tone={performance ? "outline" : "sticker"}>{label}</Chip>
              ))}
            </div>
          </div>

          <div class="space-y-4 text-sm">
            <Kicker tone={performance ? "outline" : "sticker"}>Quick links</Kicker>
            <div class="grid gap-3">
              {[
                { href: "/#how-to-join", label: "Join the club" },
                { href: "/blog", label: "Blog" },
                { href: "/account", label: "Club members" },
                { href: site.whatsappUrl, label: "Contact us on WhatsApp", external: true },
              ].map(link => (
                <a href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noreferrer" : undefined} class="font-semibold text-fg transition hover:text-accent-text">{link.label}</a>
              ))}
            </div>
          </div>
        </div>
        <div class="border-t border-line bg-canvas/70 px-6 py-4 text-center font-mono text-xs uppercase tracking-[0.22em] text-fg/60">
          <ThemeToggle variant={performance ? "performance" : "default"} class="mr-3" />
          © {new Date().getFullYear()} · Made with salt water & sunshine in Mauritius
        </div>
      </footer>}
    </div>

    <script>
      import { animate, inView, stagger } from "motion";

      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const revealAll = () => {
        document.querySelectorAll("[data-reveal]").forEach((element) => {
          element.setAttribute("data-revealed", "true");
        });
      };

      if (reducedMotion.matches) {
        revealAll();

      } else {
        animate(
          "[data-float]",
          { opacity: [0, 1], y: [32, 0] },
          { delay: stagger(0.1), duration: 0.85, ease: [0.22, 1, 0.36, 1] },
        );

        inView("[data-reveal]", (element) => {
          element.setAttribute("data-revealed", "true");

          animate(
            element,
            { opacity: [0, 1], y: [28, 0], filter: ["blur(10px)", "blur(0px)"] },
            { duration: 0.7, ease: [0.22, 1, 0.36, 1] },
          );
        });
      }
    </script>
  </body>
</html>
