---
import "../styles/global.css";
import SignOutButton from "../components/react/SignOutButton";
import { site } from "../data/site";

interface Props {
  title?: string;
  section?: "dashboard" | "orders" | "drops" | "products" | "customers";
}

const { title = `Admin · ${site.name}`, section = "dashboard" } = Astro.props;
const session = Astro.locals.session;

const navItems: { href: string; label: string; key: Props["section"] }[] = [
  { href: "/admin", label: "Dashboard", key: "dashboard" },
  { href: "/admin/orders", label: "Reservations", key: "orders" },
  { href: "/admin/drops", label: "Drops", key: "drops" },
  { href: "/admin/products", label: "Products", key: "products" },
  { href: "/admin/customers", label: "Customers", key: "customers" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..125,400..800&family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,400..800,0..100,0..1;1,9..144,400..800,0..100,0..1&family=Outfit:wght@300..800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />
  </head>
  <body class="min-h-screen bg-[var(--color-cream-soft)] antialiased">
    <div class="min-h-screen lg:grid lg:grid-cols-[260px_1fr]">
      <aside class="sticky top-0 z-30 border-b-2 border-[var(--color-ink-950)] bg-[var(--color-ink-950)] text-[var(--color-cream-soft)] lg:h-screen lg:border-b-0 lg:border-r-2">
        <div class="flex items-center justify-between gap-3 p-5">
          <a href="/admin" class="flex items-center gap-3">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl border-2 border-[var(--color-cream-soft)] bg-[var(--color-coral-500)] text-sm font-black">
              SD
            </span>
            <div>
              <p class="font-mono text-[0.64rem] uppercase tracking-[0.24em] text-[var(--color-sun-500)]">
                ✦ Admin
              </p>
              <p class="text-sm font-bold" style="font-family: var(--font-display); font-variation-settings: 'wdth' 108;">
                Sunset Duckies
              </p>
            </div>
          </a>
          <a href="/" class="chip hidden sm:inline-flex !bg-[var(--color-cream-soft)] !text-[var(--color-ink-950)] hover:!bg-[var(--color-sun-500)]">
            ← Site
          </a>
        </div>

        <nav class="hidden lg:block px-3 pb-6">
          <ul class="space-y-1">
            {navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    "flex items-center justify-between rounded-xl px-4 py-2.5 font-semibold transition",
                    section === item.key
                      ? "bg-[var(--color-sun-500)] text-[var(--color-ink-950)] shadow-[3px_3px_0_0_var(--color-cream-soft)]"
                      : "text-[var(--color-cream-soft)]/85 hover:bg-[var(--color-cream-soft)]/10",
                  ]}
                  style="font-family: var(--font-display); font-variation-settings: 'wdth' 110;"
                >
                  <span>{item.label}</span>
                  {section === item.key && <span class="text-xs">✦</span>}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <nav class="lg:hidden px-5 pb-4">
          <ul class="flex flex-wrap gap-2">
            {navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    "rounded-full border px-3 py-1.5 font-mono text-[0.7rem] uppercase tracking-[0.14em]",
                    section === item.key
                      ? "border-[var(--color-sun-500)] bg-[var(--color-sun-500)] text-[var(--color-ink-950)]"
                      : "border-[var(--color-cream-soft)]/30 text-[var(--color-cream-soft)]/80 hover:bg-[var(--color-cream-soft)]/10",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="hidden lg:block absolute bottom-4 left-4 right-4 rounded-xl border-2 border-[var(--color-cream-soft)]/30 bg-[var(--color-cream-soft)]/5 p-3">
          <p class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-[var(--color-sun-500)]">
            Signed in as
          </p>
          <p class="mt-1 truncate text-sm font-semibold">{session?.user?.name ?? "Admin"}</p>
          <p class="truncate font-mono text-[0.68rem] text-[var(--color-cream-soft)]/65">
            {session?.user?.email}
          </p>
          <div class="mt-2">
            <SignOutButton client:load className="font-mono text-[0.66rem] uppercase tracking-[0.18em] text-[var(--color-coral-500)] underline-offset-4 hover:underline" />
          </div>
        </div>
      </aside>

      <main class="px-4 py-8 sm:px-6 lg:px-10 lg:py-12">
        <slot />
      </main>
    </div>
  </body>
</html>
