---
import BaseLayout from "./BaseLayout.astro";
interface Props { title?: string; section?: "dashboard" | "orders" | "drops" | "products" | "customers" | "gallery" | "cup" | "parents" | "kids" | "training" }
const { title = "Admin · Sunset Duckies", section = "dashboard" } = Astro.props;
---
<BaseLayout title={title} workspace="admin" section={section}>
  <div class="mx-auto min-w-0 max-w-screen-2xl px-4 py-8 sm:px-8 lg:py-12"><slot /></div>
</BaseLayout>
