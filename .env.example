# Use a dedicated Duckies Postgres database, never postgres/template1.
DUCKIES_DATABASE_URL=postgresql://duckies:duckies@localhost:54329/duckies
BETTER_AUTH_URL=http://localhost:4321
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
RESEND_API_KEY=
# A sender on your verified Resend domain
EMAIL_FROM=Sunset Duckies <members@sunsetduckies.com>
# Optional: shop reservation alerts for an organiser
EMAIL_ADMIN_NOTIFY=
# Base64 PKCS8 DER Ed25519 private key. Keep stable and back it up securely.
# Generate: node -e "console.log(require('node:crypto').generateKeyPairSync('ed25519').privateKey.export({format:'der',type:'pkcs8'}).toString('base64'))"
WAIVER_SIGNING_PRIVATE_KEY=
# Optional server-only key for approved branding editors’ granola recipe suggestions.
OPENAI_API_KEY=
GRANOLA_AI_MODEL=gpt-5-mini

# Optional: direct (unpooled) URLs for `pnpm db:migrate:staging` / `pnpm db:migrate:production`.
# STAGING_DATABASE_URL=
# PRODUCTION_DATABASE_URL=
