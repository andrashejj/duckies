# Sunset Duckies — env template
# Copy to .env (local) and set the same values in Vercel project env for prod.

# --- Database (Neon Postgres) ---
# Pooled connection string — used by the app at runtime.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/duckies?sslmode=require"

# Direct connection string — used by Prisma Migrate (non-pooled).
DIRECT_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/duckies?sslmode=require"

# --- Site ---
PUBLIC_SITE_URL="http://localhost:4321"

# --- Auth (lands in PR 3) ---
# AUTH_SECRET=""             # openssl rand -base64 32
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_TRUST_HOST="true"

# --- Email / Resend ---
# Without these, orders still persist — emails are skipped and warned in logs.
RESEND_API_KEY=""
EMAIL_FROM="Sunset Duckies <orders@sunsetduckies.com>"
EMAIL_ADMIN_NOTIFY="orders@sunsetduckies.com"
