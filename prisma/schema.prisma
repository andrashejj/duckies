// Sunset Duckies — Prisma schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Catalogue ----------

enum ProductCategory {
  APPAREL
  HEADWEAR
  ACCESSORIES
  BOARD_CARE
  STATIONERY
  BUNDLE
}

enum DropStatus {
  DRAFT
  LIVE
  CLOSED
}

model Drop {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String?
  status      DropStatus  @default(DRAFT)
  opensAt     DateTime?
  closesAt    DateTime?
  pickupNote  String?
  sortOrder   Int         @default(0)
  products    Product[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status, sortOrder])
}

model Product {
  id          String          @id @default(cuid())
  sku         String          @unique
  slug        String          @unique
  name        String
  kind        String
  tagline     String?
  description String
  priceCents  Int
  currency    String          @default("MUR")
  category    ProductCategory
  sizes       String[]        @default([])
  colorway    String          @default("ink")
  imageUrl    String?
  imageAlt    String?
  active      Boolean         @default(true)
  featured    Boolean         @default(false)
  stock       Int?
  sortOrder   Int             @default(0)
  dropId      String?
  drop        Drop?           @relation(fields: [dropId], references: [id], onDelete: SetNull)
  images      ProductImage[]
  orderItems  OrderItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([active, sortOrder])
  @@index([category])
  @@index([dropId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

// ---------- Users + Auth.js ----------

enum UserRole {
  CUSTOMER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  phone         String?
  role          UserRole  @default(CUSTOMER)
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  orderEvents   OrderEvent[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Orders ----------

enum OrderStatus {
  PENDING
  CONFIRMED
  READY
  FULFILLED
  CANCELLED
}

enum PickupMethod {
  SESH
  ARRANGE
}

enum OrderEventType {
  CREATED
  CONFIRMED
  READY
  FULFILLED
  CANCELLED
  PAID
  NOTE
  EMAIL_SENT
}

model Order {
  id             String         @id @default(cuid())
  guestToken     String         @unique
  userId         String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  email          String
  name           String
  phone          String?
  status         OrderStatus    @default(PENDING)
  pickupMethod   PickupMethod   @default(SESH)
  pickupNote     String?
  customerNote   String?
  internalNotes  String?
  subtotalCents  Int
  totalCents     Int
  currency       String         @default("MUR")
  paidAt         DateTime?
  items          OrderItem[]
  events         OrderEvent[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([userId])
  @@index([paidAt])
}

model OrderItem {
  id                String  @id @default(cuid())
  orderId           String
  order             Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku               String
  nameSnapshot      String
  priceCentsSnapshot Int
  quantity          Int
  size              String?
  kidName           String?
  lineTotalCents    Int

  @@index([orderId])
  @@index([productId])
}

model OrderEvent {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      OrderEventType
  message   String?
  actorId   String?
  actor     User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())

  @@index([orderId, createdAt])
}
