// Sunset Duckies — Prisma schema
// PR 1 scope: Product catalog only.
// Auth, Order, OrderItem, OrderEvent land in later PRs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductCategory {
  APPAREL
  HEADWEAR
  ACCESSORIES
  BOARD_CARE
  STATIONERY
  BUNDLE
}

model Product {
  id          String          @id @default(cuid())
  sku         String          @unique
  slug        String          @unique
  name        String
  kind        String
  tagline     String?
  description String
  priceCents  Int
  currency    String          @default("MUR")
  category    ProductCategory
  sizes       String[]        @default([])
  colorway    String          @default("ink")
  active      Boolean         @default(true)
  featured    Boolean         @default(false)
  stock       Int?
  sortOrder   Int             @default(0)
  images      ProductImage[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([active, sortOrder])
  @@index([category])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}
