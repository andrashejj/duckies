model ClubPost {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  author_id String
  body String @default("")
  photo_id String? @unique @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  hidden_at DateTime? @db.Timestamptz(6)
  author User @relation(fields:[author_id], references:[id], onDelete:Cascade, onUpdate:NoAction)
  photo GalleryUpload? @relation(fields:[photo_id], references:[id], onDelete:Cascade, onUpdate:NoAction)
  likes ClubPostLike[]
  comments ClubPostComment[]
  @@index([created_at(sort: Desc), id(sort: Desc)], map:"club_post_feed", where: raw("hidden_at IS NULL"))
  @@index([author_id, created_at(sort: Desc)], map:"club_post_author")
  @@map("club_post")
}
model ClubPostLike {
  post_id String @db.Uuid
  user_id String
  post ClubPost @relation(fields:[post_id], references:[id], onDelete:Cascade, onUpdate:NoAction)
  user User @relation(fields:[user_id], references:[id], onDelete:Cascade, onUpdate:NoAction)
  @@id([post_id,user_id])
  @@map("club_post_like")
}
model ClubPostComment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  post_id String @db.Uuid
  author_id String
  body String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  post ClubPost @relation(fields:[post_id], references:[id], onDelete:Cascade, onUpdate:NoAction)
  author User @relation(fields:[author_id], references:[id], onDelete:Cascade, onUpdate:NoAction)
  @@index([post_id,created_at,id], map:"club_post_comment_post")
  @@map("club_post_comment")
}
model ClubMemberArchive {
  departure_known Boolean @default(true)
  email String @id
  ended_at DateTime @default(now()) @db.Timestamptz(6)
  photos Json @default("[]")
  posts Json @default("[]")
  comments Json @default("[]")
  @@map("club_member_archive")
}

// Individual, explicitly published moments. Live source permissions are rechecked on every read.
model ClubPublicShare {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id String
  owner User @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  source_key String
  photo_key String?
  caption String
  token String @unique
  created_at DateTime @default(now()) @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)

  @@map("club_public_share")
}
