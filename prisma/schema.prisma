// Sunset Duckies — Prisma schema

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------- Catalogue ----------

model Drop {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  status      DropStatus @default(DRAFT)
  opensAt     DateTime?
  closesAt    DateTime?
  pickupNote  String?
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  products    Product[]

  @@index([status, sortOrder])
}

model Product {
  id          String          @id @default(cuid())
  sku         String          @unique
  slug        String          @unique
  name        String
  kind        String
  tagline     String?
  description String
  priceCents  Int
  currency    String          @default("MUR")
  category    ProductCategory
  sizes       String[]        @default([])
  colorway    String          @default("ink")
  imageUrl    String?
  imageAlt    String?
  active      Boolean         @default(true)
  featured    Boolean         @default(false)
  stock       Int?
  sortOrder   Int             @default(0)
  dropId      String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  orderItems  OrderItem[]
  drop        Drop?           @relation(fields: [dropId], references: [id])
  images      ProductImage[]

  @@index([active, sortOrder])
  @@index([category])
  @@index([dropId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

// ---------- Auth (Better Auth owns these tables; the baseline migration created them) ----------

model User {
  public_shares ClubPublicShare[]
  social_posts ClubPost[]
  social_likes ClubPostLike[]
  social_comments ClubPostComment[]
  id                     String                   @id
  name                   String
  email                  String                   @unique
  emailVerified          Boolean
  image                  String?
  createdAt              DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                 @default(now()) @db.Timestamptz(6)
  orders                 Order[]
  orderEvents            OrderEvent[]
  accounts               Account[]
  kids                   ClubKid[]
  kidPhotos              ClubKidPhoto[]
  registrationLinks      ClubRegistrationLink[]
  sessions               Session[]

  @@map("user")
}

// ---------- Orders ----------

model Order {
  family_sharing ClubOrderFamily[]
  id                    String       @id @default(cuid())
  guestToken            String       @unique
  confirmationEmailSent Boolean      @default(false)
  requestKey            String?      @unique
  requestHash           String?
  userId                String?
  email                 String
  name                  String
  phone                 String?
  status                OrderStatus  @default(PENDING)
  pickupMethod          PickupMethod @default(SESH)
  pickupNote            String?
  customerNote          String?
  internalNotes         String?
  subtotalCents         Int
  totalCents            Int
  currency              String       @default("MUR")
  paidAt                DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  user                  User?        @relation(fields: [userId], references: [id])
  events                OrderEvent[]
  items                 OrderItem[]

  @@index([status, createdAt])
  @@index([email])
  @@index([userId])
  @@index([paidAt])
}

model OrderItem {
  granolaBags        Int     @default(0)
  id                 String  @id @default(cuid())
  orderId            String
  productId          String
  sku                String
  nameSnapshot       String
  priceCentsSnapshot Int
  quantity           Int
  size               String?
  kidName            String?
  lineTotalCents     Int
  stockReserved      Boolean @default(false)
  order              Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model OrderEvent {
  id        String         @id @default(cuid())
  orderId   String
  type      OrderEventType
  message   String?
  actorId   String?
  createdAt DateTime       @default(now())
  actor     User?          @relation(fields: [actorId], references: [id])
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @db.Timestamptz(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])

  @@map("account")
}

// ---------- Branding workspace: access, granola sheet, plan board ----------

model BrandingAccess {
  email                 String                  @id
  name                  String
  reason                String                  @default("")
  status                String                  @default("pending")
  can_edit              Boolean                 @default(false)
  verified_at           DateTime?               @db.Timestamptz(6)
  requested_at          DateTime                @default(now()) @db.Timestamptz(6)
  decided_at            DateTime?               @db.Timestamptz(6)
  decided_by            String?
  version               Int                     @default(1)
  branding_access_event BrandingAccessEvent[]

  @@map("branding_access")
}

model BrandingAccessEvent {
  id              BigInt          @id @default(autoincrement())
  email           String
  status          String
  can_edit        Boolean
  actor           String
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  branding_access BrandingAccess @relation(fields: [email], references: [email], onDelete: NoAction, onUpdate: NoAction)

  @@map("branding_access_event")
}

// ---------- Club: members, kids, registration, semesters ----------

model ClubKid {
  gallery_tags GalleryKidTag[]
  attendance ClubAttendance[]
  attendance_events ClubAttendanceEvent[]
  family_orders ClubOrderFamily[]
  guardian_access ClubGuardianAccess[]
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  created_by             String?
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  archived_at            DateTime?                @db.Timestamptz(6)
  contact_name           String?
  contact_phone          String?
  user                   User?                    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  club_kid_photo         ClubKidPhoto?
  club_cup_entry         ClubCupEntry[]
  cup_heat_slot          CupHeatSlot[]
  cup_wave               CupWave[]
  club_birth_date_correction ClubBirthDateCorrection[]
  club_payment_event     ClubPaymentEvent[]
  registrationLinks      ClubRegistrationLink[]
  club_signed_waiver     ClubSignedWaiver[]

  @@map("club_kid")
}

// A kid coming to a Sunset Duckies Cup. Members ride on their signed club
// registration; cup-only kids sign the same form through the cup's term.
model ClubCupEntry {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kid_id        String   @db.Uuid
  edition       String
  member        Boolean
  contact_name  String
  contact_phone String
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  club_kid      ClubKid  @relation(fields: [kid_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([kid_id, edition], map: "club_cup_entry_kid_edition")
  @@map("club_cup_entry")
}

model ClubKidPhoto {
  kid_id      String   @id @db.Uuid
  image       Bytes
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  uploaded_by String?
  source      String
  club_kid    ClubKid @relation(fields: [kid_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user        User?    @relation(fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("club_kid_photo")
}

model ClubMember {
  email      String   @id
  role       String   @default("member")
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("club_member")
}


model ClubPaymentEvent {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kid_id        String        @db.Uuid
  term          String
  status        String
  amount_mur    Decimal?      @db.Decimal(10, 2)
  note          String
  actor_email   String
  recorded_at   DateTime      @default(now()) @db.Timestamptz(6)
  club_kid      ClubKid      @relation(fields: [kid_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  club_semester ClubSemester @relation(fields: [term], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([kid_id, term, recorded_at(sort: Desc)], map: "club_payment_event_kid")

  @@map("club_payment_event")
}

model ClubRegistrationLink {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kid_id                  String                   @db.Uuid
  token_hash              String                   @unique
  term                    String
  created_by              String?
  created_at              DateTime                 @default(now()) @db.Timestamptz(6)
  expires_at              DateTime                 @db.Timestamptz(6)
  revoked_at              DateTime?                @db.Timestamptz(6)
  completed_at            DateTime?                @db.Timestamptz(6)
  user                    User?                    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  club_kid                ClubKid                 @relation(fields: [kid_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  club_semester           ClubSemester            @relation(fields: [term], references: [id], onDelete: NoAction, onUpdate: NoAction)
  club_registration_photo ClubRegistrationPhoto[]
  parent_photos ClubRegistrationParentPhoto[]
  club_signed_waiver      ClubSignedWaiver[]

  @@index([kid_id, created_at(sort: Desc)], map: "club_registration_link_kid")

  @@map("club_registration_link")
}

// A profile photo staged against one child's slot in the form, until the
// guardian signs and it moves to that child's profile.
model ClubRegistrationPhoto {
  link_id                String                 @db.Uuid
  slot                   Int                    @default(0)
  image                  Bytes
  uploaded_at            DateTime               @default(now()) @db.Timestamptz(6)
  club_registration_link ClubRegistrationLink @relation(fields: [link_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([link_id, slot])
  @@map("club_registration_photo")
}

model ClubRegistrationParentPhoto {
  link_id String @db.Uuid
  email String
  image Bytes
  uploaded_at DateTime @default(now()) @db.Timestamptz(6)
  link ClubRegistrationLink @relation(fields: [link_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@id([link_id, email])
  @@map("club_registration_parent_photo")
}

model ClubSemester {
  id                     String                   @id
  label                  String
  starts_on              DateTime?                @db.Date
  ends_on                DateTime?                @db.Date
  child_fee_mur          Decimal                  @db.Decimal(10, 2)
  family_fee_mur         Decimal                  @db.Decimal(10, 2)
  is_current             Boolean                  @unique(map: "one_current_club_semester", where: raw("is_current")) @default(false)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  club_payment_event     ClubPaymentEvent[]
  registrationLinks      ClubRegistrationLink[]
  club_signed_waiver     ClubSignedWaiver[]

  @@map("club_semester")
}

model ClubSignedWaiver {
  id                     String                 @id @db.Uuid
  kid_id                 String                 @db.Uuid
  link_id                String                 @db.Uuid
  term                   String
  // The records a guardian signed in one go — a family's children share one,
  // and child_index keeps the order the guardian listed them in.
  signing_group          String                 @db.Uuid
  child_index            Int                    @default(0) @db.SmallInt
  signed_at              DateTime               @db.Timestamptz(6)
  snapshot               Json
  canonical_payload      String
  payload_sha256         String
  pdf                    Bytes
  pdf_sha256             String
  seal                   String
  public_key             String
  club_birth_date_correction ClubBirthDateCorrection[]
  club_kid               ClubKid               @relation(fields: [kid_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  club_registration_link ClubRegistrationLink @relation(fields: [link_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  club_semester          ClubSemester          @relation(fields: [term], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([kid_id, signed_at(sort: Desc)], map: "club_signed_waiver_kid")
  @@index([link_id, signed_at(sort: Desc)], map: "club_signed_waiver_link")
  @@index([signing_group, child_index], map: "club_signed_waiver_group")

  @@map("club_signed_waiver")
}

// ---------- Cup day: the draw, the judges' wave scores and the live ticker ----------

// One row per Cup edition: how the day is drawn and whether the leaderboard
// is public yet. Seeded by migration for cup-vol-2.
model CupEvent {
  plan Json?
  final_review Json?
  edition    String      @id
  rounds     Int         @default(2)
  heat_size  Int         @default(4)
  final_size Int         @default(4)
  live       Boolean     @default(false)
  version    Int         @default(1)
  updated_at DateTime    @default(now()) @db.Timestamptz(6)
  cup_heat   CupHeat[]
  cup_judge  CupJudge[]
  cup_ticker CupTicker[]

  @@map("cup_event")
}

// A heat: up to heat_size kids, one rashie colour each. Qualifying rounds are
// stage "round" 1..rounds; the final is stage "final" (round 0).
model CupHeat {
  duration_minutes Int @default(10)
  ends_at DateTime? @db.Timestamptz(6)
  volunteers CupHeatVolunteer[]
  judges        String[]      @default([])
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  edition       String
  stage         String        @default("round")
  round         Int
  number        Int
  status        String        @default("scheduled")
  started_at    DateTime?     @db.Timestamptz(6)
  finished_at   DateTime?     @db.Timestamptz(6)
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  cup_event     CupEvent      @relation(fields: [edition], references: [edition], onDelete: NoAction, onUpdate: NoAction)
  cup_heat_slot CupHeatSlot[]
  cup_wave      CupWave[]

  @@unique([edition, stage, round, number], map: "cup_heat_position")
  @@map("cup_heat")
}

model CupHeatSlot {
  heat_id  String   @db.Uuid
  kid_id   String   @db.Uuid
  colour   String
  cup_heat CupHeat  @relation(fields: [heat_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  club_kid ClubKid  @relation(fields: [kid_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([heat_id, kid_id])
  @@unique([heat_id, colour], map: "cup_heat_slot_colour")
  @@map("cup_heat_slot")
}

// Judges sign in with the club's email code; they need no club membership.
model CupJudge {
  edition    String
  email      String
  name       String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  created_by String?
  cup_event  CupEvent @relation(fields: [edition], references: [edition], onDelete: NoAction, onUpdate: NoAction)

  @@id([edition, email])
  @@map("cup_judge")
}

// One judge’s star rating for a numbered run. Average judges per run,
// then take the average of the kid’s best two runs.
model CupWave {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  heat_id     String   @db.Uuid
  kid_id      String   @db.Uuid
  judge_email String
  wave        Int
  score       Decimal  @db.Decimal(3, 1)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  cup_heat    CupHeat  @relation(fields: [heat_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  club_kid    ClubKid  @relation(fields: [kid_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([heat_id, kid_id, judge_email, wave], map: "cup_wave_once")
  @@index([heat_id, judge_email], map: "cup_wave_heat_judge")
  @@map("cup_wave")
}

// The news strip on the public leaderboard: heat starts and results are
// posted by the app, notes by the organisers.
model CupTicker {
  id         BigInt   @id @default(autoincrement())
  edition    String
  kind       String   @default("note")
  message    String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  cup_event  CupEvent @relation(fields: [edition], references: [edition], onDelete: NoAction, onUpdate: NoAction)

  @@index([edition, created_at(sort: Desc)], map: "cup_ticker_edition")
  @@map("cup_ticker")
}

model GalleryUpload {
  social_post ClubPost?
  kid_tags GalleryKidTag[]
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  uploaded_by   String?
  note          String?
  caption       String?
  image         Bytes
  thumb         Bytes
  width         Int
  height        Int
  status        String    @default("approved")
  reviewed_at   DateTime? @db.Timestamptz(6)
  reviewed_by   String?
  ip_hash       String?

  @@index([status, created_at(sort: Desc)], map: "gallery_upload_status_idx")
  @@map("gallery_upload")
}

model GalleryKidTag {
  kid_id String @db.Uuid
  photo_key String
  upload_id String? @db.Uuid
  created_by String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  kid ClubKid @relation(fields: [kid_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  upload GalleryUpload? @relation(fields: [upload_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@id([kid_id, photo_key])
  @@index([photo_key], map: "gallery_kid_tag_photo")
  @@index([upload_id], map: "gallery_kid_tag_upload")
  @@map("gallery_kid_tag")
}

model GranolaAiLimit {
  key      String   @id
  count    Int
  reset_at DateTime @db.Timestamptz(6)

  @@map("granola_ai_limit")
}

model GranolaPack {
  id               String             @id
  recipe           Json
  version          Int
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_by       String
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  granola_revision GranolaRevision[]

  @@map("granola_pack")
}

model GranolaRevision {
  pack_id      String
  version      Int
  recipe       Json
  created_at   DateTime     @default(now()) @db.Timestamptz(6)
  created_by   String
  granola_pack GranolaPack @relation(fields: [pack_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([pack_id, version])

  @@map("granola_revision")
}

model PlanMilestone {
  id          String       @id
  code        String
  title       String
  date_label  String
  due_on      DateTime     @db.Date
  deliverable String       @default("")
  owner_id    String?
  links       Json         @default("[]")
  sort        Int
  plan_person PlanPerson? @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plan_task   PlanTask[]

  @@map("plan_milestone")
}

model PlanPerson {
  id             String           @id
  name           String
  email          String?          @unique
  sort           Int              @default(0)
  plan_milestone PlanMilestone[]
  plan_task      PlanTask[]

  @@map("plan_person")
}

model PlanTask {
  id              String            @id
  milestone_id    String
  text            String
  owner_id        String?
  due_on          DateTime?         @db.Date
  status          String            @default("todo")
  sort            Int
  version         Int               @default(1)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  created_by      String            @default("seed")
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_by      String            @default("seed")
  plan_milestone  PlanMilestone    @relation(fields: [milestone_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plan_person     PlanPerson?      @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plan_task_event PlanTaskEvent[]

  @@index([milestone_id, sort], map: "plan_task_milestone_idx")
  @@index([owner_id, status], map: "plan_task_owner_idx")

  @@map("plan_task")
}

model PlanTaskEvent {
  id         BigInt    @id @default(autoincrement())
  task_id    String
  status     String
  owner_id   String?
  actor      String
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  plan_task  PlanTask @relation(fields: [task_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("plan_task_event")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(6)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @db.Timestamptz(6)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])

  @@map("session")
}

// ---------- Shop rate limiting ----------

model ShopRequestLimit {
  key      String   @id
  count    Int
  reset_at DateTime @db.Timestamptz(6)

  @@map("shop_request_limit")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([identifier])

  @@map("verification")
}

enum ProductCategory {
  GRANOLA
  APPAREL
  HEADWEAR
  ACCESSORIES
  BOARD_CARE
  STATIONERY
  BUNDLE
}

enum DropStatus {
  DRAFT
  LIVE
  CLOSED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  READY
  FULFILLED
  CANCELLED
}

enum PickupMethod {
  SESH
  ARRANGE
}

enum OrderEventType {
  CREATED
  CONFIRMED
  READY
  FULFILLED
  CANCELLED
  PAID
  NOTE
  EMAIL_SENT
}



// Append-only club corrections; the original signed waiver stays unchanged.
model ClubBirthDateCorrection {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kid_id String @db.Uuid
  waiver_id String @db.Uuid
  previous_date DateTime @db.Date
  date_of_birth DateTime @db.Date
  reason String
  actor_email String
  recorded_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  club_kid ClubKid @relation(fields: [kid_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  club_signed_waiver ClubSignedWaiver @relation(fields: [waiver_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([waiver_id, recorded_at(sort: Desc)], map: "club_birth_date_correction_waiver")
  @@map("club_birth_date_correction")
}

// Adults keep their own editable profile separate from signed child registrations.
model ClubParentProfile {
  email String @id
  name String
  phone String @default("")
  image Bytes?
  photo_updated_at DateTime? @db.Timestamptz(6)
  registration_link_id String? @db.Uuid
  photo_registration_link_id String? @db.Uuid
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  @@map("club_parent_profile")
}
model CupHeatVolunteer {
  heat_id String @db.Uuid
  email String
  status String @default("pending")
  requested_at DateTime @default(now()) @db.Timestamptz(6)
  reviewed_by String?
  heat CupHeat @relation(fields: [heat_id], references: [id], onDelete: Cascade)
  @@id([heat_id, email])
  @@map("cup_heat_volunteer")
}

// Overrides guardian access without changing any signed waiver.
model ClubGuardianAccess {
  kid_id String @db.Uuid
  email String
  name String
  relationship String
  phone String
  revoked_at DateTime? @db.Timestamptz(6)
  updated_by String
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  kid ClubKid @relation(fields: [kid_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@id([kid_id, email])
  @@index([email], map: "club_guardian_access_email")
  @@map("club_guardian_access")
}

model ClubOrderFamily {
  order_id String
  kid_id String @db.Uuid
