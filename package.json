{
  "name": "duckies-surf-club",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host",
    "build": "prisma generate && tsx scripts/vercel-migrate.ts && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && tsc --noEmit",
    "db:migrate": "tsx scripts/db-guard.ts && prisma migrate deploy",
    "db:migration": "prisma migrate dev --create-only --name",
    "db:migrate:staging": "tsx scripts/db-target.ts staging migrate",
    "db:migrate:production": "tsx scripts/db-target.ts production migrate",
    "db:status:staging": "tsx scripts/db-target.ts staging status",
    "db:status:production": "tsx scripts/db-target.ts production status",
    "db:rolled-back:staging": "tsx scripts/db-target.ts staging rolled-back",
    "db:rolled-back:production": "tsx scripts/db-target.ts production rolled-back",
    "member": "tsx scripts/member.ts",
    "test": "playwright test",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.7",
    "@astrojs/vercel": "^10.0.8",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.1.4",
    "better-auth": "^1.7.4",
    "dotenv": "^17.4.2",
    "motion": "^12.38.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.2.2",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
